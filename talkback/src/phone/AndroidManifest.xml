<?xml version="1.0" encoding="utf-8"?>
<!-- Parts of SandFly that only phones and tablets have. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Types what is written on the screen with one finger. -->
        <service
            android:name="com.google.android.accessibility.talkback.handwriting.HandwritingIme"
            android:label="@string/handwriting_keyboard_name"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/handwriting_ime" />
        </service>
        <!-- Installs scripts that are opened with or shared to SandFly, through Scripts. -->
        <activity
            android:name="com.google.android.accessibility.talkback.scripting.ScriptImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/script_install_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/script_install_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/x-lua" />
                <data android:mimeType="application/x-lua" />
                <data android:mimeType="text/x-script.lua" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter android:label="@string/script_install_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-lua" />
                <data android:mimeType="application/x-lua" />
                <data android:mimeType="text/x-script.lua" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <!-- A link to a script, such as one shared from a browser. -->
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
