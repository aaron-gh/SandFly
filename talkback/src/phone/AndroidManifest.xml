<?xml version="1.0" encoding="utf-8"?>
<!-- Parts of SandFly that only phones and tablets have. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Types what is written on the screen with one finger. -->
        <service
            android:name="com.google.android.accessibility.talkback.handwriting.HandwritingIme"
            android:label="@string/handwriting_keyboard_name"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/handwriting_ime" />
        </service>
        <!-- Installs scripts that are opened with or shared to SandFly, through Scripts. Messaging
             apps and file managers often give .lua files a general type, so text/plain and
             application/octet-stream files are taken too, and the activity checks the file's
             name. -->
        <activity
            android:name="com.google.android.accessibility.talkback.scripting.ScriptImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/script_install_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/script_install_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/x-lua" />
                <data android:mimeType="application/x-lua" />
                <data android:mimeType="text/x-script.lua" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/script_install_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-lua" />
                <data android:mimeType="application/x-lua" />
                <data android:mimeType="text/x-script.lua" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <!-- A .lua file, or a link to a script, such as one shared from a browser. -->
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- SandFly's live wallpaper. Android keeps the current wallpaper's process running, so
             battery savers that stop background apps leave SandFly running. -->
        <service
            android:name="com.google.android.accessibility.talkback.wallpaper.SandFlyWallpaperService"
            android:label="@string/talkback_title"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/sandfly_wallpaper" />
        </service>
        <!-- Chooses the wallpaper's image. Exported for the wallpaper picker's settings button. -->
        <activity
            android:name="com.google.android.accessibility.talkback.wallpaper.WallpaperImageActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/BlankActivityTheme" />
    </application>
</manifest>
