<?xml version="1.0" encoding="utf-8"?>
<!-- Parts of SandFly that only phones and tablets have. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Types what is written on the screen with one finger. -->
        <service
            android:name="com.google.android.accessibility.talkback.handwriting.HandwritingIme"
            android:label="@string/handwriting_keyboard_name"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/handwriting_ime" />
        </service>
        <!-- The input method for physical keyboards: no keys on the screen; held keys, emoji
             search and the symbol chooser, and whether a text field is being edited. -->
        <service
            android:name="com.google.android.accessibility.talkback.keyboard.SandFlyKeyboard"
            android:label="@string/sandfly_keyboard_name"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/sandfly_keyboard_ime" />
        </service>
        <!-- Installs scripts that are opened with or shared to SandFly, through Scripts. -->
        <activity
            android:name="com.google.android.accessibility.talkback.scripting.ScriptImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/script_install_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/script_install_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/x-lua" />
                <data android:mimeType="application/x-lua" />
                <data android:mimeType="text/x-script.lua" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter android:label="@string/script_install_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-lua" />
                <data android:mimeType="application/x-lua" />
                <data android:mimeType="text/x-script.lua" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <!-- A link to a script, such as one shared from a browser. -->
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- View code, Edit code and New script from code: the main.lua of a script. -->
        <activity
            android:name="com.google.android.accessibility.talkback.scripting.ScriptCodeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale"
            android:exported="false"
            android:label="@string/script_code_view"
            android:theme="@style/NotificationListTheme"
            android:windowSoftInputMode="adjustResize" />
        <!-- SandFly's live wallpaper. Android keeps the current wallpaper's process running, so
             battery savers that stop background apps leave SandFly running. -->
        <service
            android:name="com.google.android.accessibility.talkback.wallpaper.SandFlyWallpaperService"
            android:label="@string/talkback_title"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/sandfly_wallpaper" />
        </service>
        <!-- Chooses the wallpaper's image. Exported for the wallpaper picker's settings button. -->
        <activity
            android:name="com.google.android.accessibility.talkback.wallpaper.WallpaperImageActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/BlankActivityTheme" />
    </application>
</manifest>
