    <string name="sandfly_tutorial_item_bread">Pa</string>
    <string name="sandfly_tutorial_item_cheese">Formatge</string>
    <string name="sandfly_tutorial_item_dates">Dàtils</string>
    <string name="sandfly_tutorial_item_eggs">Ous</string>
    <string name="sandfly_tutorial_lesson_complete">Lliçó completada.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Lliçó completada. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> per acabar el tutorial.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Lliçó completada. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> per començar la lliçó següent.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, lliçó <xliff:g id="number" example="3">%2$d</xliff:g> de <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">Element <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> per tancar el menú.</string>
    <string name="sandfly_tutorial_menu_intro">El menú de SandFly té ordres per a l\'element enfocat i la pantalla actual.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> per obrir el menú de SandFly. Llisca per recórrer les seves ordres. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> tanca el menú.</string>
    <string name="sandfly_tutorial_menu_title">Menú de SandFly</string>
    <string name="sandfly_tutorial_message">Missatge de Sam: Dinem a migdia?</string>
    <string name="sandfly_tutorial_message_archive">Arxiva</string>
    <string name="sandfly_tutorial_message_delete">Suprimeix</string>
    <string name="sandfly_tutorial_message_reply">Respon</string>
    <string name="sandfly_tutorial_move_intro">Lliscar passa a l\'element següent o anterior de la pantalla, en ordre de lectura.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> per anar a l\'element següent. Continua fins a arribar a <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> per anar a l\'element anterior. Torna a <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Moure\'s entre elements</string>
    <string name="sandfly_tutorial_name">Nom</string>
    <string name="sandfly_tutorial_next_lesson">Lliçó següent: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> no té cap gest. Assigna-n\'hi un a Ordres o utilitza Omet el pas.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> no es fa en una lliçó. Per sortir del tutorial, utilitza Tanca el tutorial a Contingut.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> no es fa en una lliçó.</string>
    <string name="sandfly_tutorial_pause_intro">La veu es pot posar en pausa enmig d\'un element i reprendre on s\'ha aturat.</string>
    <string name="sandfly_tutorial_pause_pause">Ves a la història de sota. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> mentre es llegeix per posar la veu en pausa, i de nou per reprendre-la.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> de nou per reprendre la veu.</string>
    <string name="sandfly_tutorial_pause_title">Posar la veu en pausa</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Cada gest diu el seu nom i la seva acció en lloc de fer-la. Anar a l\'element següent i anterior i activar continuen funcionant.</string>
    <string name="sandfly_tutorial_practice_step">Fes qualsevol gest per sentir què fa. Per aturar-te, activa <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Pràctica de gestos</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> de <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Canvia el control de lectura a <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> per avançar un caràcter.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Els controls de lectura trien què fa lliscar cap amunt i cap avall, com ara moure\'s per paraules o per caràcters, o canviar la velocitat de parla. Lliscar cap a la dreta i cap a l\'esquerra continua movent-se entre elements.</string>
    <string name="sandfly_tutorial_reading_controls_move">Ves a la frase de sota.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> per anar a la paraula següent. Avança tres paraules.</string>
    <string name="sandfly_tutorial_reading_controls_title">Controls de lectura</string>
    <string name="sandfly_tutorial_recipe_1">Creps: barreja farina, ous i llet fins a obtenir una pasta fina.</string>
    <string name="sandfly_tutorial_recipe_2">Escalfa una mica de mantega en una paella.</string>
    <string name="sandfly_tutorial_recipe_3">Aboca-hi prou pasta per cobrir la paella amb una capa fina.</string>
    <string name="sandfly_tutorial_recipe_4">Gira la crep quan la part de sota estigui daurada.</string>
    <string name="sandfly_tutorial_recipe_5">Serveix-la amb llimona i sucre.</string>
    <string name="sandfly_tutorial_scrolling_intro">Les llistes només mostren alguns dels seus elements alhora. Si llisques més enllà de l\'últim element visible, la llista es desplaça.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> per avançar una pàgina.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> per la llista fins a arribar a <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Desplaçar-se per llistes</string>
    <string name="sandfly_tutorial_sentence">Jove xef, porti whisky amb quinze glaçons d\'hidrogen, coi!</string>
    <string name="sandfly_tutorial_skip_step">Omet el pas</string>
    <string name="sandfly_tutorial_sliders_change">Ves al control lliscant <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> o <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> per canviar-ne el valor.</string>
    <string name="sandfly_tutorial_sliders_highest">Posa <xliff:g id="slider" example="Brightness">%1$s</xliff:g> al 100 per cent, el seu valor més alt.</string>
    <string name="sandfly_tutorial_sliders_intro">Quan un control lliscant té el focus, lliscar cap amunt i cap avall en canvia el valor.</string>
    <string name="sandfly_tutorial_sliders_title">Controls lliscants</string>
    <string name="sandfly_tutorial_step">Pas <xliff:g id="number" example="1">%1$d</xliff:g> de <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Els flebòtoms són mosques petites que viuen a les platges, a les vores dels rius i als boscos. Són més actius a l\'alba i al capvespre, quan l\'aire està quiet. Només piquen les femelles, perquè necessiten sang per produir els ous. Les picades fan picor durant dies, per això qui visita les zones on viuen porta repel·lent d\'insectes. Els flebòtoms volen malament, i fins i tot una brisa lleugera els manté lluny.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> per tornar enrere.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> per anar a la pantalla d\'inici.</string>
    <string name="sandfly_tutorial_system_intro">Aquests gestos funcionen a totes les pantalles. En aquesta lliçó, el tutorial diu què fa cadascun en lloc de fer-ho.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> per obrir les notificacions.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> per mostrar les aplicacions recents.</string>
    <string name="sandfly_tutorial_system_title">Enrere, Inici i notificacions</string>
    <string name="sandfly_tutorial_tile_cloud">Núvol</string>
    <string name="sandfly_tutorial_tile_moon">Lluna</string>
    <string name="sandfly_tutorial_tile_star">Estrella</string>
    <string name="sandfly_tutorial_tile_sun">Sol</string>
    <string name="sandfly_tutorial_title">Tutorial de SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Suprimeix l\'última lletra amb la tecla Suprimeix del teclat.</string>
    <string name="sandfly_tutorial_typing_intro">En activar un camp de text, s\'obre el teclat. Toca una tecla per sentir-la i aixeca el dit per escriure-la.</string>
    <string name="sandfly_tutorial_typing_open">Ves al camp <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> per començar a escriure.</string>
    <string name="sandfly_tutorial_typing_title">Escriure</string>
    <string name="sandfly_tutorial_typing_type">Escriu la paraula <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">gat</string>
    <string name="sandfly_tutorial_welcome_intro">Aquest tutorial ensenya els gestos de SandFly. Cada lliçó dona una instrucció, espera que l\'hagis fet amb els teus propis gestos i després dona la següent. La instrucció és el primer element després del nom de la lliçó. Contingut mostra totes les lliçons, i el tutorial es torna a obrir a la lliçó on eres.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> a qualsevol lloc de la pantalla per començar.</string>
    <string name="sandfly_tutorial_welcome_title">Benvinguda</string>
</resources>
