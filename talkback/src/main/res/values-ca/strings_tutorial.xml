<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Ves al missatge. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> o <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> per recórrer les seves accions. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> per fer l\'acció que sents. Fes <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Alguns elements tenen accions a més d\'activar-los, com ara Arxiva o Suprimeix en un missatge. Quan un d\'aquests elements té el focus, el control de lectura Accions les recorre.</string>
    <string name="sandfly_tutorial_actions_title">Accions</string>
    <string name="sandfly_tutorial_activate_button">Ves a <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> per activar-lo.</string>
    <string name="sandfly_tutorial_activate_check_box">Marca <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> de la mateixa manera.</string>
    <string name="sandfly_tutorial_activate_hold">Alguns elements fan una altra cosa si els mantens premuts. Ves a <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> per mantenir-lo premut.</string>
    <string name="sandfly_tutorial_activate_intro">L\'activació actua sobre l\'element enfocat, toquis on toquis la pantalla.</string>
    <string name="sandfly_tutorial_activate_title">Activar elements</string>
    <string name="sandfly_tutorial_back_in_lesson">Enrere no surt d\'una lliçó. Per triar una altra lliçó, utilitza Contingut.</string>
    <string name="sandfly_tutorial_bell">Fes sonar la campana</string>
    <string name="sandfly_tutorial_bell_rung">Vegades que ha sonat: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Brillantor</string>
    <string name="sandfly_tutorial_chapter_basics">Conceptes bàsics</string>
    <string name="sandfly_tutorial_chapter_controls">Controls i text</string>
    <string name="sandfly_tutorial_chapter_getting_around">Moure\'s</string>
    <string name="sandfly_tutorial_chapter_practice">Pràctica</string>
    <string name="sandfly_tutorial_chapter_reading">Lectura</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> o <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> per canviar el control de lectura. Tria <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Tanca el tutorial</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> per copiar al porta-retalls el darrer text que ha dit SandFly.</string>
    <string name="sandfly_tutorial_commands_intro">Aquestes ordres funcionen a totes les pantalles.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> per cercar text a la pantalla. En aquesta lliçó, el tutorial diu què fa en lloc de fer-ho.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> per desactivar la veu, i de nou per activar-la. En aquesta lliçó, el tutorial diu què fa en lloc de fer-ho.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> per sentir l\'hora, el nivell de bateria i altres dades d\'estat.</string>
    <string name="sandfly_tutorial_commands_title">Ordres útils</string>
    <string name="sandfly_tutorial_contents">Contingut</string>
    <string name="sandfly_tutorial_contents_intro">Lliçons, en ordre. Cadascuna es pot obrir per separat.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly pot llegir des de l\'element enfocat fins al final de la pantalla sense lliscar. Si toques la pantalla, s\'atura la lectura.</string>
    <string name="sandfly_tutorial_continuous_move">Ves a la primera línia de la recepta.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> per llegir a partir de l\'element enfocat.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> per obrir el menú de SandFly i, després, tria <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_title">Lectura contínua</string>
    <string name="sandfly_tutorial_details">Detalls</string>
    <string name="sandfly_tutorial_details_shown">Taula per a 2 a les 19:00, al costat de la finestra.</string>
    <string name="sandfly_tutorial_done">Completada</string>
    <string name="sandfly_tutorial_end_practice">Acaba la pràctica</string>
    <string name="sandfly_tutorial_explore_activate">Toca Estrella i aixeca el dit. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> a qualsevol lloc per activar-la.</string>
    <string name="sandfly_tutorial_explore_find">Fes lliscar un dit per la pantalla i troba els quatre quadrats: Sol, Lluna, Estrella i Núvol.</string>
    <string name="sandfly_tutorial_explore_intro">Quan toques la pantalla, es diu l\'element que hi ha sota el dit. Tocar un element no l\'activa.</string>
    <string name="sandfly_tutorial_explore_title">Exploració tàctil</string>
    <string name="sandfly_tutorial_extra_cheese">Formatge extra</string>
    <string name="sandfly_tutorial_finish">Acaba el tutorial</string>
    <string name="sandfly_tutorial_forecast_today">Avui</string>
    <string name="sandfly_tutorial_forecast_today_text">Assolellat i càlid, amb vent suau.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Demà</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Ennuvolat al matí, amb pluja a partir del migdia.</string>
    <string name="sandfly_tutorial_forecast_weekend">Cap de setmana</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Vent dissabte, cel serè diumenge.</string>
    <string name="sandfly_tutorial_headings_intro">Les pantalles i les pàgines web divideixen el contingut amb títols. El control de lectura Títols salta d\'un títol al següent.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> per saltar al títol següent. Salta a <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_headings_title">Títols</string>
