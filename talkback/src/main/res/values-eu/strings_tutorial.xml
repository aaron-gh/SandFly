    <string name="sandfly_tutorial_practice_intro">Keinu bakoitzak bere izena eta ekintza esaten ditu, ekintza gauzatu beharrean. Hurrengo eta aurreko elementura joateak eta aktibatzeak funtzionatzen jarraitzen dute.</string>
    <string name="sandfly_tutorial_practice_step">Egin edozein keinu zer egiten duen entzuteko. Gelditzeko, aktibatu <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Keinuen praktika</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Aldatu irakurketa-kontrola eta jarri <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> karaktere bat aurrera egiteko.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Irakurketa kontrolatzeko aukerek zehazten dute zer egiten duen hatza gora eta behera pasatzeak; adibidez, hitzez hitz edo karakterez karaktere mugitzea, edo hizketaren abiadura aldatzea. Hatza eskuinera eta ezkerrera pasatuta, elementu batetik bestera joaten zara oraindik.</string>
    <string name="sandfly_tutorial_reading_controls_move">Joan beheko esaldira.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> hurrengo hitzera joateko. Egin aurrera hiru hitz.</string>
    <string name="sandfly_tutorial_reading_controls_title">Irakurketa kontrolatzeko aukerak</string>
    <string name="sandfly_tutorial_recipe_1">Krepeak: nahastu irina, arrautzak eta esnea ore leun bat lortu arte.</string>
    <string name="sandfly_tutorial_recipe_2">Berotu gurin pixka bat zartagin batean.</string>
    <string name="sandfly_tutorial_recipe_3">Bota zartagina geruza mehe batez estaltzeko adina ore.</string>
    <string name="sandfly_tutorial_recipe_4">Eman buelta krepeari azpiko aldea urreztatuta dagoenean.</string>
    <string name="sandfly_tutorial_recipe_5">Zerbitzatu limoiarekin eta azukrearekin.</string>
    <string name="sandfly_tutorial_scrolling_intro">Zerrendek beren elementuetako batzuk baino ez dituzte erakusten aldi berean. Erakutsitako azken elementutik haratago hatza pasatuta, zerrenda korritzen da.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> orri bat aurrera korritzeko.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> zerrendan zehar, <xliff:g id="item" example="Item 15">%2$s</xliff:g> elementura iritsi arte.</string>
    <string name="sandfly_tutorial_scrolling_title">Zerrendak korritzea</string>
    <string name="sandfly_tutorial_sentence">Azeri marroi azkarrak txakur alferraren gainetik egiten du salto.</string>
    <string name="sandfly_tutorial_skip_step">Saltatu urratsa</string>
    <string name="sandfly_tutorial_sliders_change">Joan <xliff:g id="slider" example="Brightness">%3$s</xliff:g> graduatzailera. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> edo <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> haren balioa aldatzeko.</string>
    <string name="sandfly_tutorial_sliders_highest">Ezarri <xliff:g id="slider" example="Brightness">%1$s</xliff:g> ehuneko 100ean, haren baliorik handienean.</string>
    <string name="sandfly_tutorial_sliders_intro">Graduatzaile bat fokuratuta dagoenean, hatza gora eta behera pasatuta haren balioa aldatzen da.</string>
    <string name="sandfly_tutorial_sliders_title">Graduatzaileak</string>
    <string name="sandfly_tutorial_step"><xliff:g id="number" example="1">%1$d</xliff:g>/<xliff:g id="count" example="2">%2$d</xliff:g> urratsa: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Hondar-eltxoak hondartzetan, ibaiertzetan eta basoetan bizi diren euli txikiak dira. Egunsentian eta ilunabarrean dabiltza aktiboen, airea geldi dagoenean. Emeek bakarrik egiten dute ziztada, odola behar baitute arrautzak sortzeko. Ziztadek egunetan egiten dute azkura; horregatik, eltxo horien eskualdeetara doazenek intsektuen aurkako uxagarria eramaten dute. Hondar-eltxoak hegalari ahulak dira, eta haize-bolada arin batek ere urrun mantentzen ditu.</string>
