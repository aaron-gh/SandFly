    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> aurreko elementura joateko. Itzuli <xliff:g id="item" example="Bread">%2$s</xliff:g> elementura.</string>
