    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> orri nagusira joateko.</string>
    <string name="sandfly_tutorial_system_intro">Keinu hauek pantaila guztietan funtzionatzen dute. Ikasgai honetan, tutorialak keinu bakoitzak zer egiten duen esaten du, egin beharrean.</string>
