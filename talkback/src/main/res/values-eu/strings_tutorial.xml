    <string name="sandfly_tutorial_actions_archive">Joan mezura. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> edo <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> haren ekintzak zerrendatzeko. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> entzuten duzun ekintza gauzatzeko. Gauzatu <xliff:g id="action" example="Archive">%4$s</xliff:g> ekintza.</string>
    <string name="sandfly_tutorial_actions_intro">Elementu batzuek aktibatzeaz gain beste ekintza batzuk dituzte; adibidez, mezu batek Artxibatu edo Ezabatu. Elementu horietako bat fokuratuta dagoen bitartean, Ekintzak irakurketa-kontrolak ekintza horiek zerrendatzen ditu.</string>
    <string name="sandfly_tutorial_actions_title">Ekintzak</string>
    <string name="sandfly_tutorial_activate_button">Joan <xliff:g id="button" example="Ring the bell">%2$s</xliff:g> botoira. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> aktibatzeko.</string>
    <string name="sandfly_tutorial_activate_check_box">Hautatu <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> laukia modu berean.</string>
    <string name="sandfly_tutorial_activate_hold">Elementu batzuek beste zerbait egiten dute sakatuta edukitzean. Joan <xliff:g id="button" example="Details">%2$s</xliff:g> botoira. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> sakatuta edukitzeko.</string>
    <string name="sandfly_tutorial_activate_intro">Aktibatzeak fokuratutako elementuan funtzionatzen du, pantailan edonon sakatuta ere.</string>
    <string name="sandfly_tutorial_activate_title">Elementuak aktibatzea</string>
    <string name="sandfly_tutorial_back_in_lesson">Atzera keinuak ez du ikasgaitik irteten. Beste ikasgai bat aukeratzeko, erabili Edukia.</string>
