    <string name="sandfly_tutorial_pause_intro">Hizketa elementu baten erdian pausatu daiteke, eta gelditu zen tokitik berrekin.</string>
    <string name="sandfly_tutorial_pause_pause">Joan beheko istoriora. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> irakurtzen ari den bitartean hizketa pausatzeko, eta berriro berrekiteko.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> berriro hizketari berrekiteko.</string>
