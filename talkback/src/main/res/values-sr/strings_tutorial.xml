<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Пређите на поруку. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> или <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> – пролазак кроз њене радње. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> – извршавање радње коју чујете. Извршите радњу „<xliff:g id="action" example="Archive">%4$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_actions_intro">Неке ставке осим активирања имају и друге радње, на пример „Архивирај“ или „Избриши“ за поруку. Док је таква ставка у фокусу, контрола читања „Радње“ пролази кроз њих.</string>
    <string name="sandfly_tutorial_actions_title">Радње</string>
    <string name="sandfly_tutorial_activate_button">Пређите на „<xliff:g id="button" example="Ring the bell">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – активирање.</string>
    <string name="sandfly_tutorial_activate_check_box">На исти начин означите „<xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_activate_hold">Неке ставке раде нешто друго када се задрже. Пређите на „<xliff:g id="button" example="Details">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> – задржавање.</string>
    <string name="sandfly_tutorial_activate_intro">Активирање ради на ставци у фокусу, где год да додирнете екран.</string>
    <string name="sandfly_tutorial_activate_title">Активирање ставки</string>
    <string name="sandfly_tutorial_back_in_lesson">„Назад“ не напушта лекцију. Да бисте изабрали другу лекцију, користите „Садржај“.</string>
    <string name="sandfly_tutorial_bell">Позвони звоном</string>
    <string name="sandfly_tutorial_bell_rung">Број звоњења: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Осветљеност</string>
    <string name="sandfly_tutorial_chapter_basics">Основе</string>
    <string name="sandfly_tutorial_chapter_controls">Контроле и текст</string>
    <string name="sandfly_tutorial_chapter_getting_around">Кретање</string>
    <string name="sandfly_tutorial_chapter_practice">Вежба</string>
    <string name="sandfly_tutorial_chapter_reading">Читање</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> или <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> – промена контроле читања. Изаберите „<xliff:g id="reading_control" example="Words">%3$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_close">Затвори водич</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> – копирање последњег текста који је SandFly изговорио у привремену меморију.</string>
    <string name="sandfly_tutorial_commands_intro">Ове команде раде на сваком екрану.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> – претрага текста на екрану. У овој лекцији водич уместо тога каже шта команда ради.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> – искључивање говора, а поново – укључивање. У овој лекцији водич уместо тога каже шта команда ради.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> – време, ниво батерије и други статус.</string>
    <string name="sandfly_tutorial_commands_title">Корисне команде</string>
    <string name="sandfly_tutorial_contents">Садржај</string>
    <string name="sandfly_tutorial_contents_intro">Лекције, редом. Свака може да се отвори засебно.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly може да чита од ставке у фокусу до краја екрана без превлачења. Додир екрана зауставља читање.</string>
    <string name="sandfly_tutorial_continuous_move">Пређите на први ред рецепта.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> – читање од ставке у фокусу.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> – отварање SandFly менија. Затим изаберите „<xliff:g id="command" example="Read from focused item">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_continuous_title">Непрекидно читање</string>
    <string name="sandfly_tutorial_details">Детаљи</string>
    <string name="sandfly_tutorial_details_shown">Сто за двоје у 19 ч, поред прозора.</string>
    <string name="sandfly_tutorial_done">Завршено</string>
    <string name="sandfly_tutorial_end_practice">Заврши вежбу</string>
    <string name="sandfly_tutorial_explore_activate">Додирните „Звезда“ и подигните прст. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> било где – активирање.</string>
    <string name="sandfly_tutorial_explore_find">Превлачите једним прстом по екрану и пронађите четири квадрата: Сунце, Месец, Звезда и Облак.</string>
    <string name="sandfly_tutorial_explore_intro">Додир екрана изговара ставку испод прста. Додир ставке не активира ставку.</string>
    <string name="sandfly_tutorial_explore_title">Истраживање додиром</string>
    <string name="sandfly_tutorial_extra_cheese">Додатни сир</string>
    <string name="sandfly_tutorial_finish">Заврши водич</string>
    <string name="sandfly_tutorial_forecast_today">Данас</string>
    <string name="sandfly_tutorial_forecast_today_text">Сунчано и топло, са слабим ветром.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Сутра</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Облачно ујутру, са кишом од поднева.</string>
    <string name="sandfly_tutorial_forecast_weekend">Викенд</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Ветровито у суботу, ведро у недељу.</string>
    <string name="sandfly_tutorial_headings_intro">Екрани и веб-странице деле садржај насловима. Контрола читања „Наслови“ прелази са једног наслова на следећи.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – прелазак на следећи наслов. Пређите на „<xliff:g id="heading" example="Weekend">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_headings_title">Наслови</string>
    <string name="sandfly_tutorial_item_apples">Јабуке</string>
    <string name="sandfly_tutorial_item_bread">Хлеб</string>
    <string name="sandfly_tutorial_item_cheese">Сир</string>
    <string name="sandfly_tutorial_item_dates">Урме</string>
    <string name="sandfly_tutorial_item_eggs">Јаја</string>
    <string name="sandfly_tutorial_lesson_complete">Лекција је завршена.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Лекција је завршена. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – завршавање водича.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Лекција је завршена. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – почетак следеће лекције.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, лекција <xliff:g id="number" example="3">%2$d</xliff:g> од <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">Ставка <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> – затварање менија.</string>
    <string name="sandfly_tutorial_menu_intro">SandFly мени садржи команде за ставку у фокусу и тренутни екран.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> – отварање SandFly менија. Превлачите кроз његове команде. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> затвара мени.</string>
    <string name="sandfly_tutorial_menu_title">SandFly мени</string>
    <string name="sandfly_tutorial_message">Порука од Саше: Ручак у подне?</string>
    <string name="sandfly_tutorial_message_archive">Архивирај</string>
    <string name="sandfly_tutorial_message_delete">Избриши</string>
    <string name="sandfly_tutorial_message_reply">Одговори</string>
    <string name="sandfly_tutorial_move_intro">Превлачење прелази на следећу или претходну ставку на екрану, редоследом читања.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> – прелазак на следећу ставку. Наставите док не стигнете до „<xliff:g id="item" example="Eggs">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> – прелазак на претходну ставку. Вратите се на „<xliff:g id="item" example="Bread">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_title">Кретање између ставки</string>
    <string name="sandfly_tutorial_name">Име</string>
    <string name="sandfly_tutorial_next_lesson">Следећа лекција: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">„<xliff:g id="action" example="Next item">%1$s</xliff:g>“ нема покрет. Доделите га у одељку „Команде“ или користите „Прескочи корак“.</string>
    <string name="sandfly_tutorial_not_in_lesson">„<xliff:g id="action" example="Home">%1$s</xliff:g>“ се не извршава у лекцији. Да бисте напустили водич, користите „Затвори водич“ у „Садржају“.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">„<xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g>“ се не извршава у лекцији.</string>
    <string name="sandfly_tutorial_pause_intro">Говор може да се паузира усред ставке и настави тамо где је стао.</string>
    <string name="sandfly_tutorial_pause_pause">Пређите на причу испод. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> док се чита – паузирање говора, а поново – настављање.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> поново – настављање говора.</string>
    <string name="sandfly_tutorial_pause_title">Паузирање говора</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Сваки покрет уместо извршавања изговара свој назив и радњу. Прелазак на следећу и претходну ставку и активирање и даље раде.</string>
    <string name="sandfly_tutorial_practice_step">Направите било који покрет да бисте чули шта ради. Да бисте престали, активирајте „<xliff:g id="button" example="End practice">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_practice_title">Вежба покрета</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> од <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Промените контролу читања на „<xliff:g id="reading_control" example="Characters">%2$s</xliff:g>“. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – померање за један знак.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Контроле читања одређују шта ради превлачење нагоре и надоле, на пример кретање по речима или знаковима или промену брзине говора. Превлачење удесно и улево и даље прелази између ставки.</string>
    <string name="sandfly_tutorial_reading_controls_move">Пређите на реченицу испод.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – прелазак на следећу реч. Померите се за три речи.</string>
    <string name="sandfly_tutorial_reading_controls_title">Контроле читања</string>
    <string name="sandfly_tutorial_recipe_1">Палачинке: умутите брашно, јаја и млеко у глатко тесто.</string>
    <string name="sandfly_tutorial_recipe_2">Загрејте мало путера у тигању.</string>
    <string name="sandfly_tutorial_recipe_3">Сипајте онолико теста колико је потребно да танко прекрије тигањ.</string>
    <string name="sandfly_tutorial_recipe_4">Окрените палачинку када доња страна постане златна.</string>
    <string name="sandfly_tutorial_recipe_5">Послужите са лимуном и шећером.</string>
    <string name="sandfly_tutorial_scrolling_intro">Листе приказују само део ставки одједном. Превлачење после последње приказане ставке помера листу.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> – померање унапред за једну страницу.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> – кретање кроз листу. Стигните до „<xliff:g id="item" example="Item 15">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_scrolling_title">Померање листа</string>
    <string name="sandfly_tutorial_sentence">Ђаче, уштеду плаћај жаљењем због џиновских цифара.</string>
    <string name="sandfly_tutorial_skip_step">Прескочи корак</string>
    <string name="sandfly_tutorial_sliders_change">Пређите на клизач „<xliff:g id="slider" example="Brightness">%3$s</xliff:g>“. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> или <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> – промена вредности.</string>
    <string name="sandfly_tutorial_sliders_highest">Подесите „<xliff:g id="slider" example="Brightness">%1$s</xliff:g>“ на 100 процената, највећу вредност.</string>
    <string name="sandfly_tutorial_sliders_intro">Када је клизач у фокусу, превлачење нагоре и надоле мења његову вредност.</string>
    <string name="sandfly_tutorial_sliders_title">Клизачи</string>
    <string name="sandfly_tutorial_step">Корак <xliff:g id="number" example="1">%1$d</xliff:g> од <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Папатачи су ситне мушице које живе на плажама, обалама река и у шумама. Најактивнији су у зору и сумрак, када нема ветра. Уједају само женке, јер им је крв потребна за полагање јаја. Уједи сврбе данима, па људи који иду у крајеве папатача носе средство против инсеката. Папатачи слабо лете, па их и лагани поветарац тера.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> – повратак назад.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> – одлазак на почетни екран.</string>
    <string name="sandfly_tutorial_system_intro">Ови покрети раде на сваком екрану. У овој лекцији водич уместо извршавања каже шта сваки од њих ради.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> – отварање обавештења.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> – приказ недавних апликација.</string>
    <string name="sandfly_tutorial_system_title">Назад, почетни екран и обавештења</string>
    <string name="sandfly_tutorial_tile_cloud">Облак</string>
    <string name="sandfly_tutorial_tile_moon">Месец</string>
    <string name="sandfly_tutorial_tile_star">Звезда</string>
    <string name="sandfly_tutorial_tile_sun">Сунце</string>
    <string name="sandfly_tutorial_title">Водич за SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Избришите последње слово тастером за брисање на тастатури.</string>
    <string name="sandfly_tutorial_typing_intro">Активирање поља за текст отвара тастатуру. Додирните тастер да бисте га чули, а подигните прст да бисте га унели.</string>
    <string name="sandfly_tutorial_typing_open">Пређите на поље „<xliff:g id="field" example="Name">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – почетак уноса.</string>
    <string name="sandfly_tutorial_typing_title">Унос текста</string>
    <string name="sandfly_tutorial_typing_type">Унесите реч „<xliff:g id="word" example="cat">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_typing_word">мачка</string>
    <string name="sandfly_tutorial_welcome_intro">Овај водич учи SandFly покрете. Свака лекција даје упутство, чека да га извршите својим покретима, а затим даје следеће. Упутство је прва ставка после назива лекције. „Садржај“ наводи све лекције, а водич се поново отвара на лекцији на којој сте стали.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> било где на екрану – почетак.</string>
    <string name="sandfly_tutorial_welcome_title">Добро дошли</string>
</resources>
