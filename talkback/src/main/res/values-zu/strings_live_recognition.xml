    <string name="live_recognition_camera_on">Ikhamera ivuliwe</string>
    <string name="live_recognition_connecting">Ixhuma ku-Gemini…</string>
    <string name="live_recognition_cloud_title">Thumela izithombe zekhamera ku-Gemini?</string>
    <string name="live_recognition_cloud_message">Izigcawu, Khomba ufunde, Ukutholwa kwabantu kanye Nokutholwa kweminyango kuthumela isithombe sekhamera ku-Gemini API ka-Google njalo emizuzwaneni embalwa. Umbhalo ubonwa kule foni.\n\nNgokhiye we-API wamahhala, u-Google angagcina lokho akutholayo, akusebenzisele ukuthuthukisa imikhiqizo yakhe, futhi akunikeze abantu ukuthi bakubuyekeze. I-AI ekhiqizayo isesesigabeni sokuhlolwa, ngakho-ke izokwenza amaphutha.</string>
    <string name="live_recognition_service_title">Thumela izithombe zekhamera ku-<xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">Izigcawu, Khomba ufunde, Ukutholwa kwabantu kanye Nokutholwa kweminyango kuthumela isithombe sekhamera ku-<xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> njalo emizuzwaneni embalwa. Umbhalo ubonwa kule foni.\n\nKusebenza imigomo nenqubomgomo yobumfihlo yesevisi uqobo. I-AI ekhiqizayo isesesigabeni sokuhlolwa, ngakho-ke izokwenza amaphutha.</string>
