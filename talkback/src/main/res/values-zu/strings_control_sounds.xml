    <string name="title_pref_control_sounds">Lawula imisindo nokudlidliza</string>
    <string name="summary_pref_control_sounds">Nikeza uhlobo ngalunye lokulawula, njengezinkinobho, amabhokisi okuhlola, hlela izinkambu kanye nezinto zohlu, umsindo walo kanye nokudlidliza kwawo kusuka endikimbeni, esikhundleni somsindo ogxilile nokudlidliza, njengoba kwenza Okungakhulunywanga ku-NVDA. Umsindo uvela lapho isilawuli sikhona esikrinini, futhi SandFly ishiya ngaphandle isho ukuthi hlobo luni lokulawula.</string>
    <string name="title_pref_control_sounds_speak_roles">Usasho uhlobo lokulawula</string>
    <string name="summary_pref_control_sounds_speak_roles">Uma kudlala umsindo wokulawula, usasho ukuthi hlobo luni lokulawula, njengenkinobho. Lokhu kungokwayo yonke itimu yomsindo.</string>
