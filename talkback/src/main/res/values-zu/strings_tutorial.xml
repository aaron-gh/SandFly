    <string name="sandfly_tutorial_message_delete">Susa</string>
    <string name="sandfly_tutorial_message_reply">Phendula</string>
    <string name="sandfly_tutorial_move_intro">Ukuswayipha kuya entweni elandelayo noma edlule esikrinini, ngokulandelana kokufunda.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> ukuze uye entweni elandelayo. Qhubeka uze ufike kokuthi <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
