    <string name="sandfly_tutorial_move_title">Ukuhamba phakathi kwezinto</string>
    <string name="sandfly_tutorial_name">Igama</string>
    <string name="sandfly_tutorial_next_lesson">Isifundo esilandelayo: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">Okuthi <xliff:g id="action" example="Next item">%1$s</xliff:g> akunakho ukunyakaza. Nikeza okukodwa kokuthi Imiyalo, noma usebenzise okuthi Yeqa isinyathelo.</string>
    <string name="sandfly_tutorial_not_in_lesson">Okuthi <xliff:g id="action" example="Home">%1$s</xliff:g> akwenziwa esifundweni. Ukuze uphume kokokufundisa, sebenzisa okuthi Vala okokufundisa kokuthi Okuqukethwe.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">Okuthi <xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> akwenziwa esifundweni.</string>
    <string name="sandfly_tutorial_pause_intro">Inkulumo ingamiswa isikhashana phakathi nento, futhi iqhubeke lapho ime khona.</string>
    <string name="sandfly_tutorial_pause_pause">Iya endabeni engezansi. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> ngesikhathi ifundwa ukuze umise inkulumo isikhashana, uphinde futhi ukuze uqhubeke.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> futhi ukuze uqhubeke nenkulumo.</string>
    <string name="sandfly_tutorial_pause_title">Ukumisa inkulumo isikhashana</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Ukunyakaza ngakunye kusho igama lakho nesenzo sakho esikhundleni sokukwenza. Ukuya entweni elandelayo nedlule kanye nokwenza kusebenze kusasebenza.</string>
    <string name="sandfly_tutorial_practice_step">Yenza noma yikuphi ukunyakaza ukuze uzwe ukuthi kwenzani. Ukuze uyeke, yenza kusebenze okuthi <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Ukuzijwayeza ukunyakaza</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> kokungu-<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Shintsha isilawuli sokufunda sibe ngokuthi <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> ukuze uhambe ngohlamvu olulodwa.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Izilawuli zokufunda zikhetha lokho okwenziwa ukuswayipha phezulu naphansi, njengokuhamba ngegama noma ngohlamvu, noma ukushintsha isivinini senkulumo. Ukuswayipha ngakwesokudla nangakwesokunxele kusahamba phakathi kwezinto.</string>
    <string name="sandfly_tutorial_reading_controls_move">Iya emshweni ongezansi.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> ukuze uye egameni elilandelayo. Hamba amagama amathathu.</string>
    <string name="sandfly_tutorial_reading_controls_title">Izilawuli zokufunda</string>
    <string name="sandfly_tutorial_recipe_1">Amaphancake: xuba ufulawa, amaqanda nobisi kube inhlama ebushelelezi.</string>
    <string name="sandfly_tutorial_recipe_2">Shisisa ibhotela elincane epanini lokuthosa.</string>
    <string name="sandfly_tutorial_recipe_3">Thela inhlama eyanele ukumboza ipani kancane.</string>
    <string name="sandfly_tutorial_recipe_4">Phendula iphancake uma ingaphansi selibe nsundu ngokwegolide.</string>
    <string name="sandfly_tutorial_recipe_5">Phakela nelamula noshukela.</string>
    <string name="sandfly_tutorial_scrolling_intro">Uhlu lubonisa ezinye zezinto zalo kuphela ngesikhathi esisodwa. Ukuswayipha udlule entweni yokugcina eboniswayo kuskrola uhlu.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> ukuze uskrolele phambili ngekhasi elilodwa.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> kulo lonke uhlu uze ufike kokuthi <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Ukuskrola uhlu</string>
    <string name="sandfly_tutorial_sentence">Impungushe ensundu esheshayo yeqa phezu kwenja evilaphayo.</string>
    <string name="sandfly_tutorial_skip_step">Yeqa isinyathelo</string>
    <string name="sandfly_tutorial_sliders_change">Iya kusilayida esithi <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> noma <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> ukuze ushintshe inani laso.</string>
    <string name="sandfly_tutorial_sliders_highest">Setha okuthi <xliff:g id="slider" example="Brightness">%1$s</xliff:g> kube amaphesenti ayi-100, inani lakho eliphezulu.</string>
    <string name="sandfly_tutorial_sliders_intro">Uma isilayida sigxilisiwe, ukuswayipha phezulu naphansi kushintsha inani laso.</string>
    <string name="sandfly_tutorial_sliders_title">Izilayida</string>
    <string name="sandfly_tutorial_step">Isinyathelo <xliff:g id="number" example="1">%1$d</xliff:g> kokungu-<xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Izimpukane zesihlabathi ziyizimpukane ezincane ezihlala emabhishi, osebeni lwemifula nasemahlathini. Zisebenza kakhulu ekuseni nakusihlwa, lapho umoya uthule. Yizinsikazi kuphela ezilumayo, ngoba zidinga igazi ukuze zikhiqize amaqanda azo. Ukulunywa kuyaluma izinsuku eziningana, ngakho abantu abavakashela izindawo zezimpukane zesihlabathi baphatha umuthi oxosha izinambuzane. Izimpukane zesihlabathi azindizi kahle, futhi ngisho nomoya omncane uyazigcina kude.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> ukuze ubuyele emuva.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> ukuze uye esikrinini sasekhaya.</string>
    <string name="sandfly_tutorial_system_intro">Lokhu kunyakaza kusebenza kuso sonke isikrini. Kulesi sifundo, okokufundisa kusho ukuthi ukunyakaza ngakunye kwenzani esikhundleni sokukwenza.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> ukuze uvule izaziso.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> ukuze ubonise izinhlelo zokusebenza zakamuva.</string>
