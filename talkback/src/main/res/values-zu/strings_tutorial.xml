    <string name="sandfly_tutorial_explore_find">Shelelisa umunwe owodwa esikrinini bese uthola izikwele ezine: Ilanga, Inyanga, Inkanyezi nefu.</string>
    <string name="sandfly_tutorial_explore_intro">Ukuthinta isikrini kusho into engaphansi komunwe wakho. Ukuthinta into akuyenzi isebenze.</string>
