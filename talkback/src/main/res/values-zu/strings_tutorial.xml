    <string name="sandfly_tutorial_actions_archive">Iya kumlayezo. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> noma <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> ukuze udlule ezenzweni zawo. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> ukuze wenze isenzo osizwayo. Yenza okuthi <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Ezinye izinto zinezenzo ngaphandle kokwenza kusebenze, njengokuthi Faka kungobo yomlando noma Susa kumlayezo. Uma into enjalo igxilisiwe, isilawuli sokufunda esithi Izenzo sidlula kuzo.</string>
    <string name="sandfly_tutorial_actions_title">Izenzo</string>
    <string name="sandfly_tutorial_activate_button">Iya kokuthi <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> ukuze ukwenze kusebenze.</string>
    <string name="sandfly_tutorial_activate_check_box">Maka okuthi <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> ngendlela efanayo.</string>
    <string name="sandfly_tutorial_activate_hold">Ezinye izinto zenza okunye uma zibanjiwe. Iya kokuthi <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> ukuze ukubambe.</string>
    <string name="sandfly_tutorial_activate_intro">Ukwenza kusebenze kusebenza entweni egxilisiwe, noma ngabe uthepha kuphi esikrinini.</string>
    <string name="sandfly_tutorial_activate_title">Ukwenza izinto zisebenze</string>
