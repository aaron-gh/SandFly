    <string name="sandfly_tutorial_actions_archive">Mesaja keçin. Onun əməliyyatları arasında keçmək üçün <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> və ya <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> jestini edin. Eşitdiyiniz əməliyyatı icra etmək üçün <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> jestini edin. <xliff:g id="action" example="Archive">%4$s</xliff:g> əməliyyatını icra edin.</string>
    <string name="sandfly_tutorial_actions_intro">Bəzi elementlərin aktivləşdirmədən başqa əməliyyatları var, məsələn, mesaj üçün Arxivləşdir və ya Sil. Belə element fokusda olduqda “Əməliyyatlar” oxuma kontrolu onlar arasında keçir.</string>
    <string name="sandfly_tutorial_actions_title">Əməliyyatlar</string>
    <string name="sandfly_tutorial_activate_button"><xliff:g id="button" example="Ring the bell">%2$s</xliff:g> elementinə keçin. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> jesti ilə onu aktivləşdirin.</string>
    <string name="sandfly_tutorial_activate_check_box"><xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> elementini eyni qaydada işarələyin.</string>
    <string name="sandfly_tutorial_activate_hold">Bəzi elementlər basılı saxlandıqda başqa iş görür. <xliff:g id="button" example="Details">%2$s</xliff:g> elementinə keçin. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> jesti ilə onu basılı saxlayın.</string>
