    <string name="live_recognition_instructions">እንዲገለጽ የሚፈልጉትን ነገር የኋላ ካሜራውን ያዙሩበት። ለ«ጠቁም እና አንብብ»፣ በካሜራው ምስል ውስጥ ያለ ጽሑፍን በጣት ይጠቁሙ። መግለጫዎች የተሳሳቱ ሊሆኑ ይችላሉ። በደህና ለመንቀሳቀስ በእነሱ አይመኩ።</string>
    <string name="live_recognition_camera_off">ካሜራ ጠፍቷል</string>
    <string name="live_recognition_camera_on">ካሜራ በርቷል</string>
    <string name="live_recognition_connecting">ከGemini ጋር በመገናኘት ላይ…</string>
    <string name="live_recognition_cloud_title">የካሜራ ምስሎች ወደ Gemini ይላኩ?</string>
    <string name="live_recognition_cloud_message">ትዕይንቶች፣ ጠቁም እና አንብብ፣ ሰዎችን ማግኘት እና በሮችን ማግኘት በየጥቂት ሰከንዶቹ ከካሜራው አንድ ምስል ወደ Google Gemini API ይልካሉ። ጽሑፍ በዚህ ስልክ ላይ ይታወቃል።\n\nበነጻ የAPI ቁልፍ፣ Google የሚቀበለውን ሊያስቀምጥ፣ ምርቶቹን ለማሻሻል ሊጠቀምበት እና ሰዎች እንዲገመግሙት ሊያደርግ ይችላል። ሰው ሠራሽ አመንጪ AI የሙከራ ስለሆነ ስህተቶችን ይሠራል።</string>
    <string name="live_recognition_send">ምስሎችን ላክ</string>
    <string name="live_recognition_camera_permission">የካሜራ ፈቃድ የለም</string>
    <string name="live_recognition_camera_error">ካሜራውን መክፈት አልተቻለም</string>
