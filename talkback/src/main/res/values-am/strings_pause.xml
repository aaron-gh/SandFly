    <string name="dialog_title_pause_backtalk">SandFly ለአፍታ ይቁም?</string>
    <string name="dialog_button_pause_backtalk">ለአፍታ አቁም</string>
    <string name="dialog_message_pause_backtalk">SandFly ለአፍታ በቆመበት ጊዜ አይናገርም፣ ለእጅ ምልክቶች ምላሽ አይሰጥም፣ እና ማያ ገፁ ምንም የማያ ገፅ አንባቢ እንዳልበራ ሆኖ ይሠራል።</string>
    <string name="message_resume_keyguard">ለመቀጠል «SandFly ለአፍታ ቆሟል» የሚለውን ማሳወቂያ መታ ያድርጉ፣ ድምፅ ቀንስ ቁልፍን በፍጥነት 3 ጊዜ ይጫኑ፣ ወይም የማያ ገፅ መቆለፊያው እንዲታይ ስልኩን ቆልፈው ያንቁ።</string>
    <string name="message_resume_screen_on">ለመቀጠል «SandFly ለአፍታ ቆሟል» የሚለውን ማሳወቂያ መታ ያድርጉ፣ ድምፅ ቀንስ ቁልፍን በፍጥነት 3 ጊዜ ይጫኑ፣ ወይም ማያ ገፁን አጥፍተው እንደገና ያብሩ።</string>
    <string name="message_resume_manual">ለመቀጠል «SandFly ለአፍታ ቆሟል» የሚለውን ማሳወቂያ መታ ያድርጉ ወይም ድምፅ ቀንስ ቁልፍን በፍጥነት 3 ጊዜ ይጫኑ።</string>
    <string name="message_resume_key_combo">እንዲሁም <xliff:g id="key_combo" example="Alt + P">%1$s</xliff:g> መጫን ይችላሉ።</string>
