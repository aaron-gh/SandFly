<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">የመቆጣጠሪያ ድምፆች እና ንዝረቶች</string>
    <string name="summary_pref_control_sounds">Unspoken ለNVDA እንደሚያደርገው፣ እንደ አዝራሮች፣ አመልካች ሳጥኖች፣ የአርትዖት መስኮች እና የዝርዝር ንጥሎች ላሉ እያንዳንዱ ዓይነት መቆጣጠሪያ ከትኩረት ድምፅ እና ንዝረት ይልቅ የራሱን ድምፅ እና ከገጽታው የራሱን ንዝረት ይስጡ። ድምፁ መቆጣጠሪያው በማያ ገፁ ላይ ካለበት ቦታ ይመጣል፣ እና SandFly የመቆጣጠሪያውን ዓይነት አይናገርም።</string>
    <string name="title_pref_control_sounds_speak_roles">የመቆጣጠሪያውን ዓይነት አሁንም ተናገር</string>
    <string name="summary_pref_control_sounds_speak_roles">የመቆጣጠሪያ ድምፅ ሲጫወት፣ እንደ አዝራር ያለ የመቆጣጠሪያውን ዓይነት አሁንም ተናገር። ይህ ለሁሉም የድምፅ ገጽታዎች ነው።</string>
