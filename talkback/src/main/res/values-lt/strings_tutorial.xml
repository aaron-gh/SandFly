    <string name="sandfly_tutorial_tile_moon">Mėnulis</string>
    <string name="sandfly_tutorial_tile_star">Žvaigždė</string>
    <string name="sandfly_tutorial_tile_sun">Saulė</string>
    <string name="sandfly_tutorial_title">SandFly mokymo programa</string>
    <string name="sandfly_tutorial_typing_delete">Ištrinkite paskutinę raidę klaviatūros klavišu „Ištrinti“.</string>
    <string name="sandfly_tutorial_typing_intro">Suaktyvinus teksto lauką, atidaroma klaviatūra. Palieskite klavišą, kad jį išgirstumėte, ir pakelkite pirštą, kad jį įvestumėte.</string>
    <string name="sandfly_tutorial_typing_open">Pereikite prie lauko „<xliff:g id="field" example="Name">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: pradėkite rašyti.</string>
    <string name="sandfly_tutorial_typing_title">Teksto įvedimas</string>
    <string name="sandfly_tutorial_typing_type">Įveskite žodį „<xliff:g id="word" example="cat">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_typing_word">katė</string>
    <string name="sandfly_tutorial_welcome_intro">Ši mokymo programa moko SandFly gestų. Kiekviena pamoka pateikia nurodymą, laukia, kol jį atliksite savo gestais, tada pateikia kitą. Nurodymas yra pirmas elementas po pamokos pavadinimo. „Turinys“ pateikia visas pamokas, o mokymo programa vėl atidaroma toje pamokoje, kurioje buvote.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> bet kurioje ekrano vietoje: pradėkite.</string>
    <string name="sandfly_tutorial_welcome_title">Sveiki</string>
</resources>
