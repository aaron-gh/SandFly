    <string name="sandfly_tutorial_list_item">Elementas <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>: uždarykite meniu.</string>
    <string name="sandfly_tutorial_menu_intro">SandFly meniu yra komandų sufokusuotam elementui ir dabartiniam ekranui.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>: atidarykite SandFly meniu. Perbraukite per jo komandas. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> uždaro meniu.</string>
    <string name="sandfly_tutorial_menu_title">„SandFly“ meniu</string>
    <string name="sandfly_tutorial_message">Samo žinutė: pietūs vidurdienį?</string>
    <string name="sandfly_tutorial_message_archive">Archyvuoti</string>
    <string name="sandfly_tutorial_message_delete">Ištrinti</string>
    <string name="sandfly_tutorial_message_reply">Atsakyti</string>
    <string name="sandfly_tutorial_move_intro">Perbraukus pereinama prie kito ar ankstesnio ekrano elemento skaitymo tvarka.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: pereikite prie kito elemento. Tęskite, kol pasieksite „<xliff:g id="item" example="Eggs">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>: pereikite prie ankstesnio elemento. Grįžkite prie „<xliff:g id="item" example="Bread">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_title">Judėjimas tarp elementų</string>
    <string name="sandfly_tutorial_name">Vardas</string>
    <string name="sandfly_tutorial_next_lesson">Kita pamoka: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">Veiksmui „<xliff:g id="action" example="Next item">%1$s</xliff:g>“ nepriskirtas gestas. Priskirkite jį skiltyje „Komandos“ arba naudokite „Praleisti veiksmą“.</string>
    <string name="sandfly_tutorial_not_in_lesson">Veiksmas „<xliff:g id="action" example="Home">%1$s</xliff:g>“ pamokoje neatliekamas. Norėdami išeiti iš mokymo programos, skiltyje „Turinys“ naudokite „Uždaryti mokymo programą“.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">Veiksmas „<xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g>“ pamokoje neatliekamas.</string>
    <string name="sandfly_tutorial_pause_intro">Kalbą galima pristabdyti elemento viduryje ir tęsti nuo tos vietos, kur ji sustojo.</string>
    <string name="sandfly_tutorial_pause_pause">Pereikite prie toliau esančios istorijos. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>, kol ji skaitoma: pristabdykite kalbą, dar kartą – tęskite.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> dar kartą: tęskite kalbą.</string>
    <string name="sandfly_tutorial_pause_title">Kalbos pristabdymas</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Kiekvienas gestas, užuot atlikęs veiksmą, pasako savo pavadinimą ir veiksmą. Perėjimas prie kito ir ankstesnio elemento bei suaktyvinimas vis tiek veikia.</string>
    <string name="sandfly_tutorial_practice_step">Atlikite bet kurį gestą, kad išgirstumėte, ką jis daro. Norėdami baigti, suaktyvinkite „<xliff:g id="button" example="End practice">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_practice_title">Gestų praktika</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> iš <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Pakeiskite skaitymo valdiklį į „<xliff:g id="reading_control" example="Characters">%2$s</xliff:g>“. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: pereikite per vieną simbolį.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Skaitymo valdikliai nustato, ką daro perbraukimas aukštyn ir žemyn, pvz., judėjimą po žodį ar simbolį arba kalbėjimo spartos keitimą. Perbraukimas dešinėn ir kairėn vis tiek pereina tarp elementų.</string>
    <string name="sandfly_tutorial_reading_controls_move">Pereikite prie toliau esančio sakinio.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: pereikite prie kito žodžio. Pereikite tris žodžius.</string>
    <string name="sandfly_tutorial_reading_controls_title">Skaitymo valdikliai</string>
    <string name="sandfly_tutorial_recipe_1">Blynai: išmaišykite miltus, kiaušinius ir pieną į vientisą tešlą.</string>
    <string name="sandfly_tutorial_recipe_2">Keptuvėje įkaitinkite šiek tiek sviesto.</string>
    <string name="sandfly_tutorial_recipe_3">Įpilkite tiek tešlos, kad plonai padengtų keptuvę.</string>
    <string name="sandfly_tutorial_recipe_4">Apverskite blyną, kai apačia taps auksinė.</string>
    <string name="sandfly_tutorial_recipe_5">Patiekite su citrina ir cukrumi.</string>
    <string name="sandfly_tutorial_scrolling_intro">Sąrašai vienu metu rodo tik dalį savo elementų. Perbraukus už paskutinio rodomo elemento, sąrašas slenkamas.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>: slinkite vienu puslapiu pirmyn.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: eikite per sąrašą, kol pasieksite „<xliff:g id="item" example="Item 15">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_scrolling_title">Sąrašų slinkimas</string>
    <string name="sandfly_tutorial_sentence">Greita ruda lapė peršoka tingų šunį.</string>
    <string name="sandfly_tutorial_skip_step">Praleisti veiksmą</string>
    <string name="sandfly_tutorial_sliders_change">Pereikite prie slankiklio „<xliff:g id="slider" example="Brightness">%3$s</xliff:g>“. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> arba <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: pakeiskite jo reikšmę.</string>
    <string name="sandfly_tutorial_sliders_highest">Nustatykite „<xliff:g id="slider" example="Brightness">%1$s</xliff:g>“ į 100 procentų – didžiausią reikšmę.</string>
    <string name="sandfly_tutorial_sliders_intro">Kai slankiklis sufokusuotas, perbraukimas aukštyn ir žemyn keičia jo reikšmę.</string>
    <string name="sandfly_tutorial_sliders_title">Slankikliai</string>
    <string name="sandfly_tutorial_step">Veiksmas <xliff:g id="number" example="1">%1$d</xliff:g> iš <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Smėlio musės – tai mažos musės, gyvenančios paplūdimiuose, upių krantuose ir miškuose. Aktyviausios jos būna auštant ir sutemus, kai oras ramus. Kanda tik patelės, nes joms reikia kraujo kiaušiniams išauginti. Įkandimai niežti kelias dienas, todėl žmonės, lankantys smėlio musių kraštą, nešiojasi repelentą nuo vabzdžių. Smėlio musės silpnai skraido, ir net lengvas vėjelis jas nubaido.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>: grįžkite atgal.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>: eikite į pagrindinį ekraną.</string>
    <string name="sandfly_tutorial_system_intro">Šie gestai veikia bet kuriame ekrane. Šioje pamokoje mokymo programa, užuot atlikusi veiksmą, pasako, ką kiekvienas gestas daro.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>: atidarykite pranešimus.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>: parodykite naujausias programas.</string>
    <string name="sandfly_tutorial_system_title">Atgal, pagrindinis ekranas ir pranešimai</string>
