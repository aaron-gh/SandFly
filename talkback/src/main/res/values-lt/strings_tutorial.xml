<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Pereikite prie pranešimo. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> arba <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: peržiūrėkite jo veiksmus. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>: atlikite išgirstą veiksmą. Atlikite veiksmą „<xliff:g id="action" example="Archive">%4$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_actions_intro">Kai kurie elementai, be suaktyvinimo, turi ir kitų veiksmų, pvz., pranešimo „Archyvuoti“ ar „Ištrinti“. Kol toks elementas sufokusuotas, skaitymo valdiklis „Veiksmai“ pereina per juos.</string>
    <string name="sandfly_tutorial_actions_title">Veiksmai</string>
    <string name="sandfly_tutorial_activate_button">Pereikite prie „<xliff:g id="button" example="Ring the bell">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: suaktyvinkite.</string>
    <string name="sandfly_tutorial_activate_check_box">Tokiu pat būdu pažymėkite „<xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_activate_hold">Kai kurie elementai, juos palaikius, atlieka kitą veiksmą. Pereikite prie „<xliff:g id="button" example="Details">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>: palaikykite.</string>
    <string name="sandfly_tutorial_activate_intro">Suaktyvinimas veikia sufokusuotą elementą, kad ir kur paliestumėte ekraną.</string>
    <string name="sandfly_tutorial_activate_title">Elementų suaktyvinimas</string>
    <string name="sandfly_tutorial_back_in_lesson">„Atgal“ neišeina iš pamokos. Norėdami pasirinkti kitą pamoką, naudokite „Turinys“.</string>
    <string name="sandfly_tutorial_bell">Skambinti varpeliu</string>
    <string name="sandfly_tutorial_bell_rung">Kartų paskambinta: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Ryškumas</string>
    <string name="sandfly_tutorial_chapter_basics">Pagrindai</string>
    <string name="sandfly_tutorial_chapter_controls">Valdikliai ir tekstas</string>
