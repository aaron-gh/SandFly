    <string name="sandfly_tutorial_forecast_today_text">Saulėta ir šilta, silpnas vėjas.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Rytoj</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Ryte debesuota, nuo vidurdienio lietus.</string>
    <string name="sandfly_tutorial_forecast_weekend">Savaitgalis</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Šeštadienį vėjuota, sekmadienį giedra.</string>
    <string name="sandfly_tutorial_headings_intro">Ekranai ir tinklalapiai skirsto turinį antraštėmis. Skaitymo valdiklis „Antraštės“ peršoka nuo vienos antraštės prie kitos.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: peršokite prie kitos antraštės. Peršokite prie „<xliff:g id="heading" example="Weekend">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_headings_title">Antraštės</string>
