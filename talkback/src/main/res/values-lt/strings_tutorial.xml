    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> arba <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>: pakeiskite skaitymo valdiklį. Pasirinkite „<xliff:g id="reading_control" example="Words">%3$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_close">Uždaryti mokymo programą</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>: nukopijuokite į iškarpinę paskutinį SandFly ištartą tekstą.</string>
    <string name="sandfly_tutorial_commands_intro">Šios komandos veikia bet kuriame ekrane.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>: ieškokite teksto ekrane. Šioje pamokoje mokymo programa vietoj to pasako, ką komanda daro.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>: išjunkite kalbą, dar kartą – įjunkite. Šioje pamokoje mokymo programa vietoj to pasako, ką komanda daro.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>: išgirskite laiką, akumuliatoriaus įkrovą ir kitą būseną.</string>
    <string name="sandfly_tutorial_commands_title">Naudingos komandos</string>
    <string name="sandfly_tutorial_contents">Turinys</string>
    <string name="sandfly_tutorial_contents_intro">Pamokos eilės tvarka. Kiekvieną galima atidaryti atskirai.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly gali skaityti nuo sufokusuoto elemento iki ekrano pabaigos be perbraukimų. Palietus ekraną, skaitymas sustabdomas.</string>
    <string name="sandfly_tutorial_continuous_move">Pereikite prie pirmos recepto eilutės.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g>: skaitykite nuo sufokusuoto elemento.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>: atidarykite SandFly meniu, tada pasirinkite „<xliff:g id="command" example="Read from focused item">%2$s</xliff:g>“.</string>
