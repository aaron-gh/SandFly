    <string name="title_pref_control_sounds">Valdiklių garsai ir vibracija</string>
    <string name="summary_pref_control_sounds">Suteikite kiekvienai valdymo rūšiai, pvz., mygtukus, žymimuosius laukelius, redagavimo laukus ir sąrašo elementus, savo garsą ir vibraciją iš temos, o ne fokusavimo garsą ir vibraciją, kaip tai daro Unspoken NVDA. Garsas sklinda iš ten, kur yra valdiklis ekrane, o SandFly nenurodoma, koks tai valdiklis.</string>
    <string name="title_pref_control_sounds_speak_roles">Vis tiek sakyti valdiklio tipą</string>
    <string name="summary_pref_control_sounds_speak_roles">Kai groja valdymo garsas, vis tiek pasakykite, koks tai valdiklis, pvz., mygtukas. Tai tinka kiekvienai garso temai.</string>
