<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">Կառավարման տարրերի ձայներ և թրթռոցներ</string>
    <string name="summary_pref_control_sounds">Կառավարման տարրերի յուրաքանչյուր տեսակին (կոճակներ, նշավանդակներ, խմբագրման դաշտեր, ցանկի կետեր և այլն) տալ թեմայից իր սեփական ձայնն ու թրթռոցը՝ ընտրման ձայնի և թրթռոցի փոխարեն, ինչպես Unspoken-ն է անում NVDA-ի համար։ Ձայնը հնչում է էկրանի այն կետից, որտեղ գտնվում է տարրը, և SandFly-ը չի հնչեցնում տարրի տեսակը։</string>
    <string name="title_pref_control_sounds_speak_roles">Միևնույն է հնչեցնել տարրի տեսակը</string>
    <string name="summary_pref_control_sounds_speak_roles">Երբ կառավարման տարրի ձայնը հնչում է, միևնույն է հնչեցնել տարրի տեսակը, օրինակ՝ կոճակ։ Սա վերաբերում է բոլոր ձայնային թեմաներին։</string>
