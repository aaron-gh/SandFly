<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Pārejiet uz ziņojumu. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> vai <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: pārskatiet tā darbības. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>: izpildiet dzirdēto darbību. Izpildiet darbību <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Dažiem vienumiem bez aktivizēšanas ir arī citas darbības, piemēram, ziņojumam Arhivēt vai Dzēst. Kamēr šādam vienumam ir fokuss, lasīšanas vadīkla Darbības pārvietojas starp tām.</string>
    <string name="sandfly_tutorial_actions_title">Darbības</string>
    <string name="sandfly_tutorial_activate_button">Pārejiet uz vienumu <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: aktivizējiet to.</string>
    <string name="sandfly_tutorial_activate_check_box">Tādā pašā veidā atzīmējiet <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_hold">Daži vienumi, ja tos tur, veic citu darbību. Pārejiet uz vienumu <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>: turiet to.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivizēšana darbojas vienumam ar fokusu neatkarīgi no tā, kur pieskaraties ekrānam.</string>
    <string name="sandfly_tutorial_activate_title">Vienumu aktivizēšana</string>
    <string name="sandfly_tutorial_back_in_lesson">Atpakaļ neiziet no nodarbības. Lai izvēlētos citu nodarbību, izmantojiet Saturs.</string>
    <string name="sandfly_tutorial_bell">Zvanīt zvaniņu</string>
    <string name="sandfly_tutorial_bell_rung">Zvanīts reizes: <xliff:g id="count" example="1">%1$d</xliff:g></string>
