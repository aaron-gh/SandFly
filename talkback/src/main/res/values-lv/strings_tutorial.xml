    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> vai <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>: mainiet lasīšanas vadīklu. Izvēlieties <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Aizvērt mācības</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>: kopējiet starpliktuvē tekstu, ko SandFly izrunāja pēdējo.</string>
    <string name="sandfly_tutorial_commands_intro">Šīs komandas darbojas jebkurā ekrānā.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>: meklējiet tekstu ekrānā. Šajā nodarbībā mācības tā vietā pasaka, ko komanda dara.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>: izslēdziet runu, atkārtoti — ieslēdziet. Šajā nodarbībā mācības tā vietā pasaka, ko komanda dara.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>: noklausieties laiku, akumulatora uzlādes līmeni un citu statusu.</string>
