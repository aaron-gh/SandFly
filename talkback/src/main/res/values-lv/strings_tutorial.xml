    <string name="sandfly_tutorial_menu_intro">SandFly izvēlnē ir komandas vienumam ar fokusu un pašreizējam ekrānam.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>: atveriet SandFly izvēlni. Velciet cauri tās komandām. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> aizver izvēlni.</string>
    <string name="sandfly_tutorial_menu_title">SandFly izvēlne</string>
    <string name="sandfly_tutorial_message">Ziņojums no Sema: pusdienas pusdienlaikā?</string>
    <string name="sandfly_tutorial_message_archive">Arhivēt</string>
    <string name="sandfly_tutorial_message_delete">Dzēst</string>
    <string name="sandfly_tutorial_message_reply">Atbildēt</string>
    <string name="sandfly_tutorial_move_intro">Vilkšana pāriet uz nākamo vai iepriekšējo vienumu ekrānā lasīšanas secībā.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: pārejiet uz nākamo vienumu. Turpiniet, līdz sasniedzat vienumu <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>: pārejiet uz iepriekšējo vienumu. Atgriezieties pie vienuma <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Pārvietošanās starp vienumiem</string>
    <string name="sandfly_tutorial_name">Vārds</string>
    <string name="sandfly_tutorial_next_lesson">Nākamā nodarbība: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">Darbībai <xliff:g id="action" example="Next item">%1$s</xliff:g> nav žesta. Piešķiriet to sadaļā Komandas vai izmantojiet Izlaist darbību.</string>
    <string name="sandfly_tutorial_not_in_lesson">Darbība <xliff:g id="action" example="Home">%1$s</xliff:g> nodarbībā netiek izpildīta. Lai izietu no mācībām, sadaļā Saturs izmantojiet Aizvērt mācības.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">Darbība <xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> nodarbībā netiek izpildīta.</string>
    <string name="sandfly_tutorial_pause_intro">Runu var pauzēt vienuma vidū un atsākt no vietas, kur tā apstājās.</string>
    <string name="sandfly_tutorial_pause_pause">Pārejiet uz tālāk esošo stāstu. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> tā lasīšanas laikā: pauzējiet runu, atkārtoti — atsāciet.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> vēlreiz: atsāciet runu.</string>
    <string name="sandfly_tutorial_pause_title">Runas pauzēšana</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Katrs žests darbības izpildes vietā pasaka savu nosaukumu un darbību. Pāriešana uz nākamo un iepriekšējo vienumu un aktivizēšana joprojām darbojas.</string>
    <string name="sandfly_tutorial_practice_step">Veiciet jebkuru žestu, lai uzzinātu, ko tas dara. Lai beigtu, aktivizējiet <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Žestu prakse</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> no <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Mainiet lasīšanas vadīklu uz <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: pārvietojieties par vienu rakstzīmi.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Lasīšanas vadīklas nosaka, ko dara vilkšana uz augšu un uz leju, piemēram, pārvietošanos pa vārdiem vai rakstzīmēm vai runas ātruma maiņu. Vilkšana pa labi un pa kreisi joprojām pārvietojas starp vienumiem.</string>
    <string name="sandfly_tutorial_reading_controls_move">Pārejiet uz tālāk esošo teikumu.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: pārejiet uz nākamo vārdu. Pārvietojieties par trim vārdiem.</string>
    <string name="sandfly_tutorial_reading_controls_title">Lasīšanas vadīklas</string>
    <string name="sandfly_tutorial_recipe_1">Pankūkas: samaisiet miltus, olas un pienu viendabīgā mīklā.</string>
    <string name="sandfly_tutorial_recipe_2">Pannā uzkarsējiet nedaudz sviesta.</string>
    <string name="sandfly_tutorial_recipe_3">Ielejiet tik daudz mīklas, lai tā plānā kārtā pārklātu pannu.</string>
    <string name="sandfly_tutorial_recipe_4">Apgrieziet pankūku, kad apakšpuse ir zeltaina.</string>
    <string name="sandfly_tutorial_recipe_5">Pasniedziet ar citronu un cukuru.</string>
    <string name="sandfly_tutorial_scrolling_intro">Saraksti vienlaikus rāda tikai daļu savu vienumu. Vilkšana aiz pēdējā redzamā vienuma ritina sarakstu.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>: ritiniet uz priekšu par vienu lapu.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: pārvietojieties pa sarakstu, līdz sasniedzat vienumu <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Sarakstu ritināšana</string>
    <string name="sandfly_tutorial_sentence">Ātrā brūnā lapsa pārlec pāri slinkajam sunim.</string>
    <string name="sandfly_tutorial_skip_step">Izlaist darbību</string>
    <string name="sandfly_tutorial_sliders_change">Pārejiet uz slīdni <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> vai <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: mainiet tā vērtību.</string>
    <string name="sandfly_tutorial_sliders_highest">Iestatiet <xliff:g id="slider" example="Brightness">%1$s</xliff:g> uz 100 procentiem, tā augstāko vērtību.</string>
    <string name="sandfly_tutorial_sliders_intro">Kad slīdnim ir fokuss, vilkšana uz augšu un uz leju maina tā vērtību.</string>
    <string name="sandfly_tutorial_sliders_title">Slīdņi</string>
    <string name="sandfly_tutorial_step"><xliff:g id="number" example="1">%1$d</xliff:g>. darbība no <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Smilšu mušas ir mazas mušas, kas dzīvo pludmalēs, upju krastos un mežos. Visaktīvākās tās ir rītausmā un krēslā, kad gaiss ir rāms. Kož tikai mātītes, jo tām vajag asinis, lai radītu olas. Kodumi niez vairākas dienas, tāpēc cilvēki, kas apmeklē smilšu mušu apvidus, ņem līdzi kukaiņu atbaidītāju. Smilšu mušas ir vājas lidotājas, un pat viegla vēsma tās aizbaida.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>: atgriezieties atpakaļ.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>: atveriet sākuma ekrānu.</string>
    <string name="sandfly_tutorial_system_intro">Šie žesti darbojas jebkurā ekrānā. Šajā nodarbībā mācības tā vietā pasaka, ko katrs žests dara.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>: atveriet paziņojumus.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>: parādiet nesen izmantotās lietotnes.</string>
    <string name="sandfly_tutorial_system_title">Atpakaļ, sākuma ekrāns un paziņojumi</string>
    <string name="sandfly_tutorial_tile_cloud">Mākonis</string>
    <string name="sandfly_tutorial_tile_moon">Mēness</string>
    <string name="sandfly_tutorial_tile_star">Zvaigzne</string>
    <string name="sandfly_tutorial_tile_sun">Saule</string>
    <string name="sandfly_tutorial_title">SandFly mācības</string>
    <string name="sandfly_tutorial_typing_delete">Izdzēsiet pēdējo burtu ar tastatūras taustiņu Dzēst.</string>
    <string name="sandfly_tutorial_typing_intro">Aktivizējot teksta lauku, tiek atvērta tastatūra. Pieskarieties taustiņam, lai to dzirdētu, un paceliet pirkstu, lai to ierakstītu.</string>
    <string name="sandfly_tutorial_typing_open">Pārejiet uz lauku <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: sāciet rakstīt.</string>
    <string name="sandfly_tutorial_typing_title">Rakstīšana</string>
    <string name="sandfly_tutorial_typing_type">Ierakstiet vārdu <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">kaķis</string>
    <string name="sandfly_tutorial_welcome_intro">Šīs mācības iemāca SandFly žestus. Katra nodarbība dod norādījumu, gaida, līdz jūs to izpildāt ar saviem žestiem, un tad dod nākamo. Norādījums ir pirmais vienums pēc nodarbības nosaukuma. Saturs uzskaita visas nodarbības, un mācības atkal atveras nodarbībā, kurā bijāt.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> jebkurā ekrāna vietā: sāciet.</string>
    <string name="sandfly_tutorial_welcome_title">Laipni lūdzam!</string>
