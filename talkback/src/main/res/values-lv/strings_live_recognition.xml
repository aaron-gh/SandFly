    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">Pavērsiet aizmugures kameru pret to, ko vēlaties aprakstīt. Režīmā Norādīt un lasīt ar pirkstu norādiet uz tekstu kameras attēlā. Apraksti var būt nepareizi. Nepaļaujieties uz tiem, lai droši pārvietotos.</string>
    <string name="live_recognition_camera_off">Kamera izslēgta</string>
    <string name="live_recognition_camera_on">Kamera ieslēgta</string>
    <string name="live_recognition_connecting">Notiek savienojuma izveide ar Gemini…</string>
    <string name="live_recognition_cloud_title">Vai sūtīt kameras attēlus uz Gemini?</string>
    <string name="live_recognition_cloud_message">Ainas, Norādīt un lasīt, Cilvēku noteikšana un Durvju noteikšana ik pēc dažām sekundēm nosūta attēlu no kameras uz Google Gemini API. Teksts tiek atpazīts šajā tālrunī.\n\nIzmantojot bezmaksas API atslēgu, Google var saglabāt saņemto, izmantot to savu produktu uzlabošanai un ļaut cilvēkiem to pārskatīt. Ģeneratīvais AI ir eksperimentāls, tāpēc tas pieļaus kļūdas.</string>
    <string name="live_recognition_service_title">Vai sūtīt kameras attēlus uz <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">Ainas, Norādīt un lasīt, Cilvēku noteikšana un Durvju noteikšana ik pēc dažām sekundēm nosūta attēlu no kameras uz <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>. Teksts tiek atpazīts šajā tālrunī.\n\nAttiecas pakalpojuma noteikumi un konfidencialitātes politika. Ģeneratīvais AI ir eksperimentāls, tāpēc tas pieļaus kļūdas.</string>
