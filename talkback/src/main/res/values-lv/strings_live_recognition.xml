    <string name="live_recognition_title">Tiešraides atpazīšana</string>
    <string name="live_recognition_hint">Velciet augšup vai lejup, lai izvēlētos režīmu, pēc tam veiciet dubultskārienu, lai to ieslēgtu vai izslēgtu</string>
