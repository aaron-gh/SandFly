    <string name="live_recognition_title">Live-Erkennung</string>
    <string name="live_recognition_hint">Wische nach oben oder unten, um einen Modus zu wählen, und tippe dann doppelt, um ihn ein- oder auszuschalten</string>
    <string name="live_recognition_scenes">Szenen</string>
