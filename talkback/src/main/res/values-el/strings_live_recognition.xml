    <string name="live_recognition_title">Ζωντανή αναγνώριση</string>
    <string name="live_recognition_hint">Σύρετε προς τα πάνω ή προς τα κάτω για να επιλέξετε λειτουργία και, στη συνέχεια, πατήστε δύο φορές για να την ενεργοποιήσετε ή να την απενεργοποιήσετε</string>
    <string name="live_recognition_scenes">Σκηνές</string>
    <string name="live_recognition_text">Κείμενο</string>
    <string name="live_recognition_point">Δείξε και διάβασε</string>
    <string name="live_recognition_people">Ανίχνευση ατόμων</string>
