    <string name="sandfly_tutorial_reading_controls_characters">Ndrysho kontrollin e leximit në <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> për të lëvizur me një karakter.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Kontrollet e leximit zgjedhin çfarë bën rrëshqitja lart dhe poshtë, si lëvizja sipas fjalës ose sipas karakterit, ose ndryshimi i shpejtësisë së të folurit. Rrëshqitja djathtas dhe majtas vazhdon të kalojë mes artikujve.</string>
    <string name="sandfly_tutorial_reading_controls_move">Shko te fjalia më poshtë.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> për të kaluar te fjala tjetër. Lëviz tri fjalë.</string>
