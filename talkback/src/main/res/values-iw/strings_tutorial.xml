    <string name="sandfly_tutorial_practice_intro">כל תנועה אומרת את השם ואת הפעולה שלה במקום לבצע אותה. מעבר לפריט הבא ולפריט הקודם והפעלה עדיין פועלים.</string>
    <string name="sandfly_tutorial_practice_step">מבצעים תנועה כלשהי כדי לשמוע מה היא עושה. כדי לעצור, מפעילים את \"<xliff:g id="button" example="End practice">%1$s</xliff:g>\".</string>
