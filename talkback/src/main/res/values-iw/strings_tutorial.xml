    <string name="sandfly_tutorial_reading_controls_intro">כפתורי ההקראה קובעים מה עושה החלקה למעלה ולמטה, כמו מעבר לפי מילה או לפי תו, או שינוי קצב הדיבור. החלקה ימינה ושמאלה עדיין עוברת בין פריטים.</string>
    <string name="sandfly_tutorial_reading_controls_move">עוברים למשפט שלמטה.</string>
    <string name="sandfly_tutorial_reading_controls_next_word">מבצעים <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> כדי לעבור למילה הבאה. מתקדמים שלוש מילים.</string>
