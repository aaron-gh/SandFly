    <string name="message_resume_screen_on">כדי להמשיך, יש להקיש על ההתראה ״SandFly מושהה״, ללחוץ 3 פעמים במהירות על מקש החלשת עוצמת הקול או לכבות את המסך ולהדליק אותו שוב.</string>
    <string name="message_resume_manual">כדי להמשיך, יש להקיש על ההתראה ״SandFly מושהה״ או ללחוץ 3 פעמים במהירות על מקש החלשת עוצמת הקול.</string>
