    <string name="live_recognition_title">זיהוי בזמן אמת</string>
    <string name="live_recognition_hint">צריך להחליק למעלה או למטה כדי לבחור מצב, ואז להקיש פעמיים כדי להפעיל או להשבית אותו</string>
