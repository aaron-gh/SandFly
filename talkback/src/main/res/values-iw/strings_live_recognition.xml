    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">יש לכוון את המצלמה האחורית אל מה שרוצים לתאר. במצב \"הצבעה והקראה\" יש להצביע באצבע על טקסט בתמונת המצלמה. התיאורים עלולים להיות שגויים. אין להסתמך עליהם כדי לנוע בבטחה.</string>
    <string name="live_recognition_camera_off">המצלמה כבויה</string>
    <string name="live_recognition_camera_on">המצלמה פועלת</string>
    <string name="live_recognition_connecting">מתבצע חיבור ל-Gemini…</string>
    <string name="live_recognition_cloud_title">לשלוח תמונות מהמצלמה ל-Gemini?</string>
    <string name="live_recognition_cloud_message">המצבים \"סצנות\", \"הצבעה והקראה\", \"זיהוי אנשים\" ו\"זיהוי דלתות\" שולחים תמונה מהמצלמה ל-Gemini API של Google כל כמה שניות. הטקסט מזוהה בטלפון הזה.\n\nעם מפתח API בחינם, Google עשויה לשמור את מה שהיא מקבלת, להשתמש בו כדי לשפר את המוצרים שלה ולתת לאנשים לבדוק אותו. בינה מלאכותית גנרטיבית היא ניסיונית, ולכן היא תטעה.</string>
    <string name="live_recognition_service_title">לשלוח תמונות מהמצלמה אל <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">המצבים \"סצנות\", \"הצבעה והקראה\", \"זיהוי אנשים\" ו\"זיהוי דלתות\" שולחים תמונה מהמצלמה אל <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> כל כמה שניות. הטקסט מזוהה בטלפון הזה.\n\nחלים התנאים ומדיניות הפרטיות של השירות. בינה מלאכותית גנרטיבית היא ניסיונית, ולכן היא תטעה.</string>
