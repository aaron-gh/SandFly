    <string name="pref_on_device_ai_download">मॉडेल डाउनलोड करा (%1$s)</string>
    <string name="pref_on_device_ai_download_summary">हगिंग फेस वरून एकदा डाउनलोड करा. त्यानंतर, नेटवर्कवर काहीही पाठवले जात नाही.</string>
    <string name="pref_on_device_ai_downloading">डाउनलोड करत आहे, %1$d%%</string>
    <string name="pref_on_device_ai_downloading_summary">%1$s. थांबण्यासाठी टॅप करा. तुम्ही ते पुन्हा सुरू केल्यास ते येथून पुढे चालू राहील.</string>
    <string name="on_device_ai_progress_sizes">%2$s पैकी %1$s</string>
