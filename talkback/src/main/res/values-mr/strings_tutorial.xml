<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">मेसेजवर जा. त्याच्या कृतींमधून जाण्यासाठी <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> किंवा <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>. ऐकलेली कृती करण्यासाठी <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>. “<xliff:g id="action" example="Archive">%4$s</xliff:g>” ही कृती करा.</string>
    <string name="sandfly_tutorial_actions_intro">काही आयटमवर सक्रिय करण्याव्यतिरिक्त इतर कृती असतात, जसे की मेसेजसाठी संग्रहित करा किंवा हटवा. अशा आयटमवर फोकस असताना “कृती” वाचन नियंत्रण त्या कृतींमधून जाते.</string>
    <string name="sandfly_tutorial_actions_title">कृती</string>
    <string name="sandfly_tutorial_activate_button"><xliff:g id="button" example="Ring the bell">%2$s</xliff:g> वर जा. ते सक्रिय करण्यासाठी <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_check_box"><xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> त्याच प्रकारे चेक करा.</string>
    <string name="sandfly_tutorial_activate_hold">काही आयटम धरून ठेवल्यावर वेगळे काहीतरी करतात. <xliff:g id="button" example="Details">%2$s</xliff:g> वर जा. ते धरून ठेवण्यासाठी <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_intro">तुम्ही स्क्रीनवर कुठेही टॅप केले तरी सक्रिय करणे फोकस असलेल्या आयटमवर काम करते.</string>
    <string name="sandfly_tutorial_activate_title">आयटम सक्रिय करणे</string>
    <string name="sandfly_tutorial_back_in_lesson">“मागे जा” मुळे धड्यातून बाहेर पडता येत नाही. दुसरा धडा निवडण्यासाठी “अनुक्रमणिका” वापरा.</string>
    <string name="sandfly_tutorial_bell">घंटा वाजवा</string>
    <string name="sandfly_tutorial_bell_rung">घंटा वाजवल्याची संख्या: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">ब्राइटनेस</string>
    <string name="sandfly_tutorial_chapter_basics">मूलभूत गोष्टी</string>
    <string name="sandfly_tutorial_chapter_controls">नियंत्रणे आणि मजकूर</string>
    <string name="sandfly_tutorial_chapter_getting_around">स्क्रीनवर फिरणे</string>
    <string name="sandfly_tutorial_chapter_practice">सराव</string>
    <string name="sandfly_tutorial_chapter_reading">वाचन</string>
    <string name="sandfly_tutorial_choose_reading_control">वाचन नियंत्रण बदलण्यासाठी <xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> किंवा <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>. <xliff:g id="reading_control" example="Words">%3$s</xliff:g> निवडा.</string>
    <string name="sandfly_tutorial_close">ट्यूटोरियल बंद करा</string>
    <string name="sandfly_tutorial_commands_copy">SandFly ने शेवटी बोललेला मजकूर क्लिपबोर्डवर कॉपी करण्यासाठी <xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_commands_intro">या कमांड प्रत्येक स्क्रीनवर काम करतात.</string>
    <string name="sandfly_tutorial_commands_search">स्क्रीनवरील मजकूर शोधण्यासाठी <xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>. या धड्यात ट्यूटोरियल त्याऐवजी ते काय करते ते सांगते.</string>
    <string name="sandfly_tutorial_commands_speech_off">स्पीच बंद करण्यासाठी <xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> आणि सुरू करण्यासाठी पुन्हा तेच. या धड्यात ट्यूटोरियल त्याऐवजी ते काय करते ते सांगते.</string>
    <string name="sandfly_tutorial_commands_status">वेळ, बॅटरी पातळी आणि इतर स्थिती ऐकण्यासाठी <xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_commands_title">उपयुक्त कमांड</string>
    <string name="sandfly_tutorial_contents">अनुक्रमणिका</string>
    <string name="sandfly_tutorial_contents_intro">धडे, क्रमाने. प्रत्येक धडा स्वतंत्रपणे उघडता येतो.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly स्वाइप न करता फोकस केलेल्या आयटमपासून स्क्रीनच्या शेवटपर्यंत वाचू शकते. स्क्रीनला स्पर्श केल्यास वाचन थांबते.</string>
    <string name="sandfly_tutorial_continuous_move">पाककृतीच्या पहिल्या ओळीवर जा.</string>
    <string name="sandfly_tutorial_continuous_read">फोकस केलेल्या आयटमपासून वाचण्यासाठी <xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu">SandFly मेनू उघडण्यासाठी <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>, नंतर <xliff:g id="command" example="Read from focused item">%2$s</xliff:g> निवडा.</string>
    <string name="sandfly_tutorial_continuous_title">सलग वाचन</string>
    <string name="sandfly_tutorial_details">तपशील</string>
    <string name="sandfly_tutorial_details_shown">संध्याकाळी 7 वाजता 2 जणांसाठी टेबल, खिडकीजवळ.</string>
    <string name="sandfly_tutorial_done">पूर्ण</string>
    <string name="sandfly_tutorial_end_practice">सराव संपवा</string>
    <string name="sandfly_tutorial_explore_activate">“तारा” ला स्पर्श करा आणि बोट उचला. ते सक्रिय करण्यासाठी कुठेही <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_explore_find">एक बोट स्क्रीनवर फिरवा आणि चार चौकोन शोधा: सूर्य, चंद्र, तारा आणि ढग.</string>
    <string name="sandfly_tutorial_explore_intro">स्क्रीनला स्पर्श केल्यावर बोटाखालील आयटम बोलला जातो. आयटमला स्पर्श केल्याने तो सक्रिय होत नाही.</string>
    <string name="sandfly_tutorial_explore_title">स्पर्श करून एक्सप्लोर करणे</string>
    <string name="sandfly_tutorial_extra_cheese">अतिरिक्त चीज</string>
    <string name="sandfly_tutorial_finish">ट्यूटोरियल समाप्त करा</string>
    <string name="sandfly_tutorial_forecast_today">आज</string>
    <string name="sandfly_tutorial_forecast_today_text">सूर्यप्रकाश आणि उबदार हवामान, हलका वारा.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">उद्या</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">सकाळी ढगाळ, दुपारपासून पाऊस.</string>
    <string name="sandfly_tutorial_forecast_weekend">आठवड्याचा शेवट</string>
    <string name="sandfly_tutorial_forecast_weekend_text">शनिवारी वादळी वारा, रविवारी स्वच्छ आकाश.</string>
    <string name="sandfly_tutorial_headings_intro">स्क्रीन आणि वेब पेज त्यांचा आशय शीर्षकांनी विभागतात. “शीर्षके” वाचन नियंत्रण एका शीर्षकावरून पुढील शीर्षकावर जाते.</string>
    <string name="sandfly_tutorial_headings_jump">पुढील शीर्षकावर जाण्यासाठी <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>. <xliff:g id="heading" example="Weekend">%2$s</xliff:g> वर जा.</string>
    <string name="sandfly_tutorial_headings_title">शीर्षके</string>
    <string name="sandfly_tutorial_item_apples">सफरचंद</string>
    <string name="sandfly_tutorial_item_bread">ब्रेड</string>
    <string name="sandfly_tutorial_item_cheese">चीज</string>
    <string name="sandfly_tutorial_item_dates">खजूर</string>
    <string name="sandfly_tutorial_item_eggs">अंडी</string>
    <string name="sandfly_tutorial_lesson_complete">धडा पूर्ण झाला.</string>
    <string name="sandfly_tutorial_lesson_complete_last">धडा पूर्ण झाला. ट्यूटोरियल समाप्त करण्यासाठी <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_lesson_complete_next">धडा पूर्ण झाला. पुढील धडा सुरू करण्यासाठी <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, <xliff:g id="count" example="17">%3$d</xliff:g> पैकी धडा <xliff:g id="number" example="3">%2$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">आयटम <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close">मेनू बंद करण्यासाठी <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_menu_intro">SandFly मेनूमध्ये फोकस केलेल्या आयटमसाठी आणि सध्याच्या स्क्रीनसाठी कमांड असतात.</string>
    <string name="sandfly_tutorial_menu_open">SandFly मेनू उघडण्यासाठी <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>. त्याच्या कमांडमधून स्वाइप करा. मेनू बंद करण्यासाठी <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_menu_title">SandFly मेनू</string>
    <string name="sandfly_tutorial_message">सॅमचा मेसेज: दुपारी जेवायला भेटायचे?</string>
    <string name="sandfly_tutorial_message_archive">संग्रहित करा</string>
    <string name="sandfly_tutorial_message_delete">हटवा</string>
    <string name="sandfly_tutorial_message_reply">उत्तर द्या</string>
    <string name="sandfly_tutorial_move_intro">स्वाइप केल्याने स्क्रीनवरील पुढील किंवा मागील आयटमवर, वाचनाच्या क्रमाने, जाता येते.</string>
    <string name="sandfly_tutorial_move_next">पुढील आयटमवर जाण्यासाठी <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>. <xliff:g id="item" example="Eggs">%2$s</xliff:g> पर्यंत पोहोचेपर्यंत सुरू ठेवा.</string>
    <string name="sandfly_tutorial_move_previous">मागील आयटमवर जाण्यासाठी <xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>. <xliff:g id="item" example="Bread">%2$s</xliff:g> वर परत जा.</string>
    <string name="sandfly_tutorial_move_title">आयटमदरम्यान जाणे</string>
    <string name="sandfly_tutorial_name">नाव</string>
    <string name="sandfly_tutorial_next_lesson">पुढील धडा: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> साठी कोणतेही जेश्चर नाही. “कमांड” मध्ये एक नियुक्त करा किंवा “पायरी वगळा” वापरा.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> धड्यामध्ये केले जात नाही. ट्यूटोरियलमधून बाहेर पडण्यासाठी “अनुक्रमणिका” मधील “ट्यूटोरियल बंद करा” वापरा.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> धड्यामध्ये केले जात नाही.</string>
    <string name="sandfly_tutorial_pause_intro">स्पीच आयटमच्या मध्येच थांबवता येते आणि जिथे थांबले तिथून पुन्हा सुरू करता येते.</string>
    <string name="sandfly_tutorial_pause_pause">खालील कथेवर जा. ती वाचली जात असताना स्पीच थांबवण्यासाठी <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> आणि पुन्हा सुरू करण्यासाठी पुन्हा तेच.</string>
    <string name="sandfly_tutorial_pause_resume">स्पीच पुन्हा सुरू करण्यासाठी पुन्हा <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_pause_title">स्पीच थांबवणे</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">प्रत्येक जेश्चर कृती करण्याऐवजी त्याचे नाव आणि कृती सांगते. पुढील आणि मागील आयटमवर जाणे आणि सक्रिय करणे अजूनही काम करते.</string>
    <string name="sandfly_tutorial_practice_step">ते काय करते ते ऐकण्यासाठी कोणतेही जेश्चर करा. थांबवण्यासाठी <xliff:g id="button" example="End practice">%1$s</xliff:g> सक्रिय करा.</string>
    <string name="sandfly_tutorial_practice_title">जेश्चरचा सराव</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="count" example="4">%2$d</xliff:g> पैकी <xliff:g id="done" example="2">%1$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">वाचन नियंत्रण <xliff:g id="reading_control" example="Characters">%2$s</xliff:g> वर बदला. एका वर्णाने पुढे जाण्यासाठी <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_intro">वर आणि खाली स्वाइप केल्याने काय होते ते वाचन नियंत्रणे ठरवतात, जसे की शब्दानुसार किंवा वर्णानुसार पुढे जाणे किंवा स्पीच रेट बदलणे. उजवीकडे आणि डावीकडे स्वाइप केल्याने अजूनही आयटमदरम्यान जाता येते.</string>
    <string name="sandfly_tutorial_reading_controls_move">खालील वाक्यावर जा.</string>
    <string name="sandfly_tutorial_reading_controls_next_word">पुढील शब्दावर जाण्यासाठी <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>. तीन शब्द पुढे जा.</string>
    <string name="sandfly_tutorial_reading_controls_title">वाचन नियंत्रणे</string>
    <string name="sandfly_tutorial_recipe_1">पॅनकेक: मैदा, अंडी आणि दूध मिसळून एकसारखे पीठ बनवा.</string>
    <string name="sandfly_tutorial_recipe_2">तव्यावर थोडे लोणी गरम करा.</string>
    <string name="sandfly_tutorial_recipe_3">तवा पातळ झाकला जाईल इतके पीठ ओता.</string>
    <string name="sandfly_tutorial_recipe_4">खालची बाजू सोनेरी झाल्यावर पॅनकेक उलटा.</string>
    <string name="sandfly_tutorial_recipe_5">लिंबू आणि साखरेसोबत वाढा.</string>
    <string name="sandfly_tutorial_scrolling_intro">सूची एका वेळी त्यांचे फक्त काही आयटम दाखवतात. दाखवलेल्या शेवटच्या आयटमच्या पुढे स्वाइप केल्याने सूची स्क्रोल होते.</string>
    <string name="sandfly_tutorial_scrolling_page">एक पेज पुढे स्क्रोल करण्यासाठी <xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="item" example="Item 15">%2$s</xliff:g> पर्यंत पोहोचेपर्यंत सूचीमधून पुढे जाण्यासाठी <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">सूची स्क्रोल करणे</string>
    <string name="sandfly_tutorial_sentence">चपळ तपकिरी कोल्हा आळशी कुत्र्यावरून उडी मारतो.</string>
    <string name="sandfly_tutorial_skip_step">पायरी वगळा</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> स्लायडरवर जा. त्याचे मूल्य बदलण्यासाठी <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> किंवा <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> 100 टक्के, म्हणजे सर्वोच्च मूल्यावर सेट करा.</string>
    <string name="sandfly_tutorial_sliders_intro">स्लायडरवर फोकस असताना वर आणि खाली स्वाइप केल्याने त्याचे मूल्य बदलते.</string>
    <string name="sandfly_tutorial_sliders_title">स्लायडर</string>
    <string name="sandfly_tutorial_step"><xliff:g id="count" example="2">%2$d</xliff:g> पैकी पायरी <xliff:g id="number" example="1">%1$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">सँडफ्लाय या लहान माश्या आहेत ज्या समुद्रकिनाऱ्यांवर, नदीकाठांवर आणि जंगलांमध्ये राहतात. पहाटे आणि संध्याकाळी, जेव्हा हवा स्थिर असते, तेव्हा त्या सर्वाधिक सक्रिय असतात. फक्त माद्या चावतात, कारण अंडी तयार करण्यासाठी त्यांना रक्ताची गरज असते. चाव्यांना अनेक दिवस खाज येते, म्हणून सँडफ्लाय असलेल्या भागात जाणारे लोक कीटक प्रतिबंधक सोबत ठेवतात. सँडफ्लाय नीट उडू शकत नाहीत आणि हलकी झुळूकदेखील त्यांना दूर ठेवते.</string>
