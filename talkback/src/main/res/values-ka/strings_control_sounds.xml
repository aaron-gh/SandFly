    <string name="title_pref_control_sounds">მართვის ელემენტების ხმები და ვიბრაციები</string>
    <string name="summary_pref_control_sounds">მართვის ელემენტის თითოეულ ტიპს, მაგალითად ღილაკებს, მოსანიშნ ველებს, რედაქტირების ველებსა და სიის ელემენტებს, თემიდან საკუთარი ხმა და ვიბრაცია ენიჭება ფოკუსის ხმისა და ვიბრაციის ნაცვლად, როგორც ამას Unspoken აკეთებს NVDA-სთვის. ხმა ისმის ეკრანზე ელემენტის მდებარეობიდან და SandFly ელემენტის ტიპს არ ამბობს.</string>
    <string name="title_pref_control_sounds_speak_roles">მართვის ელემენტის ტიპის მაინც წარმოთქმა</string>
    <string name="summary_pref_control_sounds_speak_roles">მართვის ელემენტის ხმის დაკვრისას ელემენტის ტიპიც წარმოითქმის, მაგალითად, ღილაკი. ვრცელდება ყველა ხმოვან თემაზე.</string>
