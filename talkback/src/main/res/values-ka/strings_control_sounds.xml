    <string name="title_pref_control_sounds">Აკონტროლეთ ხმები და ვიბრაციები</string>
    <string name="summary_pref_control_sounds">Მიეცით თითოეული სახის კონტროლი, როგორიცაა ღილაკები, ჩამრთველები, ველების რედაქტირება და სიის ელემენტები, საკუთარი ხმა და საკუთარი ვიბრაცია თემიდან, ფოკუსირებული ხმის და ვიბრაციის ნაცვლად, როგორც ამას აკეთებს Unspoken NVDA-სთვის. ხმა მოდის იქიდან, სადაც არის კონტროლი ეკრანზე და SandFly ტოვებს იმის თქმას, თუ რა სახის კონტროლია ეს.</string>
    <string name="title_pref_control_sounds_speak_roles">Მაინც თქვით როგორი კონტროლი</string>
    <string name="summary_pref_control_sounds_speak_roles">Როდესაც საკონტროლო ხმა უკრავს, მაინც თქვით რა სახის კონტროლია, მაგალითად, ღილაკი. ეს არის ყველა ხმოვანი თემისთვის.</string>
