    <string name="dialog_message_ai_service_consent">Სურათები და ეკრანის ანაბეჭდები იგზავნება <xliff:g id="host" example="openrouter.ai">%1$s</xliff:g>-ზე აღსაწერად, რასაც რამდენიმე წამი სჭირდება. მოქმედებს მისი საკუთარი პირობები და კონფიდენციალურობის პოლიტიკა. გენერაციული AI ექსპერიმენტულია, ამიტომ შეცდომებს დაუშვებს.</string>
    <string name="ai_service_error_api_key">AI სერვისმა არ მიიღო API გასაღები. შეამოწმეთ მისი პარამეტრები ავტომატურ აღწერილობებში.</string>
    <string name="ai_service_error_quota">AI სერვისის გამოყენების ლიმიტი მიღწეულია. სცადეთ მოგვიანებით.</string>
    <string name="ai_service_error_busy">AI სერვისი ამჟამად დაკავებულია. სცადეთ ხელახლა რამდენიმე წუთში.</string>
