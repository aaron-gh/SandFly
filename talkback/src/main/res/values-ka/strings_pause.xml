    <string name="dialog_message_pause_backtalk">Სანამ SandFly დაპაუზებულია, ის არ საუბრობს და არ პასუხობს ჟესტებს და ეკრანი ისე მუშაობს, თითქოს ეკრანის წამკითხველი არ არის ჩართული.</string>
    <string name="message_resume_keyguard">გასაგრძელებლად შეეხეთ შეტყობინებას „SandFly შეჩერებულია“, სწრაფად სამჯერ დააჭირეთ ხმის დაწევის ღილაკს, ან დაბლოკეთ და გააღვიძეთ ტელეფონი, რათა დაბლოკვის ეკრანი გამოჩნდეს.</string>
    <string name="message_resume_screen_on">Განახლებისთვის შეეხეთ SandFly შეჩერებულია შეტყობინებას, 3-ჯერ სწრაფად დააჭირეთ ხმის შემცირებას ან გამორთეთ და ხელახლა ჩართეთ ეკრანი.</string>
    <string name="message_resume_manual">Განახლებისთვის შეეხეთ SandFly შეჩერებული შეტყობინებას ან 3-ჯერ სწრაფად დააჭირეთ ხმის შემცირებას.</string>
