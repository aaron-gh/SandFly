    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> utförs inte i en lektion. Använd Stäng guiden under Innehåll för att lämna guiden.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> utförs inte i en lektion.</string>
    <string name="sandfly_tutorial_pause_intro">Talet kan pausas mitt i ett objekt och återupptas där det stoppades.</string>
    <string name="sandfly_tutorial_pause_pause">Gå till berättelsen nedan. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> medan den läses upp för att pausa talet, och igen för att återuppta.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> igen för att återuppta talet.</string>
