    <string name="sandfly_tutorial_headings_intro">Skärmar och webbsidor delar in sitt innehåll med rubriker. Läsinställningen Rubriker hoppar från en rubrik till nästa.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> för att hoppa till nästa rubrik. Hoppa till <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
