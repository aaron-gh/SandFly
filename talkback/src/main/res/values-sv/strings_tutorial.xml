    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> för att byta läsinställning. Välj <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Stäng guiden</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> för att kopiera den senaste texten som SandFly läste upp till urklipp.</string>
    <string name="sandfly_tutorial_commands_intro">De här kommandona fungerar på alla skärmar.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> för att söka efter text på skärmen. I den här lektionen säger guiden i stället vad rörelsen gör.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> för att stänga av talet och igen för att slå på det. I den här lektionen säger guiden i stället vad rörelsen gör.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> för att höra tiden, batterinivån och annan status.</string>
