    <string name="sandfly_tutorial_tile_sun">Sol</string>
    <string name="sandfly_tutorial_title">SandFly-guiden</string>
    <string name="sandfly_tutorial_typing_delete">Radera den sista bokstaven med tangentbordets raderingstangent.</string>
    <string name="sandfly_tutorial_typing_intro">När du aktiverar ett textfält öppnas tangentbordet. Rör vid en tangent för att höra den och lyft fingret för att skriva den.</string>
    <string name="sandfly_tutorial_typing_open">Gå till fältet <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> för att börja skriva.</string>
    <string name="sandfly_tutorial_typing_title">Skrivning</string>
    <string name="sandfly_tutorial_typing_type">Skriv ordet <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">katt</string>
    <string name="sandfly_tutorial_welcome_intro">Den här guiden lär ut SandFlys rörelser. Varje lektion ger en instruktion, väntar tills du har utfört den med dina egna rörelser och ger sedan nästa. Instruktionen är det första objektet efter lektionens namn. Innehåll visar alla lektioner, och guiden öppnas igen på lektionen du var på.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> var som helst på skärmen för att börja.</string>
    <string name="sandfly_tutorial_welcome_title">Välkommen</string>
