    <string name="sandfly_tutorial_move_intro">Svepning flyttar till nästa eller föregående objekt på skärmen, i läsordning.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> för att gå till nästa objekt. Fortsätt tills du når <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> för att gå till föregående objekt. Gå tillbaka till <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
