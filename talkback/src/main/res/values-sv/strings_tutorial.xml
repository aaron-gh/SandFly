    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Varje rörelse säger sitt namn och sin åtgärd i stället för att utföra den. Att gå till nästa och föregående objekt och att aktivera fungerar fortfarande.</string>
    <string name="sandfly_tutorial_practice_step">Gör valfri rörelse för att höra vad den gör. Aktivera <xliff:g id="button" example="End practice">%1$s</xliff:g> för att sluta.</string>
    <string name="sandfly_tutorial_practice_title">Öva rörelser</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> av <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Byt läsinställning till <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> för att flytta ett tecken.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Läsinställningar väljer vad svepning uppåt och nedåt gör, till exempel att flytta ord för ord eller tecken för tecken, eller att ändra talhastigheten. Svepning åt höger och vänster flyttar fortfarande mellan objekt.</string>
    <string name="sandfly_tutorial_reading_controls_move">Gå till meningen nedan.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> för att gå till nästa ord. Flytta tre ord.</string>
    <string name="sandfly_tutorial_reading_controls_title">Läsinställningar</string>
    <string name="sandfly_tutorial_recipe_1">Pannkakor: blanda mjöl, ägg och mjölk till en slät smet.</string>
    <string name="sandfly_tutorial_recipe_2">Hetta upp lite smör i en stekpanna.</string>
    <string name="sandfly_tutorial_recipe_3">Häll i så mycket smet att den täcker pannan tunt.</string>
    <string name="sandfly_tutorial_recipe_4">Vänd pannkakan när undersidan är gyllene.</string>
    <string name="sandfly_tutorial_recipe_5">Servera med citron och socker.</string>
    <string name="sandfly_tutorial_scrolling_intro">Listor visar bara några av sina objekt åt gången. När du sveper förbi det sista objektet som visas rullas listan.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> för att rulla framåt en sida.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> genom listan tills du når <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Rulla listor</string>
    <string name="sandfly_tutorial_sentence">Den snabba bruna räven hoppar över den lata hunden.</string>
    <string name="sandfly_tutorial_skip_step">Hoppa över steg</string>
    <string name="sandfly_tutorial_sliders_change">Gå till reglaget <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> för att ändra dess värde.</string>
    <string name="sandfly_tutorial_sliders_highest">Ställ in <xliff:g id="slider" example="Brightness">%1$s</xliff:g> på 100 procent, dess högsta värde.</string>
    <string name="sandfly_tutorial_sliders_intro">När ett reglage har fokus ändrar svepning uppåt och nedåt dess värde.</string>
    <string name="sandfly_tutorial_sliders_title">Reglage</string>
    <string name="sandfly_tutorial_step">Steg <xliff:g id="number" example="1">%1$d</xliff:g> av <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Sandmyggor är små flugor som lever på stränder, vid flodstränder och i skogar. De är mest aktiva i gryningen och skymningen, när luften är stilla. Bara honorna sticks, eftersom de behöver blod för att producera sina ägg. Betten kliar i flera dagar, så den som besöker sandmyggornas trakter har med sig insektsmedel. Sandmyggor är svaga flygare, och redan en lätt bris håller dem borta.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> för att gå tillbaka.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> för att gå till startskärmen.</string>
    <string name="sandfly_tutorial_system_intro">De här rörelserna fungerar på alla skärmar. I den här lektionen säger guiden vad varje rörelse gör i stället för att utföra den.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> för att öppna aviseringar.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> för att visa senaste apparna.</string>
    <string name="sandfly_tutorial_system_title">Bakåt, Hem och aviseringar</string>
