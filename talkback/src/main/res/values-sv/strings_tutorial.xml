    <string name="sandfly_tutorial_actions_archive">Gå till meddelandet. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> för att gå igenom dess åtgärder. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> för att utföra åtgärden du hör. Utför <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Vissa objekt har andra åtgärder än aktivering, till exempel Arkivera eller Radera för ett meddelande. När ett sådant objekt har fokus går läsinställningen Åtgärder igenom dem.</string>
    <string name="sandfly_tutorial_actions_title">Åtgärder</string>
    <string name="sandfly_tutorial_activate_button">Gå till <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> för att aktivera den.</string>
    <string name="sandfly_tutorial_activate_check_box">Markera <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> på samma sätt.</string>
    <string name="sandfly_tutorial_activate_hold">Vissa objekt gör något annat när de hålls ned. Gå till <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> för att hålla ned den.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivering gäller objektet i fokus, var du än trycker på skärmen.</string>
    <string name="sandfly_tutorial_activate_title">Aktivera objekt</string>
    <string name="sandfly_tutorial_back_in_lesson">Bakåt lämnar inte en lektion. Använd Innehåll för att välja en annan lektion.</string>
