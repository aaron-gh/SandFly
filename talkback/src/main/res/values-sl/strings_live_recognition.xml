    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">Usmerite zadnji fotoaparat proti temu, kar želite, da je opisano. Za Pokaži in preberi s prstom pokažite besedilo na sliki fotoaparata. Opisi so lahko napačni. Ne zanašajte se nanje za varno premikanje.</string>
    <string name="live_recognition_camera_off">Fotoaparat izklopljen</string>
    <string name="live_recognition_camera_on">Fotoaparat vklopljen</string>
    <string name="live_recognition_connecting">Povezovanje z Geminijem…</string>
    <string name="live_recognition_cloud_title">Želite pošiljati slike fotoaparata Geminiju?</string>
    <string name="live_recognition_cloud_message">Prizori, Pokaži in preberi, Zaznavanje oseb in Zaznavanje vrat vsakih nekaj sekund pošljejo sliko fotoaparata Googlovemu vmesniku Gemini API. Besedilo se prepozna v tem telefonu.\n\nZ brezplačnim ključem API lahko Google shrani, kar prejme, to uporabi za izboljšanje svojih izdelkov in da to pregledati ljudem. Generativna umetna inteligenca je poskusna, zato bo delala napake.</string>
    <string name="live_recognition_service_title">Želite pošiljati slike fotoaparata na <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">Prizori, Pokaži in preberi, Zaznavanje oseb in Zaznavanje vrat vsakih nekaj sekund pošljejo sliko fotoaparata na <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>. Besedilo se prepozna v tem telefonu.\n\nVeljajo pogoji in pravilnik o zasebnosti storitve. Generativna umetna inteligenca je poskusna, zato bo delala napake.</string>
