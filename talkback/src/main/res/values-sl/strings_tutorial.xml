    <string name="sandfly_tutorial_move_intro">Vlečenje premakne na naslednji ali prejšnji element na zaslonu, v vrstnem redu branja.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> za premik na naslednji element. Nadaljujte, dokler ne pridete do elementa <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> za premik na prejšnji element. Vrnite se na element <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Premikanje med elementi</string>
    <string name="sandfly_tutorial_name">Ime</string>
    <string name="sandfly_tutorial_next_lesson">Naslednja lekcija: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> nima poteze. Dodelite jo v razdelku Ukazi ali uporabite Preskoči korak.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> se v lekciji ne izvede. Vadnico zapustite z gumbom Zapri vadnico v vsebini.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> se v lekciji ne izvede.</string>
    <string name="sandfly_tutorial_pause_intro">Govor lahko začasno ustavite sredi elementa in ga nadaljujete tam, kjer se je ustavil.</string>
    <string name="sandfly_tutorial_pause_pause">Premaknite se na zgodbo spodaj. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> med branjem za začasno ustavitev govora, ponovno za nadaljevanje.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> ponovno za nadaljevanje govora.</string>
    <string name="sandfly_tutorial_pause_title">Začasna ustavitev govora</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Vsaka poteza namesto izvedbe izgovori svoje ime in dejanje. Premik na naslednji in prejšnji element ter aktiviranje še vedno delujejo.</string>
    <string name="sandfly_tutorial_practice_step">Naredite katero koli potezo, da slišite, kaj naredi. Vajo končate z aktiviranjem gumba <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Vaja potez</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> od <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Kontrolnik za branje spremenite v <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> za premik za en znak.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Kontrolniki za branje določajo, kaj naredi vlečenje navzgor in navzdol, na primer premik po besedah ali po znakih ali sprememba hitrosti govora. Vlečenje desno in levo še vedno premika med elementi.</string>
    <string name="sandfly_tutorial_reading_controls_move">Premaknite se na poved spodaj.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> za premik na naslednjo besedo. Premaknite se za tri besede.</string>
    <string name="sandfly_tutorial_reading_controls_title">Kontrolniki za branje</string>
    <string name="sandfly_tutorial_recipe_1">Palačinke: zmešajte moko, jajca in mleko v gladko testo.</string>
    <string name="sandfly_tutorial_recipe_2">V ponvi segrejte malo masla.</string>
    <string name="sandfly_tutorial_recipe_3">Vlijte toliko testa, da tanko prekrije ponev.</string>
    <string name="sandfly_tutorial_recipe_4">Ko je spodnja stran zlata, palačinko obrnite.</string>
    <string name="sandfly_tutorial_recipe_5">Postrezite z limono in sladkorjem.</string>
    <string name="sandfly_tutorial_scrolling_intro">Seznami hkrati prikazujejo le nekatere elemente. Vlečenje čez zadnji prikazani element pomakne seznam.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> za pomik za eno stran naprej.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> za pomikanje po seznamu, dokler ne pridete do elementa <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Pomikanje po seznamih</string>
    <string name="sandfly_tutorial_sentence">Hitra rjava lisica skoči čez lenega psa.</string>
    <string name="sandfly_tutorial_skip_step">Preskoči korak</string>
    <string name="sandfly_tutorial_sliders_change">Premaknite se na drsnik <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ali <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> za spremembo njegove vrednosti.</string>
    <string name="sandfly_tutorial_sliders_highest">Drsnik <xliff:g id="slider" example="Brightness">%1$s</xliff:g> nastavite na 100 odstotkov, najvišjo vrednost.</string>
    <string name="sandfly_tutorial_sliders_intro">Ko je drsnik v fokusu, vlečenje navzgor in navzdol spreminja njegovo vrednost.</string>
    <string name="sandfly_tutorial_sliders_title">Drsniki</string>
    <string name="sandfly_tutorial_step">Korak <xliff:g id="number" example="1">%1$d</xliff:g> od <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Peščene mušice so majhne muhe, ki živijo na plažah, na rečnih bregovih in v gozdovih. Najbolj dejavne so ob zori in mraku, ko je zrak miren. Pikajo samo samice, ker potrebujejo kri za razvoj jajčec. Piki srbijo več dni, zato ljudje, ki obiščejo kraje s peščenimi mušicami, s seboj nosijo sredstvo proti mrčesu. Peščene mušice slabo letijo in že rahel vetrič jih odžene.</string>
