    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> ali <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> za spremembo kontrolnika za branje. Izberite <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Zapri vadnico</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> za kopiranje zadnjega besedila, ki ga je izgovoril SandFly, v odložišče.</string>
    <string name="sandfly_tutorial_commands_intro">Ti ukazi delujejo na vsakem zaslonu.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> za iskanje besedila na zaslonu. V tej lekciji vadnica namesto tega pove, kaj poteza naredi.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> za izklop govora, ponovno za vklop. V tej lekciji vadnica namesto tega pove, kaj poteza naredi.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> za izgovor ure, ravni baterije in drugih podatkov o stanju.</string>
