    <string name="sandfly_tutorial_typing_delete">Zadnjo črko izbrišite s tipko za brisanje na tipkovnici.</string>
    <string name="sandfly_tutorial_typing_intro">Aktiviranje besedilnega polja odpre tipkovnico. Dotaknite se tipke, da jo slišite, in dvignite prst, da jo vnesete.</string>
    <string name="sandfly_tutorial_typing_open">Premaknite se na polje <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> za začetek tipkanja.</string>
