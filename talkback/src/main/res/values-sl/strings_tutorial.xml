    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> za odpiranje začetnega zaslona.</string>
    <string name="sandfly_tutorial_system_intro">Te poteze delujejo na vsakem zaslonu. V tej lekciji vadnica namesto izvedbe pove, kaj vsaka od njih naredi.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> za odpiranje obvestil.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> za prikaz nedavnih aplikacij.</string>
