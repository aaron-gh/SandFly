    <string name="sandfly_tutorial_typing_word">mak</string>
    <string name="sandfly_tutorial_welcome_intro">Ta vadnica uči poteze SandFly. Vsaka lekcija da navodilo, počaka, da ga izvedete s svojimi potezami, nato da naslednje. Navodilo je prvi element za imenom lekcije. Vsebina navaja vse lekcije, vadnica pa se znova odpre pri lekciji, pri kateri ste ostali.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> kjer koli na zaslonu za začetek.</string>
    <string name="sandfly_tutorial_welcome_title">Dobrodošli</string>
