<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Premaknite se na sporočilo. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ali <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> za pregledovanje njegovih dejanj. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> za izvedbo dejanja, ki ga slišite. Izvedite dejanje <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Nekateri elementi imajo poleg aktiviranja še druga dejanja, na primer Arhiviraj ali Izbriši pri sporočilu. Ko je tak element v fokusu, kontrolnik za branje Dejanja gre skozi njih.</string>
    <string name="sandfly_tutorial_actions_title">Dejanja</string>
    <string name="sandfly_tutorial_activate_button">Premaknite se na element <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> za aktiviranje.</string>
    <string name="sandfly_tutorial_activate_check_box">Na enak način potrdite <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_hold">Nekateri elementi ob pridržanju naredijo nekaj drugega. Premaknite se na element <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> za pridržanje.</string>
    <string name="sandfly_tutorial_activate_intro">Aktiviranje deluje na elementu v fokusu, ne glede na to, kje se dotaknete zaslona.</string>
    <string name="sandfly_tutorial_activate_title">Aktiviranje elementov</string>
    <string name="sandfly_tutorial_back_in_lesson">Nazaj ne zapusti lekcije. Drugo lekcijo izberete z gumbom Vsebina.</string>
    <string name="sandfly_tutorial_bell">Pozvoni z zvoncem</string>
    <string name="sandfly_tutorial_bell_rung">Število zvonjenj: <xliff:g id="count" example="1">%1$d</xliff:g></string>
