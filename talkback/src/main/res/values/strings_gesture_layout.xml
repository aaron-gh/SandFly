<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the setting on the Gestures screen that chooses which gestures SandFly starts from: SandFly's own or those of VoiceOver on iPhone. -->
    <string name="title_pref_gesture_layout">Gesture layout</string>
    <!-- Name of SandFly's own gesture layout, in the Gesture layout list and the first-run dialog. -->
    <string name="gesture_layout_sandfly">SandFly gestures</string>
    <!-- Name of the gesture layout that matches VoiceOver on iPhone, in the Gesture layout list and the first-run dialog. Keep "VoiceOver" untranslated. -->
    <string name="gesture_layout_voiceover">VoiceOver gestures</string>
    <!-- Title of the dialog shown the first time SandFly starts, which chooses the gesture layout. -->
    <string name="gesture_layout_dialog_title">Choose gestures</string>
    <!-- Title of the switch on the Gestures screen. On, two-finger swipes run the commands assigned to them; off, they scroll in the app. -->
    <string name="title_pref_handle_two_finger_swipes">Handle two-finger swipes in SandFly</string>
    <!-- Label for the preference that assigns an action to a four-finger tap on the top half of the screen. -->
    <string name="title_pref_shortcut_4finger_1tap_top">Tap with 4 fingers on top half</string>
    <!-- Label for the preference that assigns an action to a four-finger tap on the bottom half of the screen. -->
    <string name="title_pref_shortcut_4finger_1tap_bottom">Tap with 4 fingers on bottom half</string>
    <!-- Name of the command that speaks where the focused item is in its list or table. -->
    <string name="shortcut_speak_position">Speak position</string>
    <!-- Spoken by Speak position for an item in a list. -->
    <string name="speak_position_item">Item <xliff:g id="index">%1$d</xliff:g> of <xliff:g id="count">%2$d</xliff:g></string>
    <!-- Spoken by Speak position for a cell in a table. -->
    <string name="speak_position_row_column">Row <xliff:g id="row">%1$d</xliff:g> of <xliff:g id="row_count">%2$d</xliff:g>, column <xliff:g id="column">%3$d</xliff:g> of <xliff:g id="column_count">%4$d</xliff:g></string>
    <!-- Spoken by Speak position when the focused item is in no list or table. -->
    <string name="speak_position_none">No position</string>
</resources>
