    <string name="command_replace_gesture"><xliff:g id="gesture" example="Swipe up then right">%1$s</xliff:g> runs <xliff:g id="old_command" example="Read from top">%2$s</xliff:g>. Use it for <xliff:g id="new_command" example="Describe image">%3$s</xliff:g> instead?</string>
    <!-- Button that confirms using a gesture for a different command. [CHAR LIMIT=40] -->
    <string name="command_replace">Replace</string>
    <!-- Announcement after a gesture is assigned to a command. %1$s is the gesture, %2$s the command. [CHAR LIMIT=NONE] -->
