<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the settings entry and screen that list every screen reader command; each command shows its gestures and keyboard shortcuts. [CHAR LIMIT=40] -->
    <string name="title_pref_commands">Commands</string>
    <!-- Group of commands that activate the focused item or open menus for it. [CHAR LIMIT=40] -->
    <string name="commands_category_activation">Activation</string>
    <!-- Group of commands that scroll lists and pages. [CHAR LIMIT=40] -->
    <string name="commands_category_scrolling">Scrolling</string>
    <!-- Group of commands that move through tables. [CHAR LIMIT=40] -->
