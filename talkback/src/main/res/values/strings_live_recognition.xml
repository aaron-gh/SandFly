<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the settings entry, screen and reading control that describe what the rear camera sees. [CHAR LIMIT=40] -->
    <string name="live_recognition_title">Live recognition</string>
    <!-- Hint spoken for the Live recognition reading control. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_hint">Swipe up or down to choose a mode, then double-tap to turn it on or off</string>
    <!-- Live recognition mode that describes the objects the camera sees. [CHAR LIMIT=30] -->
    <string name="live_recognition_scenes">Scenes</string>
    <!-- Live recognition mode that reads text the camera sees. [CHAR LIMIT=30] -->
    <string name="live_recognition_text">Text</string>
    <!-- Live recognition mode that reads the text a finger points at in the camera view, as in VoiceOver. [CHAR LIMIT=30] -->
    <string name="live_recognition_point">Point and Speak</string>
    <!-- Live recognition mode that describes the people the camera sees. [CHAR LIMIT=30] -->
    <string name="live_recognition_people">People detection</string>
    <!-- Live recognition mode that describes the doors the camera sees. [CHAR LIMIT=30] -->
    <string name="live_recognition_doors">Door detection</string>
    <!-- A Live recognition mode and whether it is on, such as "Scenes, on". [CHAR LIMIT=NONE] -->
    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <!-- Text at the top of the Live recognition screen. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_instructions">Point the rear camera at what you want described. For Point and Speak, point a finger at text in the camera view. Descriptions can be wrong. Don\'t rely on them to move around safely.</string>
    <!-- Status on the Live recognition screen when no mode is on. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_camera_off">Camera off</string>
    <!-- Status on the Live recognition screen while a mode is on. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_camera_on">Camera on</string>
    <!-- Status on the Live recognition screen while the connection to Gemini opens. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_connecting">Connecting to Gemini…</string>
    <!-- Title of the dialog shown before camera images are first sent to Gemini on a visit to the Live recognition screen. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_cloud_title">Send camera images to Gemini?</string>
    <!-- Message of the dialog shown before camera images are first sent to Gemini. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_cloud_message">Scenes, Point and Speak, People detection and Door detection send an image from the camera to Google\'s Gemini API every few seconds. Text is recognized on this phone.\n\nWith a free API key, Google may keep what it receives, use it to improve its products, and have people review it. Generative AI is experimental, so it will make mistakes.</string>
    <!-- Button of the dialog that sends camera images to Gemini. [CHAR LIMIT=20] -->
    <string name="live_recognition_send">Send images</string>
    <!-- Spoken when the camera permission was not given. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_camera_permission">No camera permission</string>
    <!-- Spoken when the rear camera cannot be used, for example because another app uses it. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_camera_error">The camera could not be opened</string>
    <!-- Spoken when the connection to Gemini fails or Gemini reports an error. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_connection_error">Gemini connection failed. Modes that use Gemini turned off.</string>
    <!-- Spoken when Gemini does not answer in time. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_timeout">Gemini didn\'t answer in time. Modes that use Gemini turned off.</string>
    <!-- Spoken when Gemini ends the session, which it does after a few minutes. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_session_ended">The Gemini session ended. Modes that use Gemini turned off.</string>
    <!-- Spoken when text recognition on the phone fails, for example while Google Play services still downloads its model. [CHAR LIMIT=NONE] -->
    <string name="live_recognition_ocr_error">Text recognition is not available. Text turned off.</string>
    <!-- Choice on the Live recognition screen: Point and Speak reads the text above the fingertip. [CHAR LIMIT=40] -->
    <string name="live_recognition_point_above">Read above the fingertip</string>
    <!-- Choice on the Live recognition screen: Point and Speak reads the text below the fingertip. [CHAR LIMIT=40] -->
    <string name="live_recognition_point_below">Read below the fingertip</string>
</resources>
