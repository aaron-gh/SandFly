<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pref_export_item_file_reference_key" translatable="false">pref_export_item_file_reference</string>

    <!-- Action on screens of items, such as Macros and Gesture profiles, that imports the items in a file: macros, gesture profiles, keymaps, gestures in apps, settings profiles, dictionary entries and custom voice commands. Also the title of the dialog that lists what an import left out. [CHAR_LIMIT=NONE] -->
    <string name="item_file_import">Import from file</string>
    <!-- Action that saves items to a file: on a list screen every item in the list, on an item's screen that item. [CHAR_LIMIT=NONE] -->
    <string name="item_file_export">Export to file</string>
    <!-- Settings entry on the Back up and restore screen that saves a document describing item files, with the gestures, commands and settings of the phone, for writing item files by hand or with an AI chat. [CHAR_LIMIT=NONE] -->
    <string name="title_pref_export_item_file_reference">Export file format reference</string>
    <!-- Name of the keymaps in an item file, in the list of what an import left out. [CHAR_LIMIT=NONE] -->
    <string name="item_file_keymaps">Keymaps</string>
    <!-- Message after a file was exported. [CHAR_LIMIT=NONE] -->
    <string name="item_file_exported">Exported</string>
    <!-- Message when a file could not be exported. [CHAR_LIMIT=NONE] -->
    <string name="item_file_export_failed">Could not export</string>
    <!-- Message when a file chosen for Import from file is not an item file. [CHAR_LIMIT=NONE] -->
    <string name="item_file_not_read">This file is not a SandFly item file, or could not be read</string>
    <!-- Message when a file chosen for Import from file holds all of SandFly's settings. [CHAR_LIMIT=NONE] -->
    <string name="item_file_settings_file">This is a settings file. Import it with Back up and restore &gt; Import settings</string>
    <!-- Message when an item file is of a later version of the format than this SandFly reads. [CHAR_LIMIT=NONE] -->
    <string name="item_file_newer">This file is from a newer version of SandFly</string>
    <!-- Message when an item file had nothing that could be imported. [CHAR_LIMIT=NONE] -->
    <string name="item_file_nothing_imported">Nothing imported</string>
    <!-- Message after an import. %1$s lists what was imported, such as "2 macros, 1 gesture profile". [CHAR_LIMIT=NONE] -->
    <string name="item_file_imported">Imported <xliff:g id="items" example="2 macros, 1 gesture profile">%1$s</xliff:g></string>
    <!-- Heading of the list of what an import left out. [CHAR_LIMIT=NONE] -->
    <string name="item_file_left_out">Left out:</string>
    <!-- An item of a file that was left out because it lacks a name or other required text. %1$s is the kind of item, such as Macros; %2$d its number in the file's list. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_not_read"><xliff:g id="kind" example="Macros">%1$s</xliff:g>, item <xliff:g id="number" example="3">%2$d</xliff:g>: not read</string>
    <!-- A command that SandFly doesn't have, left out. %1$s is the item, such as a macro's name; %2$s the command as written. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_command"><xliff:g id="item" example="Open mail">%1$s</xliff:g>: unknown command <xliff:g id="command" example="READ_ALL">%2$s</xliff:g></string>
    <!-- A gesture that SandFly doesn't have, left out. %1$s is the item, such as a gesture profile's name; %2$s the gesture as written. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_gesture"><xliff:g id="item" example="Reading">%1$s</xliff:g>: unknown gesture <xliff:g id="gesture" example="pref_shortcut_spin">%2$s</xliff:g></string>
    <!-- Keys that could not be read as a keyboard shortcut, left out. %1$s is the item, such as a keymap's name; %2$s the keys as written. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_keys"><xliff:g id="item" example="My keymap">%1$s</xliff:g>: keys not understood: <xliff:g id="keys" example="SandFly+Foo">%2$s</xliff:g></string>
    <!-- Keys that another command of the same keymap already has, left out. %1$s is the keymap's name; %2$s the keys. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_keys_taken"><xliff:g id="item" example="My keymap">%1$s</xliff:g>: keys already used: <xliff:g id="keys" example="SandFly+H">%2$s</xliff:g></string>
    <!-- A setting of a settings profile that was left out. %1$s is the profile's name; %2$s the setting's key. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_setting"><xliff:g id="item" example="Reading">%1$s</xliff:g>: setting <xliff:g id="key" example="pref_vibration">%2$s</xliff:g> is unknown, can\'t be in a profile, or has a value of the wrong type</string>
    <!-- A dictionary entry whose regular expression is invalid or could take very long to match, left out. %1$s is the dictionary; %2$s the expression. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_regex"><xliff:g id="dictionary" example="Speech dictionary">%1$s</xliff:g>: regular expression refused: <xliff:g id="expression" example="(a+)+">%2$s</xliff:g></string>
    <!-- Items past the most that are kept, left out. %1$s is the kind of item; %2$d the most kept. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_limit"><xliff:g id="kind" example="Symbol dictionary">%1$s</xliff:g>: at most <xliff:g id="number" example="500">%2$d</xliff:g> items</string>
    <!-- Last line of the list of what an import left out, when the list is too long to show. [CHAR_LIMIT=NONE] -->
    <string name="item_file_problem_more">More was left out</string>

    <!-- How many macros an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_macros">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> macro</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> macros</item>
    </plurals>
    <!-- How many gesture profiles an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_gesture_profiles">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> gesture profile</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> gesture profiles</item>
    </plurals>
    <!-- How many keymaps an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_keymaps">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> keymap</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> keymaps</item>
    </plurals>
    <!-- For how many apps an import set the gestures and keyboard shortcuts in apps. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_apps">
        <item quantity="one">gestures and keyboard shortcuts of <xliff:g id="count" example="1">%d</xliff:g> app</item>
        <item quantity="other">gestures and keyboard shortcuts of <xliff:g id="count" example="2">%d</xliff:g> apps</item>
    </plurals>
    <!-- How many settings profiles an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_settings_profiles">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> settings profile</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> settings profiles</item>
    </plurals>
    <!-- How many speech dictionary entries an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_speech_dictionary">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> speech dictionary entry</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> speech dictionary entries</item>
    </plurals>
    <!-- How many symbol dictionary entries an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_symbol_dictionary">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> symbol dictionary entry</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> symbol dictionary entries</item>
    </plurals>
    <!-- How many braille dictionary entries an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_braille_dictionary">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> braille dictionary entry</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> braille dictionary entries</item>
    </plurals>
    <!-- How many custom voice commands an import added or replaced. [CHAR_LIMIT=NONE] -->
    <plurals name="item_file_count_voice_commands">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> custom voice command</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> custom voice commands</item>
    </plurals>
</resources>
