<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Name of SandFly's interactive keyboard tutorial, and the heading of its list of lessons. [CHAR LIMIT=40] -->
    <string name="sandfly_keyboard_tutorial_title">SandFly keyboard tutorial</string>
    <!-- Instruction of a step whose command has no keyboard shortcut. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_no_key"><xliff:g id="command" example="Next item">%1$s</xliff:g> has no keyboard shortcut. Assign one in Commands, or use Skip step.</string>
    <!-- How the keys that turn browse mode on or off are named in an instruction: a key pressed twice. [CHAR LIMIT=40] -->
    <string name="sandfly_keyboard_tutorial_key_twice"><xliff:g id="key" example="Meta">%1$s</xliff:g> twice</string>
    <!-- Said when a lesson is done and focus moves to the button that starts the next lesson. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_lesson_complete_next">Lesson complete. Press <xliff:g id="keys" example="Meta + Space">%1$s</xliff:g> to start the next lesson.</string>
    <!-- Said when the last lesson is done and focus moves to the button that finishes the tutorial. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_lesson_complete_last">Lesson complete. Press <xliff:g id="keys" example="Meta + Space">%1$s</xliff:g> to finish the tutorial.</string>
    <!-- Name of the tutorial chapter about web pages. [CHAR LIMIT=40] -->
    <string name="sandfly_keyboard_tutorial_chapter_web">Web pages</string>

    <!-- Introduction of the first lesson. The first placeholder is the key that most keyboard shortcuts use, the second says where it is. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_welcome_intro">This tutorial teaches SandFly\'s keyboard shortcuts. Most of them use the SandFly key, <xliff:g id="key" example="Meta">%1$s</xliff:g>, with other keys. <xliff:g id="location" example="The Meta key is the Windows key, next to the left Alt key.">%2$s</xliff:g> Ctrl stops speech. Each lesson gives an instruction, waits until you have pressed the keys it names, then gives the next one. The instruction is the first item after the name of the lesson. Contents lists every lesson, and the tutorial reopens at the lesson you were on.</string>
    <!-- Where the Meta key is on the keyboard. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_action_key_location">The Meta key is the Windows key, next to the left Alt key. On Apple keyboards, it\'s the Command key, next to the space bar.</string>
    <!-- Where the Ctrl and Alt keys, held together as the SandFly key, are on the keyboard. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_ctrl_alt_key_location">Hold Ctrl and Alt down together. Both are at the bottom left of the keyboard.</string>
    <!-- Where the Alt key is on the keyboard. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_alt_key_location">The Alt key is next to the space bar.</string>
    <!-- Where the Ctrl and Meta keys, held together as the SandFly key, are on the keyboard. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_ctrl_meta_key_location">Hold Ctrl and Meta down together. Both are at the bottom left of the keyboard.</string>
    <!-- Where the Insert key is on the keyboard. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_insert_key_location">On most keyboards, Insert is in the group of six keys above the arrow keys.</string>
    <!-- Where Numpad Insert is on the keyboard. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_numpad_insert_key_location">Numpad Insert is the 0 key of the number pad, with Num Lock off.</string>
    <!-- Instruction of the first lesson. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_welcome_start">Press <xliff:g id="keys" example="Meta + Space">%1$s</xliff:g> to start.</string>

    <!-- Introduction of the lesson about moving between items. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_move_intro">Next item and Previous item move through the items on the screen in reading order.</string>
    <!-- Instruction to move to the next item until a named item is reached. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_move_next">Press <xliff:g id="keys" example="Meta + Right arrow">%1$s</xliff:g> to move to the next item. Continue until you reach <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <!-- Instruction to move back to a named item. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_move_previous">Press <xliff:g id="keys" example="Meta + Left arrow">%1$s</xliff:g> to move to the previous item. Go back to <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>

    <!-- Introduction of the lesson about activating items. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_activate_intro">Activating works on the item that has focus.</string>
    <!-- Instruction to move to a button and activate it. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_activate_button">Move to <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. Press <xliff:g id="keys" example="Meta + Space">%1$s</xliff:g> to activate it.</string>
    <!-- Instruction to check a check box. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_activate_check_box">Check <xliff:g id="check_box" example="Extra cheese">%2$s</xliff:g> with <xliff:g id="keys" example="Meta + Space">%1$s</xliff:g>.</string>
    <!-- Instruction to hold a button. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_activate_hold">Some items do something else when held. Move to <xliff:g id="button" example="Details">%2$s</xliff:g>. Press <xliff:g id="keys" example="Meta + Shift + Space">%1$s</xliff:g> to hold it.</string>

    <!-- Introduction of the lesson about reading controls. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_reading_controls_intro">Reading controls choose what moving up and down does, such as moving by word or by character. Next item and Previous item still move between items.</string>
    <!-- Instruction to choose a reading control. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_choose_reading_control">Press <xliff:g id="keys" example="Meta + Shift + Right arrow">%1$s</xliff:g> or <xliff:g id="keys" example="Meta + Shift + Left arrow">%2$s</xliff:g> to change the reading control. Choose <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <!-- Instruction to move by word three times. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_next_word">Press <xliff:g id="keys" example="Meta + Down arrow">%1$s</xliff:g> to move to the next word. Move three words.</string>
    <!-- Instruction to change the reading control and move by one character. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_characters">Change the reading control to <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. Press <xliff:g id="keys" example="Meta + Down arrow">%1$s</xliff:g> to move by one character.</string>
    <!-- Instruction to jump to a heading with the Headings reading control. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_headings_jump">Press <xliff:g id="keys" example="Meta + Down arrow">%1$s</xliff:g> to jump to the next heading. Jump to <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>

    <!-- Introduction of the lesson about reading continuously. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_continuous_intro">SandFly can read from the focused item to the end of the screen. Ctrl stops reading.</string>
    <!-- Instruction to start reading from the focused item. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_continuous_read">Press <xliff:g id="keys" example="Meta + Ctrl + R">%1$s</xliff:g> to read from the focused item.</string>

    <!-- Introduction of the lesson about scrolling lists. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_scrolling_intro">Lists show only some of their items at a time. Moving past the last item shown scrolls the list.</string>
    <!-- Instruction to move through a list to a named item. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_scrolling_next">Press <xliff:g id="keys" example="Meta + Right arrow">%1$s</xliff:g> until you reach <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>

    <!-- Introduction of the lesson about actions. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_actions_intro">Some items have actions besides activating, such as Archive or Delete for a message. The actions menu lists them.</string>
    <!-- Instruction to perform an action from the actions menu. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_actions_archive">Move to the message. Press <xliff:g id="keys" example="Meta + Ctrl + A">%1$s</xliff:g> to open its actions. Choose <xliff:g id="action" example="Archive">%2$s</xliff:g>.</string>

    <!-- Introduction of the lesson about typing. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_typing_intro">Activating a text field lets you type in it.</string>
    <!-- Instruction to activate a text field. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_typing_open">Move to the <xliff:g id="field" example="Name">%2$s</xliff:g> field. Press <xliff:g id="keys" example="Meta + Space">%1$s</xliff:g> to start typing.</string>
    <!-- Instruction to delete the last letter typed. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_typing_delete">Delete the last letter with Backspace.</string>

    <!-- Introduction of the lesson about Android's own keyboard shortcuts. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_system_intro">Android has its own keyboard shortcuts with the Meta key. They work on every screen. In this lesson, the tutorial says what each one does instead of doing it.</string>
    <!-- Instruction to go back. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_system_back">Press <xliff:g id="keys" example="Meta + Esc">%1$s</xliff:g> to go back.</string>
    <!-- Instruction to go to the Home screen. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_system_home">Press <xliff:g id="keys" example="Meta + H">%1$s</xliff:g> to go to the Home screen.</string>
    <!-- Instruction to show recent apps. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_system_overview">Press <xliff:g id="keys" example="Meta + Tab">%1$s</xliff:g> to show recent apps. Alt + Tab switches between apps.</string>
    <!-- Instruction to open notifications. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_system_notifications">Press <xliff:g id="keys" example="Meta + N">%1$s</xliff:g> to open notifications.</string>

    <!-- Instruction to open the SandFly menu. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_menu_open">Press <xliff:g id="keys" example="Meta + Ctrl + M">%1$s</xliff:g> to open the SandFly menu. Move through its commands. Esc closes the menu.</string>
    <!-- Instruction to close the SandFly menu. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_menu_close">Press Esc to close the menu.</string>

    <!-- Title of the lesson about the list of keyboard shortcuts. [CHAR LIMIT=40] -->
    <string name="sandfly_keyboard_tutorial_shortcut_list_title">Keyboard shortcut list</string>
    <!-- Introduction of the lesson about the list of keyboard shortcuts. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_shortcut_list_intro">SandFly lists every keyboard shortcut with its command.</string>
    <!-- Instruction to open the list of keyboard shortcuts. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_shortcut_list_open">Press <xliff:g id="keys" example="Meta + Shift + /">%1$s</xliff:g> to open the list. Esc closes it.</string>
    <!-- Instruction to close the list of keyboard shortcuts. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_shortcut_list_close">Press Esc to close the list.</string>

    <!-- Instruction to copy the last spoken text. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_commands_copy">Press <xliff:g id="keys" example="Meta + Ctrl + C">%1$s</xliff:g> to copy the last text SandFly spoke to the clipboard.</string>
    <!-- Instruction to search the screen. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_commands_search">Press <xliff:g id="keys" example="Meta + Ctrl + /">%1$s</xliff:g> to search for text on the screen. In this lesson, the tutorial says what it does instead.</string>

    <!-- Title of the lesson about browse mode. [CHAR LIMIT=40] -->
    <string name="sandfly_keyboard_tutorial_browse_mode_title">Browse mode</string>
    <!-- Introduction of the lesson about browse mode. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_browse_mode_intro">In browse mode, single letters jump to the next item of a kind, such as H for headings, K for links and B for buttons. Shift with the letter jumps back. Browse mode turns off while you type in a text field.</string>
    <!-- Instruction to turn on browse mode. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_browse_mode_on">Press <xliff:g id="keys" example="Meta twice">%1$s</xliff:g> to turn on browse mode.</string>
    <!-- Instruction to jump to a heading in browse mode. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_browse_mode_heading">Press <xliff:g id="keys" example="H">%1$s</xliff:g> to jump to the next heading. Jump to <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
    <!-- Instruction to turn off browse mode. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_browse_mode_off">Press <xliff:g id="keys" example="Meta twice">%1$s</xliff:g> to turn off browse mode.</string>

    <!-- Title of the lesson where keys say what they do. [CHAR LIMIT=40] -->
    <string name="sandfly_keyboard_tutorial_practice_title">Keyboard practice</string>
    <!-- Introduction of keyboard practice. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_practice_intro">Each keyboard shortcut says its keys and command instead of running it. Next item, Previous item and activating still work.</string>
    <!-- Instruction of keyboard practice. [CHAR LIMIT=NONE] -->
    <string name="sandfly_keyboard_tutorial_practice_step">Press any keyboard shortcut to hear what it does. To stop, activate <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
</resources>
