<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the setting, and of its dialog, for the Gemini API key. [CHAR LIMIT=40] -->
    <string name="title_pref_gemini_api_key">Gemini API key</string>
    <!-- Summary of the Gemini API key setting when the user has not entered a key, but the app was built with one. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_gemini_api_key_built_in">Using the key built into this app</string>
    <!-- Message in the dialog where the user enters a Gemini API key. [CHAR LIMIT=NONE] -->
    <string name="gemini_api_key_dialog_message">Get a free API key from Google AI Studio, at aistudio.google.com/apikey, and paste it here. To remove your key, clear the field and save.\n\nImages and screens that you describe are sent to Google. On the free tier, Google can use them to improve its products.</string>
    <!-- Hint in the empty field for the Gemini API key. [CHAR LIMIT=30] -->
    <string name="gemini_api_key_hint">API key</string>
    <!-- Button that saves the Gemini API key. [CHAR LIMIT=20] -->
    <string name="gemini_api_key_save">Save</string>
    <!-- Button that opens Google AI Studio in the browser to get a Gemini API key. [CHAR LIMIT=20] -->
    <string name="gemini_api_key_get">Get a key</string>
    <!-- Title of the setting, and of its list, for the Gemini model that Describe image and Describe screen ask. [CHAR LIMIT=40] -->
    <string name="title_pref_gemini_model">Gemini model</string>
    <!-- The choice of the Gemini model setting that leaves it to SandFly. [CHAR LIMIT=40] -->
    <string name="gemini_model_automatic">Automatic</string>
    <!-- Summary of the Gemini model setting on Automatic. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_gemini_model_automatic">Automatic: Gemini Flash, then Flash-Lite when Flash is busy</string>
    <!-- Summary of the Gemini model setting when the user chose a model, such as gemini-3.6-flash. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_gemini_model_chosen"><xliff:g id="model" example="gemini-3.6-flash">%1$s</xliff:g>, then Flash-Lite when it is busy</string>
    <!-- Shown while SandFly gets the list of Gemini models from Google. [CHAR LIMIT=NONE] -->
    <string name="gemini_model_loading">Getting the models…</string>
    <!-- Shown when the list of Gemini models could not be got, with the reason. [CHAR LIMIT=NONE] -->
    <string name="gemini_model_list_failed">Could not get the models: <xliff:g id="reason" example="HTTP 403">%1$s</xliff:g></string>
    <!-- Shown when the Gemini model setting is opened without an API key. [CHAR LIMIT=NONE] -->
    <string name="gemini_model_needs_key">Set a Gemini API key first</string>
    <!-- Link text in the AI consent dialogs, to the terms that cover requests to the Gemini API. -->
    <string name="gemini_api_terms_link">Gemini API Additional Terms of Service</string>

    <!-- Hint of the field for the address of the AI service. [CHAR LIMIT=NONE] -->
    <string name="ai_service_address_hint">Address, such as https://openrouter.ai/api/v1</string>
    <!-- Hint of the field for the model the AI service runs. [CHAR LIMIT=NONE] -->
    <string name="ai_service_model_hint">Model</string>
    <!-- Shown when the address entered for the AI service is not an https address. [CHAR LIMIT=NONE] -->
    <string name="ai_service_address_invalid">The address must start with https://. Nothing was saved.</string>
    <!-- Message of the dialogs that ask before images or screenshots are sent to be described, when another AI service is set up. [CHAR LIMIT=NONE] -->
    <string name="dialog_message_ai_service_consent">Images and screenshots are sent to <xliff:g id="host" example="openrouter.ai">%1$s</xliff:g> to be described, which takes several seconds. Its own terms and privacy policy apply. Generative AI is experimental, so it will make mistakes.</string>
    <!-- Spoken when the other AI service rejects the API key. [CHAR LIMIT=NONE] -->
    <string name="ai_service_error_api_key">The AI service didn\'t accept the API key. Check its settings in Automatic descriptions.</string>
    <!-- Spoken when the usage limit of the other AI service is reached. [CHAR LIMIT=NONE] -->
    <string name="ai_service_error_quota">The usage limit of the AI service has been reached. Try again later.</string>
    <!-- Spoken when the other AI service is overloaded. [CHAR LIMIT=NONE] -->
    <string name="ai_service_error_busy">The AI service is busy right now. Try again in a moment.</string>
    <!-- Spoken when the other AI service does not answer in time. [CHAR LIMIT=NONE] -->
    <string name="ai_service_error_timeout">The AI service took too long to answer. Try again.</string>

    <!-- Names of the AI services that Describe image and Describe screen can use. [CHAR LIMIT=40] -->
    <string name="ai_provider_gemini">Gemini</string>
    <string name="ai_provider_claude">Claude</string>
    <string name="ai_provider_openai">OpenAI (ChatGPT)</string>
    <string name="ai_provider_mistral">Mistral</string>
    <string name="ai_provider_groq">Groq</string>
    <string name="ai_provider_openrouter">OpenRouter</string>
    <string name="ai_provider_ollama">Ollama Cloud</string>
    <!-- The choice of no AI service: images and screens are described on the phone, or only their text is read. [CHAR LIMIT=40] -->
    <string name="ai_provider_none">None</string>
    <!-- Switch in Gemini settings that makes Gemini the AI service in use. [CHAR LIMIT=50] -->
    <string name="ai_provider_use_gemini">Use Gemini</string>
    <!-- An AI service at an address the user enters. [CHAR LIMIT=40] -->
    <string name="ai_provider_other">Other service</string>
    <!-- Heading of the AI service settings in Automatic descriptions. [CHAR LIMIT=40] -->
    <string name="title_pref_category_ai_services">AI services</string>
    <!-- Setting: which AI service describes images and screens. [CHAR LIMIT=40] -->
    <string name="title_pref_ai_provider">AI service</string>
    <!-- Title of the settings screen of one AI service, such as "Claude settings". [CHAR LIMIT=50] -->
    <string name="title_ai_provider_settings"><xliff:g id="service" example="Claude">%1$s</xliff:g> settings</string>
    <!-- Summary of the AI service setting when the chosen one is not set up. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_chosen_not_ready"><xliff:g id="service" example="Claude">%1$s</xliff:g>, not set up</string>
    <!-- Summary of an AI service's settings entry when it is the one in use. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_in_use">In use</string>
    <!-- Summary of an AI service's settings entry when it has no model. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_not_set_up">Not set up</string>
    <!-- Switch on an AI service's settings screen that makes it the one in use. [CHAR LIMIT=50] -->
    <string name="ai_provider_use">Use <xliff:g id="service" example="Claude">%1$s</xliff:g></string>
    <!-- Summary of the Use switch while the service has no model, or no address. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_not_ready">Choose a model first</string>
    <!-- Setting: the address of the other AI service. [CHAR LIMIT=40] -->
    <string name="ai_provider_address">Address</string>
    <!-- Message of the dialog for the other AI service's address. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_address_message">The address of a service with an OpenAI-compatible chat API and image input, such as https://example.com/v1.</string>
    <!-- Summary of a setting that has no value. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_not_set">Not set</string>
    <!-- Summary of the API key setting when a key is saved. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_set">Set</string>
    <!-- Setting and dialog: an AI service's API key, such as "Claude API key". [CHAR LIMIT=50] -->
    <string name="title_pref_gemini_api_key_of"><xliff:g id="service" example="Claude">%1$s</xliff:g> API key</string>
    <!-- Setting and dialog: an AI service's model, such as "Claude model". [CHAR LIMIT=50] -->
    <string name="title_pref_gemini_model_of"><xliff:g id="service" example="Claude">%1$s</xliff:g> model</string>
    <!-- Summary of the model setting when no model is chosen. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_choose_model">Not chosen</string>
    <!-- Message of the dialog where the user enters an AI service's API key. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_key_message">Paste your <xliff:g id="service" example="Claude">%1$s</xliff:g> API key. To remove it, clear the field and save. Images and screens that you describe are sent to <xliff:g id="service" example="Claude">%1$s</xliff:g>.</string>
    <!-- Shown when the model setting is opened before the service's API key is set, such as "Set the Claude API key first". [CHAR LIMIT=NONE] -->
    <string name="ai_provider_needs_key">Set the <xliff:g id="service" example="Claude">%1$s</xliff:g> API key first</string>
    <!-- Shown when the other service's model setting is opened before its address is set. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_needs_address">Set the address first</string>
    <!-- Shown when the user chooses an AI service that is not set up yet, such as "Set up Claude in Claude settings first". [CHAR LIMIT=NONE] -->
    <string name="ai_provider_set_up_first">Set up <xliff:g id="service" example="Claude">%1$s</xliff:g> in <xliff:g id="service" example="Claude">%1$s</xliff:g> settings first</string>
    <!-- First item of a service's list of models, to type a model name instead. [CHAR LIMIT=NONE] -->
    <string name="ai_provider_enter_model">Enter a model name</string>
</resources>
