<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the notification and dialog that offer to install SandFly. [CHAR LIMIT=NONE] -->
    <string name="update_move_title">Backtalk Aaron is now SandFly</string>
    <!-- Text of the notification that offers to install SandFly. [CHAR LIMIT=NONE] -->
    <string name="update_move_notification_text">Install SandFly. Settings and custom labels are copied to it. Tap to install.</string>
    <!-- Message of the dialog that offers to install SandFly. [CHAR LIMIT=NONE] -->
    <string name="update_move_dialog_message">Backtalk Aaron is now a separate screen reader, SandFly, and gets no more updates. Install SandFly; settings and custom labels are copied to it. Then turn on SandFly, and Backtalk Aaron turns off.</string>
    <!-- Announced before the install prompt for SandFly. [CHAR LIMIT=NONE] -->
    <string name="update_move_installing">Installing SandFly. Settings and custom labels are copied to it.</string>
    <!-- Announced when the accessibility settings open after SandFly is installed. [CHAR LIMIT=NONE] -->
    <string name="update_move_turn_on">Turn on SandFly. Backtalk Aaron then turns off.</string>
    <!-- Shown when the downloaded update is not a build that can be installed. [CHAR LIMIT=NONE] -->
    <string name="update_wrong_package">The download is not a build of this app, so it was not installed</string>
    <!-- Title of the notification that SandFly shows once it took over from Backtalk Aaron. [CHAR LIMIT=NONE] -->
    <string name="migration_moved_title">Settings copied from Backtalk Aaron</string>
    <!-- Text of the notification that offers to uninstall Backtalk Aaron. [CHAR LIMIT=NONE] -->
    <string name="migration_moved_text">Tap to uninstall Backtalk Aaron.</string>
</resources>
