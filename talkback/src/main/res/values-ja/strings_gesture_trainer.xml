    <string name="gesture_trainer_finding_fingers_landed_apart">指が触れた時間差は <xliff:g id="ms">%1$d</xliff:g> ミリ秒で、許容されるのは <xliff:g id="limit">%2$d</xliff:g> ミリ秒までです。</string>
