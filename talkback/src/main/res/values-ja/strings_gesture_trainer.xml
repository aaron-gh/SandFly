    <string name="gesture_trainer_no_detection">ジェスチャー トレーナーには Android 13 以降が必要です。</string>
    <string name="gesture_trainer_left_out_swipes_before_lift">往復ジェスチャーと直角ジェスチャーは除外されています: <xliff:g id="setting">%1$s</xliff:g>がオンです。</string>
    <string name="gesture_trainer_left_out_two_finger_swipes">2 本の指のスワイプは除外されています: <xliff:g id="setting">%1$s</xliff:g>がオフのため、アプリがスクロールします。</string>
    <string name="gesture_trainer_exercise_heading">練習 <xliff:g id="number">%1$d</xliff:g>/<xliff:g id="count">%2$d</xliff:g>: <xliff:g id="gesture">%3$s</xliff:g></string>
