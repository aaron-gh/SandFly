    <string name="gesture_trainer_finding_paused">指が <xliff:g id="ms">%1$d</xliff:g> ミリ秒遅くなりました。1 cm あたり <xliff:g id="limit">%2$d</xliff:g> ミリ秒まで許容されます。</string>
