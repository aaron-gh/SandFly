    <string name="sandfly_tutorial_forecast_today">今日</string>
    <string name="sandfly_tutorial_forecast_today_text">晴れて暖かく、風は弱い。</string>
    <string name="sandfly_tutorial_forecast_tomorrow">明日</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">午前中は曇り、昼から雨。</string>
    <string name="sandfly_tutorial_forecast_weekend">週末</string>
    <string name="sandfly_tutorial_forecast_weekend_text">土曜日は風が強く、日曜日は晴れ。</string>
    <string name="sandfly_tutorial_headings_intro">画面やウェブページは、見出しでコンテンツを区切っています。[見出し] 読み上げコントロールは、見出しから次の見出しへ移動します。</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>して次の見出しに移動します。「<xliff:g id="heading" example="Weekend">%2$s</xliff:g>」に移動してください。</string>
    <string name="sandfly_tutorial_headings_title">見出し</string>
