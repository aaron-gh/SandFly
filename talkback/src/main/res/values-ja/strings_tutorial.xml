    <string name="sandfly_tutorial_tile_moon">月</string>
    <string name="sandfly_tutorial_tile_star">星</string>
    <string name="sandfly_tutorial_tile_sun">太陽</string>
    <string name="sandfly_tutorial_title">SandFly チュートリアル</string>
    <string name="sandfly_tutorial_typing_delete">キーボードの削除キーで最後の 1 文字を削除します。</string>
    <string name="sandfly_tutorial_typing_intro">テキスト フィールドを有効にするとキーボードが開きます。キーに触れると読み上げられ、指を離すと入力されます。</string>
    <string name="sandfly_tutorial_typing_open">「<xliff:g id="field" example="Name">%2$s</xliff:g>」フィールドに移動します。<xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>して入力を開始します。</string>
    <string name="sandfly_tutorial_typing_title">文字入力</string>
    <string name="sandfly_tutorial_typing_type">「<xliff:g id="word" example="cat">%1$s</xliff:g>」と入力します。</string>
    <string name="sandfly_tutorial_typing_word">ねこ</string>
    <string name="sandfly_tutorial_welcome_intro">このチュートリアルでは SandFly のジェスチャーを学びます。各レッスンでは指示が出され、自分のジェスチャーで実行すると次の指示に進みます。指示はレッスン名の次の項目です。[目次] にはすべてのレッスンがあり、チュートリアルは前回のレッスンから再開します。</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>して開始します。画面のどこで行ってもかまいません。</string>
    <string name="sandfly_tutorial_welcome_title">ようこそ</string>
