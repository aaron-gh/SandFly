<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">メッセージに移動します。<xliff:g id="gesture" example="Swipe up">%1$s</xliff:g>または<xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>で操作を順に移動します。<xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>で読み上げられた操作を実行します。「<xliff:g id="action" example="Archive">%4$s</xliff:g>」を実行してください。</string>
    <string name="sandfly_tutorial_actions_intro">項目によっては、有効化以外の操作があります。たとえばメッセージの「アーカイブ」や「削除」です。そのような項目にフォーカスがあるとき、[操作] 読み上げコントロールでそれらの操作を順に移動します。</string>
    <string name="sandfly_tutorial_actions_title">操作</string>
    <string name="sandfly_tutorial_activate_button">「<xliff:g id="button" example="Ring the bell">%2$s</xliff:g>」に移動します。<xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>して有効にします。</string>
    <string name="sandfly_tutorial_activate_check_box">同じ方法で「<xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>」をオンにします。</string>
    <string name="sandfly_tutorial_activate_hold">項目によっては、長押しすると別の動作をします。「<xliff:g id="button" example="Details">%2$s</xliff:g>」に移動します。<xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>して長押しします。</string>
    <string name="sandfly_tutorial_activate_intro">有効化はフォーカスのある項目に対して行われます。画面のどこをタップしてもかまいません。</string>
    <string name="sandfly_tutorial_activate_title">項目の有効化</string>
    <string name="sandfly_tutorial_back_in_lesson">[戻る] ではレッスンを終了しません。別のレッスンを選ぶには [目次] を使用します。</string>
    <string name="sandfly_tutorial_bell">ベルを鳴らす</string>
    <string name="sandfly_tutorial_bell_rung">鳴らした回数: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">明るさ</string>
    <string name="sandfly_tutorial_chapter_basics">基本</string>
    <string name="sandfly_tutorial_chapter_controls">コントロールとテキスト</string>
