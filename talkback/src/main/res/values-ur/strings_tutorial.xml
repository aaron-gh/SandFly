    <string name="sandfly_tutorial_practice_step">یہ سننے کیلئے کہ کوئی اشارہ کیا کرتا ہے، کوئی بھی اشارہ کریں۔ روکنے کیلئے «<xliff:g id="button" example="End practice">%1$s</xliff:g>» فعال کریں۔</string>
    <string name="sandfly_tutorial_practice_title">اشاروں کی مشق</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> از <xliff:g id="count" example="4">%2$d</xliff:g>۔</string>
