    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>، <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">پچھلے کیمرے کو اس چیز کی طرف کریں جس کی آپ وضاحت چاہتے ہیں۔ \"اشارہ کریں اور پڑھیں\" کے لیے کیمرے کی تصویر میں کسی متن کی طرف انگلی سے اشارہ کریں۔ وضاحتیں غلط ہو سکتی ہیں۔ محفوظ طریقے سے چلنے پھرنے کے لیے ان پر بھروسہ نہ کریں۔</string>
    <string name="live_recognition_camera_off">کیمرا آف ہے</string>
    <string name="live_recognition_camera_on">کیمرا آن ہے</string>
    <string name="live_recognition_connecting">Gemini سے منسلک ہو رہا ہے…</string>
    <string name="live_recognition_cloud_title">کیمرے کی تصاویر Gemini کو بھیجیں؟</string>
    <string name="live_recognition_cloud_message">مناظر، اشارہ کریں اور پڑھیں، لوگوں کا پتہ لگانا اور دروازوں کا پتہ لگانا ہر چند سیکنڈ میں کیمرے سے ایک تصویر Google کے Gemini API کو بھیجتے ہیں۔ متن اسی فون پر پہچانا جاتا ہے۔\n\nمفت API کلید کے ساتھ، Google جو کچھ موصول کرتا ہے اسے رکھ سکتا ہے، اسے اپنی پروڈکٹس بہتر بنانے کے لیے استعمال کر سکتا ہے اور لوگوں سے اس کا جائزہ لے سکتا ہے۔ جنریٹو AI تجرباتی ہے، اس لیے یہ غلطیاں کرے گا۔</string>
    <string name="live_recognition_service_title">کیمرے کی تصاویر <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> کو بھیجیں؟</string>
    <string name="live_recognition_service_message">مناظر، اشارہ کریں اور پڑھیں، لوگوں کا پتہ لگانا اور دروازوں کا پتہ لگانا ہر چند سیکنڈ میں کیمرے سے ایک تصویر <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> کو بھیجتے ہیں۔ متن اسی فون پر پہچانا جاتا ہے۔\n\nسروس کی اپنی شرائط اور رازداری کی پالیسی لاگو ہوتی ہیں۔ جنریٹو AI تجرباتی ہے، اس لیے یہ غلطیاں کرے گا۔</string>
