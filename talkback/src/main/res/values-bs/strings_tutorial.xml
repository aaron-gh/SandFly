    <string name="sandfly_tutorial_title">Vodič za SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Izbrišite posljednje slovo tipkom za brisanje na tastaturi.</string>
    <string name="sandfly_tutorial_typing_intro">Aktiviranje tekstnog polja otvara tastaturu. Dodirnite tipku da biste je čuli i podignite prst da biste je upisali.</string>
    <string name="sandfly_tutorial_typing_open">Prijeđite na polje <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> za početak pisanja.</string>
