    <string name="sandfly_tutorial_actions_archive">Prijeđite na poruku. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ili <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> za prolazak kroz njezine radnje. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> za izvršavanje radnje koju čujete. Izvršite radnju <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Neke stavke osim aktiviranja imaju i druge radnje, na primjer Arhiviraj ili Izbriši kod poruke. Dok je takva stavka u fokusu, kontrola za čitanje Radnje prolazi kroz njih.</string>
    <string name="sandfly_tutorial_actions_title">Radnje</string>
    <string name="sandfly_tutorial_activate_button">Prijeđite na stavku <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> za aktiviranje.</string>
    <string name="sandfly_tutorial_activate_check_box">Na isti način označite <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_hold">Neke stavke rade nešto drugo kad se zadrže. Prijeđite na stavku <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> za zadržavanje.</string>
    <string name="sandfly_tutorial_activate_intro">Aktiviranje djeluje na fokusiranu stavku, gdje god dodirnete ekran.</string>
    <string name="sandfly_tutorial_activate_title">Aktiviranje stavki</string>
    <string name="sandfly_tutorial_back_in_lesson">Natrag ne napušta lekciju. Drugu lekciju odaberite dugmetom Sadržaj.</string>
