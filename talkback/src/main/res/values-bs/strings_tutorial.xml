    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> ili <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> za promjenu kontrole za čitanje. Odaberite <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
