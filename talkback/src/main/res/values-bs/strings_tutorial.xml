    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> za prelazak na sljedeću stavku. Nastavite dok ne dođete do stavke <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> za prelazak na prethodnu stavku. Vratite se na stavku <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
