    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> za odlazak na početni ekran.</string>
    <string name="sandfly_tutorial_system_intro">Ovi pokreti rade na svakom ekranu. U ovoj lekciji vodič umjesto izvršavanja kaže šta svaki od njih radi.</string>
