    <string name="sandfly_tutorial_pause_intro">Govor se može pauzirati usred stavke i nastaviti ondje gdje je stao.</string>
    <string name="sandfly_tutorial_pause_pause">Prijeđite na priču ispod. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> dok se čita za pauziranje govora, ponovo za nastavak.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> ponovo za nastavak govora.</string>
    <string name="sandfly_tutorial_pause_title">Pauziranje govora</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Svaki pokret umjesto izvršavanja izgovara svoj naziv i radnju. Prelazak na sljedeću i prethodnu stavku te aktiviranje i dalje rade.</string>
    <string name="sandfly_tutorial_practice_step">Napravite bilo koji pokret da biste čuli šta radi. Za završetak aktivirajte <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Vježba pokreta</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> od <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Promijenite kontrolu za čitanje u <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> za pomak za jedan znak.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Kontrole za čitanje određuju šta radi prevlačenje gore i dolje, na primjer pomak po riječima ili po znakovima ili promjenu brzine govora. Prevlačenje udesno i ulijevo i dalje pomiče između stavki.</string>
    <string name="sandfly_tutorial_reading_controls_move">Prijeđite na rečenicu ispod.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> za pomak na sljedeću riječ. Pomaknite se za tri riječi.</string>
    <string name="sandfly_tutorial_reading_controls_title">Kontrole za čitanje</string>
    <string name="sandfly_tutorial_recipe_1">Palačinke: umiješajte brašno, jaja i mlijeko u glatko tijesto.</string>
    <string name="sandfly_tutorial_recipe_2">Zagrijte malo maslaca u tavi.</string>
    <string name="sandfly_tutorial_recipe_3">Ulijte toliko tijesta da tanko prekrije tavu.</string>
    <string name="sandfly_tutorial_recipe_4">Okrenite palačinku kad donja strana postane zlatna.</string>
    <string name="sandfly_tutorial_recipe_5">Poslužite s limunom i šećerom.</string>
    <string name="sandfly_tutorial_scrolling_intro">Liste odjednom prikazuju samo neke stavke. Prevlačenje preko posljednje prikazane stavke pomiče listu.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> za klizanje za jednu stranicu naprijed.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> za prolazak kroz listu dok ne dođete do stavke <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Klizanje kroz liste</string>
    <string name="sandfly_tutorial_sentence">Brza smeđa lisica preskače lijenog psa.</string>
    <string name="sandfly_tutorial_skip_step">Preskoči korak</string>
    <string name="sandfly_tutorial_sliders_change">Prijeđite na klizač <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ili <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> za promjenu njegove vrijednosti.</string>
    <string name="sandfly_tutorial_sliders_highest">Postavite klizač <xliff:g id="slider" example="Brightness">%1$s</xliff:g> na 100 posto, najvišu vrijednost.</string>
    <string name="sandfly_tutorial_sliders_intro">Kad je klizač u fokusu, prevlačenje gore i dolje mijenja njegovu vrijednost.</string>
    <string name="sandfly_tutorial_sliders_title">Klizači</string>
    <string name="sandfly_tutorial_step">Korak <xliff:g id="number" example="1">%1$d</xliff:g> od <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Pješčane mušice male su muhe koje žive na plažama, uz obale rijeka i u šumama. Najaktivnije su u zoru i sumrak, kad je zrak miran. Bodu samo ženke jer im je krv potrebna za stvaranje jaja. Ubodi svrbe danima, pa ljudi koji posjećuju krajeve s pješčanim mušicama nose sredstvo protiv insekata. Pješčane mušice slabo lete i već ih lagani povjetarac drži podalje.</string>
