    <string name="sandfly_tutorial_commands_intro">Ove komande rade na svakom ekranu.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> za pretraživanje teksta na ekranu. U ovoj lekciji vodič umjesto toga kaže šta pokret radi.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> za isključivanje govora, ponovo za uključivanje. U ovoj lekciji vodič umjesto toga kaže šta pokret radi.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> za izgovaranje vremena, razine baterije i drugih podataka o stanju.</string>
