    <string name="sandfly_tutorial_typing_word">mak</string>
    <string name="sandfly_tutorial_welcome_intro">Ovaj vodič uči pokrete SandFlya. Svaka lekcija daje uputu, čeka dok je ne izvršite vlastitim pokretima, a zatim daje sljedeću. Uputa je prva stavka nakon naziva lekcije. Sadržaj navodi sve lekcije, a vodič se ponovo otvara na lekciji na kojoj ste stali.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> bilo gdje na ekranu za početak.</string>
