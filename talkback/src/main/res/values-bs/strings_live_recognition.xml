    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">Usmjerite zadnju kameru prema onome što želite da bude opisano. Za Pokaži i pročitaj prstom pokažite tekst na slici kamere. Opisi mogu biti pogrešni. Nemojte se oslanjati na njih za sigurno kretanje.</string>
    <string name="live_recognition_camera_off">Kamera je isključena</string>
    <string name="live_recognition_camera_on">Kamera je uključena</string>
    <string name="live_recognition_connecting">Povezivanje s Geminijem…</string>
    <string name="live_recognition_cloud_title">Slati slike s kamere Geminiju?</string>
    <string name="live_recognition_cloud_message">Scene, Pokaži i pročitaj, Otkrivanje osoba i Otkrivanje vrata svakih nekoliko sekundi šalju sliku s kamere Googleovom Gemini API-ju. Tekst se prepoznaje na ovom telefonu.\n\nS besplatnim API ključem Google može zadržati ono što primi, koristiti to za poboljšanje svojih proizvoda i dati to ljudima na pregled. Generativna umjetna inteligencija je eksperimentalna, pa će griješiti.</string>
    <string name="live_recognition_service_title">Slati slike s kamere na <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">Scene, Pokaži i pročitaj, Otkrivanje osoba i Otkrivanje vrata svakih nekoliko sekundi šalju sliku s kamere na <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>. Tekst se prepoznaje na ovom telefonu.\n\nPrimjenjuju se uslovi i pravila privatnosti te usluge. Generativna umjetna inteligencija je eksperimentalna, pa će griješiti.</string>
