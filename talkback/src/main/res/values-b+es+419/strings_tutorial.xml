    <string name="sandfly_tutorial_menu_intro">El menú de SandFly tiene comandos para el elemento enfocado y la pantalla actual.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir el menú de SandFly. Desliza para recorrer sus comandos. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> cierra el menú.</string>
