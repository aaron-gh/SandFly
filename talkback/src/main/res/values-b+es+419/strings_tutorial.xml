    <string name="sandfly_tutorial_move_intro">Al deslizar se pasa al elemento siguiente o anterior de la pantalla, en orden de lectura.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> para ir al siguiente elemento. Sigue hasta llegar a <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> para ir al elemento anterior. Vuelve a <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Moverse entre elementos</string>
    <string name="sandfly_tutorial_name">Nombre</string>
    <string name="sandfly_tutorial_next_lesson">Siguiente lección: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> no tiene gesto. Asigna uno en Comandos o usa Saltar paso.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> no se realiza en una lección. Para salir del instructivo, usa Cerrar instructivo en Contenido.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> no se realiza en una lección.</string>
    <string name="sandfly_tutorial_pause_intro">La voz se puede pausar en mitad de un elemento y reanudar donde se detuvo.</string>
    <string name="sandfly_tutorial_pause_pause">Ve a la historia de abajo. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> mientras se lee para pausar la voz, y otra vez para reanudarla.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> otra vez para reanudar la voz.</string>
    <string name="sandfly_tutorial_pause_title">Pausar la voz</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Cada gesto dice su nombre y su acción en lugar de realizarla. Ir al elemento siguiente y anterior y activar siguen funcionando.</string>
    <string name="sandfly_tutorial_practice_step">Haz cualquier gesto para oír lo que hace. Para terminar, activa <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Práctica de gestos</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> de <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Cambia el control de lectura a <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para avanzar un carácter.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Los controles de lectura eligen lo que hace deslizar hacia arriba y hacia abajo, como moverse por palabras o por caracteres, o cambiar la velocidad de habla. Deslizar hacia la derecha y hacia la izquierda sigue moviéndose entre elementos.</string>
    <string name="sandfly_tutorial_reading_controls_move">Ve a la frase de abajo.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para ir a la siguiente palabra. Avanza tres palabras.</string>
    <string name="sandfly_tutorial_reading_controls_title">Controles de lectura</string>
    <string name="sandfly_tutorial_recipe_1">Panqueques: mezcla harina, huevos y leche hasta obtener una masa suave.</string>
    <string name="sandfly_tutorial_recipe_2">Calienta un poco de mantequilla en una sartén.</string>
    <string name="sandfly_tutorial_recipe_3">Vierte masa suficiente para cubrir la sartén con una capa fina.</string>
    <string name="sandfly_tutorial_recipe_4">Da vuelta el panqueque cuando la parte de abajo esté dorada.</string>
    <string name="sandfly_tutorial_recipe_5">Sírvela con limón y azúcar.</string>
    <string name="sandfly_tutorial_scrolling_intro">Las listas solo muestran algunos de sus elementos a la vez. Al deslizar más allá del último elemento visible, la lista se desplaza.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> para avanzar una página.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> por la lista hasta llegar a <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Desplazarse por listas</string>
    <string name="sandfly_tutorial_sentence">El veloz murciélago hindú comía feliz cardillo y kiwi.</string>
    <string name="sandfly_tutorial_skip_step">Saltar paso</string>
    <string name="sandfly_tutorial_sliders_change">Ve al control deslizante <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> o <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para cambiar su valor.</string>
    <string name="sandfly_tutorial_sliders_highest">Ajusta <xliff:g id="slider" example="Brightness">%1$s</xliff:g> al 100 por ciento, su valor más alto.</string>
    <string name="sandfly_tutorial_sliders_intro">Cuando un control deslizante tiene el foco, deslizar hacia arriba y hacia abajo cambia su valor.</string>
    <string name="sandfly_tutorial_sliders_title">Controles deslizantes</string>
    <string name="sandfly_tutorial_step">Paso <xliff:g id="number" example="1">%1$d</xliff:g> de <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Los flebótomos son pequeñas moscas que viven en playas, orillas de ríos y bosques. Son más activos al amanecer y al anochecer, cuando no hay viento. Solo pican las hembras, porque necesitan sangre para producir sus huevos. Las picaduras pican durante días, así que quienes visitan las zonas donde viven llevan repelente de insectos. Los flebótomos vuelan mal, e incluso una brisa ligera los mantiene alejados.</string>
