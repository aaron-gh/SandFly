    <string name="sandfly_tutorial_commands_intro">Estos comandos funcionan en todas las pantallas.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> para buscar texto en la pantalla. En esta lección, el instructivo dice lo que hace en lugar de hacerlo.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> para desactivar la voz, y otra vez para activarla. En esta lección, el instructivo dice lo que hace en lugar de hacerlo.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> para oír la hora, el nivel de batería y otros datos de estado.</string>
