    <string name="sandfly_tutorial_actions_archive">Ve al mensaje. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> o <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para recorrer sus acciones. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> para realizar la acción que oyes. Realiza <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Algunos elementos tienen acciones además de activarse, como Archivar o Borrar en un mensaje. Cuando uno de estos elementos tiene el foco, el control de lectura Acciones las recorre.</string>
    <string name="sandfly_tutorial_actions_title">Acciones</string>
    <string name="sandfly_tutorial_activate_button">Ve a <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para activarlo.</string>
    <string name="sandfly_tutorial_activate_check_box">Marca <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> de la misma forma.</string>
    <string name="sandfly_tutorial_activate_hold">Algunos elementos hacen otra cosa si se mantienen presionados. Ve a <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> para mantenerlo presionado.</string>
    <string name="sandfly_tutorial_activate_intro">La activación actúa sobre el elemento enfocado, toques donde toques la pantalla.</string>
    <string name="sandfly_tutorial_activate_title">Activar elementos</string>
    <string name="sandfly_tutorial_back_in_lesson">Atrás no sale de una lección. Para elegir otra lección, usa Contenido.</string>
