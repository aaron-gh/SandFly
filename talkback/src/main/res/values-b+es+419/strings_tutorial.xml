    <string name="sandfly_tutorial_contents_intro">Lecciones, en orden. Cada una se puede abrir por separado.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly puede leer desde el elemento enfocado hasta el final de la pantalla sin deslizar. Al tocar la pantalla se detiene la lectura.</string>
    <string name="sandfly_tutorial_continuous_move">Ve a la primera línea de la receta.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> para leer desde el elemento enfocado.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir el menú de SandFly y, después, elige <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
