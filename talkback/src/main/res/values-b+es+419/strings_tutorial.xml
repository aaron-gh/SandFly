    <string name="sandfly_tutorial_typing_delete">Borra la última letra con la tecla Borrar del teclado.</string>
    <string name="sandfly_tutorial_typing_intro">Al activar un campo de texto se abre el teclado. Toca una tecla para oírla y levanta el dedo para escribirla.</string>
    <string name="sandfly_tutorial_typing_open">Ve al campo <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para empezar a escribir.</string>
    <string name="sandfly_tutorial_typing_title">Escritura</string>
    <string name="sandfly_tutorial_typing_type">Escribe la palabra <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">gato</string>
    <string name="sandfly_tutorial_welcome_intro">Este instructivo enseña los gestos de SandFly. Cada lección da una instrucción, espera a que la hayas hecho con tus propios gestos y luego da la siguiente. La instrucción es el primer elemento después del nombre de la lección. Contenido muestra todas las lecciones, y el instructivo se vuelve a abrir en la lección en la que estabas.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> en cualquier parte de la pantalla para empezar.</string>
    <string name="sandfly_tutorial_welcome_title">Bienvenida</string>
</resources>
