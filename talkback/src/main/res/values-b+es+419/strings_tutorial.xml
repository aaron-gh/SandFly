    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> para ir a la pantalla de inicio.</string>
    <string name="sandfly_tutorial_system_intro">Estos gestos funcionan en todas las pantallas. En esta lección, el instructivo dice lo que hace cada uno en lugar de hacerlo.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> para abrir las notificaciones.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> para mostrar las apps recientes.</string>
    <string name="sandfly_tutorial_system_title">Atrás, Inicio y notificaciones</string>
