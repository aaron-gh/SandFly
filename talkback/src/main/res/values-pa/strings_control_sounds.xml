<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">ਆਵਾਜ਼ਾਂ ਅਤੇ ਵਾਈਬ੍ਰੇਸ਼ਨਾਂ ਨੂੰ ਕੰਟਰੋਲ ਕਰੋ</string>
    <string name="summary_pref_control_sounds">ਫੋਕਸ ਧੁਨੀ ਅਤੇ ਵਾਈਬ੍ਰੇਸ਼ਨ ਦੀ ਥਾਂ \'ਤੇ ਹਰ ਕਿਸਮ ਦਾ ਨਿਯੰਤਰਣ ਦਿਓ, ਜਿਵੇਂ ਕਿ ਬਟਨ, ਚੈਕਬਾਕਸ, ਸੰਪਾਦਿਤ ਖੇਤਰ ਅਤੇ ਸੂਚੀ ਆਈਟਮਾਂ, ਇਸਦੀ ਆਪਣੀ ਧੁਨੀ ਅਤੇ ਥੀਮ ਤੋਂ ਆਪਣੀ ਖੁਦ ਦੀ ਵਾਈਬ੍ਰੇਸ਼ਨ, ਜਿਵੇਂ ਕਿ ਅਨਸਪੋਕਨ NVDA ਲਈ ਕਰਦਾ ਹੈ। ਧੁਨੀ ਉਸ ਥਾਂ ਤੋਂ ਆਉਂਦੀ ਹੈ ਜਿੱਥੋਂ ਸਕ੍ਰੀਨ \'ਤੇ ਕੰਟਰੋਲ ਹੁੰਦਾ ਹੈ, ਅਤੇ SandFly ਇਹ ਕਹਿੰਦੇ ਹੋਏ ਨਿਕਲ ਜਾਂਦਾ ਹੈ ਕਿ ਇਹ ਕਿਸ ਤਰ੍ਹਾਂ ਦਾ ਕੰਟਰੋਲ ਹੈ।</string>
    <string name="title_pref_control_sounds_speak_roles">ਫਿਰ ਵੀ ਕੰਟਰੋਲ ਦੀ ਕਿਸਮ ਕਹੋ</string>
    <string name="summary_pref_control_sounds_speak_roles">ਜਦੋਂ ਕੋਈ ਨਿਯੰਤਰਣ ਧੁਨੀ ਚਲਦੀ ਹੈ, ਤਾਂ ਵੀ ਦੱਸੋ ਕਿ ਇਹ ਕਿਸ ਤਰ੍ਹਾਂ ਦਾ ਨਿਯੰਤਰਣ ਹੈ, ਜਿਵੇਂ ਕਿ ਬਟਨ। ਇਹ ਹਰ ਸਾਊਂਡ ਥੀਮ ਲਈ ਹੈ।</string>
