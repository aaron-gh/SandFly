<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">सन्देशमा जानुहोस्। यसका कारबाहीहरू हेर्न: <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> वा <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>। सुनिएको कारबाही गर्न: <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>। <xliff:g id="action" example="Archive">%4$s</xliff:g> गर्नुहोस्।</string>
    <string name="sandfly_tutorial_actions_intro">केही वस्तुमा सक्रिय पार्नेबाहेक अन्य कारबाहीहरू पनि हुन्छन्, जस्तै सन्देशका लागि संग्रह गर्ने वा मेटाउने। त्यस्तो वस्तुमा फोकस हुँदा “कारबाहीहरू” रिडिङ कन्ट्रोलले ती कारबाहीहरूमा क्रमैसँग लैजान्छ।</string>
    <string name="sandfly_tutorial_actions_title">कारबाहीहरू</string>
    <string name="sandfly_tutorial_activate_button"><xliff:g id="button" example="Ring the bell">%2$s</xliff:g> मा जानुहोस्। यसलाई सक्रिय पार्न: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_activate_check_box"><xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> लाई पनि उसैगरी चेक गर्नुहोस्।</string>
    <string name="sandfly_tutorial_activate_hold">केही वस्तुले थिचिराख्दा अर्कै काम गर्छन्। <xliff:g id="button" example="Details">%2$s</xliff:g> मा जानुहोस्। यसलाई थिचिराख्न: <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_activate_intro">तपाईंले स्क्रिनको जहाँसुकै ट्याप गरे पनि सक्रिय पार्ने काम फोकस भएको वस्तुमा हुन्छ।</string>
    <string name="sandfly_tutorial_activate_title">वस्तुहरू सक्रिय पार्ने</string>
    <string name="sandfly_tutorial_back_in_lesson">पछाडि जाने जेस्चरले पाठ छोड्दैन। अर्को पाठ छान्न “विषयसूची” प्रयोग गर्नुहोस्।</string>
    <string name="sandfly_tutorial_bell">घण्टी बजाउनुहोस्</string>
    <string name="sandfly_tutorial_bell_rung">बजाइएको पटक: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">चमक</string>
    <string name="sandfly_tutorial_chapter_basics">आधारभूत कुरा</string>
    <string name="sandfly_tutorial_chapter_controls">नियन्त्रण र पाठ</string>
    <string name="sandfly_tutorial_chapter_getting_around">यताउता जाने</string>
    <string name="sandfly_tutorial_chapter_practice">अभ्यास</string>
    <string name="sandfly_tutorial_chapter_reading">पढ्ने</string>
    <string name="sandfly_tutorial_choose_reading_control">रिडिङ कन्ट्रोल बदल्न: <xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> वा <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>। <xliff:g id="reading_control" example="Words">%3$s</xliff:g> छान्नुहोस्।</string>
    <string name="sandfly_tutorial_close">ट्यूटोरियल बन्द गर्नुहोस्</string>
    <string name="sandfly_tutorial_commands_copy">SandFly ले पछिल्लो पटक बोलेको पाठ क्लिपबोर्डमा कपी गर्न: <xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_commands_intro">यी आदेशहरू हरेक स्क्रिनमा काम गर्छन्।</string>
    <string name="sandfly_tutorial_commands_search">स्क्रिनमा पाठ खोज्न: <xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>। यस पाठमा ट्यूटोरियलले त्यसको सट्टा यसले के गर्छ भनेर बताउँछ।</string>
    <string name="sandfly_tutorial_commands_speech_off">स्पिच अफ गर्न: <xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>, र फेरि अन गर्न फेरि त्यही। यस पाठमा ट्यूटोरियलले त्यसको सट्टा यसले के गर्छ भनेर बताउँछ।</string>
    <string name="sandfly_tutorial_commands_status">समय, ब्याट्रीको स्तर र अन्य स्थिति सुन्न: <xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_commands_title">उपयोगी आदेशहरू</string>
    <string name="sandfly_tutorial_contents">विषयसूची</string>
    <string name="sandfly_tutorial_contents_intro">पाठहरू, क्रमैसँग। प्रत्येक पाठ छुट्टै खोल्न सकिन्छ।</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly ले स्वाइप नगरिकनै फोकस भएको वस्तुदेखि स्क्रिनको अन्त्यसम्म पढ्न सक्छ। स्क्रिन छुँदा पढ्न रोकिन्छ।</string>
    <string name="sandfly_tutorial_continuous_move">विधिको पहिलो पङ्क्तिमा जानुहोस्।</string>
    <string name="sandfly_tutorial_continuous_read">फोकस भएको वस्तुबाट पढ्न: <xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_continuous_read_from_menu">SandFly मेनु खोल्न: <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>, अनि <xliff:g id="command" example="Read from focused item">%2$s</xliff:g> छान्नुहोस्।</string>
    <string name="sandfly_tutorial_continuous_title">लगातार पढ्ने</string>
    <string name="sandfly_tutorial_details">विवरण</string>
    <string name="sandfly_tutorial_details_shown">२ जनाका लागि टेबल, बेलुका ७ बजे, झ्यालको छेउमा।</string>
    <string name="sandfly_tutorial_done">पूरा भयो</string>
    <string name="sandfly_tutorial_end_practice">अभ्यास अन्त्य गर्नुहोस्</string>
    <string name="sandfly_tutorial_explore_activate">तारा छोएर औँला उठाउनुहोस्। यसलाई सक्रिय पार्न जहाँसुकै: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_explore_find">एउटा औँला स्क्रिनमा यताउता सारेर चारवटा वर्ग फेला पार्नुहोस्: सूर्य, चन्द्रमा, तारा र बादल।</string>
    <string name="sandfly_tutorial_explore_intro">स्क्रिन छुँदा औँलामुनिको वस्तु बोलिन्छ। वस्तु छुँदा त्यो सक्रिय हुँदैन।</string>
    <string name="sandfly_tutorial_explore_title">छोएर अन्वेषण</string>
    <string name="sandfly_tutorial_extra_cheese">थप चिज</string>
    <string name="sandfly_tutorial_finish">ट्यूटोरियल समाप्त गर्नुहोस्</string>
    <string name="sandfly_tutorial_forecast_today">आज</string>
    <string name="sandfly_tutorial_forecast_today_text">घमाइलो र न्यानो, हल्का हावासहित।</string>
    <string name="sandfly_tutorial_forecast_tomorrow">भोलि</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">बिहान बादल, मध्यान्हदेखि वर्षा।</string>
    <string name="sandfly_tutorial_forecast_weekend">सप्ताहान्त</string>
    <string name="sandfly_tutorial_forecast_weekend_text">शनिबार हावाहुरी, आइतबार खुला आकाश।</string>
    <string name="sandfly_tutorial_headings_intro">स्क्रिन र वेब पेजहरूले आफ्नो सामग्री शीर्षकहरूले छुट्याउँछन्। “शीर्षकहरू” रिडिङ कन्ट्रोलले एउटा शीर्षकबाट अर्कोमा पुर्‍याउँछ।</string>
    <string name="sandfly_tutorial_headings_jump">अर्को शीर्षकमा जान: <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>। <xliff:g id="heading" example="Weekend">%2$s</xliff:g> मा जानुहोस्।</string>
    <string name="sandfly_tutorial_headings_title">शीर्षकहरू</string>
    <string name="sandfly_tutorial_item_apples">स्याउ</string>
    <string name="sandfly_tutorial_item_bread">पाउरोटी</string>
    <string name="sandfly_tutorial_item_cheese">चिज</string>
    <string name="sandfly_tutorial_item_dates">खजुर</string>
    <string name="sandfly_tutorial_item_eggs">अण्डा</string>
    <string name="sandfly_tutorial_lesson_complete">पाठ पूरा भयो।</string>
    <string name="sandfly_tutorial_lesson_complete_last">पाठ पूरा भयो। ट्यूटोरियल समाप्त गर्न: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_lesson_complete_next">पाठ पूरा भयो। अर्को पाठ सुरु गर्न: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, पाठ <xliff:g id="number" example="3">%2$d</xliff:g> / <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">वस्तु <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close">मेनु बन्द गर्न: <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_menu_intro">SandFly मेनुमा फोकस भएको वस्तु र हालको स्क्रिनका लागि आदेशहरू हुन्छन्।</string>
    <string name="sandfly_tutorial_menu_open">SandFly मेनु खोल्न: <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>। यसका आदेशहरूमा स्वाइप गर्नुहोस्। मेनु बन्द गर्न: <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g>।</string>
    <string name="sandfly_tutorial_menu_title">SandFly मेनु</string>
    <string name="sandfly_tutorial_message">सामको सन्देश: दिउँसो १२ बजे खाना खाने?</string>
    <string name="sandfly_tutorial_message_archive">संग्रह गर्नुहोस्</string>
    <string name="sandfly_tutorial_message_delete">मेटाउनुहोस्</string>
    <string name="sandfly_tutorial_message_reply">जवाफ</string>
    <string name="sandfly_tutorial_move_intro">स्वाइप गर्दा स्क्रिनको अर्को वा अघिल्लो वस्तुमा, पढ्ने क्रममा, पुगिन्छ।</string>
    <string name="sandfly_tutorial_move_next">अर्को वस्तुमा जान: <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>। <xliff:g id="item" example="Eggs">%2$s</xliff:g> सम्म नपुगुन्जेल जारी राख्नुहोस्।</string>
    <string name="sandfly_tutorial_move_previous">अघिल्लो वस्तुमा जान: <xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>। <xliff:g id="item" example="Bread">%2$s</xliff:g> मा फर्कनुहोस्।</string>
    <string name="sandfly_tutorial_move_title">वस्तुहरूबीच सर्ने</string>
    <string name="sandfly_tutorial_name">नाम</string>
    <string name="sandfly_tutorial_next_lesson">अर्को पाठ: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> को कुनै जेस्चर छैन। “आदेशहरू” मा एउटा तोक्नुहोस्, वा “चरण छोड्नुहोस्” प्रयोग गर्नुहोस्।</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> पाठभित्र गरिँदैन। ट्यूटोरियल छोड्न “विषयसूची” मा “ट्यूटोरियल बन्द गर्नुहोस्” प्रयोग गर्नुहोस्।</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> पाठभित्र गरिँदैन।</string>
    <string name="sandfly_tutorial_pause_intro">स्पिच कुनै वस्तुको बीचमा पज गर्न र रोकिएकै ठाउँबाट पुनः सुरु गर्न सकिन्छ।</string>
    <string name="sandfly_tutorial_pause_pause">तलको कथामा जानुहोस्। यो पढिँदै गर्दा स्पिच पज गर्न: <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>, र पुनः सुरु गर्न फेरि त्यही।</string>
    <string name="sandfly_tutorial_pause_resume">स्पिच पुनः सुरु गर्न फेरि: <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_pause_title">स्पिच पज गर्ने</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">प्रत्येक जेस्चरले आफ्नो काम गर्नुको सट्टा आफ्नो नाम र कार्य बताउँछ। अर्को र अघिल्लो वस्तुमा जाने र सक्रिय पार्ने काम अझै चल्छन्।</string>
    <string name="sandfly_tutorial_practice_step">कुनै पनि जेस्चर गरेर त्यसले के गर्छ सुन्नुहोस्। रोक्न <xliff:g id="button" example="End practice">%1$s</xliff:g> सक्रिय पार्नुहोस्।</string>
    <string name="sandfly_tutorial_practice_title">जेस्चर अभ्यास</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> / <xliff:g id="count" example="4">%2$d</xliff:g>।</string>
    <string name="sandfly_tutorial_reading_controls_characters">रिडिङ कन्ट्रोल <xliff:g id="reading_control" example="Characters">%2$s</xliff:g> मा बदल्नुहोस्। एक वर्ण सार्न: <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_reading_controls_intro">रिडिङ कन्ट्रोलहरूले माथि र तल स्वाइप गर्दा के हुन्छ भनेर छान्छन्, जस्तै शब्द वा वर्णअनुसार सर्ने, वा बोल्ने गति बदल्ने। दायाँ र बायाँ स्वाइप गर्दा अझै वस्तुहरूबीच सरिन्छ।</string>
    <string name="sandfly_tutorial_reading_controls_move">तलको वाक्यमा जानुहोस्।</string>
    <string name="sandfly_tutorial_reading_controls_next_word">अर्को शब्दमा जान: <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>। तीन शब्द सार्नुहोस्।</string>
    <string name="sandfly_tutorial_reading_controls_title">रिडिङ कन्ट्रोलहरू</string>
    <string name="sandfly_tutorial_recipe_1">प्यानकेक: पीठो, अण्डा र दूध मिसाएर चिल्लो घोल बनाउनुहोस्।</string>
    <string name="sandfly_tutorial_recipe_2">फ्राइङ प्यानमा अलिकति मक्खन तताउनुहोस्।</string>
    <string name="sandfly_tutorial_recipe_3">प्यान पातलो गरी ढाक्ने जति घोल खन्याउनुहोस्।</string>
    <string name="sandfly_tutorial_recipe_4">तलपट्टि सुनौलो भएपछि प्यानकेक पल्टाउनुहोस्।</string>
    <string name="sandfly_tutorial_recipe_5">कागती र चिनीसँग पस्कनुहोस्।</string>
    <string name="sandfly_tutorial_scrolling_intro">सूचीहरूले एकपटकमा आफ्ना केही वस्तु मात्र देखाउँछन्। देखिएको अन्तिम वस्तुभन्दा पर स्वाइप गर्दा सूची स्क्रोल हुन्छ।</string>
    <string name="sandfly_tutorial_scrolling_page">एक पृष्ठ अगाडि स्क्रोल गर्न: <xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="item" example="Item 15">%2$s</xliff:g> मा नपुगुन्जेल सूचीमा: <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_scrolling_title">सूचीहरू स्क्रोल गर्ने</string>
    <string name="sandfly_tutorial_sentence">चञ्चल खैरो स्याल अल्छी कुकुरमाथि उफ्रन्छ।</string>
    <string name="sandfly_tutorial_skip_step">चरण छोड्नुहोस्</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> स्लाइडरमा जानुहोस्। यसको मान बदल्न: <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> वा <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>।</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> लाई यसको सबैभन्दा उच्च मान, १०० प्रतिशतमा सेट गर्नुहोस्।</string>
    <string name="sandfly_tutorial_sliders_intro">स्लाइडरमा फोकस हुँदा माथि र तल स्वाइप गर्दा यसको मान बदलिन्छ।</string>
    <string name="sandfly_tutorial_sliders_title">स्लाइडरहरू</string>
    <string name="sandfly_tutorial_step">चरण <xliff:g id="number" example="1">%1$d</xliff:g> / <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">स्यान्डफ्लाइहरू समुद्री किनार, नदी किनार र जङ्गलमा बस्ने साना झिंगा हुन्। हावा शान्त हुने बेला, बिहानीपख र साँझपख, तिनीहरू सबैभन्दा सक्रिय हुन्छन्। पोथीले मात्र टोक्छन्, किनभने अण्डा पार्न तिनलाई रगत चाहिन्छ। टोकेको ठाउँ धेरै दिनसम्म चिलाउँछ, त्यसैले स्यान्डफ्लाइ भएको ठाउँ जाने मानिसहरू कीरा भगाउने औषधि बोक्छन्। स्यान्डफ्लाइहरू कमजोर उड्ने हुन्छन्, र हल्का हावाले पनि तिनलाई टाढा राख्छ।</string>
    <string name="sandfly_tutorial_system_back">पछाडि जान: <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_home">होम स्क्रिनमा जान: <xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_intro">यी जेस्चरहरू हरेक स्क्रिनमा काम गर्छन्। यस पाठमा ट्यूटोरियलले प्रत्येक जेस्चरको काम गर्नुको सट्टा त्यसले के गर्छ भनेर बताउँछ।</string>
    <string name="sandfly_tutorial_system_notifications">नोटिफिकेसनहरू खोल्न: <xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_overview">हालै चलाइएका एप देखाउन: <xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_title">पछाडि, होम र नोटिफिकेसनहरू</string>
