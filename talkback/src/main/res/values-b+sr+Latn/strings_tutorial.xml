<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Pređite na poruku. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ili <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> – prolazak kroz njene radnje. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> – izvršavanje radnje koju čujete. Izvršite radnju „<xliff:g id="action" example="Archive">%4$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_actions_intro">Neke stavke osim aktiviranja imaju i druge radnje, na primer „Arhiviraj“ ili „Izbriši“ za poruku. Dok je takva stavka u fokusu, kontrola čitanja „Radnje“ prolazi kroz njih.</string>
    <string name="sandfly_tutorial_actions_title">Radnje</string>
    <string name="sandfly_tutorial_activate_button">Pređite na „<xliff:g id="button" example="Ring the bell">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – aktiviranje.</string>
    <string name="sandfly_tutorial_activate_check_box">Na isti način označite „<xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_activate_hold">Neke stavke rade nešto drugo kada se zadrže. Pređite na „<xliff:g id="button" example="Details">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> – zadržavanje.</string>
    <string name="sandfly_tutorial_activate_intro">Aktiviranje radi na stavci u fokusu, gde god da dodirnete ekran.</string>
    <string name="sandfly_tutorial_activate_title">Aktiviranje stavki</string>
    <string name="sandfly_tutorial_back_in_lesson">„Nazad“ ne napušta lekciju. Da biste izabrali drugu lekciju, koristite „Sadržaj“.</string>
    <string name="sandfly_tutorial_bell">Pozvoni zvonom</string>
    <string name="sandfly_tutorial_bell_rung">Broj zvonjenja: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Osvetljenost</string>
    <string name="sandfly_tutorial_chapter_basics">Osnove</string>
    <string name="sandfly_tutorial_chapter_controls">Kontrole i tekst</string>
    <string name="sandfly_tutorial_chapter_getting_around">Kretanje</string>
    <string name="sandfly_tutorial_chapter_practice">Vežba</string>
    <string name="sandfly_tutorial_chapter_reading">Čitanje</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> ili <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> – promena kontrole čitanja. Izaberite „<xliff:g id="reading_control" example="Words">%3$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_close">Zatvori vodič</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> – kopiranje poslednjeg teksta koji je SandFly izgovorio u privremenu memoriju.</string>
    <string name="sandfly_tutorial_commands_intro">Ove komande rade na svakom ekranu.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> – pretraga teksta na ekranu. U ovoj lekciji vodič umesto toga kaže šta komanda radi.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> – isključivanje govora, a ponovo – uključivanje. U ovoj lekciji vodič umesto toga kaže šta komanda radi.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> – vreme, nivo baterije i drugi status.</string>
    <string name="sandfly_tutorial_commands_title">Korisne komande</string>
    <string name="sandfly_tutorial_contents">Sadržaj</string>
    <string name="sandfly_tutorial_contents_intro">Lekcije, redom. Svaka može da se otvori zasebno.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly može da čita od stavke u fokusu do kraja ekrana bez prevlačenja. Dodir ekrana zaustavlja čitanje.</string>
    <string name="sandfly_tutorial_continuous_move">Pređite na prvi red recepta.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> – čitanje od stavke u fokusu.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> – otvaranje SandFly menija. Zatim izaberite „<xliff:g id="command" example="Read from focused item">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_continuous_title">Neprekidno čitanje</string>
    <string name="sandfly_tutorial_details">Detalji</string>
    <string name="sandfly_tutorial_details_shown">Sto za dvoje u 19 č, pored prozora.</string>
    <string name="sandfly_tutorial_done">Završeno</string>
    <string name="sandfly_tutorial_end_practice">Završi vežbu</string>
    <string name="sandfly_tutorial_explore_activate">Dodirnite „Zvezda“ i podignite prst. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> bilo gde – aktiviranje.</string>
    <string name="sandfly_tutorial_explore_find">Prevlačite jednim prstom po ekranu i pronađite četiri kvadrata: Sunce, Mesec, Zvezda i Oblak.</string>
    <string name="sandfly_tutorial_explore_intro">Dodir ekrana izgovara stavku ispod prsta. Dodir stavke ne aktivira stavku.</string>
    <string name="sandfly_tutorial_explore_title">Istraživanje dodirom</string>
    <string name="sandfly_tutorial_extra_cheese">Dodatni sir</string>
    <string name="sandfly_tutorial_finish">Završi vodič</string>
    <string name="sandfly_tutorial_forecast_today">Danas</string>
    <string name="sandfly_tutorial_forecast_today_text">Sunčano i toplo, sa slabim vetrom.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Sutra</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Oblačno ujutru, sa kišom od podneva.</string>
    <string name="sandfly_tutorial_forecast_weekend">Vikend</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Vetrovito u subotu, vedro u nedelju.</string>
    <string name="sandfly_tutorial_headings_intro">Ekrani i veb-stranice dele sadržaj naslovima. Kontrola čitanja „Naslovi“ prelazi sa jednog naslova na sledeći.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – prelazak na sledeći naslov. Pređite na „<xliff:g id="heading" example="Weekend">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_headings_title">Naslovi</string>
    <string name="sandfly_tutorial_item_apples">Jabuke</string>
    <string name="sandfly_tutorial_item_bread">Hleb</string>
    <string name="sandfly_tutorial_item_cheese">Sir</string>
    <string name="sandfly_tutorial_item_dates">Urme</string>
    <string name="sandfly_tutorial_item_eggs">Jaja</string>
    <string name="sandfly_tutorial_lesson_complete">Lekcija je završena.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Lekcija je završena. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – završavanje vodiča.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Lekcija je završena. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – početak sledeće lekcije.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, lekcija <xliff:g id="number" example="3">%2$d</xliff:g> od <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">Stavka <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> – zatvaranje menija.</string>
    <string name="sandfly_tutorial_menu_intro">SandFly meni sadrži komande za stavku u fokusu i trenutni ekran.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> – otvaranje SandFly menija. Prevlačite kroz njegove komande. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> zatvara meni.</string>
    <string name="sandfly_tutorial_menu_title">SandFly meni</string>
    <string name="sandfly_tutorial_message">Poruka od Saše: Ručak u podne?</string>
    <string name="sandfly_tutorial_message_archive">Arhiviraj</string>
    <string name="sandfly_tutorial_message_delete">Izbriši</string>
    <string name="sandfly_tutorial_message_reply">Odgovori</string>
    <string name="sandfly_tutorial_move_intro">Prevlačenje prelazi na sledeću ili prethodnu stavku na ekranu, redosledom čitanja.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> – prelazak na sledeću stavku. Nastavite dok ne stignete do „<xliff:g id="item" example="Eggs">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> – prelazak na prethodnu stavku. Vratite se na „<xliff:g id="item" example="Bread">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_title">Kretanje između stavki</string>
    <string name="sandfly_tutorial_name">Ime</string>
    <string name="sandfly_tutorial_next_lesson">Sledeća lekcija: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">„<xliff:g id="action" example="Next item">%1$s</xliff:g>“ nema pokret. Dodelite ga u odeljku „Komande“ ili koristite „Preskoči korak“.</string>
    <string name="sandfly_tutorial_not_in_lesson">„<xliff:g id="action" example="Home">%1$s</xliff:g>“ se ne izvršava u lekciji. Da biste napustili vodič, koristite „Zatvori vodič“ u „Sadržaju“.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">„<xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g>“ se ne izvršava u lekciji.</string>
    <string name="sandfly_tutorial_pause_intro">Govor može da se pauzira usred stavke i nastavi tamo gde je stao.</string>
    <string name="sandfly_tutorial_pause_pause">Pređite na priču ispod. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> dok se čita – pauziranje govora, a ponovo – nastavljanje.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> ponovo – nastavljanje govora.</string>
    <string name="sandfly_tutorial_pause_title">Pauziranje govora</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Svaki pokret umesto izvršavanja izgovara svoj naziv i radnju. Prelazak na sledeću i prethodnu stavku i aktiviranje i dalje rade.</string>
    <string name="sandfly_tutorial_practice_step">Napravite bilo koji pokret da biste čuli šta radi. Da biste prestali, aktivirajte „<xliff:g id="button" example="End practice">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_practice_title">Vežba pokreta</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> od <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Promenite kontrolu čitanja na „<xliff:g id="reading_control" example="Characters">%2$s</xliff:g>“. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – pomeranje za jedan znak.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Kontrole čitanja određuju šta radi prevlačenje nagore i nadole, na primer kretanje po rečima ili znakovima ili promenu brzine govora. Prevlačenje udesno i ulevo i dalje prelazi između stavki.</string>
    <string name="sandfly_tutorial_reading_controls_move">Pređite na rečenicu ispod.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – prelazak na sledeću reč. Pomerite se za tri reči.</string>
    <string name="sandfly_tutorial_reading_controls_title">Kontrole čitanja</string>
    <string name="sandfly_tutorial_recipe_1">Palačinke: umutite brašno, jaja i mleko u glatko testo.</string>
    <string name="sandfly_tutorial_recipe_2">Zagrejte malo putera u tiganju.</string>
    <string name="sandfly_tutorial_recipe_3">Sipajte onoliko testa koliko je potrebno da tanko prekrije tiganj.</string>
    <string name="sandfly_tutorial_recipe_4">Okrenite palačinku kada donja strana postane zlatna.</string>
    <string name="sandfly_tutorial_recipe_5">Poslužite sa limunom i šećerom.</string>
    <string name="sandfly_tutorial_scrolling_intro">Liste prikazuju samo deo stavki odjednom. Prevlačenje posle poslednje prikazane stavke pomera listu.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> – pomeranje unapred za jednu stranicu.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> – kretanje kroz listu. Stignite do „<xliff:g id="item" example="Item 15">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_scrolling_title">Pomeranje lista</string>
    <string name="sandfly_tutorial_sentence">Đače, uštedu plaćaj žaljenjem zbog džinovskih cifara.</string>
    <string name="sandfly_tutorial_skip_step">Preskoči korak</string>
    <string name="sandfly_tutorial_sliders_change">Pređite na klizač „<xliff:g id="slider" example="Brightness">%3$s</xliff:g>“. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ili <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> – promena vrednosti.</string>
    <string name="sandfly_tutorial_sliders_highest">Podesite „<xliff:g id="slider" example="Brightness">%1$s</xliff:g>“ na 100 procenata, najveću vrednost.</string>
    <string name="sandfly_tutorial_sliders_intro">Kada je klizač u fokusu, prevlačenje nagore i nadole menja njegovu vrednost.</string>
    <string name="sandfly_tutorial_sliders_title">Klizači</string>
    <string name="sandfly_tutorial_step">Korak <xliff:g id="number" example="1">%1$d</xliff:g> od <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Papatači su sitne mušice koje žive na plažama, obalama reka i u šumama. Najaktivniji su u zoru i sumrak, kada nema vetra. Ujedaju samo ženke, jer im je krv potrebna za polaganje jaja. Ujedi svrbe danima, pa ljudi koji idu u krajeve papatača nose sredstvo protiv insekata. Papatači slabo lete, pa ih i lagani povetarac tera.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> – povratak nazad.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> – odlazak na početni ekran.</string>
    <string name="sandfly_tutorial_system_intro">Ovi pokreti rade na svakom ekranu. U ovoj lekciji vodič umesto izvršavanja kaže šta svaki od njih radi.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> – otvaranje obaveštenja.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> – prikaz nedavnih aplikacija.</string>
    <string name="sandfly_tutorial_system_title">Nazad, početni ekran i obaveštenja</string>
    <string name="sandfly_tutorial_tile_cloud">Oblak</string>
    <string name="sandfly_tutorial_tile_moon">Mesec</string>
    <string name="sandfly_tutorial_tile_star">Zvezda</string>
    <string name="sandfly_tutorial_tile_sun">Sunce</string>
    <string name="sandfly_tutorial_title">Vodič za SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Izbrišite poslednje slovo tasterom za brisanje na tastaturi.</string>
    <string name="sandfly_tutorial_typing_intro">Aktiviranje polja za tekst otvara tastaturu. Dodirnite taster da biste ga čuli, a podignite prst da biste ga uneli.</string>
    <string name="sandfly_tutorial_typing_open">Pređite na polje „<xliff:g id="field" example="Name">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – početak unosa.</string>
    <string name="sandfly_tutorial_typing_title">Unos teksta</string>
    <string name="sandfly_tutorial_typing_type">Unesite reč „<xliff:g id="word" example="cat">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_typing_word">mačka</string>
    <string name="sandfly_tutorial_welcome_intro">Ovaj vodič uči SandFly pokrete. Svaka lekcija daje uputstvo, čeka da ga izvršite svojim pokretima, a zatim daje sledeće. Uputstvo je prva stavka posle naziva lekcije. „Sadržaj“ navodi sve lekcije, a vodič se ponovo otvara na lekciji na kojoj ste stali.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> bilo gde na ekranu – početak.</string>
    <string name="sandfly_tutorial_welcome_title">Dobro došli</string>
</resources>
