    <string name="title_pref_control_sounds">Kontrolišite zvukove i vibracije</string>
    <string name="summary_pref_control_sounds">Dajte svakoj vrsti kontrole, kao što su dugmad, polja za potvrdu, polja za uređivanje i stavke liste, sopstveni zvuk i sopstvenu vibraciju iz teme, umesto zvuka fokusa i vibracije, kao što Unspoken radi za NVDA. Zvuk dolazi sa mesta gde je kontrola na ekranu, a SandFly izostavlja da kaže kakva je to kontrola.</string>
    <string name="title_pref_control_sounds_speak_roles">Još kažemo vrstu kontrole</string>
    <string name="summary_pref_control_sounds_speak_roles">Kada se reprodukuje kontrolni zvuk, ipak recite kakva je to kontrola, na primer dugme. Ovo je za svaku zvučnu temu.</string>
