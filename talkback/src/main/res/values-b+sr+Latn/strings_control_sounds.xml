    <string name="title_pref_control_sounds">Zvukovi i vibracije kontrola</string>
    <string name="summary_pref_control_sounds">Svaka vrsta kontrole, kao što su dugmad, polja za potvrdu, polja za uređivanje i stavke liste, dobija sopstveni zvuk i vibraciju iz teme umesto zvuka i vibracije fokusa, kao što Unspoken radi za NVDA. Zvuk dolazi sa mesta kontrole na ekranu, a SandFly ne izgovara vrstu kontrole.</string>
    <string name="title_pref_control_sounds_speak_roles">Ipak izgovaraj vrstu kontrole</string>
    <string name="summary_pref_control_sounds_speak_roles">Kada se pusti zvuk kontrole, vrsta kontrole se ipak izgovara, na primer dugme. Važi za sve zvučne teme.</string>
