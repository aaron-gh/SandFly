<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">Sons e vibrações dos controlos</string>
    <string name="summary_pref_control_sounds">Cada tipo de controlo, como botões, caixas de verificação, campos de edição e itens de lista, recebe um som e uma vibração próprios do tema em vez do som e da vibração de foco, como o Unspoken faz no NVDA. O som vem da posição do controlo no ecrã, e o SandFly não diz o tipo de controlo.</string>
    <string name="title_pref_control_sounds_speak_roles">Também dizer o tipo de controlo</string>
    <string name="summary_pref_control_sounds_speak_roles">Quando um som de controlo é reproduzido, o tipo de controlo continua a ser dito, como botão. Aplica-se a todos os temas sonoros.</string>
