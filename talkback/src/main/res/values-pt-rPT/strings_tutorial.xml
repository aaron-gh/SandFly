    <string name="sandfly_tutorial_message_archive">Arquivar</string>
    <string name="sandfly_tutorial_message_delete">Eliminar</string>
    <string name="sandfly_tutorial_message_reply">Responder</string>
    <string name="sandfly_tutorial_move_intro">Deslizar move para o item seguinte ou anterior no ecrã, pela ordem de leitura.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> para avançar para o item seguinte. Continue até chegar a <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> para recuar para o item anterior. Volte a <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Mover entre itens</string>
    <string name="sandfly_tutorial_name">Nome</string>
    <string name="sandfly_tutorial_next_lesson">Lição seguinte: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> não tem gesto. Atribua um em Comandos ou use Ignorar passo.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> não é executado numa lição. Para sair do tutorial, use Fechar tutorial em Conteúdo.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> não é executado numa lição.</string>
    <string name="sandfly_tutorial_pause_intro">A voz pode ser colocada em pausa a meio de um item e retomada onde parou.</string>
    <string name="sandfly_tutorial_pause_pause">Desloque-se para a história abaixo. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> durante a leitura para colocar a voz em pausa e novamente para a retomar.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> novamente para retomar a voz.</string>
    <string name="sandfly_tutorial_pause_title">Colocar a voz em pausa</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Cada gesto diz o respetivo nome e ação em vez de a executar. Mover para o item seguinte e anterior e ativar continuam a funcionar.</string>
    <string name="sandfly_tutorial_practice_step">Faça qualquer gesto para ouvir o que faz. Para parar, ative <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Prática de gestos</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> de <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Mude o controlo de leitura para <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para avançar um caráter.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Os controlos de leitura definem o que deslizar para cima e para baixo faz, como mover por palavra ou por caráter, ou alterar a velocidade de voz. Deslizar para a direita e para a esquerda continua a mover entre itens.</string>
    <string name="sandfly_tutorial_reading_controls_move">Desloque-se para a frase abaixo.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para avançar para a palavra seguinte. Avance três palavras.</string>
    <string name="sandfly_tutorial_reading_controls_title">Controlos de leitura</string>
    <string name="sandfly_tutorial_recipe_1">Panquecas: misture farinha, ovos e leite até obter uma massa homogénea.</string>
    <string name="sandfly_tutorial_recipe_2">Aqueça um pouco de manteiga numa frigideira.</string>
    <string name="sandfly_tutorial_recipe_3">Deite massa suficiente para cobrir o fundo da frigideira com uma camada fina.</string>
    <string name="sandfly_tutorial_recipe_4">Vire a panqueca quando a parte de baixo estiver dourada.</string>
    <string name="sandfly_tutorial_recipe_5">Sirva com limão e açúcar.</string>
    <string name="sandfly_tutorial_scrolling_intro">As listas mostram apenas alguns itens de cada vez. Deslizar para além do último item apresentado desloca a lista.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> para avançar uma página.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> pela lista até chegar a <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Deslocar listas</string>
    <string name="sandfly_tutorial_sentence">A raposa castanha e rápida salta por cima do cão preguiçoso.</string>
    <string name="sandfly_tutorial_skip_step">Ignorar passo</string>
    <string name="sandfly_tutorial_sliders_change">Desloque-se para o controlo de deslize <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para alterar o respetivo valor.</string>
    <string name="sandfly_tutorial_sliders_highest">Defina <xliff:g id="slider" example="Brightness">%1$s</xliff:g> para 100 por cento, o valor máximo.</string>
    <string name="sandfly_tutorial_sliders_intro">Quando um controlo de deslize está focado, deslizar para cima e para baixo altera o respetivo valor.</string>
    <string name="sandfly_tutorial_sliders_title">Controlos de deslize</string>
    <string name="sandfly_tutorial_step">Passo <xliff:g id="number" example="1">%1$d</xliff:g> de <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Os flebótomos são pequenos insetos que vivem em praias, margens de rios e florestas. São mais ativos ao amanhecer e ao anoitecer, quando o ar está parado. Só as fêmeas picam, porque precisam de sangue para produzir os ovos. As picadas provocam comichão durante dias, por isso quem visita as regiões onde vivem leva repelente de insetos. Os flebótomos voam mal, e até uma brisa ligeira os mantém afastados.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> para retroceder.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> para aceder ao ecrã principal.</string>
    <string name="sandfly_tutorial_system_intro">Estes gestos funcionam em todos os ecrãs. Nesta lição, o tutorial diz o que cada um faz em vez de o executar.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> para abrir as notificações.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> para mostrar as apps recentes.</string>
    <string name="sandfly_tutorial_system_title">Anterior, Página inicial e notificações</string>
    <string name="sandfly_tutorial_tile_cloud">Nuvem</string>
    <string name="sandfly_tutorial_tile_moon">Lua</string>
    <string name="sandfly_tutorial_tile_star">Estrela</string>
    <string name="sandfly_tutorial_tile_sun">Sol</string>
    <string name="sandfly_tutorial_title">Tutorial do SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Apague a última letra com a tecla Eliminar do teclado.</string>
    <string name="sandfly_tutorial_typing_intro">Ativar um campo de texto abre o teclado. Toque numa tecla para a ouvir e levante o dedo para a escrever.</string>
    <string name="sandfly_tutorial_typing_open">Desloque-se para o campo <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para começar a escrever.</string>
    <string name="sandfly_tutorial_typing_title">Escrita</string>
    <string name="sandfly_tutorial_typing_type">Escreva a palavra <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">gato</string>
    <string name="sandfly_tutorial_welcome_intro">Este tutorial ensina os gestos do SandFly. Cada lição dá uma instrução, espera até a executar com os seus próprios gestos e, em seguida, dá a seguinte. A instrução é o primeiro item após o nome da lição. Conteúdo lista todas as lições, e o tutorial volta a abrir na lição em que estava.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> em qualquer ponto do ecrã para começar.</string>
    <string name="sandfly_tutorial_welcome_title">Boas-vindas</string>
</resources>
