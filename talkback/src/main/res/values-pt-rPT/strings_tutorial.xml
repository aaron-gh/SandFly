<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Desloque-se para a mensagem. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para percorrer as respetivas ações. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> para executar a ação anunciada. Execute <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Alguns itens têm ações além de ativar, como Arquivar ou Eliminar numa mensagem. Enquanto um destes itens está focado, o controlo de leitura Ações percorre essas ações.</string>
    <string name="sandfly_tutorial_actions_title">Ações</string>
    <string name="sandfly_tutorial_activate_button">Desloque-se para <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para o ativar.</string>
    <string name="sandfly_tutorial_activate_check_box">Marque <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> da mesma forma.</string>
    <string name="sandfly_tutorial_activate_hold">Alguns itens fazem outra coisa quando são mantidos premidos. Desloque-se para <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> para o manter premido.</string>
    <string name="sandfly_tutorial_activate_intro">A ativação aplica-se ao item focado, independentemente do ponto do ecrã em que toca.</string>
    <string name="sandfly_tutorial_activate_title">Ativar itens</string>
    <string name="sandfly_tutorial_back_in_lesson">Anterior não sai de uma lição. Para escolher outra lição, use Conteúdo.</string>
    <string name="sandfly_tutorial_bell">Tocar a campainha</string>
    <string name="sandfly_tutorial_bell_rung">Toques: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Brilho</string>
    <string name="sandfly_tutorial_chapter_basics">Noções básicas</string>
    <string name="sandfly_tutorial_chapter_controls">Controlos e texto</string>
    <string name="sandfly_tutorial_chapter_getting_around">Navegação</string>
    <string name="sandfly_tutorial_chapter_practice">Prática</string>
    <string name="sandfly_tutorial_chapter_reading">Leitura</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> para mudar o controlo de leitura. Escolha <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Fechar tutorial</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> para copiar o último texto dito pelo SandFly para a área de transferência.</string>
    <string name="sandfly_tutorial_commands_intro">Estes comandos funcionam em todos os ecrãs.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> para pesquisar texto no ecrã. Nesta lição, o tutorial diz o que o comando faz em vez de o executar.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> para desativar a voz e novamente para a ativar. Nesta lição, o tutorial diz o que o comando faz em vez de o executar.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> para ouvir a hora, o nível da bateria e outros estados.</string>
    <string name="sandfly_tutorial_commands_title">Comandos úteis</string>
    <string name="sandfly_tutorial_contents">Conteúdo</string>
    <string name="sandfly_tutorial_contents_intro">Lições, por ordem. Cada uma pode ser aberta individualmente.</string>
    <string name="sandfly_tutorial_continuous_intro">O SandFly pode ler desde o item focado até ao fim do ecrã sem ter de deslizar. Tocar no ecrã para a leitura.</string>
    <string name="sandfly_tutorial_continuous_move">Desloque-se para a primeira linha da receita.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> para ler a partir do item focado.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir o menu do SandFly. Em seguida, escolha <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_title">Leitura contínua</string>
    <string name="sandfly_tutorial_details">Detalhes</string>
    <string name="sandfly_tutorial_details_shown">Mesa para 2 às 19:00, junto à janela.</string>
    <string name="sandfly_tutorial_done">Concluída</string>
    <string name="sandfly_tutorial_end_practice">Terminar prática</string>
    <string name="sandfly_tutorial_explore_activate">Toque em Estrela e levante o dedo. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> em qualquer ponto para o ativar.</string>
    <string name="sandfly_tutorial_explore_find">Deslize um dedo pelo ecrã e encontre os quatro quadrados: Sol, Lua, Estrela e Nuvem.</string>
    <string name="sandfly_tutorial_explore_intro">Tocar no ecrã diz o item sob o dedo. Tocar num item não o ativa.</string>
    <string name="sandfly_tutorial_explore_title">Explorar através do toque</string>
    <string name="sandfly_tutorial_extra_cheese">Queijo extra</string>
    <string name="sandfly_tutorial_finish">Terminar tutorial</string>
    <string name="sandfly_tutorial_forecast_today">Hoje</string>
    <string name="sandfly_tutorial_forecast_today_text">Sol e calor, com vento fraco.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Amanhã</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Nublado de manhã, com chuva a partir do meio-dia.</string>
    <string name="sandfly_tutorial_forecast_weekend">Fim de semana</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Vento forte no sábado, céu limpo no domingo.</string>
    <string name="sandfly_tutorial_headings_intro">Os ecrãs e as páginas Web dividem o conteúdo com títulos. O controlo de leitura Títulos salta de um título para o seguinte.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para saltar para o título seguinte. Salte para <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_headings_title">Títulos</string>
    <string name="sandfly_tutorial_item_apples">Maçãs</string>
    <string name="sandfly_tutorial_item_bread">Pão</string>
    <string name="sandfly_tutorial_item_cheese">Queijo</string>
    <string name="sandfly_tutorial_item_dates">Tâmaras</string>
    <string name="sandfly_tutorial_item_eggs">Ovos</string>
    <string name="sandfly_tutorial_lesson_complete">Lição concluída.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Lição concluída. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para terminar o tutorial.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Lição concluída. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para iniciar a lição seguinte.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, lição <xliff:g id="number" example="3">%2$d</xliff:g> de <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">Item <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> para fechar o menu.</string>
    <string name="sandfly_tutorial_menu_intro">O menu do SandFly tem comandos para o item focado e para o ecrã atual.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir o menu do SandFly. Deslize pelos respetivos comandos. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> fecha o menu.</string>
    <string name="sandfly_tutorial_menu_title">Menu do SandFly</string>
