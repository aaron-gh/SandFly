<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">നിയന്ത്രണങ്ങളുടെ ശബ്ദങ്ങളും വൈബ്രേഷനുകളും</string>
    <string name="summary_pref_control_sounds">ബട്ടണുകൾ, ചെക്ക്‌ബോക്‌സുകൾ, എഡിറ്റ് ഫീൽഡുകൾ, ലിസ്റ്റ് ഇനങ്ങൾ എന്നിങ്ങനെ ഓരോ തരം നിയന്ത്രണത്തിനും ഫോക്കസ് ശബ്‌ദത്തിനും വൈബ്രേഷനും പകരം തീമിൽ നിന്നുള്ള സ്വന്തം ശബ്‌ദവും വൈബ്രേഷനും ലഭിക്കും, NVDA-യ്ക്കായി Unspoken ചെയ്യുന്നത് പോലെ. സ്‌ക്രീനിൽ നിയന്ത്രണം ഉള്ള സ്ഥാനത്തുനിന്നാണ് ശബ്‌ദം വരുന്നത്, SandFly നിയന്ത്രണത്തിന്റെ തരം പറയുന്നില്ല.</string>
    <string name="title_pref_control_sounds_speak_roles">നിയന്ത്രണത്തിന്റെ തരവും പറയുക</string>
    <string name="summary_pref_control_sounds_speak_roles">നിയന്ത്രണ ശബ്‌ദം പ്ലേ ചെയ്യുമ്പോഴും നിയന്ത്രണത്തിന്റെ തരം പറയും, ഉദാഹരണത്തിന് ബട്ടൺ. എല്ലാ ശബ്‌ദ തീമുകൾക്കും ബാധകം.</string>
