<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">നിയന്ത്രണങ്ങളുടെ ശബ്ദങ്ങളും വൈബ്രേഷനുകളും</string>
    <string name="summary_pref_control_sounds">എൻവിഡിഎയ്‌ക്ക് ഫോക്കസ് ശബ്‌ദത്തിനും വൈബ്രേഷനും പകരം ബട്ടണുകൾ, ചെക്ക്‌ബോക്‌സുകൾ, എഡിറ്റ് ഫീൽഡുകൾ, ലിസ്റ്റ് ഇനങ്ങൾ, അതിൻ്റേതായ ശബ്ദവും തീമിൽ നിന്നുള്ള സ്വന്തം വൈബ്രേഷനും പോലുള്ള ഓരോ തരത്തിലുള്ള നിയന്ത്രണവും നൽകുക. സ്‌ക്രീനിൽ നിയന്ത്രണം ഉള്ളിടത്ത് നിന്നാണ് ശബ്‌ദം വരുന്നത്, SandFly അത് ഏത് തരത്തിലുള്ള നിയന്ത്രണമാണെന്ന് പറയുന്നു.</string>
    <string name="title_pref_control_sounds_speak_roles">നിയന്ത്രണത്തിന്റെ തരവും പറയുക</string>
    <string name="summary_pref_control_sounds_speak_roles">ഒരു നിയന്ത്രണ ശബ്‌ദം പ്ലേ ചെയ്യുമ്പോൾ, അത് ഏത് തരത്തിലുള്ള നിയന്ത്രണമാണെന്ന് ഇപ്പോഴും പറയുക, ഉദാഹരണത്തിന് ബട്ടൺ. ഇത് എല്ലാ ശബ്ദ തീമുകൾക്കുമുള്ളതാണ്.</string>
