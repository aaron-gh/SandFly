<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">സന്ദേശത്തിലേക്ക് നീങ്ങുക. അതിന്റെ പ്രവർത്തനങ്ങളിലൂടെ പോകാൻ <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> അല്ലെങ്കിൽ <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>. കേൾക്കുന്ന പ്രവർത്തനം നടത്താൻ <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>. <xliff:g id="action" example="Archive">%4$s</xliff:g> നടത്തുക.</string>
    <string name="sandfly_tutorial_actions_intro">ചില ഇനങ്ങൾക്ക് സജീവമാക്കലിന് പുറമെ മറ്റ് പ്രവർത്തനങ്ങളുമുണ്ട്, ഉദാഹരണത്തിന് ഒരു സന്ദേശത്തിന് ആർക്കൈവ് ചെയ്യുക അല്ലെങ്കിൽ ഇല്ലാതാക്കുക. അത്തരമൊരു ഇനത്തിൽ ഫോക്കസ് ഉള്ളപ്പോൾ, “പ്രവർത്തനങ്ങൾ” വായനാ നിയന്ത്രണം അവയിലൂടെ പോകുന്നു.</string>
    <string name="sandfly_tutorial_actions_title">പ്രവർത്തനങ്ങൾ</string>
    <string name="sandfly_tutorial_activate_button"><xliff:g id="button" example="Ring the bell">%2$s</xliff:g> എന്നതിലേക്ക് നീങ്ങുക. അത് സജീവമാക്കാൻ <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_check_box">അതേ രീതിയിൽ <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> ചെക്ക് ചെയ്യുക.</string>
    <string name="sandfly_tutorial_activate_hold">ചില ഇനങ്ങൾ അമർത്തിപ്പിടിക്കുമ്പോൾ മറ്റെന്തെങ്കിലും ചെയ്യുന്നു. <xliff:g id="button" example="Details">%2$s</xliff:g> എന്നതിലേക്ക് നീങ്ങുക. അത് അമർത്തിപ്പിടിക്കാൻ <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_intro">സ്ക്രീനിൽ എവിടെ ടാപ്പ് ചെയ്താലും, ഫോക്കസ് ഉള്ള ഇനമാണ് സജീവമാകുന്നത്.</string>
    <string name="sandfly_tutorial_activate_title">ഇനങ്ങൾ സജീവമാക്കൽ</string>
    <string name="sandfly_tutorial_back_in_lesson">മടങ്ങുക പാഠത്തിൽ നിന്ന് പുറത്തുകടക്കില്ല. മറ്റൊരു പാഠം തിരഞ്ഞെടുക്കാൻ, “ഉള്ളടക്കം” ഉപയോഗിക്കുക.</string>
    <string name="sandfly_tutorial_bell">മണി അടിക്കുക</string>
    <string name="sandfly_tutorial_bell_rung">മണി അടിച്ചത്: <xliff:g id="count" example="1">%1$d</xliff:g> തവണ</string>
    <string name="sandfly_tutorial_brightness">തെളിച്ചം</string>
    <string name="sandfly_tutorial_chapter_basics">അടിസ്ഥാനകാര്യങ്ങൾ</string>
    <string name="sandfly_tutorial_chapter_controls">നിയന്ത്രണങ്ങളും ടെക്സ്റ്റും</string>
    <string name="sandfly_tutorial_chapter_getting_around">സ്ക്രീനിൽ സഞ്ചരിക്കൽ</string>
    <string name="sandfly_tutorial_chapter_practice">പരിശീലനം</string>
    <string name="sandfly_tutorial_chapter_reading">വായന</string>
    <string name="sandfly_tutorial_choose_reading_control">വായനാ നിയന്ത്രണം മാറ്റാൻ <xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> അല്ലെങ്കിൽ <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>. <xliff:g id="reading_control" example="Words">%3$s</xliff:g> തിരഞ്ഞെടുക്കുക.</string>
    <string name="sandfly_tutorial_close">ട്യൂട്ടോറിയൽ അടയ്ക്കുക</string>
    <string name="sandfly_tutorial_commands_copy">SandFly അവസാനം പറഞ്ഞ ടെക്സ്റ്റ് ക്ലിപ്പ്ബോർഡിലേക്ക് പകർത്താൻ <xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_commands_intro">ഈ കമാൻഡുകൾ എല്ലാ സ്ക്രീനിലും പ്രവർത്തിക്കുന്നു.</string>
    <string name="sandfly_tutorial_commands_search">സ്ക്രീനിൽ ടെക്സ്റ്റ് തിരയാൻ <xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>. ഈ പാഠത്തിൽ, പകരം അത് എന്ത് ചെയ്യുമെന്ന് ട്യൂട്ടോറിയൽ പറയുന്നു.</string>
    <string name="sandfly_tutorial_commands_speech_off">സംഭാഷണം ഓഫാക്കാൻ <xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>, ഓണാക്കാൻ വീണ്ടും. ഈ പാഠത്തിൽ, പകരം അത് എന്ത് ചെയ്യുമെന്ന് ട്യൂട്ടോറിയൽ പറയുന്നു.</string>
    <string name="sandfly_tutorial_commands_status">സമയം, ബാറ്ററി നില, മറ്റ് സ്റ്റാറ്റസ് എന്നിവ കേൾക്കാൻ <xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_commands_title">ഉപയോഗപ്രദമായ കമാൻഡുകൾ</string>
    <string name="sandfly_tutorial_contents">ഉള്ളടക്കം</string>
    <string name="sandfly_tutorial_contents_intro">പാഠങ്ങൾ, ക്രമത്തിൽ. ഓരോന്നും പ്രത്യേകം തുറക്കാം.</string>
    <string name="sandfly_tutorial_continuous_intro">സ്വൈപ്പ് ചെയ്യാതെ തന്നെ ഫോക്കസ് ചെയ്ത ഇനം മുതൽ സ്ക്രീനിന്റെ അവസാനം വരെ SandFly-ക്ക് വായിക്കാനാകും. സ്ക്രീനിൽ തൊട്ടാൽ വായന നിർത്തും.</string>
    <string name="sandfly_tutorial_continuous_move">പാചകക്കുറിപ്പിന്റെ ആദ്യ വരിയിലേക്ക് നീങ്ങുക.</string>
    <string name="sandfly_tutorial_continuous_read">ഫോക്കസ് ചെയ്ത ഇനത്തിൽ നിന്ന് വായിക്കാൻ <xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu">SandFly മെനു തുറക്കാൻ <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>, തുടർന്ന് <xliff:g id="command" example="Read from focused item">%2$s</xliff:g> തിരഞ്ഞെടുക്കുക.</string>
    <string name="sandfly_tutorial_continuous_title">തുടർച്ചയായി വായിക്കൽ</string>
    <string name="sandfly_tutorial_details">വിശദാംശങ്ങൾ</string>
    <string name="sandfly_tutorial_details_shown">2 പേർക്കുള്ള മേശ, രാത്രി 7 മണിക്ക്, ജനലിനരികിൽ.</string>
    <string name="sandfly_tutorial_done">പൂർത്തിയായി</string>
    <string name="sandfly_tutorial_end_practice">പരിശീലനം അവസാനിപ്പിക്കുക</string>
    <string name="sandfly_tutorial_explore_activate">നക്ഷത്രം തൊട്ട് വിരൽ ഉയർത്തുക. അത് സജീവമാക്കാൻ എവിടെയെങ്കിലും <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_explore_find">സ്ക്രീനിൽ ഒരു വിരൽ നീക്കി നാല് ചതുരങ്ങൾ കണ്ടെത്തുക: സൂര്യൻ, ചന്ദ്രൻ, നക്ഷത്രം, മേഘം.</string>
    <string name="sandfly_tutorial_explore_intro">സ്ക്രീനിൽ തൊടുമ്പോൾ വിരലിന് താഴെയുള്ള ഇനം പറയുന്നു. ഒരു ഇനത്തിൽ തൊടുന്നത് അതിനെ സജീവമാക്കുന്നില്ല.</string>
    <string name="sandfly_tutorial_explore_title">ടച്ച് വഴി അടുത്തറിയൽ</string>
    <string name="sandfly_tutorial_extra_cheese">അധിക ചീസ്</string>
    <string name="sandfly_tutorial_finish">ട്യൂട്ടോറിയൽ പൂർത്തിയാക്കുക</string>
    <string name="sandfly_tutorial_forecast_today">ഇന്ന്</string>
    <string name="sandfly_tutorial_forecast_today_text">വെയിലും ചൂടും, നേരിയ കാറ്റോടെ.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">നാളെ</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">രാവിലെ മേഘാവൃതം, ഉച്ച മുതൽ മഴ.</string>
    <string name="sandfly_tutorial_forecast_weekend">വാരാന്ത്യം</string>
    <string name="sandfly_tutorial_forecast_weekend_text">ശനിയാഴ്ച കാറ്റ്, ഞായറാഴ്ച തെളിഞ്ഞ ആകാശം.</string>
    <string name="sandfly_tutorial_headings_intro">സ്ക്രീനുകളും വെബ് പേജുകളും തലക്കെട്ടുകൾ ഉപയോഗിച്ച് ഉള്ളടക്കം വിഭജിക്കുന്നു. “തലക്കെട്ടുകൾ” വായനാ നിയന്ത്രണം ഒരു തലക്കെട്ടിൽ നിന്ന് അടുത്തതിലേക്ക് പോകുന്നു.</string>
    <string name="sandfly_tutorial_headings_jump">അടുത്ത തലക്കെട്ടിലേക്ക് പോകാൻ <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>. <xliff:g id="heading" example="Weekend">%2$s</xliff:g> എന്നതിലേക്ക് പോകുക.</string>
    <string name="sandfly_tutorial_headings_title">തലക്കെട്ടുകൾ</string>
    <string name="sandfly_tutorial_item_apples">ആപ്പിൾ</string>
    <string name="sandfly_tutorial_item_bread">ബ്രെഡ്</string>
    <string name="sandfly_tutorial_item_cheese">ചീസ്</string>
    <string name="sandfly_tutorial_item_dates">ഈന്തപ്പഴം</string>
    <string name="sandfly_tutorial_item_eggs">മുട്ട</string>
    <string name="sandfly_tutorial_lesson_complete">പാഠം പൂർത്തിയായി.</string>
    <string name="sandfly_tutorial_lesson_complete_last">പാഠം പൂർത്തിയായി. ട്യൂട്ടോറിയൽ പൂർത്തിയാക്കാൻ <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_lesson_complete_next">പാഠം പൂർത്തിയായി. അടുത്ത പാഠം ആരംഭിക്കാൻ <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, പാഠം <xliff:g id="number" example="3">%2$d</xliff:g>/<xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">ഇനം <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close">മെനു അടയ്ക്കാൻ <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_menu_intro">ഫോക്കസ് ചെയ്ത ഇനത്തിനും നിലവിലെ സ്ക്രീനിനുമുള്ള കമാൻഡുകൾ SandFly മെനുവിലുണ്ട്.</string>
    <string name="sandfly_tutorial_menu_open">SandFly മെനു തുറക്കാൻ <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>. അതിന്റെ കമാൻഡുകളിലൂടെ സ്വൈപ്പ് ചെയ്യുക. മെനു അടയ്ക്കാൻ <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_menu_title">SandFly മെനു</string>
    <string name="sandfly_tutorial_message">സാമിൽ നിന്നുള്ള സന്ദേശം: ഉച്ചയ്ക്ക് 12 മണിക്ക് ഊണ്?</string>
    <string name="sandfly_tutorial_message_archive">ആർക്കൈവ് ചെയ്യുക</string>
    <string name="sandfly_tutorial_message_delete">ഇല്ലാതാക്കുക</string>
    <string name="sandfly_tutorial_message_reply">മറുപടി നൽകുക</string>
    <string name="sandfly_tutorial_move_intro">സ്വൈപ്പ് ചെയ്യുമ്പോൾ സ്ക്രീനിലെ അടുത്ത അല്ലെങ്കിൽ മുമ്പത്തെ ഇനത്തിലേക്ക്, വായനാ ക്രമത്തിൽ, നീങ്ങുന്നു.</string>
    <string name="sandfly_tutorial_move_next">അടുത്ത ഇനത്തിലേക്ക് നീങ്ങാൻ <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>. <xliff:g id="item" example="Eggs">%2$s</xliff:g> എത്തുന്നത് വരെ തുടരുക.</string>
    <string name="sandfly_tutorial_move_previous">മുമ്പത്തെ ഇനത്തിലേക്ക് നീങ്ങാൻ <xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>. <xliff:g id="item" example="Bread">%2$s</xliff:g> എന്നതിലേക്ക് തിരികെ പോകുക.</string>
    <string name="sandfly_tutorial_move_title">ഇനങ്ങൾക്കിടയിൽ നീങ്ങൽ</string>
    <string name="sandfly_tutorial_name">പേര്</string>
    <string name="sandfly_tutorial_next_lesson">അടുത്ത പാഠം: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> എന്നതിന് ജെസ്‌ച്ചർ ഇല്ല. “കമാൻഡുകൾ” എന്നതിൽ ഒന്ന് നൽകുക, അല്ലെങ്കിൽ “ഘട്ടം ഒഴിവാക്കുക” ഉപയോഗിക്കുക.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> പാഠത്തിൽ ചെയ്യില്ല. ട്യൂട്ടോറിയലിൽ നിന്ന് പുറത്തുകടക്കാൻ, “ഉള്ളടക്കം” എന്നതിലെ “ട്യൂട്ടോറിയൽ അടയ്ക്കുക” ഉപയോഗിക്കുക.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> പാഠത്തിൽ ചെയ്യില്ല.</string>
    <string name="sandfly_tutorial_pause_intro">ഒരു ഇനത്തിന്റെ മധ്യത്തിൽ സംഭാഷണം താൽക്കാലികമായി നിർത്താനും നിർത്തിയിടത്ത് നിന്ന് പുനരാരംഭിക്കാനും കഴിയും.</string>
    <string name="sandfly_tutorial_pause_pause">താഴെയുള്ള കഥയിലേക്ക് നീങ്ങുക. അത് വായിക്കുമ്പോൾ സംഭാഷണം താൽക്കാലികമായി നിർത്താൻ <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>, പുനരാരംഭിക്കാൻ വീണ്ടും.</string>
    <string name="sandfly_tutorial_pause_resume">സംഭാഷണം പുനരാരംഭിക്കാൻ വീണ്ടും <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_pause_title">സംഭാഷണം താൽക്കാലികമായി നിർത്തൽ</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">ഓരോ ജെസ്‌ച്ചറും പ്രവർത്തനം നടത്തുന്നതിന് പകരം അതിന്റെ പേരും പ്രവർത്തനവും പറയുന്നു. അടുത്തതും മുമ്പത്തേതുമായ ഇനത്തിലേക്ക് നീങ്ങലും സജീവമാക്കലും ഇപ്പോഴും പ്രവർത്തിക്കുന്നു.</string>
    <string name="sandfly_tutorial_practice_step">ഏതെങ്കിലും ജെസ്‌ച്ചർ എന്ത് ചെയ്യുന്നുവെന്ന് കേൾക്കാൻ അത് ചെയ്യുക. നിർത്താൻ, <xliff:g id="button" example="End practice">%1$s</xliff:g> സജീവമാക്കുക.</string>
    <string name="sandfly_tutorial_practice_title">ജെസ്‌ച്ചർ പരിശീലനം</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">വായനാ നിയന്ത്രണം <xliff:g id="reading_control" example="Characters">%2$s</xliff:g> എന്നതിലേക്ക് മാറ്റുക. ഒരു പ്രതീകം നീങ്ങാൻ <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_intro">മുകളിലേക്കും താഴേക്കും സ്വൈപ്പ് ചെയ്യുമ്പോൾ എന്ത് സംഭവിക്കുമെന്ന് വായനാ നിയന്ത്രണങ്ങൾ തീരുമാനിക്കുന്നു, ഉദാഹരണത്തിന് വാക്ക് അനുസരിച്ചോ പ്രതീകം അനുസരിച്ചോ നീങ്ങൽ, അല്ലെങ്കിൽ വായനയുടെ വേഗത മാറ്റൽ. വലത്തോട്ടും ഇടത്തോട്ടും സ്വൈപ്പ് ചെയ്യുന്നത് ഇപ്പോഴും ഇനങ്ങൾക്കിടയിൽ നീങ്ങുന്നു.</string>
    <string name="sandfly_tutorial_reading_controls_move">താഴെയുള്ള വാക്യത്തിലേക്ക് നീങ്ങുക.</string>
    <string name="sandfly_tutorial_reading_controls_next_word">അടുത്ത വാക്കിലേക്ക് നീങ്ങാൻ <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>. മൂന്ന് വാക്കുകൾ നീങ്ങുക.</string>
    <string name="sandfly_tutorial_reading_controls_title">വായനാ നിയന്ത്രണങ്ങൾ</string>
    <string name="sandfly_tutorial_recipe_1">പാൻകേക്കുകൾ: മാവ്, മുട്ട, പാൽ എന്നിവ കലർത്തി മിനുസമുള്ള മാവ് തയ്യാറാക്കുക.</string>
    <string name="sandfly_tutorial_recipe_2">ഒരു പാനിൽ അൽപ്പം വെണ്ണ ചൂടാക്കുക.</string>
    <string name="sandfly_tutorial_recipe_3">പാൻ നേർത്തതായി മൂടാൻ ആവശ്യമായ മാവ് ഒഴിക്കുക.</string>
    <string name="sandfly_tutorial_recipe_4">അടിഭാഗം സ്വർണ്ണനിറമാകുമ്പോൾ പാൻകേക്ക് മറിച്ചിടുക.</string>
    <string name="sandfly_tutorial_recipe_5">നാരങ്ങയും പഞ്ചസാരയും ചേർത്ത് വിളമ്പുക.</string>
    <string name="sandfly_tutorial_scrolling_intro">ലിസ്റ്റുകൾ ഒരു സമയം അവയുടെ ചില ഇനങ്ങൾ മാത്രമേ കാണിക്കൂ. കാണിച്ചിരിക്കുന്ന അവസാന ഇനം കടന്ന് സ്വൈപ്പ് ചെയ്യുമ്പോൾ ലിസ്റ്റ് സ്ക്രോൾ ചെയ്യുന്നു.</string>
    <string name="sandfly_tutorial_scrolling_page">ഒരു പേജ് മുന്നോട്ട് സ്ക്രോൾ ചെയ്യാൻ <xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="item" example="Item 15">%2$s</xliff:g> എത്തുന്നത് വരെ ലിസ്റ്റിൽ <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">ലിസ്റ്റുകൾ സ്ക്രോൾ ചെയ്യൽ</string>
    <string name="sandfly_tutorial_sentence">വേഗതയുള്ള തവിട്ട് കുറുക്കൻ മടിയനായ നായയുടെ മുകളിലൂടെ ചാടുന്നു.</string>
    <string name="sandfly_tutorial_skip_step">ഘട്ടം ഒഴിവാക്കുക</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> സ്ലൈഡറിലേക്ക് നീങ്ങുക. അതിന്റെ മൂല്യം മാറ്റാൻ <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> അല്ലെങ്കിൽ <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> അതിന്റെ ഏറ്റവും ഉയർന്ന മൂല്യമായ 100 ശതമാനത്തിലേക്ക് സജ്ജമാക്കുക.</string>
    <string name="sandfly_tutorial_sliders_intro">ഒരു സ്ലൈഡറിൽ ഫോക്കസ് ഉള്ളപ്പോൾ, മുകളിലേക്കും താഴേക്കും സ്വൈപ്പ് ചെയ്യുന്നത് അതിന്റെ മൂല്യം മാറ്റുന്നു.</string>
    <string name="sandfly_tutorial_sliders_title">സ്ലൈഡറുകൾ</string>
    <string name="sandfly_tutorial_step">ഘട്ടം <xliff:g id="number" example="1">%1$d</xliff:g>/<xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">കടൽത്തീരങ്ങളിലും നദീതീരങ്ങളിലും കാടുകളിലും ജീവിക്കുന്ന ചെറിയ ഈച്ചകളാണ് മണലീച്ചകൾ. കാറ്റില്ലാത്ത പുലർച്ചെയും സന്ധ്യയ്ക്കുമാണ് അവ ഏറ്റവും സജീവം. പെണ്ണീച്ചകൾ മാത്രമേ കടിക്കൂ, കാരണം മുട്ടയിടാൻ അവയ്ക്ക് രക്തം വേണം. കടിച്ച പാടുകൾ ദിവസങ്ങളോളം ചൊറിയും, അതിനാൽ മണലീച്ചകളുള്ള പ്രദേശങ്ങൾ സന്ദർശിക്കുന്നവർ പ്രാണികളെ അകറ്റുന്ന ലേപനം കരുതുന്നു. മണലീച്ചകൾ ദുർബലമായി പറക്കുന്നവയാണ്, നേരിയ കാറ്റ് പോലും അവയെ അകറ്റിനിർത്തുന്നു.</string>
    <string name="sandfly_tutorial_system_back">മടങ്ങാൻ <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_home">ഹോം സ്ക്രീനിലേക്ക് പോകാൻ <xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_intro">ഈ ജെസ്‌ച്ചറുകൾ എല്ലാ സ്ക്രീനിലും പ്രവർത്തിക്കുന്നു. ഈ പാഠത്തിൽ, ഓരോന്നും ചെയ്യുന്നതിന് പകരം അത് എന്ത് ചെയ്യുമെന്ന് ട്യൂട്ടോറിയൽ പറയുന്നു.</string>
    <string name="sandfly_tutorial_system_notifications">അറിയിപ്പുകൾ തുറക്കാൻ <xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_overview">അടുത്തിടെയുള്ള ആപ്പുകൾ കാണിക്കാൻ <xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>.</string>
