    <string name="sandfly_tutorial_actions_archive">Gå til beskeden. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> for at gennemgå dens handlinger. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> for at udføre den handling, du hører. Udfør <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Nogle elementer har andre handlinger end aktivering, f.eks. Arkivér eller Slet for en besked. Når et sådant element har fokus, gennemgår indstillingen for oplæsning Handlinger dem.</string>
    <string name="sandfly_tutorial_actions_title">Handlinger</string>
    <string name="sandfly_tutorial_activate_button">Gå til <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> for at aktivere den.</string>
    <string name="sandfly_tutorial_activate_check_box">Markér <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> på samme måde.</string>
    <string name="sandfly_tutorial_activate_hold">Nogle elementer gør noget andet, når de holdes. Gå til <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> for at holde den.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivering virker på det element, der har fokus, uanset hvor du trykker på skærmen.</string>
    <string name="sandfly_tutorial_activate_title">Aktivering af elementer</string>
    <string name="sandfly_tutorial_back_in_lesson">Tilbage forlader ikke en lektion. Brug Indhold for at vælge en anden lektion.</string>
