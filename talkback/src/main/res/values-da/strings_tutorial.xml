    <string name="sandfly_tutorial_practice_intro">Hver bevægelse siger sit navn og sin handling i stedet for at udføre den. Flytning til næste og forrige element og aktivering virker stadig.</string>
    <string name="sandfly_tutorial_practice_step">Lav en vilkårlig bevægelse for at høre, hvad den gør. Aktivér <xliff:g id="button" example="End practice">%1$s</xliff:g> for at stoppe.</string>
