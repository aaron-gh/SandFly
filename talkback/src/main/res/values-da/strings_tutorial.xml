    <string name="sandfly_tutorial_sliders_change">Gå til skyderen <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> for at ændre dens værdi.</string>
    <string name="sandfly_tutorial_sliders_highest">Indstil <xliff:g id="slider" example="Brightness">%1$s</xliff:g> til 100 procent, dens højeste værdi.</string>
