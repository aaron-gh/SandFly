    <string name="sandfly_tutorial_recipe_3">Hæld nok dej i til at dække panden i et tyndt lag.</string>
    <string name="sandfly_tutorial_recipe_4">Vend pandekagen, når undersiden er gylden.</string>
    <string name="sandfly_tutorial_recipe_5">Server med citron og sukker.</string>
