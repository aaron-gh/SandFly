    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> மூலம் SandFly மெனுவைத் திறக்கவும். அதன் கட்டளைகளுக்கு இடையே ஸ்வைப் செய்யவும். <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> மெனுவை மூடும்.</string>
    <string name="sandfly_tutorial_menu_title">SandFly மெனு</string>
