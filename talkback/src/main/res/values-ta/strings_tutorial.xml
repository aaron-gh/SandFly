    <string name="sandfly_tutorial_forecast_today_text">வெயிலும் வெப்பமும், லேசான காற்றுடன்.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">நாளை</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">காலையில் மேகமூட்டம், மதியம் முதல் மழை.</string>
    <string name="sandfly_tutorial_forecast_weekend">வார இறுதி</string>
    <string name="sandfly_tutorial_forecast_weekend_text">சனிக்கிழமை பலத்த காற்று, ஞாயிற்றுக்கிழமை தெளிவான வானம்.</string>
    <string name="sandfly_tutorial_headings_intro">திரைகளும் இணையப் பக்கங்களும் அவற்றின் உள்ளடக்கத்தைத் தலைப்புகள் மூலம் பிரிக்கின்றன. “தலைப்புகள்” வாசிப்புக் கட்டுப்பாடு ஒரு தலைப்பிலிருந்து அடுத்ததற்குத் தாவும்.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> மூலம் அடுத்த தலைப்புக்குத் தாவவும். <xliff:g id="heading" example="Weekend">%2$s</xliff:g> என்பதற்குத் தாவவும்.</string>
