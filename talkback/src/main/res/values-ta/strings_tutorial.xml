    <string name="sandfly_tutorial_move_intro">ஸ்வைப் செய்தால் திரையில் உள்ள அடுத்த அல்லது முந்தைய உருப்படிக்கு, வாசிப்பு வரிசைப்படி, செல்லும்.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> மூலம் அடுத்த உருப்படிக்குச் செல்லவும். <xliff:g id="item" example="Eggs">%2$s</xliff:g> வரும் வரை தொடரவும்.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> மூலம் முந்தைய உருப்படிக்குச் செல்லவும். <xliff:g id="item" example="Bread">%2$s</xliff:g> என்பதற்குத் திரும்பவும்.</string>
    <string name="sandfly_tutorial_move_title">உருப்படிகளுக்கு இடையே நகர்தல்</string>
    <string name="sandfly_tutorial_name">பெயர்</string>
