    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> கட்டளைக்குச் சைகை இல்லை. “கட்டளைகள்” என்பதில் ஒன்றை ஒதுக்கவும், அல்லது “படியைத் தவிர்” என்பதைப் பயன்படுத்தவும்.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> பாடத்தில் செய்யப்படாது. பயிற்சியிலிருந்து வெளியேற, “உள்ளடக்கம்” என்பதில் உள்ள “பயிற்சியை மூடு” என்பதைப் பயன்படுத்தவும்.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> பாடத்தில் செய்யப்படாது.</string>
    <string name="sandfly_tutorial_pause_intro">ஒரு உருப்படியின் நடுவில் பேச்சை இடைநிறுத்தி, நின்ற இடத்திலிருந்து தொடரலாம்.</string>
    <string name="sandfly_tutorial_pause_pause">கீழே உள்ள கதைக்குச் செல்லவும். அது வாசிக்கப்படும்போது <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> மூலம் பேச்சை இடைநிறுத்தவும், மீண்டும் செய்து தொடரவும்.</string>
    <string name="sandfly_tutorial_pause_resume">மீண்டும் <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> மூலம் பேச்சைத் தொடரவும்.</string>
    <string name="sandfly_tutorial_pause_title">பேச்சை இடைநிறுத்துதல்</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">ஒவ்வொரு சைகையும் செயல்படுவதற்குப் பதிலாகத் தன் பெயரையும் செயலையும் சொல்லும். அடுத்த, முந்தைய உருப்படிக்குச் செல்லுதலும் செயல்படுத்துதலும் வழக்கம்போல் வேலை செய்யும்.</string>
    <string name="sandfly_tutorial_practice_step">ஏதேனும் சைகை என்ன செய்யும் என்று கேட்க அதைச் செய்யவும். நிறுத்த, <xliff:g id="button" example="End practice">%1$s</xliff:g> என்பதைச் செயல்படுத்தவும்.</string>
    <string name="sandfly_tutorial_practice_title">சைகைப் பயிற்சி</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">வாசிப்புக் கட்டுப்பாட்டை <xliff:g id="reading_control" example="Characters">%2$s</xliff:g> என மாற்றவும். <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> மூலம் ஒரு எழுத்து நகரவும்.</string>
    <string name="sandfly_tutorial_reading_controls_intro">மேலும் கீழும் ஸ்வைப் செய்தால் என்ன நடக்கும் என்பதை வாசிப்புக் கட்டுப்பாடுகள் தீர்மானிக்கின்றன, எ.கா. சொல் சொல்லாக அல்லது எழுத்து எழுத்தாக நகர்தல், பேச்சு வீதத்தை மாற்றுதல். வலப்புறமும் இடப்புறமும் ஸ்வைப் செய்தால் உருப்படிகளுக்கு இடையே நகர்வது மாறாது.</string>
    <string name="sandfly_tutorial_reading_controls_move">கீழே உள்ள வாக்கியத்திற்குச் செல்லவும்.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> மூலம் அடுத்த சொல்லுக்குச் செல்லவும். மூன்று சொற்கள் நகரவும்.</string>
    <string name="sandfly_tutorial_reading_controls_title">வாசிப்புக் கட்டுப்பாடுகள்</string>
    <string name="sandfly_tutorial_recipe_1">பான்கேக்: மாவு, முட்டை, பால் ஆகியவற்றைக் கலந்து மென்மையான மாவுக் கலவையாக்கவும்.</string>
    <string name="sandfly_tutorial_recipe_2">வாணலியில் சிறிது வெண்ணெயைச் சூடாக்கவும்.</string>
    <string name="sandfly_tutorial_recipe_3">வாணலியை மெல்லியதாக மூடும் அளவுக்கு மாவுக் கலவையை ஊற்றவும்.</string>
    <string name="sandfly_tutorial_recipe_4">அடிப்பகுதி பொன்னிறமானதும் பான்கேக்கைத் திருப்பவும்.</string>
    <string name="sandfly_tutorial_recipe_5">எலுமிச்சை, சர்க்கரையுடன் பரிமாறவும்.</string>
    <string name="sandfly_tutorial_scrolling_intro">பட்டியல்கள் ஒரு நேரத்தில் சில உருப்படிகளை மட்டுமே காட்டும். காட்டப்படும் கடைசி உருப்படியைத் தாண்டி ஸ்வைப் செய்தால் பட்டியல் நகரும்.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> மூலம் ஒரு பக்கம் முன்னோக்கி நகர்த்தவும்.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> மூலம் <xliff:g id="item" example="Item 15">%2$s</xliff:g> வரும் வரை பட்டியலில் செல்லவும்.</string>
    <string name="sandfly_tutorial_scrolling_title">பட்டியல்களை நகர்த்துதல்</string>
    <string name="sandfly_tutorial_sentence">வேகமான பழுப்பு நரி சோம்பேறி நாயின் மேல் தாவுகிறது.</string>
    <string name="sandfly_tutorial_skip_step">படியைத் தவிர்</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> ஸ்லைடருக்குச் செல்லவும். <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> அல்லது <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> மூலம் அதன் மதிப்பை மாற்றவும்.</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> என்பதை அதன் அதிகபட்ச மதிப்பான 100 சதவீதத்திற்கு அமைக்கவும்.</string>
    <string name="sandfly_tutorial_sliders_intro">ஸ்லைடரில் ஃபோகஸ் இருக்கும்போது, மேலும் கீழும் ஸ்வைப் செய்தால் அதன் மதிப்பு மாறும்.</string>
    <string name="sandfly_tutorial_sliders_title">ஸ்லைடர்கள்</string>
    <string name="sandfly_tutorial_step">படி <xliff:g id="number" example="1">%1$d</xliff:g>/<xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">மணல் ஈக்கள் கடற்கரைகளிலும் ஆற்றங்கரைகளிலும் காடுகளிலும் வாழும் சிறிய ஈக்கள். காற்று அசையாமல் இருக்கும் விடியலிலும் அந்தியிலும் அவை மிகவும் சுறுசுறுப்பாக இருக்கும். பெண் ஈக்கள் மட்டுமே கடிக்கும், ஏனெனில் முட்டையிட அவற்றுக்கு இரத்தம் தேவை. கடித்த இடம் பல நாட்கள் அரிக்கும், அதனால் மணல் ஈக்கள் உள்ள பகுதிகளுக்குச் செல்பவர்கள் பூச்சி விரட்டியை எடுத்துச் செல்வார்கள். மணல் ஈக்கள் பலவீனமாகப் பறக்கும், லேசான காற்றுகூட அவற்றை விலக்கி வைக்கும்.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> மூலம் பின்செல்லவும்.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> மூலம் முகப்புத் திரைக்குச் செல்லவும்.</string>
    <string name="sandfly_tutorial_system_intro">இந்தச் சைகைகள் எல்லாத் திரைகளிலும் வேலை செய்யும். இந்தப் பாடத்தில், ஒவ்வொன்றையும் செய்வதற்குப் பதிலாக அது என்ன செய்யும் என்று பயிற்சி சொல்லும்.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> மூலம் அறிவிப்புகளைத் திறக்கவும்.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> மூலம் சமீபத்திய ஆப்ஸைக் காட்டவும்.</string>
    <string name="sandfly_tutorial_system_title">பின்செல், முகப்பு, அறிவிப்புகள்</string>
    <string name="sandfly_tutorial_tile_cloud">மேகம்</string>
    <string name="sandfly_tutorial_tile_moon">நிலா</string>
    <string name="sandfly_tutorial_tile_star">நட்சத்திரம்</string>
    <string name="sandfly_tutorial_tile_sun">சூரியன்</string>
    <string name="sandfly_tutorial_title">SandFly பயிற்சி</string>
    <string name="sandfly_tutorial_typing_delete">கீபோர்டின் நீக்கு விசை மூலம் கடைசி எழுத்தை நீக்கவும்.</string>
    <string name="sandfly_tutorial_typing_intro">உரைப் புலத்தைச் செயல்படுத்தினால் கீபோர்டு திறக்கும். விசையைக் கேட்க அதைத் தொடவும், டைப் செய்ய விரலை எடுக்கவும்.</string>
    <string name="sandfly_tutorial_typing_open"><xliff:g id="field" example="Name">%2$s</xliff:g> புலத்திற்குச் செல்லவும். <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> மூலம் டைப் செய்யத் தொடங்கவும்.</string>
    <string name="sandfly_tutorial_typing_title">டைப் செய்தல்</string>
    <string name="sandfly_tutorial_typing_type"><xliff:g id="word" example="cat">%1$s</xliff:g> என்ற சொல்லை டைப் செய்யவும்.</string>
    <string name="sandfly_tutorial_typing_word">பால்</string>
    <string name="sandfly_tutorial_welcome_intro">இந்தப் பயிற்சி SandFly-இன் சைகைகளைக் கற்பிக்கிறது. ஒவ்வொரு பாடமும் ஒரு வழிமுறையைத் தரும், நீங்கள் உங்கள் சைகைகள் மூலம் அதைச் செய்யும் வரை காத்திருக்கும், பிறகு அடுத்ததைத் தரும். வழிமுறை என்பது பாடத்தின் பெயருக்குப் பிறகு உள்ள முதல் உருப்படி. “உள்ளடக்கம்” எல்லாப் பாடங்களையும் பட்டியலிடும், நீங்கள் இருந்த பாடத்திலேயே பயிற்சி மீண்டும் திறக்கும்.</string>
    <string name="sandfly_tutorial_welcome_start">திரையில் எங்கேனும் <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> மூலம் தொடங்கவும்.</string>
    <string name="sandfly_tutorial_welcome_title">வரவேற்கிறோம்</string>
</resources>
