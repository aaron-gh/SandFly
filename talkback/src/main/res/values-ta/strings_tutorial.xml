    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> அல்லது <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> மூலம் வாசிப்புக் கட்டுப்பாட்டை மாற்றவும். <xliff:g id="reading_control" example="Words">%3$s</xliff:g> என்பதைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="sandfly_tutorial_close">பயிற்சியை மூடு</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> மூலம் SandFly கடைசியாகச் சொன்ன உரையைக் கிளிப்போர்டுக்கு நகலெடுக்கலாம்.</string>
    <string name="sandfly_tutorial_commands_intro">இந்தக் கட்டளைகள் எல்லாத் திரைகளிலும் வேலை செய்யும்.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> மூலம் திரையில் உரையைத் தேடலாம். இந்தப் பாடத்தில், அதைச் செய்வதற்குப் பதிலாக அது என்ன செய்யும் என்று பயிற்சி சொல்லும்.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> மூலம் பேச்சை முடக்கலாம், மீண்டும் செய்தால் இயக்கலாம். இந்தப் பாடத்தில், அதைச் செய்வதற்குப் பதிலாக அது என்ன செய்யும் என்று பயிற்சி சொல்லும்.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> மூலம் நேரம், பேட்டரி நிலை, பிற நிலைத் தகவல்களைக் கேட்கலாம்.</string>
    <string name="sandfly_tutorial_commands_title">பயனுள்ள கட்டளைகள்</string>
    <string name="sandfly_tutorial_contents">உள்ளடக்கம்</string>
    <string name="sandfly_tutorial_contents_intro">பாடங்கள், வரிசைப்படி. ஒவ்வொன்றையும் தனியாகத் திறக்கலாம்.</string>
    <string name="sandfly_tutorial_continuous_intro">ஸ்வைப் செய்யாமலேயே ஃபோகஸ் செய்த உருப்படியிலிருந்து திரையின் இறுதி வரை SandFly வாசிக்கும். திரையைத் தொட்டால் வாசிப்பு நிற்கும்.</string>
    <string name="sandfly_tutorial_continuous_move">சமையல் குறிப்பின் முதல் வரிக்குச் செல்லவும்.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> மூலம் ஃபோகஸ் செய்த உருப்படியிலிருந்து வாசிக்கவும்.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> மூலம் SandFly மெனுவைத் திறந்து, <xliff:g id="command" example="Read from focused item">%2$s</xliff:g> என்பதைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="sandfly_tutorial_continuous_title">தொடர்ந்து வாசித்தல்</string>
    <string name="sandfly_tutorial_details">விவரங்கள்</string>
    <string name="sandfly_tutorial_details_shown">2 பேருக்கான மேசை, இரவு 7 மணி, ஜன்னல் அருகே.</string>
    <string name="sandfly_tutorial_done">முடிந்தது</string>
