    <string name="title_pref_sound_themes">ஒலி தீம்கள்</string>
    <string name="summary_pref_sound_themes">ஒலிகள் மற்றும் அதிர்வுகளின் தொகுப்புகளை நிறுவி தேர்வு செய்யவும், ஒற்றை ஒலிகளை உங்கள் சொந்த ஒலியுடன் மாற்றவும், மேலும் கட்டுப்பாட்டு ஒலிகள் மற்றும் அதிர்வுகள் மற்றும் 3D ஆடியோவை இயக்கவும்.</string>
    <string name="sound_themes_installed_category">நிறுவப்பட்ட தீம்கள்</string>
    <string name="sound_theme_backtalk">SandFly</string>
    <string name="sound_theme_backtalk_description">SandFly இன் சொந்த ஒலிகள் மற்றும் அதிர்வுகள் மற்றும் உங்கள் சொந்த ஒலிகள்.</string>
    <string name="sound_theme_in_use">பயன்பாட்டில் உள்ளது</string>
