    <string name="dialog_title_pause_backtalk">SandFly-ஐ இடைநிறுத்தவா?</string>
    <string name="dialog_button_pause_backtalk">இடைநிறுத்து</string>
    <string name="dialog_message_pause_backtalk">SandFly இடைநிறுத்தப்பட்டிருக்கும்போது அது பேசாது, சைகைகளுக்குப் பதிலளிக்காது. திரை வாசிப்பான் இயக்கத்தில் இல்லாதது போலத் திரை செயல்படும்.</string>
    <string name="message_resume_keyguard">தொடர, “SandFly இடைநிறுத்தப்பட்டது” அறிவிப்பைத் தட்டவும், ஒலியளவைக் குறைக்கும் பட்டனை விரைவாக 3 முறை அழுத்தவும் அல்லது பூட்டுத் திரை தோன்றும்படி ஃபோனைப் பூட்டி மீண்டும் எழுப்பவும்.</string>
    <string name="message_resume_screen_on">தொடர, “SandFly இடைநிறுத்தப்பட்டது” அறிவிப்பைத் தட்டவும், ஒலியளவைக் குறைக்கும் பட்டனை விரைவாக 3 முறை அழுத்தவும் அல்லது திரையை அணைத்து மீண்டும் இயக்கவும்.</string>
    <string name="message_resume_manual">தொடர, “SandFly இடைநிறுத்தப்பட்டது” அறிவிப்பைத் தட்டவும் அல்லது ஒலியளவைக் குறைக்கும் பட்டனை விரைவாக 3 முறை அழுத்தவும்.</string>
    <string name="message_resume_key_combo">நீங்கள் <xliff:g id="key_combo" example="Alt + P">%1$s</xliff:g> ஐயும் அழுத்தலாம்.</string>
    <string name="title_pref_resume_backtalk">SandFly-ஐ மீண்டும் தொடங்குதல்</string>
    <string name="value_resume_keyguard">பூட்டுத் திரை தோன்றும்போது</string>
    <string name="value_resume_screen_on">திரை இயக்கப்படும் போது</string>
    <string name="value_resume_manual">அறிவிப்பு அல்லது குறுக்குவழியிலிருந்து மட்டுமே</string>
