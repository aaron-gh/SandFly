    <string name="title_pause_backtalk">SandFly-ஐ இடைநிறுத்து</string>
    <string name="summary_pause_backtalk">SandFly-ஐ மீண்டும் தொடங்கும் வரை பேச்சு, சைகைகள், “தொடுவதன் மூலம் அறிக” ஆகியவற்றை முடக்கும்</string>
