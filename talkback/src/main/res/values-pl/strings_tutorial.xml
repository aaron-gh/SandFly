<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Przejdź do wiadomości. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> lub <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>, aby przejrzeć jej czynności. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>, aby wykonać usłyszaną czynność. Wykonaj czynność <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Niektóre elementy mają czynności inne niż aktywacja, np. Archiwizuj lub Usuń dla wiadomości. Gdy taki element jest zaznaczony, opcja sterowania czytaniem Czynności przechodzi przez nie.</string>
    <string name="sandfly_tutorial_actions_title">Czynności</string>
    <string name="sandfly_tutorial_activate_button">Przejdź do elementu <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>, aby go aktywować.</string>
    <string name="sandfly_tutorial_activate_check_box">W ten sam sposób zaznacz pole <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_hold">Niektóre elementy po przytrzymaniu robią coś innego. Przejdź do elementu <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>, aby go przytrzymać.</string>
    <string name="sandfly_tutorial_activate_intro">Aktywacja działa na zaznaczonym elemencie, niezależnie od tego, gdzie dotkniesz ekranu.</string>
    <string name="sandfly_tutorial_activate_title">Aktywowanie elementów</string>
    <string name="sandfly_tutorial_back_in_lesson">Wstecz nie opuszcza lekcji. Aby wybrać inną lekcję, użyj przycisku Spis treści.</string>
    <string name="sandfly_tutorial_bell">Zadzwoń dzwonkiem</string>
    <string name="sandfly_tutorial_bell_rung">Liczba dzwonień: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Jasność</string>
    <string name="sandfly_tutorial_chapter_basics">Podstawy</string>
    <string name="sandfly_tutorial_chapter_controls">Elementy sterujące i tekst</string>
    <string name="sandfly_tutorial_chapter_getting_around">Poruszanie się</string>
    <string name="sandfly_tutorial_chapter_practice">Ćwiczenia</string>
    <string name="sandfly_tutorial_chapter_reading">Czytanie</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> lub <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>, aby zmienić opcję sterowania czytaniem. Wybierz <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Zamknij samouczek</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>, aby skopiować do schowka ostatni tekst wypowiedziany przez SandFly.</string>
    <string name="sandfly_tutorial_commands_intro">Te polecenia działają na każdym ekranie.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>, aby wyszukać tekst na ekranie. W tej lekcji samouczek zamiast tego mówi, co robi ten gest.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>, aby wyłączyć mowę, i ponownie, aby ją włączyć. W tej lekcji samouczek zamiast tego mówi, co robi ten gest.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>, aby usłyszeć godzinę, poziom baterii i inne informacje o stanie.</string>
    <string name="sandfly_tutorial_commands_title">Przydatne polecenia</string>
    <string name="sandfly_tutorial_contents">Spis treści</string>
    <string name="sandfly_tutorial_contents_intro">Lekcje w kolejności. Każdą można otworzyć osobno.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly może czytać od zaznaczonego elementu do końca ekranu bez przesuwania palcem. Dotknięcie ekranu zatrzymuje czytanie.</string>
    <string name="sandfly_tutorial_continuous_move">Przejdź do pierwszego wiersza przepisu.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g>, aby czytać od zaznaczonego elementu.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>, aby otworzyć menu SandFly, a następnie wybierz <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_title">Czytanie ciągłe</string>
    <string name="sandfly_tutorial_details">Szczegóły</string>
    <string name="sandfly_tutorial_details_shown">Stolik dla 2 osób na 19:00, przy oknie.</string>
    <string name="sandfly_tutorial_done">Ukończono</string>
    <string name="sandfly_tutorial_end_practice">Zakończ ćwiczenie</string>
    <string name="sandfly_tutorial_explore_activate">Dotknij elementu Gwiazda i podnieś palec. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> w dowolnym miejscu, aby go aktywować.</string>
    <string name="sandfly_tutorial_explore_find">Przesuwaj jednym palcem po ekranie i znajdź cztery kwadraty: Słońce, Księżyc, Gwiazda i Chmura.</string>
    <string name="sandfly_tutorial_explore_intro">Dotknięcie ekranu odczytuje element pod palcem. Dotknięcie elementu nie aktywuje go.</string>
    <string name="sandfly_tutorial_explore_title">Czytanie dotykiem</string>
    <string name="sandfly_tutorial_extra_cheese">Dodatkowy ser</string>
    <string name="sandfly_tutorial_finish">Zakończ samouczek</string>
    <string name="sandfly_tutorial_forecast_today">Dziś</string>
    <string name="sandfly_tutorial_forecast_today_text">Słonecznie i ciepło, słaby wiatr.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Jutro</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Rano pochmurno, od południa deszcz.</string>
    <string name="sandfly_tutorial_forecast_weekend">Weekend</string>
    <string name="sandfly_tutorial_forecast_weekend_text">W sobotę wietrznie, w niedzielę bezchmurnie.</string>
    <string name="sandfly_tutorial_headings_intro">Ekrany i strony internetowe dzielą treść nagłówkami. Opcja sterowania czytaniem Nagłówki przeskakuje od jednego nagłówka do następnego.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>, aby przejść do następnego nagłówka. Przejdź do nagłówka <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_headings_title">Nagłówki</string>
    <string name="sandfly_tutorial_item_apples">Jabłka</string>
    <string name="sandfly_tutorial_item_bread">Chleb</string>
    <string name="sandfly_tutorial_item_cheese">Ser</string>
    <string name="sandfly_tutorial_item_dates">Daktyle</string>
    <string name="sandfly_tutorial_item_eggs">Jajka</string>
    <string name="sandfly_tutorial_lesson_complete">Lekcja ukończona.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Lekcja ukończona. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>, aby zakończyć samouczek.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Lekcja ukończona. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>, aby rozpocząć następną lekcję.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, lekcja <xliff:g id="number" example="3">%2$d</xliff:g> z <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">Element <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>, aby zamknąć menu.</string>
    <string name="sandfly_tutorial_menu_intro">Menu SandFly zawiera polecenia dla zaznaczonego elementu i bieżącego ekranu.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>, aby otworzyć menu SandFly. Przesuwaj palcem, aby przejrzeć polecenia. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g>, aby zamknąć menu.</string>
    <string name="sandfly_tutorial_menu_title">Menu SandFly</string>
    <string name="sandfly_tutorial_message">Wiadomość od Sama: obiad w południe?</string>
    <string name="sandfly_tutorial_message_archive">Archiwizuj</string>
    <string name="sandfly_tutorial_message_delete">Usuń</string>
    <string name="sandfly_tutorial_message_reply">Odpowiedz</string>
    <string name="sandfly_tutorial_move_intro">Przesunięcie palcem przechodzi do następnego lub poprzedniego elementu na ekranie, w kolejności czytania.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>, aby przejść do następnego elementu. Kontynuuj, aż dojdziesz do elementu <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>, aby przejść do poprzedniego elementu. Wróć do elementu <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Przechodzenie między elementami</string>
    <string name="sandfly_tutorial_name">Imię</string>
    <string name="sandfly_tutorial_next_lesson">Następna lekcja: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> nie ma gestu. Przypisz go w sekcji Polecenia lub użyj przycisku Pomiń krok.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> nie działa w lekcji. Aby opuścić samouczek, użyj przycisku Zamknij samouczek w spisie treści.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> nie działa w lekcji.</string>
    <string name="sandfly_tutorial_pause_intro">Mowę można wstrzymać w środku elementu i wznowić tam, gdzie się zatrzymała.</string>
    <string name="sandfly_tutorial_pause_pause">Przejdź do opowiadania poniżej. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> podczas jego czytania, aby wstrzymać mowę, i ponownie, aby ją wznowić.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> ponownie, aby wznowić mowę.</string>
    <string name="sandfly_tutorial_pause_title">Wstrzymywanie mowy</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Każdy gest wypowiada swoją nazwę i czynność zamiast ją wykonywać. Przechodzenie do następnego i poprzedniego elementu oraz aktywacja nadal działają.</string>
    <string name="sandfly_tutorial_practice_step">Wykonaj dowolny gest, aby usłyszeć, co robi. Aby zakończyć, aktywuj <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Ćwiczenie gestów</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> z <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Zmień opcję sterowania czytaniem na <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>, aby przejść o jeden znak.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Sterowanie czytaniem określa, co robi przesuwanie palcem w górę i w dół, np. przechodzenie o słowo lub o znak albo zmiana szybkości mowy. Przesuwanie w prawo i w lewo nadal przechodzi między elementami.</string>
    <string name="sandfly_tutorial_reading_controls_move">Przejdź do zdania poniżej.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>, aby przejść do następnego słowa. Przejdź o trzy słowa.</string>
    <string name="sandfly_tutorial_reading_controls_title">Sterowanie czytaniem</string>
    <string name="sandfly_tutorial_recipe_1">Naleśniki: wymieszaj mąkę, jajka i mleko na gładkie ciasto.</string>
    <string name="sandfly_tutorial_recipe_2">Rozgrzej odrobinę masła na patelni.</string>
    <string name="sandfly_tutorial_recipe_3">Wlej tyle ciasta, aby cienko pokryło patelnię.</string>
    <string name="sandfly_tutorial_recipe_4">Przewróć naleśnik, gdy spód będzie złocisty.</string>
    <string name="sandfly_tutorial_recipe_5">Podawaj z cytryną i cukrem.</string>
    <string name="sandfly_tutorial_scrolling_intro">Listy pokazują naraz tylko część elementów. Przesunięcie za ostatni widoczny element przewija listę.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>, aby przewinąć o stronę do przodu.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>, aby przechodzić przez listę, aż dojdziesz do elementu <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Przewijanie list</string>
    <string name="sandfly_tutorial_sentence">Szybki brązowy lis przeskakuje nad leniwym psem.</string>
    <string name="sandfly_tutorial_skip_step">Pomiń krok</string>
    <string name="sandfly_tutorial_sliders_change">Przejdź do suwaka <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> lub <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>, aby zmienić jego wartość.</string>
    <string name="sandfly_tutorial_sliders_highest">Ustaw suwak <xliff:g id="slider" example="Brightness">%1$s</xliff:g> na 100 procent, czyli najwyższą wartość.</string>
    <string name="sandfly_tutorial_sliders_intro">Gdy suwak jest zaznaczony, przesuwanie palcem w górę i w dół zmienia jego wartość.</string>
    <string name="sandfly_tutorial_sliders_title">Suwaki</string>
    <string name="sandfly_tutorial_step">Krok <xliff:g id="number" example="1">%1$d</xliff:g> z <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Muszki piaskowe to małe muchy, które żyją na plażach, nad brzegami rzek i w lasach. Są najbardziej aktywne o świcie i o zmierzchu, gdy powietrze jest nieruchome. Gryzą tylko samice, bo potrzebują krwi do wytworzenia jaj. Ugryzienia swędzą przez wiele dni, więc osoby odwiedzające tereny muszek piaskowych noszą przy sobie środek odstraszający owady. Muszki piaskowe słabo latają i nawet lekki wiatr trzyma je z daleka.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>, aby wrócić.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>, aby przejść do ekranu głównego.</string>
    <string name="sandfly_tutorial_system_intro">Te gesty działają na każdym ekranie. W tej lekcji samouczek mówi, co robi każdy z nich, zamiast go wykonywać.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>, aby otworzyć powiadomienia.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>, aby pokazać ostatnie aplikacje.</string>
    <string name="sandfly_tutorial_system_title">Wstecz, ekran główny i powiadomienia</string>
    <string name="sandfly_tutorial_tile_cloud">Chmura</string>
    <string name="sandfly_tutorial_tile_moon">Księżyc</string>
    <string name="sandfly_tutorial_tile_star">Gwiazda</string>
    <string name="sandfly_tutorial_tile_sun">Słońce</string>
    <string name="sandfly_tutorial_title">Samouczek SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Usuń ostatnią literę klawiszem usuwania na klawiaturze.</string>
    <string name="sandfly_tutorial_typing_intro">Aktywacja pola tekstowego otwiera klawiaturę. Dotknij klawisza, aby go usłyszeć, i podnieś palec, aby go wpisać.</string>
    <string name="sandfly_tutorial_typing_open">Przejdź do pola <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>, aby zacząć pisać.</string>
    <string name="sandfly_tutorial_typing_title">Pisanie</string>
    <string name="sandfly_tutorial_typing_type">Wpisz słowo <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">kot</string>
    <string name="sandfly_tutorial_welcome_intro">Ten samouczek uczy gestów SandFly. Każda lekcja podaje instrukcję, czeka, aż wykonasz ją własnymi gestami, a potem podaje następną. Instrukcja jest pierwszym elementem po nazwie lekcji. Spis treści zawiera wszystkie lekcje, a samouczek otwiera się ponownie na ostatnio otwartej lekcji.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> w dowolnym miejscu ekranu, aby rozpocząć.</string>
    <string name="sandfly_tutorial_welcome_title">Witaj</string>
</resources>
