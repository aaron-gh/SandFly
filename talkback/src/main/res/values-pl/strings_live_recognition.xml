    <string name="live_recognition_title">Rozpoznawanie na żywo</string>
    <string name="live_recognition_hint">Przesuń palcem w górę lub w dół, aby wybrać tryb, a następnie kliknij dwukrotnie, aby go włączyć lub wyłączyć</string>
    <string name="live_recognition_scenes">Sceny</string>
    <string name="live_recognition_text">Tekst</string>
    <string name="live_recognition_point">Wskaż i czytaj</string>
    <string name="live_recognition_people">Wykrywanie osób</string>
    <string name="live_recognition_doors">Wykrywanie drzwi</string>
    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">Skieruj tylny aparat na to, co chcesz opisać. W trybie „Wskaż i czytaj” wskaż palcem tekst widoczny w obrazie z aparatu. Opisy mogą być błędne. Nie traktuj ich jako wskazówek zapewniających bezpieczne poruszanie się.</string>
    <string name="live_recognition_camera_off">Aparat wyłączony</string>
    <string name="live_recognition_camera_on">Aparat włączony</string>
    <string name="live_recognition_connecting">Łączenie z Gemini…</string>
    <string name="live_recognition_cloud_title">Wysyłać obrazy z aparatu do Gemini?</string>
    <string name="live_recognition_cloud_message">W trybach „Sceny”, „Wskaż i czytaj”, „Wykrywanie osób” i „Wykrywanie drzwi” obraz z aparatu jest co kilka sekund wysyłany do interfejsu Gemini API firmy Google. Rozpoznawanie tekstu odbywa się na telefonie.\n\nJeśli używasz bezpłatnego klucza API, Google może przechowywać otrzymane dane, wykorzystywać je do ulepszania swoich produktów i przekazywać je ludziom do przeglądu. Generatywna AI jest eksperymentalna i będzie popełniać błędy.</string>
    <string name="live_recognition_service_title">Wysyłać obrazy z aparatu do <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">W trybach „Sceny”, „Wskaż i czytaj”, „Wykrywanie osób” i „Wykrywanie drzwi” obraz z aparatu jest co kilka sekund wysyłany do usługi <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>. Rozpoznawanie tekstu odbywa się na telefonie.\n\nObowiązują warunki korzystania i polityka prywatności tej usługi. Generatywna AI jest eksperymentalna i będzie popełniać błędy.</string>
