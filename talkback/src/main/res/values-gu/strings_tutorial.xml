    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> પાઠમાં થતું નથી. ટ્યૂટૉરિઅલ છોડવા માટે, “અનુક્રમણિકા”માં “ટ્યૂટૉરિઅલ બંધ કરો”નો ઉપયોગ કરો.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> પાઠમાં થતું નથી.</string>
    <string name="sandfly_tutorial_pause_intro">આઇટમની વચ્ચે સ્પીચ થોભાવી શકાય છે, અને જ્યાં અટકી હતી ત્યાંથી ફરી શરૂ કરી શકાય છે.</string>
    <string name="sandfly_tutorial_pause_pause">નીચેની વાર્તા પર જાઓ. તે વંચાતી હોય ત્યારે સ્પીચ થોભાવવા માટે <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>, અને ફરી શરૂ કરવા માટે ફરીથી.</string>
    <string name="sandfly_tutorial_pause_resume">સ્પીચ ફરી શરૂ કરવા માટે ફરીથી <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_pause_title">સ્પીચ થોભાવવી</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">દરેક સંકેત કરવાને બદલે તેનું નામ અને ક્રિયા બોલે છે. આગલી અને પાછલી આઇટમ પર જવું અને સક્રિય કરવું હજુ પણ કામ કરે છે.</string>
    <string name="sandfly_tutorial_practice_step">કોઈપણ સંકેત શું કરે છે તે સાંભળવા માટે તે કરો. રોકવા માટે, <xliff:g id="button" example="End practice">%1$s</xliff:g> સક્રિય કરો.</string>
    <string name="sandfly_tutorial_practice_title">સંકેતોનો અભ્યાસ</string>
