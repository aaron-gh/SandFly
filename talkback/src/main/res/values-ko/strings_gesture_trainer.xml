    <string name="gesture_trainer_repeat">반복</string>
    <string name="gesture_trainer_finish">완료</string>
    <string name="gesture_trainer_group_done"><xliff:g id="group">%1$s</xliff:g>의 모든 연습을 마쳤습니다.</string>
    <string name="gesture_trainer_open_setting">‘<xliff:g id="setting">%1$s</xliff:g>’ 변경</string>
    <string name="gesture_trainer_measure_duration"><xliff:g id="ms">%1$d</xliff:g> ms 걸림</string>
    <string name="gesture_trainer_measure_length">길이 <xliff:g id="cm">%1$.1f</xliff:g>cm</string>
    <string name="gesture_trainer_measure_speed">초당 <xliff:g id="speed">%1$.0f</xliff:g>cm</string>
    <string name="gesture_trainer_measure_angle">직선에서 <xliff:g id="degrees">%1$.0f</xliff:g>도 벗어남</string>
    <string name="gesture_trainer_measure_start">첫 1cm에 <xliff:g id="ms">%1$d</xliff:g> ms</string>
    <string name="gesture_trainer_measure_landing">손가락이 <xliff:g id="ms">%1$d</xliff:g> ms 간격으로 닿음</string>
    <string name="gesture_trainer_measure_tap">탭 <xliff:g id="ms">%1$d</xliff:g> ms</string>
    <string name="gesture_trainer_measure_gap">탭 사이 <xliff:g id="ms">%1$d</xliff:g> ms</string>
    <string name="gesture_trainer_measure_spread">손가락이 <xliff:g id="mm">%1$.0f</xliff:g>mm 움직임</string>
    <string name="gesture_trainer_measure_rotation"><xliff:g id="degrees">%1$.0f</xliff:g>도 회전</string>
    <string name="gesture_trainer_measure_corner">모서리의 가장자리에서 <xliff:g id="mm">%1$.0f</xliff:g>mm</string>
