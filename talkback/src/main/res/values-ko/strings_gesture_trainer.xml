<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="gesture_trainer_title">동작 트레이너</string>
    <string name="gesture_trainer_intro">동작 그룹을 선택하세요. 각 연습에서 동작 하나를 설명합니다. 동작을 <xliff:g id="tries">%1$d</xliff:g>번 하세요. 각 시도의 결과가 음성으로 출력됩니다. 마지막 시도 후 화면에 각 시도의 측정값, 고칠 점, 관련 설정이 표시됩니다.</string>
    <string name="gesture_trainer_group_one_finger">한 손가락</string>
    <string name="gesture_trainer_group_two_fingers">두 손가락</string>
    <string name="gesture_trainer_group_three_fingers">세 손가락</string>
    <string name="gesture_trainer_group_four_fingers">네 손가락</string>
    <string name="gesture_trainer_group_pinch_rotate_scrub">핀치, 회전 및 문지르기</string>
    <string name="gesture_trainer_group_count"><xliff:g id="group">%1$s</xliff:g>, 연습 <xliff:g id="count">%2$d</xliff:g>개</string>
    <string name="gesture_trainer_close">닫기</string>
    <string name="gesture_trainer_no_detection">동작 트레이너를 사용하려면 Android 13 이상이 필요합니다.</string>
    <string name="gesture_trainer_left_out_swipes_before_lift">왕복 및 연속 동작은 제외됩니다: ‘<xliff:g id="setting">%1$s</xliff:g>’ 설정이 켜져 있습니다.</string>
    <string name="gesture_trainer_left_out_two_finger_swipes">두 손가락 스와이프는 제외됩니다: ‘<xliff:g id="setting">%1$s</xliff:g>’ 설정이 꺼져 있어 앱이 스크롤됩니다.</string>
    <string name="gesture_trainer_exercise_heading">연습 <xliff:g id="count">%2$d</xliff:g>개 중 <xliff:g id="number">%1$d</xliff:g>번째: <xliff:g id="gesture">%3$s</xliff:g></string>
    <string name="gesture_trainer_start">시작</string>
    <string name="gesture_trainer_skip">이 연습 건너뛰기</string>
    <string name="gesture_trainer_back_to_groups">그룹으로 돌아가기</string>
    <string name="gesture_trainer_go">화면의 아무 곳에서나 동작을 <xliff:g id="tries">%1$d</xliff:g>번 하세요. 터치할 때마다 한 번의 시도입니다.</string>
    <string name="gesture_trainer_fingers_1">한 손가락</string>
    <string name="gesture_trainer_fingers_2">약 1cm 간격으로 나란히 놓은 두 손가락</string>
    <string name="gesture_trainer_fingers_3">살짝 벌려 나란히 놓은 세 손가락</string>
    <string name="gesture_trainer_fingers_4">살짝 벌려 나란히 놓은 네 손가락</string>
    <string name="gesture_trainer_direction_up">위로</string>
    <string name="gesture_trainer_direction_down">아래로</string>
    <string name="gesture_trainer_direction_left">왼쪽으로</string>
    <string name="gesture_trainer_direction_right">오른쪽으로</string>
    <string name="gesture_trainer_how_swipe"><xliff:g id="fingers">%1$s</xliff:g>으로 화면을 터치하고 기다리지 말고 <xliff:g id="direction">%2$s</xliff:g> 직선으로 약 2~3cm 민 다음 손가락을 떼세요. 바로 움직이기 시작하세요. 손가락이 먼저 멈춰 있으면 터치하여 탐색이 시작됩니다.</string>
    <string name="gesture_trainer_how_swipe_multi">손가락을 동시에 함께 내려놓고 모두 같은 방향으로 움직이세요. 모든 손가락이 처음부터 끝까지 <xliff:g id="direction">%1$s</xliff:g> 가야 하므로 직선을 유지하세요.</string>
    <string name="gesture_trainer_how_back_and_forth">한 손가락으로 화면을 터치하고 <xliff:g id="first">%1$s</xliff:g> 약 2cm 민 다음, 손가락을 떼지 말고 곧바로 <xliff:g id="second">%2$s</xliff:g> 약 2cm 되돌아온 후 손가락을 떼세요. 빠르고 매끄러운 한 동작으로 하세요.</string>
    <string name="gesture_trainer_how_angle"><xliff:g id="fingers">%1$s</xliff:g>으로 화면을 터치하고 <xliff:g id="first">%2$s</xliff:g> 약 2cm 민 다음, 손가락을 떼지 말고 방향을 급하게 꺾어 <xliff:g id="second">%3$s</xliff:g> 약 2cm 밀고 손가락을 떼세요. 곡선이 아니라 L자처럼 꺾인 모서리가 되도록 하세요.</string>
    <string name="gesture_trainer_taps_1">한 번</string>
    <string name="gesture_trainer_taps_2">두 번</string>
    <string name="gesture_trainer_taps_3">세 번</string>
    <string name="gesture_trainer_taps_4">네 번</string>
    <string name="gesture_trainer_how_taps"><xliff:g id="fingers">%2$s</xliff:g>으로 <xliff:g id="taps">%1$s</xliff:g> 탭하세요. 손가락을 함께 내려놓고 함께 빠르게 떼며, 밀지 마세요.</string>
    <string name="gesture_trainer_how_taps_quick">탭을 빠르게, 같은 위치에서 하세요. 다음 탭은 이전 탭 후 <xliff:g id="gap">%1$d</xliff:g> ms 이내에 해야 합니다.</string>
    <string name="gesture_trainer_how_hold"><xliff:g id="fingers">%1$s</xliff:g>을 화면에 함께 올려놓고 밀지 말고 <xliff:g id="hold">%2$d</xliff:g> ms 이상 움직이지 마세요.</string>
    <string name="gesture_trainer_how_long_hold_turns_off">다른 명령이 할당되지 않은 경우 이 동작은 SandFly를 끕니다. 트레이너에서는 아무것도 실행하지 않습니다.</string>
    <string name="gesture_trainer_how_taps_hold"><xliff:g id="fingers">%2$s</xliff:g>으로 <xliff:g id="taps">%1$s</xliff:g> 탭하고, 마지막 탭에서 손가락을 화면에 댄 채 <xliff:g id="hold">%3$d</xliff:g> ms 이상 움직이지 마세요.</string>
    <string name="gesture_trainer_how_three_finger_hand">엄지, 검지, 중지를 사용하세요.</string>
    <string name="gesture_trainer_how_four_finger_pinch_hand">검지와 중지를 나란히 놓고, 엄지와 약지를 양쪽으로 몇 센티미터 떨어뜨려 놓으세요. 그런 다음 네 손가락 끝을 한 점으로 모으세요.</string>
    <string name="gesture_trainer_how_pinch">손가락 <xliff:g id="fingers">%1$d</xliff:g>개를 넓게 벌려 화면에 올려놓으세요. 그런 다음 무언가를 집듯이 손가락을 서로를 향해 곧게 1cm 이상 모으고 화면에서 떼세요. 손 전체가 아니라 손가락만 움직이고, 호를 그리지 마세요.</string>
    <string name="gesture_trainer_how_spread">손가락 <xliff:g id="fingers">%1$d</xliff:g>개를 서로 가깝게 화면에 올려놓으세요. 그런 다음 손가락을 곧게 1cm 이상 벌리고 화면에서 떼세요. 손 전체가 아니라 손가락만 움직이고, 호를 그리지 마세요.</string>
    <string name="gesture_trainer_clockwise">시계 방향</string>
    <string name="gesture_trainer_counterclockwise">시계 반대 방향</string>
    <string name="gesture_trainer_how_rotate">두 손가락을 약 2~3cm 간격으로 화면에 올려놓고, 다이얼을 돌리듯이 두 손가락의 가운데를 중심으로 <xliff:g id="way">%1$s</xliff:g>으로 약 4분의 1바퀴 돌리세요. 그런 다음 손가락을 떼세요.</string>
    <string name="gesture_trainer_how_scrub">두 손가락을 화면에 올려놓고, 무언가를 지우듯이 한쪽으로 약 2cm 빠르게 움직였다가 되돌아오세요. 전체를 약 1초 안에 하세요. 그런 다음 손가락을 떼세요.</string>
    <string name="gesture_trainer_edge_bottom">하단 가장자리에</string>
    <string name="gesture_trainer_edge_top_left">상단 가장자리의 왼쪽 절반에</string>
    <string name="gesture_trainer_edge_top_right">상단 가장자리의 오른쪽 절반에</string>
    <string name="gesture_trainer_edge_left_top">왼쪽 가장자리의 위쪽 절반에</string>
    <string name="gesture_trainer_edge_left_bottom">왼쪽 가장자리의 아래쪽 절반에</string>
    <string name="gesture_trainer_edge_right_top">오른쪽 가장자리의 위쪽 절반에</string>
    <string name="gesture_trainer_edge_right_bottom">오른쪽 가장자리의 아래쪽 절반에</string>
    <string name="gesture_trainer_edge_left">왼쪽 가장자리에</string>
    <string name="gesture_trainer_edge_right">오른쪽 가장자리에</string>
    <string name="gesture_trainer_edge_top">상단 가장자리에</string>
    <string name="gesture_trainer_how_edge">한 손가락을 <xliff:g id="edge">%1$s</xliff:g>, 가장자리에서 <xliff:g id="edge_width">%2$d</xliff:g>mm 이내에 놓고 <xliff:g id="direction">%3$s</xliff:g> 화면 안쪽으로 첫 번째 클릭까지 약 <xliff:g id="distance">%4$d</xliff:g>mm 미세요. 그런 다음 바로 손가락을 떼세요. 두 번째 클릭을 지나면 길게 스와이프가 됩니다.</string>
    <string name="gesture_trainer_how_edge_long">한 손가락을 <xliff:g id="edge">%1$s</xliff:g>, 가장자리에서 <xliff:g id="edge_width">%2$d</xliff:g>mm 이내에 놓고 <xliff:g id="direction">%3$s</xliff:g> 화면 안쪽으로 첫 번째 클릭을 지나 두 번째 클릭까지 약 <xliff:g id="distance">%4$d</xliff:g>mm 미세요. 그런 다음 손가락을 떼세요.</string>
    <string name="gesture_trainer_how_along">한 손가락으로 <xliff:g id="edge">%1$s</xliff:g>를 따라 <xliff:g id="direction">%2$s</xliff:g> <xliff:g id="distance">%3$d</xliff:g>mm 이상 미세요.</string>
    <string name="gesture_trainer_corner_top_left">왼쪽 위</string>
    <string name="gesture_trainer_corner_top_right">오른쪽 위</string>
    <string name="gesture_trainer_corner_bottom_left">왼쪽 아래</string>
    <string name="gesture_trainer_corner_bottom_right">오른쪽 아래</string>
    <string name="gesture_trainer_how_corner">화면의 <xliff:g id="corner">%2$s</xliff:g> 모서리를 <xliff:g id="taps">%1$s</xliff:g> 탭하세요. 손가락을 모서리에 정확히 놓아 양쪽 가장자리에서 <xliff:g id="size">%3$d</xliff:g>mm 이내에 두고, <xliff:g id="time">%4$d</xliff:g> ms 이내에 빠르게 떼세요.</string>
    <string name="gesture_trainer_sizes"><xliff:g id="edge_setting">%1$s</xliff:g>: <xliff:g id="edge">%2$d</xliff:g>mm. <xliff:g id="corner_setting">%3$s</xliff:g>: <xliff:g id="corner">%4$d</xliff:g>mm.</string>
    <string name="gesture_trainer_corner_warning">모서리가 클수록 왼쪽 위의 뒤로 버튼처럼 모서리 근처의 컨트롤을 탭하면 대신 모서리 동작이 실행될 수 있습니다.</string>
    <string name="gesture_trainer_rating_precise">인식됨, 정확함</string>
    <string name="gesture_trainer_rating_good">인식됨, 양호</string>
    <string name="gesture_trainer_rating_borderline">인식됨, 한도에 가까움</string>
    <string name="gesture_trainer_try_recognized">시도 <xliff:g id="number">%1$d</xliff:g>: <xliff:g id="rating">%2$s</xliff:g>.</string>
    <string name="gesture_trainer_try_nothing">시도 <xliff:g id="number">%1$d</xliff:g>: 인식되지 않음.</string>
    <string name="gesture_trainer_try_other">시도 <xliff:g id="number">%1$d</xliff:g>: <xliff:g id="gesture">%2$s</xliff:g>(으)로 인식됨.</string>
    <string name="gesture_trainer_results_heading"><xliff:g id="gesture">%1$s</xliff:g>: <xliff:g id="tries">%3$d</xliff:g>번 중 <xliff:g id="recognized">%2$d</xliff:g>번 인식됨</string>
