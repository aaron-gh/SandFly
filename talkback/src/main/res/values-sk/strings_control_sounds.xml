    <string name="title_pref_control_sounds">Ovládajte zvuky a vibrácie</string>
    <string name="summary_pref_control_sounds">Dajte každému druhu ovládania, ako sú tlačidlá, zaškrtávacie políčka, editačné polia a položky zoznamu, vlastný zvuk a vlastné vibrácie z témy, namiesto zvuku a vibrácií zamerania, ako to robí Unspoken pre NVDA. Zvuk prichádza z miesta, kde je ovládací prvok na obrazovke, a SandFly vynecháva, o aký druh ovládacieho prvku ide.</string>
    <string name="title_pref_control_sounds_speak_roles">Ešte povedať druh kontroly</string>
    <string name="summary_pref_control_sounds_speak_roles">Keď prehrá zvuk ovládacieho prvku, povedzte, o aký druh ovládacieho prvku ide, napríklad tlačidlo. Toto je pre každú zvukovú tému.</string>
