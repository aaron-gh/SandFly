    <string name="title_pref_control_sounds">Zvuky a vibrácie ovládacích prvkov</string>
    <string name="summary_pref_control_sounds">Každý druh ovládacieho prvku, napríklad tlačidlá, začiarkavacie políčka, polia na úpravy a položky zoznamu, dostane namiesto zvuku a vibrácie zamerania vlastný zvuk a vibráciu z témy, ako to robí Unspoken pre NVDA. Zvuk znie z miesta ovládacieho prvku na obrazovke a SandFly nevysloví, o aký druh prvku ide.</string>
    <string name="title_pref_control_sounds_speak_roles">Aj tak vysloviť typ ovládacieho prvku</string>
    <string name="summary_pref_control_sounds_speak_roles">Keď zaznie zvuk ovládacieho prvku, druh prvku sa aj tak vysloví, napríklad tlačidlo. Platí pre všetky zvukové témy.</string>
