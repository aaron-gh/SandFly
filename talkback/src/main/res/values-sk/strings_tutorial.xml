    <string name="sandfly_tutorial_typing_delete">Odstráňte posledné písmeno klávesom Odstrániť na klávesnici.</string>
    <string name="sandfly_tutorial_typing_intro">Aktivácia textového poľa otvorí klávesnicu. Dotknite sa klávesu, aby ste ho počuli, a zdvihnutím prsta ho napíšete.</string>
    <string name="sandfly_tutorial_typing_open">Prejdite na pole <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: začatie písania.</string>
