    <string name="sandfly_tutorial_contents_intro">Lekcie v poradí. Každú možno otvoriť samostatne.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly dokáže čítať od označenej položky až po koniec obrazovky bez potiahnutí. Dotyk obrazovky čítanie zastaví.</string>
    <string name="sandfly_tutorial_continuous_move">Prejdite na prvý riadok receptu.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g>: čítanie od označenej položky.</string>
