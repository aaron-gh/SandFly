    <string name="sandfly_tutorial_welcome_intro">Tento návod učí gestá SandFly. Každá lekcia zadá pokyn, počká, kým ho vykonáte vlastnými gestami, a potom zadá ďalší. Pokyn je prvá položka za názvom lekcie. Obsah uvádza všetky lekcie a návod sa znova otvorí na lekcii, v ktorej ste skončili.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> kdekoľvek na obrazovke: začatie.</string>
    <string name="sandfly_tutorial_welcome_title">Vitajte</string>
