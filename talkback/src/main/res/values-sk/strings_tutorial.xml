    <string name="sandfly_tutorial_name">Meno</string>
    <string name="sandfly_tutorial_next_lesson">Ďalšia lekcia: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> nemá žiadne gesto. Priraďte ho v sekcii Príkazy alebo použite Preskočiť krok.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> sa v lekcii nevykonáva. Návod opustíte tlačidlom Zavrieť návod v obsahu.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> sa v lekcii nevykonáva.</string>
    <string name="sandfly_tutorial_pause_intro">Reč sa dá pozastaviť uprostred položky a obnoviť tam, kde skončila.</string>
    <string name="sandfly_tutorial_pause_pause">Prejdite na príbeh nižšie. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> počas čítania: pozastavenie reči, opakovaním ju obnovíte.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> znova: obnovenie reči.</string>
    <string name="sandfly_tutorial_pause_title">Pozastavenie reči</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Každé gesto namiesto vykonania povie svoj názov a akciu. Presun na ďalšiu a predchádzajúcu položku a aktivácia fungujú ďalej.</string>
    <string name="sandfly_tutorial_practice_step">Urobte ľubovoľné gesto a budete počuť, čo robí. Precvičovanie ukončíte aktiváciou tlačidla <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Precvičovanie gest</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> z <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Zmeňte ovládací prvok čítania na <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: presun o jeden znak.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Ovládanie čítania určuje, čo robí potiahnutie nahor a nadol, napríklad presun po slovách alebo po znakoch alebo zmenu rýchlosti reči. Potiahnutie doprava a doľava ďalej presúva medzi položkami.</string>
    <string name="sandfly_tutorial_reading_controls_move">Prejdite na vetu nižšie.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: presun na ďalšie slovo. Posuňte sa o tri slová.</string>
    <string name="sandfly_tutorial_reading_controls_title">Ovládanie čítania</string>
    <string name="sandfly_tutorial_recipe_1">Palacinky: zmiešajte múku, vajcia a mlieko na hladké cesto.</string>
    <string name="sandfly_tutorial_recipe_2">Na panvici rozohrejte trochu masla.</string>
    <string name="sandfly_tutorial_recipe_3">Nalejte toľko cesta, aby tenko pokrylo panvicu.</string>
    <string name="sandfly_tutorial_recipe_4">Keď je spodná strana zlatistá, palacinku obráťte.</string>
    <string name="sandfly_tutorial_recipe_5">Podávajte s citrónom a cukrom.</string>
    <string name="sandfly_tutorial_scrolling_intro">Zoznamy zobrazujú naraz len niektoré položky. Potiahnutie za poslednú zobrazenú položku zoznam posunie.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>: posun o stránku dopredu.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: prechádzanie zoznamom. Pokračujte, kým sa nedostanete na položku <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Posúvanie zoznamov</string>
    <string name="sandfly_tutorial_sentence">Rýchla hnedá líška preskočí lenivého psa.</string>
    <string name="sandfly_tutorial_skip_step">Preskočiť krok</string>
    <string name="sandfly_tutorial_sliders_change">Prejdite na posúvač <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> alebo <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: zmena jeho hodnoty.</string>
    <string name="sandfly_tutorial_sliders_highest">Nastavte posúvač <xliff:g id="slider" example="Brightness">%1$s</xliff:g> na 100 percent, najvyššiu hodnotu.</string>
    <string name="sandfly_tutorial_sliders_intro">Keď je posúvač označený, potiahnutie nahor a nadol mení jeho hodnotu.</string>
    <string name="sandfly_tutorial_sliders_title">Posúvače</string>
    <string name="sandfly_tutorial_step">Krok <xliff:g id="number" example="1">%1$d</xliff:g> z <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Piesočné mušky sú malé muchy, ktoré žijú na plážach, na brehoch riek a v lesoch. Najaktívnejšie sú za úsvitu a za súmraku, keď je bezvetrie. Hryzú iba samičky, pretože potrebujú krv na tvorbu vajíčok. Uhryznutia svrbia celé dni, a preto ľudia, ktorí navštívia kraj piesočných mušiek, nosia repelent. Piesočné mušky lietajú slabo a aj mierny vánok ich udrží v diaľke.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>: návrat späť.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>: prechod na plochu.</string>
    <string name="sandfly_tutorial_system_intro">Tieto gestá fungujú na každej obrazovke. V tejto lekcii návod namiesto vykonania povie, čo každé z nich robí.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>: otvorenie upozornení.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>: zobrazenie nedávnych aplikácií.</string>
