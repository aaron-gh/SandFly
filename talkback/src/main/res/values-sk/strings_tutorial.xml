    <string name="sandfly_tutorial_move_intro">Potiahnutie presunie na ďalšiu alebo predchádzajúcu položku na obrazovke v poradí čítania.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: presun na ďalšiu položku. Pokračujte, kým sa nedostanete na položku <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>: presun na predchádzajúcu položku. Vráťte sa na položku <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
