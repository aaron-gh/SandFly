    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> alebo <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>: zmena ovládacieho prvku čítania. Vyberte <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Zavrieť návod</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>: skopírovanie posledného textu, ktorý SandFly vyslovil, do schránky.</string>
    <string name="sandfly_tutorial_commands_intro">Tieto príkazy fungujú na každej obrazovke.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>: vyhľadanie textu na obrazovke. V tejto lekcii návod namiesto toho povie, čo gesto robí.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>: vypnutie reči, opakovaním ju znova zapnete. V tejto lekcii návod namiesto toho povie, čo gesto robí.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>: oznámenie času, stavu batérie a ďalších informácií o stave.</string>
