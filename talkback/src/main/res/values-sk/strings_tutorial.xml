<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Prejdite na správu. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> alebo <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: prechádzanie jej akciami. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>: vykonanie akcie, ktorú počujete. Vykonajte akciu <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Niektoré položky majú okrem aktivácie aj ďalšie akcie, napríklad Archivovať alebo Odstrániť pri správe. Keď je taká položka označená, ovládací prvok čítania Akcie nimi prechádza.</string>
    <string name="sandfly_tutorial_actions_title">Akcie</string>
    <string name="sandfly_tutorial_activate_button">Prejdite na položku <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: jej aktivácia.</string>
    <string name="sandfly_tutorial_activate_check_box">Rovnakým spôsobom začiarknite <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_hold">Niektoré položky po pridržaní robia niečo iné. Prejdite na položku <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>: jej pridržanie.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivácia pôsobí na označenú položku, nech klepnete kamkoľvek na obrazovku.</string>
    <string name="sandfly_tutorial_activate_title">Aktivácia položiek</string>
    <string name="sandfly_tutorial_back_in_lesson">Späť lekciu neopustí. Inú lekciu vyberiete tlačidlom Obsah.</string>
    <string name="sandfly_tutorial_bell">Zazvoniť na zvonček</string>
    <string name="sandfly_tutorial_bell_rung">Počet zazvonení: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Jas</string>
