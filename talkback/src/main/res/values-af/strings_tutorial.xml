    <string name="sandfly_tutorial_move_intro">Swiep beweeg na die volgende of vorige item op die skerm, in leesvolgorde.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> om na die volgende item te beweeg. Gaan voort totdat jy <xliff:g id="item" example="Eggs">%2$s</xliff:g> bereik.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> om na die vorige item te beweeg. Gaan terug na <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Beweging tussen items</string>
    <string name="sandfly_tutorial_name">Naam</string>
    <string name="sandfly_tutorial_next_lesson">Volgende les: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> het geen gebaar nie. Wys een in Opdragte toe, of gebruik Slaan stap oor.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> word nie in \'n les gedoen nie. Gebruik Maak tutoriaal toe in Inhoud om die tutoriaal te verlaat.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> word nie in \'n les gedoen nie.</string>
    <string name="sandfly_tutorial_pause_intro">Spraak kan in die middel van \'n item onderbreek word, en hervat waar dit gestop het.</string>
    <string name="sandfly_tutorial_pause_pause">Gaan na die storie hieronder. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> terwyl dit gelees word om spraak te onderbreek, en weer om te hervat.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> weer om spraak te hervat.</string>
    <string name="sandfly_tutorial_pause_title">Onderbreek spraak</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Elke gebaar sê sy naam en handeling in plaas daarvan om dit uit te voer. Beweging na die volgende en vorige item en aktivering werk steeds.</string>
    <string name="sandfly_tutorial_practice_step">Maak enige gebaar om te hoor wat dit doen. Aktiveer <xliff:g id="button" example="End practice">%1$s</xliff:g> om te stop.</string>
    <string name="sandfly_tutorial_practice_title">Gebaaroefening</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> van <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Verander die leeskontrole na <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> om een karakter te beweeg.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Leeskontroles kies wat swiep op en af doen, soos om per woord of per karakter te beweeg, of om die spraaktempo te verander. Swiep regs en links beweeg steeds tussen items.</string>
    <string name="sandfly_tutorial_reading_controls_move">Gaan na die sin hieronder.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> om na die volgende woord te beweeg. Beweeg drie woorde.</string>
    <string name="sandfly_tutorial_reading_controls_title">Leeskontroles</string>
    <string name="sandfly_tutorial_recipe_1">Pannekoek: meng meel, eiers en melk tot \'n gladde beslag.</string>
    <string name="sandfly_tutorial_recipe_2">Verhit \'n bietjie botter in \'n pan.</string>
    <string name="sandfly_tutorial_recipe_3">Gooi genoeg beslag in om die pan dun te bedek.</string>
    <string name="sandfly_tutorial_recipe_4">Draai die pannekoek om wanneer die onderkant goudbruin is.</string>
    <string name="sandfly_tutorial_recipe_5">Bedien met suurlemoen en suiker.</string>
    <string name="sandfly_tutorial_scrolling_intro">Lyste wys net sommige van hul items op \'n slag. Om verby die laaste gewysde item te swiep, rollees die lys.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> om een bladsy vorentoe te rollees.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> deur die lys totdat jy <xliff:g id="item" example="Item 15">%2$s</xliff:g> bereik.</string>
    <string name="sandfly_tutorial_scrolling_title">Rollees deur lyste</string>
    <string name="sandfly_tutorial_sentence">Die vinnige bruin jakkals spring oor die lui hond.</string>
    <string name="sandfly_tutorial_skip_step">Slaan stap oor</string>
    <string name="sandfly_tutorial_sliders_change">Gaan na die <xliff:g id="slider" example="Brightness">%3$s</xliff:g>-glyer. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> of <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> om sy waarde te verander.</string>
    <string name="sandfly_tutorial_sliders_highest">Stel <xliff:g id="slider" example="Brightness">%1$s</xliff:g> op 100 persent, sy hoogste waarde.</string>
    <string name="sandfly_tutorial_sliders_intro">Wanneer \'n glyer fokus het, verander swiep op en af sy waarde.</string>
    <string name="sandfly_tutorial_sliders_title">Glyers</string>
    <string name="sandfly_tutorial_step">Stap <xliff:g id="number" example="1">%1$d</xliff:g> van <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Sandvlieë is klein vlieë wat op strande, op rivieroewers en in woude leef. Hulle is die aktiefste teen dagbreek en skemer, wanneer die lug stil is. Net die wyfies byt, omdat hulle bloed nodig het om hul eiers te produseer. Die byte jeuk vir dae, daarom dra mense wat sandvliegwêreld besoek insekweerder. Sandvlieë is swak vlieërs, en selfs \'n ligte briesie hou hulle weg.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> om terug te gaan.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> om na die tuisskerm te gaan.</string>
    <string name="sandfly_tutorial_system_intro">Hierdie gebare werk op elke skerm. In hierdie les sê die tutoriaal wat elkeen doen in plaas daarvan om dit te doen.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> om kennisgewings oop te maak.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> om onlangse toepassings te wys.</string>
    <string name="sandfly_tutorial_system_title">Terug, Tuis en kennisgewings</string>
    <string name="sandfly_tutorial_tile_cloud">Wolk</string>
    <string name="sandfly_tutorial_tile_moon">Maan</string>
    <string name="sandfly_tutorial_tile_star">Ster</string>
    <string name="sandfly_tutorial_tile_sun">Son</string>
    <string name="sandfly_tutorial_title">SandFly-tutoriaal</string>
    <string name="sandfly_tutorial_typing_delete">Vee die laaste letter uit met die sleutelbord se Vee uit-sleutel.</string>
    <string name="sandfly_tutorial_typing_intro">Om \'n teksveld te aktiveer, maak die sleutelbord oop. Raak \'n sleutel aan om dit te hoor, en lig jou vinger om dit te tik.</string>
    <string name="sandfly_tutorial_typing_open">Gaan na die <xliff:g id="field" example="Name">%2$s</xliff:g>-veld. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> om te begin tik.</string>
    <string name="sandfly_tutorial_typing_title">Tik</string>
    <string name="sandfly_tutorial_typing_type">Tik die woord <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">kat</string>
    <string name="sandfly_tutorial_welcome_intro">Hierdie tutoriaal leer SandFly se gebare. Elke les gee \'n opdrag, wag totdat jy dit met jou eie gebare gedoen het, en gee dan die volgende een. Die opdrag is die eerste item ná die naam van die les. Inhoud lys elke les, en die tutoriaal maak weer oop by die les waarby jy was.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> enige plek op die skerm om te begin.</string>
    <string name="sandfly_tutorial_welcome_title">Welkom</string>
</resources>
