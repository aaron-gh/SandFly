    <string name="sandfly_tutorial_contents">Inhoud</string>
    <string name="sandfly_tutorial_contents_intro">Lesse, in volgorde. Elkeen kan afsonderlik oopgemaak word.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly kan van die gefokusde item tot aan die einde van die skerm lees sonder om te swiep. Om die skerm aan te raak, stop die lees.</string>
    <string name="sandfly_tutorial_continuous_move">Gaan na die eerste reël van die resep.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> om vanaf die gefokusde item te lees.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> om die SandFly-kieslys oop te maak, en kies dan <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
