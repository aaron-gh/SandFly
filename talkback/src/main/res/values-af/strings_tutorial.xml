    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> of <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> om die leeskontrole te verander. Kies <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Maak tutoriaal toe</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> om die laaste teks wat SandFly gesê het na die knipbord te kopieer.</string>
    <string name="sandfly_tutorial_commands_intro">Hierdie opdragte werk op elke skerm.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> om teks op die skerm te soek. In hierdie les sê die tutoriaal eerder wat dit doen.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> om spraak af te skakel, en weer om dit aan te skakel. In hierdie les sê die tutoriaal eerder wat dit doen.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> om die tyd, die batteryvlak en ander status te hoor.</string>
