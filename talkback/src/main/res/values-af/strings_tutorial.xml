    <string name="sandfly_tutorial_actions_archive">Gaan na die boodskap. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> of <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> om deur sy handelinge te gaan. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> om die handeling uit te voer wat jy hoor. Voer <xliff:g id="action" example="Archive">%4$s</xliff:g> uit.</string>
    <string name="sandfly_tutorial_actions_intro">Sommige items het handelinge behalwe aktivering, soos Argiveer of Vee uit vir \'n boodskap. Terwyl so \'n item fokus het, gaan die Handelinge-leeskontrole deur hulle.</string>
    <string name="sandfly_tutorial_actions_title">Handelinge</string>
    <string name="sandfly_tutorial_activate_button">Gaan na <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> om dit te aktiveer.</string>
    <string name="sandfly_tutorial_activate_check_box">Merk <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> op dieselfde manier.</string>
    <string name="sandfly_tutorial_activate_hold">Sommige items doen iets anders wanneer hulle vasgehou word. Gaan na <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> om dit vas te hou.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivering werk op die item met fokus, waar jy ook al op die skerm tik.</string>
    <string name="sandfly_tutorial_activate_title">Aktiveer items</string>
    <string name="sandfly_tutorial_back_in_lesson">Terug verlaat nie \'n les nie. Gebruik Inhoud om \'n ander les te kies.</string>
    <string name="sandfly_tutorial_bell">Lui die klok</string>
    <string name="sandfly_tutorial_bell_rung">Kere gelui: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Helderheid</string>
