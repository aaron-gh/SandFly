    <string name="sandfly_tutorial_forecast_tomorrow">Môre</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Bewolk in die oggend, met reën vanaf middag.</string>
    <string name="sandfly_tutorial_forecast_weekend">Naweek</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Winderig op Saterdag, helder op Sondag.</string>
    <string name="sandfly_tutorial_headings_intro">Skerms en webbladsye verdeel hul inhoud met opskrifte. Die Opskrifte-leeskontrole spring van een opskrif na die volgende.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> om na die volgende opskrif te spring. Spring na <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
