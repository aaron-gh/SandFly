    <string name="sandfly_tutorial_actions_archive">Siirry viestiin. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> tai <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: käy läpi sen toiminnot. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>: suorita kuulemasi toiminto. Suorita <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Joillakin kohteilla on aktivoinnin lisäksi muita toimintoja, kuten viestin Arkistoi tai Poista. Kun tällainen kohde on kohdistettuna, Toiminnot-lukuasetus käy ne läpi.</string>
    <string name="sandfly_tutorial_actions_title">Toiminnot</string>
    <string name="sandfly_tutorial_activate_button">Siirry kohteeseen <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: aktivoi se.</string>
    <string name="sandfly_tutorial_activate_check_box">Valitse <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> samalla tavalla.</string>
    <string name="sandfly_tutorial_activate_hold">Jotkin kohteet tekevät jotain muuta, kun niitä pidetään painettuna. Siirry kohteeseen <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>: pidä sitä painettuna.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivointi koskee kohdistettua kohdetta riippumatta siitä, mihin kohtaan näyttöä napautat.</string>
