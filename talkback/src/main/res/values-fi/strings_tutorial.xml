    <string name="sandfly_tutorial_practice_intro">Jokainen ele sanoo nimensä ja toimintonsa sen suorittamisen sijaan. Siirtyminen seuraavaan ja edelliseen kohteeseen sekä aktivointi toimivat edelleen.</string>
    <string name="sandfly_tutorial_practice_step">Tee mikä tahansa ele kuullaksesi, mitä se tekee. Lopeta aktivoimalla <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Eleharjoittelu</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Vaihda lukuasetukseksi <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: siirry yksi merkki.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Lukuasetukset valitsevat, mitä ylös ja alas pyyhkäiseminen tekee, esimerkiksi siirtyminen sana tai merkki kerrallaan tai puheen nopeuden muuttaminen. Oikealle ja vasemmalle pyyhkäiseminen siirtää edelleen kohteesta toiseen.</string>
    <string name="sandfly_tutorial_reading_controls_move">Siirry alla olevaan lauseeseen.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: siirry seuraavaan sanaan. Siirry kolme sanaa.</string>
    <string name="sandfly_tutorial_reading_controls_title">Lukuasetukset</string>
    <string name="sandfly_tutorial_recipe_1">Ohukaiset: sekoita jauhot, kananmunat ja maito tasaiseksi taikinaksi.</string>
    <string name="sandfly_tutorial_recipe_2">Kuumenna vähän voita paistinpannulla.</string>
    <string name="sandfly_tutorial_recipe_3">Kaada pannulle sen verran taikinaa, että pohja peittyy ohuelti.</string>
    <string name="sandfly_tutorial_recipe_4">Käännä ohukainen, kun alapuoli on kullanruskea.</string>
    <string name="sandfly_tutorial_recipe_5">Tarjoile sitruunan ja sokerin kanssa.</string>
    <string name="sandfly_tutorial_scrolling_intro">Luettelot näyttävät kerralla vain osan kohteistaan. Kun pyyhkäiset viimeisen näkyvän kohteen ohi, luettelo vierittyy.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>: vieritä sivun verran eteenpäin.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: käy luetteloa läpi, kunnes pääset kohteeseen <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Luetteloiden vierittäminen</string>
    <string name="sandfly_tutorial_sentence">Viekas kettu punaturkki laiskan koiran takaa kurkki.</string>
    <string name="sandfly_tutorial_skip_step">Ohita vaihe</string>
    <string name="sandfly_tutorial_sliders_change">Siirry liukusäätimeen <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> tai <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: muuta sen arvoa.</string>
    <string name="sandfly_tutorial_sliders_highest">Aseta <xliff:g id="slider" example="Brightness">%1$s</xliff:g> arvoon 100 prosenttia, joka on sen suurin arvo.</string>
    <string name="sandfly_tutorial_sliders_intro">Kun liukusäädin on kohdistettuna, ylös ja alas pyyhkäiseminen muuttaa sen arvoa.</string>
    <string name="sandfly_tutorial_sliders_title">Liukusäätimet</string>
    <string name="sandfly_tutorial_step">Vaihe <xliff:g id="number" example="1">%1$d</xliff:g>/<xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Hietakärpäset ovat pieniä kärpäsiä, jotka elävät rannoilla, joenpenkoilla ja metsissä. Ne ovat aktiivisimmillaan aamu- ja iltahämärissä, kun ilma on tyyni. Vain naaraat purevat, koska ne tarvitsevat verta munien tuottamiseen. Puremat kutisevat päiviä, joten hietakärpästen alueilla vierailevat kantavat mukanaan hyönteiskarkotetta. Hietakärpäset ovat heikkoja lentäjiä, ja kevytkin tuulenvire pitää ne poissa.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>: palaa takaisin.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>: siirry aloitusnäytölle.</string>
    <string name="sandfly_tutorial_system_intro">Nämä eleet toimivat kaikilla näytöillä. Tällä oppitunnilla opetusohjelma kertoo, mitä kukin ele tekee, sen tekemisen sijaan.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>: avaa ilmoitukset.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>: näytä viimeaikaiset sovellukset.</string>
