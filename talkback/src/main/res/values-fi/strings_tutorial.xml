    <string name="sandfly_tutorial_typing_word">kissa</string>
    <string name="sandfly_tutorial_welcome_intro">Tämä opetusohjelma opettaa SandFlyn eleet. Jokainen oppitunti antaa ohjeen, odottaa, kunnes olet tehnyt sen omilla eleilläsi, ja antaa sitten seuraavan. Ohje on ensimmäinen kohde oppitunnin nimen jälkeen. Sisältö luettelee kaikki oppitunnit, ja opetusohjelma avautuu uudelleen siihen oppituntiin, jossa olit.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> missä tahansa näytöllä: aloita.</string>
    <string name="sandfly_tutorial_welcome_title">Tervetuloa</string>
