    <string name="sandfly_tutorial_typing_intro">Tekstikentän aktivointi avaa näppäimistön. Kosketa näppäintä kuullaksesi sen ja kirjoita se nostamalla sormi.</string>
    <string name="sandfly_tutorial_typing_open">Siirry kenttään <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: aloita kirjoittaminen.</string>
