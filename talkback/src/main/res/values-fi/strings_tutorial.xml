    <string name="sandfly_tutorial_not_in_lesson">Toimintoa <xliff:g id="action" example="Home">%1$s</xliff:g> ei tehdä oppitunnilla. Poistu opetusohjelmasta valitsemalla Sisältö-kohdasta Sulje opetusohjelma.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">Toimintoa <xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> ei tehdä oppitunnilla.</string>
    <string name="sandfly_tutorial_pause_intro">Puheen voi keskeyttää kesken kohteen ja jatkaa siitä, mihin se jäi.</string>
    <string name="sandfly_tutorial_pause_pause">Siirry alla olevaan tarinaan. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> sen lukemisen aikana: keskeytä puhe. Uudelleen tehtynä puhe jatkuu.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> uudelleen: jatka puhetta.</string>
    <string name="sandfly_tutorial_pause_title">Puheen keskeyttäminen</string>
