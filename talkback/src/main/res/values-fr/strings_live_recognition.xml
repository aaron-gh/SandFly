    <string name="live_recognition_title">Reconnaissance en direct</string>
    <string name="live_recognition_hint">Balayez vers le haut ou vers le bas pour choisir un mode, puis appuyez deux fois pour l\'activer ou le désactiver</string>
    <string name="live_recognition_scenes">Scènes</string>
    <string name="live_recognition_text">Texte</string>
