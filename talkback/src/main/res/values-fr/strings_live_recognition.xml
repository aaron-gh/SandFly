    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">Orientez la caméra arrière vers ce que vous voulez faire décrire. Pour Pointer et lire, pointez un doigt vers un texte dans l\'image de la caméra. Les descriptions peuvent être fausses. Ne vous y fiez pas pour vous déplacer en sécurité.</string>
    <string name="live_recognition_camera_off">Caméra désactivée</string>
    <string name="live_recognition_camera_on">Caméra activée</string>
    <string name="live_recognition_connecting">Connexion à Gemini…</string>
    <string name="live_recognition_cloud_title">Envoyer des images de la caméra à Gemini ?</string>
    <string name="live_recognition_cloud_message">Scènes, Pointer et lire, Détection de personnes et Détection de portes envoient une image de la caméra à l\'API Gemini de Google toutes les quelques secondes. Le texte est reconnu sur ce téléphone.\n\nAvec une clé API gratuite, Google peut conserver ce qu\'il reçoit, l\'utiliser pour améliorer ses produits et le faire examiner par des personnes. L\'IA générative est expérimentale et fera donc des erreurs.</string>
    <string name="live_recognition_service_title">Envoyer des images de la caméra à <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> ?</string>
    <string name="live_recognition_service_message">Scènes, Pointer et lire, Détection de personnes et Détection de portes envoient une image de la caméra à <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> toutes les quelques secondes. Le texte est reconnu sur ce téléphone.\n\nLes conditions d\'utilisation et la politique de confidentialité du service s\'appliquent. L\'IA générative est expérimentale et fera donc des erreurs.</string>
