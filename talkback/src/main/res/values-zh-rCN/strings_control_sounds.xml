<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Sound themes: switch that gives each kind of control its own sound, from where it is on the screen, and its own vibration, from the sound theme. [CHAR LIMIT=40] -->
    <string name="title_pref_control_sounds">控件声音与振动</string>
    <!-- Sound and vibration settings: summary of the control sounds switch. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_control_sounds">为每种控件（如按钮、复选框、编辑框和列表项）赋予主题中各自的专属声音和振动，取代焦点音和振动，就像 Unspoken 为 NVDA 所做的那样。声音来自控件在屏幕上的位置，且 SandFly 不再说出控件的种类。</string>
    <!-- Sound and vibration settings: switch that keeps saying the kind of control, like "button", when its control sound plays. [CHAR LIMIT=60] -->
    <string name="title_pref_control_sounds_speak_roles">仍然说出控件种类</string>
    <!-- Sound and vibration settings: summary of the switch that keeps saying the kind of control when its control sound plays. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_control_sounds_speak_roles">播放控件声音时，仍然说出控件的种类，例如按钮。此项对所有声音主题生效。</string>
    <!-- Sound and vibration settings: title of the choice of when control sounds play in 3D. [CHAR LIMIT=40] -->
    <string name="title_pref_control_sounds_3d">3D 音频</string>
    <!-- Sound and vibration settings: control sounds play in 3D with headphones, and move between the left and right speakers otherwise. [CHAR LIMIT=60] -->
    <string name="pref_control_sounds_3d_headphones">戴耳机时</string>
    <!-- Sound and vibration settings: control sounds always play in 3D. [CHAR LIMIT=60] -->
    <string name="pref_control_sounds_3d_always">始终</string>
    <!-- Sound and vibration settings: control sounds only move between the left and right speakers. [CHAR LIMIT=60] -->
    <string name="pref_control_sounds_3d_never">从不，仅左右声道</string>

