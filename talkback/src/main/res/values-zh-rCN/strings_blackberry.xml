    <string name="blackberry_mode_confirm_title">要开启 BlackBerry 模式吗？</string>
    <string name="blackberry_mode_confirm_message">BlackBerry 模式会将手势、键盘快捷键、提示音和播报替换为与 BlackBerry 10 屏幕阅读器相似的内容。如果您没有用过 BlackBerry 10，可能会不熟悉这些内容。如需关闭，请依次前往 SandFly 设置 > 设置配置 > BlackBerry 模式。</string>
    <string name="blackberry_mode_confirm_button">开启</string>
    <string name="blackberry_gestures_confirm_title">要使用 BlackBerry 手势吗？</string>
    <string name="blackberry_gestures_confirm_message">BlackBerry 手势与 BlackBerry 10 屏幕阅读器的手势相似。如果您没有用过 BlackBerry 10，可能会不熟悉这些手势。如需恢复，请将手势 > 手势布局设为 SandFly 手势。</string>
