<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" xmlns:tools="http://schemas.android.com/tools">
    <!-- Label for the shortcut that speaks the time, battery, and network state. [CHAR LIMIT=40] -->
    <string name="shortcut_announce_status" tools:ignore="MissingTranslation">朗读状态</string>

    <!-- Status readout: signal strength of a network. [CHAR LIMIT=NONE] -->
    <string name="template_status_bars" tools:ignore="MissingTranslation"><xliff:g id="level" example="3">%1$d</xliff:g> 格，共 <xliff:g id="max_level" example="4">%2$d</xliff:g> 格</string>
    <!-- Status readout: Wi-Fi is turned off. [CHAR LIMIT=NONE] -->
    <string name="status_wifi_off" tools:ignore="MissingTranslation">Wi-Fi 已关闭</string>
    <!-- Status readout: Wi-Fi is on but not connected to a network. [CHAR LIMIT=NONE] -->
    <string name="status_wifi_not_connected" tools:ignore="MissingTranslation">Wi-Fi 未连接</string>
    <!-- Status readout: connected to Wi-Fi when the network name is not available. [CHAR LIMIT=NONE] -->
    <string name="template_status_wifi" tools:ignore="MissingTranslation">Wi-Fi，<xliff:g id="bars" example="3 of 4 bars">%1$s</xliff:g></string>
    <!-- Status readout: connected to a named Wi-Fi network. [CHAR LIMIT=NONE] -->
    <string name="template_status_wifi_named" tools:ignore="MissingTranslation">Wi-Fi <xliff:g id="network_name" example="Home">%1$s</xliff:g>，<xliff:g id="bars" example="3 of 4 bars">%2$s</xliff:g></string>
    <!-- Status readout: mobile network, with the carrier and network type. [CHAR LIMIT=NONE] -->
    <string name="template_status_mobile" tools:ignore="MissingTranslation"><xliff:g id="network" example="T-Mobile, 5G">%1$s</xliff:g>，<xliff:g id="bars" example="2 of 4 bars">%2$s</xliff:g></string>
    <!-- Status readout: name for the mobile network when the carrier is unknown. [CHAR LIMIT=NONE] -->
    <string name="status_mobile" tools:ignore="MissingTranslation">移动网络</string>
    <!-- Status readout: there is no mobile service. [CHAR LIMIT=NONE] -->
    <string name="status_mobile_no_service" tools:ignore="MissingTranslation">无移动服务</string>
    <!-- Status readout: Do Not Disturb is on. [CHAR LIMIT=NONE] -->
    <string name="status_do_not_disturb" tools:ignore="MissingTranslation">免打扰</string>
    <!-- Status readout: the ringer is set to vibrate. [CHAR LIMIT=NONE] -->
    <string name="status_ringer_vibrate" tools:ignore="MissingTranslation">振动</string>
    <!-- Status readout: the ringer is silent. [CHAR LIMIT=NONE] -->
    <string name="status_ringer_silent" tools:ignore="MissingTranslation">静音</string>
    <!-- Status readout: airplane mode is on. [CHAR LIMIT=NONE] -->
    <string name="status_airplane_mode" tools:ignore="MissingTranslation">飞行模式</string>

    <!-- Title of the settings screen that chooses what the status gesture speaks. [CHAR LIMIT=40] -->
    <string name="title_pref_status_readout" tools:ignore="MissingTranslation">状态读出</string>

    <!-- Status readout settings: title of the time item. [CHAR LIMIT=40] -->
    <string name="status_item_time" tools:ignore="MissingTranslation">时间</string>
    <!-- Status readout settings: summary of the time item. [CHAR LIMIT=NONE] -->
    <string name="status_item_time_summary" tools:ignore="MissingTranslation">当前时间</string>
    <!-- Status readout settings: title of the battery item. [CHAR LIMIT=40] -->
    <string name="status_item_battery" tools:ignore="MissingTranslation">电量</string>
    <!-- Status readout settings: summary of the battery item. [CHAR LIMIT=NONE] -->
    <string name="status_item_battery_summary" tools:ignore="MissingTranslation">电量、充电状态和省电模式</string>
    <!-- Status readout settings: title of the Wi-Fi item. [CHAR LIMIT=40] -->
    <string name="status_item_wifi" tools:ignore="MissingTranslation">Wi-Fi</string>
    <!-- Status readout settings: summary of the Wi-Fi item. [CHAR LIMIT=NONE] -->
    <string name="status_item_wifi_summary" tools:ignore="MissingTranslation">网络名称和信号强度</string>
    <!-- Status readout settings: title of the mobile network item. [CHAR LIMIT=40] -->
    <string name="status_item_mobile" tools:ignore="MissingTranslation">移动网络</string>
    <!-- Status readout settings: summary of the mobile network item. [CHAR LIMIT=NONE] -->
    <string name="status_item_mobile_summary" tools:ignore="MissingTranslation">运营商、网络类型和信号强度</string>
    <!-- Status readout settings: title of the ringer item. [CHAR LIMIT=40] -->
    <string name="status_item_ringer" tools:ignore="MissingTranslation">铃声与免打扰</string>
    <!-- Status readout settings: summary of the ringer item. [CHAR LIMIT=NONE] -->
    <string name="status_item_ringer_summary" tools:ignore="MissingTranslation">仅当铃声未设为响铃或免打扰开启时</string>
    <!-- Status readout settings: title of the airplane mode item. [CHAR LIMIT=40] -->
    <string name="status_item_airplane_mode" tools:ignore="MissingTranslation">飞行模式</string>
    <!-- Status readout settings: summary of the airplane mode item. [CHAR LIMIT=NONE] -->
    <string name="status_item_airplane_mode_summary" tools:ignore="MissingTranslation">仅当飞行模式开启时</string>
</resources>
