    <string name="gesture_trainer_title">手势训练器</string>
    <string name="gesture_trainer_intro">选择一组手势。每个练习描述一个手势。将手势执行 <xliff:g id="tries">%1$d</xliff:g> 次；每次尝试的结果都会朗读。最后一次尝试后，屏幕会列出每次尝试的测量值、需要改变的地方以及相关设置。</string>
    <string name="gesture_trainer_group_one_finger">单指</string>
    <string name="gesture_trainer_group_two_fingers">双指</string>
