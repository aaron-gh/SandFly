    <string name="gesture_trainer_back_to_groups">返回分组</string>
    <string name="gesture_trainer_go">在屏幕任意位置将手势执行 <xliff:g id="tries">%1$d</xliff:g> 次。每次触摸算一次尝试。</string>
    <string name="gesture_trainer_fingers_1">一根手指</string>
    <string name="gesture_trainer_fingers_2">并排、相距约 1 厘米的两根手指</string>
    <string name="gesture_trainer_fingers_3">并排、稍微分开的三根手指</string>
    <string name="gesture_trainer_fingers_4">并排、稍微分开的四根手指</string>
    <string name="gesture_trainer_direction_up">向上</string>
    <string name="gesture_trainer_direction_down">向下</string>
    <string name="gesture_trainer_direction_left">向左</string>
    <string name="gesture_trainer_direction_right">向右</string>
    <string name="gesture_trainer_how_swipe">用<xliff:g id="fingers">%1$s</xliff:g>触摸屏幕，不要停顿，<xliff:g id="direction">%2$s</xliff:g>沿直线滑动约 2 到 3 厘米，然后抬起。立即开始移动：手指若先停住不动，就会开始触摸浏览。</string>
    <string name="gesture_trainer_how_swipe_multi">同时放下所有手指，并让它们朝同一方向移动。每根手指必须始终<xliff:g id="direction">%1$s</xliff:g>移动，因此请保持直线。</string>
    <string name="gesture_trainer_how_back_and_forth">用一根手指触摸屏幕，<xliff:g id="first">%1$s</xliff:g>滑动约 2 厘米，然后不要抬起，直接<xliff:g id="second">%2$s</xliff:g>滑回约 2 厘米，再抬起。用一个快速、流畅的动作完成。</string>
    <string name="gesture_trainer_how_angle">用<xliff:g id="fingers">%1$s</xliff:g>触摸屏幕，<xliff:g id="first">%2$s</xliff:g>滑动约 2 厘米，然后不要抬起，急转后<xliff:g id="second">%3$s</xliff:g>滑动约 2 厘米，再抬起。转弯要是尖角，像字母 L，而不是弧线。</string>
    <string name="gesture_trainer_taps_1">一次</string>
    <string name="gesture_trainer_taps_2">两次</string>
    <string name="gesture_trainer_taps_3">三次</string>
    <string name="gesture_trainer_taps_4">四次</string>
    <string name="gesture_trainer_how_taps">用<xliff:g id="fingers">%2$s</xliff:g>点按<xliff:g id="taps">%1$s</xliff:g>。手指同时放下、同时抬起，动作要快，不要滑动。</string>
    <string name="gesture_trainer_how_taps_quick">点按要快且在同一位置：下一次点按必须在上一次之后 <xliff:g id="gap">%1$d</xliff:g> 毫秒内。</string>
    <string name="gesture_trainer_how_hold">将<xliff:g id="fingers">%1$s</xliff:g>同时放在屏幕上并保持不动，不要滑动，至少 <xliff:g id="hold">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_how_long_hold_turns_off">如果未分配其他命令，此手势会关闭 SandFly。在训练器中，它不执行任何操作。</string>
    <string name="gesture_trainer_how_taps_hold">用<xliff:g id="fingers">%2$s</xliff:g>点按<xliff:g id="taps">%1$s</xliff:g>，最后一次点按时将手指留在屏幕上保持不动，至少 <xliff:g id="hold">%3$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_how_three_finger_hand">使用拇指、食指和中指。</string>
    <string name="gesture_trainer_how_four_finger_pinch_hand">将食指和中指并排放置，拇指和无名指分别放在两侧几厘米外。然后将四个指尖合拢到一点。</string>
    <string name="gesture_trainer_how_pinch">将 <xliff:g id="fingers">%1$d</xliff:g> 根手指放在屏幕上，彼此张开。然后让它们直线相互靠拢至少 1 厘米，就像捡起东西一样，再从屏幕上抬起。只移动手指，不要移动整只手，也不要沿弧线移动。</string>
    <string name="gesture_trainer_how_spread">将 <xliff:g id="fingers">%1$d</xliff:g> 根手指并拢放在屏幕上。然后让它们直线分开至少 1 厘米，再从屏幕上抬起。只移动手指，不要移动整只手，也不要沿弧线移动。</string>
    <string name="gesture_trainer_clockwise">顺时针</string>
    <string name="gesture_trainer_counterclockwise">逆时针</string>
    <string name="gesture_trainer_how_rotate">将两根手指放在屏幕上，相距约 2 到 3 厘米，绕它们的中点<xliff:g id="way">%1$s</xliff:g>转动，像转动旋钮一样，大约转四分之一圈。然后抬起。</string>
    <string name="gesture_trainer_how_scrub">将两根手指放在屏幕上，快速向一侧移动约 2 厘米再移回，像擦掉东西一样，全部在约一秒内完成。然后抬起。</string>
    <string name="gesture_trainer_edge_bottom">底部边缘</string>
    <string name="gesture_trainer_edge_top_left">顶部边缘的左半部分</string>
    <string name="gesture_trainer_edge_top_right">顶部边缘的右半部分</string>
    <string name="gesture_trainer_edge_left_top">左边缘的上半部分</string>
