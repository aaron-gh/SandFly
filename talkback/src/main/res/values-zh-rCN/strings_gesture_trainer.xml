    <string name="gesture_trainer_left_out_two_finger_swipes">已略过双指滑动：“<xliff:g id="setting">%1$s</xliff:g>”已关闭，因此双指滑动会滚动应用。</string>
    <string name="gesture_trainer_exercise_heading">练习 <xliff:g id="number">%1$d</xliff:g>/<xliff:g id="count">%2$d</xliff:g>：<xliff:g id="gesture">%3$s</xliff:g></string>
