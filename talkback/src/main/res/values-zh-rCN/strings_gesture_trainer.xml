    <string name="gesture_trainer_edge_top">顶部边缘</string>
    <string name="gesture_trainer_how_edge">将一根手指放在<xliff:g id="edge">%1$s</xliff:g>，距边缘不超过 <xliff:g id="edge_width">%2$d</xliff:g> 毫米，<xliff:g id="direction">%3$s</xliff:g>滑入屏幕直到第一次咔嗒声，约 <xliff:g id="distance">%4$d</xliff:g> 毫米。然后立即抬起：超过第二次咔嗒声即为长滑。</string>
    <string name="gesture_trainer_how_edge_long">将一根手指放在<xliff:g id="edge">%1$s</xliff:g>，距边缘不超过 <xliff:g id="edge_width">%2$d</xliff:g> 毫米，<xliff:g id="direction">%3$s</xliff:g>滑入屏幕，越过第一次咔嗒声直到第二次，约 <xliff:g id="distance">%4$d</xliff:g> 毫米。然后抬起。</string>
    <string name="gesture_trainer_how_along">用一根手指沿<xliff:g id="edge">%1$s</xliff:g><xliff:g id="direction">%2$s</xliff:g>滑动，至少 <xliff:g id="distance">%3$d</xliff:g> 毫米。</string>
