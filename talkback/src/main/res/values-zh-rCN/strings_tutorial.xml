    <string name="sandfly_tutorial_pause_intro">语音可在某项读到一半时暂停，并从停止处继续。</string>
    <string name="sandfly_tutorial_pause_pause">移到下方的故事。朗读时，<xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>可暂停语音，再次执行可继续。</string>
    <string name="sandfly_tutorial_pause_resume">再次<xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>即可继续语音。</string>
    <string name="sandfly_tutorial_pause_title">暂停语音</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>：<xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">每个手势会说出其名称和操作，而不会执行它。移到下一项、上一项和激活仍然有效。</string>
    <string name="sandfly_tutorial_practice_step">执行任意手势即可听到它的作用。如需停止，请激活“<xliff:g id="button" example="End practice">%1$s</xliff:g>”。</string>
    <string name="sandfly_tutorial_practice_title">手势练习</string>
    <string name="sandfly_tutorial_progress">已完成 <xliff:g id="done" example="2">%1$d</xliff:g> 个，共 <xliff:g id="count" example="4">%2$d</xliff:g> 个。</string>
    <string name="sandfly_tutorial_reading_controls_characters">将朗读控件更改为“<xliff:g id="reading_control" example="Characters">%2$s</xliff:g>”。<xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>可移动一个字符。</string>
    <string name="sandfly_tutorial_reading_controls_intro">朗读控件决定向上和向下滑动的作用，例如按字词或字符移动，或更改语速。向右和向左滑动仍会在项之间移动。</string>
    <string name="sandfly_tutorial_reading_controls_move">移到下方的句子。</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>可移到下一个字词。移动三个字词。</string>
    <string name="sandfly_tutorial_reading_controls_title">朗读控件</string>
    <string name="sandfly_tutorial_recipe_1">薄煎饼：将面粉、鸡蛋和牛奶混合成顺滑的面糊。</string>
    <string name="sandfly_tutorial_recipe_2">在平底锅中加热少许黄油。</string>
    <string name="sandfly_tutorial_recipe_3">倒入适量面糊，薄薄地铺满锅底。</string>
    <string name="sandfly_tutorial_recipe_4">底面呈金黄色时，将薄煎饼翻面。</string>
    <string name="sandfly_tutorial_recipe_5">配柠檬和白糖食用。</string>
