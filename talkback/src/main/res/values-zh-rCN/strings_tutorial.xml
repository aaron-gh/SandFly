    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>浏览列表，直到到达“<xliff:g id="item" example="Item 15">%2$s</xliff:g>”。</string>
    <string name="sandfly_tutorial_scrolling_title">滚动列表</string>
    <string name="sandfly_tutorial_sentence">敏捷的棕色狐狸跳过了那只懒狗。</string>
