<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">శబ్దాలు మరియు కంపనాలను నియంత్రించండి</string>
    <string name="summary_pref_control_sounds">NVDA కోసం ఫోకస్ సౌండ్ మరియు వైబ్రేషన్ స్థానంలో బటన్‌లు, చెక్‌బాక్స్‌లు, ఎడిట్ ఫీల్డ్‌లు మరియు లిస్ట్ ఐటెమ్‌లు, దాని స్వంత సౌండ్ మరియు దాని స్వంత వైబ్రేషన్ వంటి ప్రతి రకమైన నియంత్రణను అందించండి. స్క్రీన్‌పై నియంత్రణ ఉన్న చోట నుండి ధ్వని వస్తుంది మరియు SandFly అది ఎలాంటి నియంత్రణను తెలియజేస్తుంది.</string>
    <string name="title_pref_control_sounds_speak_roles">ఇప్పటికీ నియంత్రణ రకం చెప్పండి</string>
    <string name="summary_pref_control_sounds_speak_roles">కంట్రోల్ సౌండ్ ప్లే అయినప్పుడు, బటన్ వంటిది ఎలాంటి కంట్రోల్ అని చెప్పండి. ఇది ప్రతి ధ్వని థీమ్ కోసం.</string>
