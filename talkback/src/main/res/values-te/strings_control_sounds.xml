<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">కంట్రోల్ ధ్వనులు మరియు వైబ్రేషన్‌లు</string>
    <string name="summary_pref_control_sounds">బటన్‌లు, చెక్‌బాక్స్‌లు, ఎడిట్ ఫీల్డ్‌లు, లిస్ట్ ఐటెమ్‌లు వంటి ప్రతి రకమైన కంట్రోల్‌కు ఫోకస్ సౌండ్, వైబ్రేషన్‌కు బదులుగా థీమ్ నుండి సొంత సౌండ్, వైబ్రేషన్ లభిస్తాయి, NVDA కోసం Unspoken చేసినట్లు. సౌండ్ స్క్రీన్‌పై కంట్రోల్ ఉన్న స్థానం నుండి వస్తుంది, SandFly కంట్రోల్ రకాన్ని చెప్పదు.</string>
    <string name="title_pref_control_sounds_speak_roles">కంట్రోల్ రకాన్ని కూడా చెప్పు</string>
    <string name="summary_pref_control_sounds_speak_roles">కంట్రోల్ సౌండ్ ప్లే అయినప్పుడు కూడా కంట్రోల్ రకం చెప్పబడుతుంది, ఉదా. బటన్. అన్ని సౌండ్ థీమ్‌లకు వర్తిస్తుంది.</string>
