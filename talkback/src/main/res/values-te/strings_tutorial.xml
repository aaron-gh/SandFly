<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">మెసేజ్‌కు వెళ్లండి. దాని చర్యల మధ్య వెళ్లడానికి <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> లేదా <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>. మీకు వినిపించిన చర్యను చేయడానికి <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>. <xliff:g id="action" example="Archive">%4$s</xliff:g>ని చేయండి.</string>
    <string name="sandfly_tutorial_actions_intro">కొన్ని ఐటెమ్‌లకు యాక్టివేట్ చేయడం కాకుండా ఇతర చర్యలు ఉంటాయి, ఉదాహరణకు మెసేజ్‌కు ఆర్కైవ్ లేదా తొలగించండి. అలాంటి ఐటెమ్‌పై ఫోకస్ ఉన్నప్పుడు, “చర్యలు” రీడింగ్ కంట్రోల్ వాటి మధ్య వెళ్తుంది.</string>
    <string name="sandfly_tutorial_actions_title">చర్యలు</string>
    <string name="sandfly_tutorial_activate_button"><xliff:g id="button" example="Ring the bell">%2$s</xliff:g>కు వెళ్లండి. దాన్ని యాక్టివేట్ చేయడానికి <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_check_box">అదే విధంగా <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>ని చెక్ చేయండి.</string>
    <string name="sandfly_tutorial_activate_hold">కొన్ని ఐటెమ్‌లను నొక్కి ఉంచినప్పుడు అవి వేరే పని చేస్తాయి. <xliff:g id="button" example="Details">%2$s</xliff:g>కు వెళ్లండి. దాన్ని నొక్కి ఉంచడానికి <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_intro">మీరు స్క్రీన్‌పై ఎక్కడ నొక్కినా, యాక్టివేట్ చేయడం ఫోకస్ ఉన్న ఐటెమ్‌పై పని చేస్తుంది.</string>
    <string name="sandfly_tutorial_activate_title">ఐటెమ్‌లను యాక్టివేట్ చేయడం</string>
    <string name="sandfly_tutorial_back_in_lesson">వెనుకకు అనేది పాఠం నుండి బయటకు తీసుకెళ్లదు. మరో పాఠాన్ని ఎంచుకోవడానికి, “విషయ సూచిక”ను ఉపయోగించండి.</string>
    <string name="sandfly_tutorial_bell">గంట కొట్టండి</string>
    <string name="sandfly_tutorial_bell_rung">గంట కొట్టిన సార్లు: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">ప్రకాశం</string>
    <string name="sandfly_tutorial_chapter_basics">ప్రాథమిక అంశాలు</string>
    <string name="sandfly_tutorial_chapter_controls">కంట్రోల్స్, టెక్స్ట్</string>
    <string name="sandfly_tutorial_chapter_getting_around">స్క్రీన్‌లో తిరగడం</string>
    <string name="sandfly_tutorial_chapter_practice">ప్రాక్టీస్</string>
    <string name="sandfly_tutorial_chapter_reading">చదవడం</string>
    <string name="sandfly_tutorial_choose_reading_control">రీడింగ్ కంట్రోల్‌ను మార్చడానికి <xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> లేదా <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g>. <xliff:g id="reading_control" example="Words">%3$s</xliff:g>ని ఎంచుకోండి.</string>
    <string name="sandfly_tutorial_close">ట్యుటోరియల్‌ను మూసివేయండి</string>
    <string name="sandfly_tutorial_commands_copy">SandFly చివరిగా పలికిన టెక్స్ట్‌ను క్లిప్‌బోర్డ్‌కు కాపీ చేయడానికి <xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_commands_intro">ఈ ఆదేశాలు ప్రతి స్క్రీన్‌లో పని చేస్తాయి.</string>
    <string name="sandfly_tutorial_commands_search">స్క్రీన్‌పై టెక్స్ట్ కోసం వెతకడానికి <xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>. ఈ పాఠంలో, బదులుగా అది ఏమి చేస్తుందో ట్యుటోరియల్ చెబుతుంది.</string>
    <string name="sandfly_tutorial_commands_speech_off">స్పీచ్‌ను ఆఫ్ చేయడానికి <xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>, మళ్లీ ఆన్ చేయడానికి మరోసారి. ఈ పాఠంలో, బదులుగా అది ఏమి చేస్తుందో ట్యుటోరియల్ చెబుతుంది.</string>
    <string name="sandfly_tutorial_commands_status">సమయం, బ్యాటరీ స్థాయి, ఇతర స్థితి వినడానికి <xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_commands_title">ఉపయోగకరమైన ఆదేశాలు</string>
    <string name="sandfly_tutorial_contents">విషయ సూచిక</string>
    <string name="sandfly_tutorial_contents_intro">పాఠాలు, క్రమంలో. ప్రతి దాన్ని విడిగా తెరవవచ్చు.</string>
    <string name="sandfly_tutorial_continuous_intro">స్వైప్ చేయకుండానే ఫోకస్ చేసిన ఐటెమ్ నుండి స్క్రీన్ చివరి వరకు SandFly చదవగలదు. స్క్రీన్‌ను తాకితే చదవడం ఆగుతుంది.</string>
    <string name="sandfly_tutorial_continuous_move">రెసిపీలోని మొదటి లైన్‌కు వెళ్లండి.</string>
    <string name="sandfly_tutorial_continuous_read">ఫోకస్ చేసిన ఐటెమ్ నుండి చదవడానికి <xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu">SandFly మెనూను తెరవడానికి <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>, ఆపై <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>ని ఎంచుకోండి.</string>
    <string name="sandfly_tutorial_continuous_title">నిరంతరంగా చదవడం</string>
    <string name="sandfly_tutorial_details">వివరాలు</string>
    <string name="sandfly_tutorial_details_shown">2 మందికి టేబుల్, రాత్రి 7 గంటలకు, కిటికీ దగ్గర.</string>
    <string name="sandfly_tutorial_done">పూర్తయింది</string>
    <string name="sandfly_tutorial_end_practice">ప్రాక్టీస్‌ను ముగించండి</string>
    <string name="sandfly_tutorial_explore_activate">నక్షత్రాన్ని తాకి, వేలిని ఎత్తండి. దాన్ని యాక్టివేట్ చేయడానికి ఎక్కడైనా <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_explore_find">స్క్రీన్‌పై ఒక వేలిని కదిలించి, నాలుగు చతురస్రాలను కనుగొనండి: సూర్యుడు, చంద్రుడు, నక్షత్రం, మేఘం.</string>
    <string name="sandfly_tutorial_explore_intro">స్క్రీన్‌ను తాకితే మీ వేలి కింద ఉన్న ఐటెమ్ చదవబడుతుంది. ఐటెమ్‌ను తాకితే అది యాక్టివేట్ కాదు.</string>
    <string name="sandfly_tutorial_explore_title">తాకడం ద్వారా పరిశీలించడం</string>
    <string name="sandfly_tutorial_extra_cheese">అదనపు చీజ్</string>
    <string name="sandfly_tutorial_finish">ట్యుటోరియల్‌ను ముగించండి</string>
    <string name="sandfly_tutorial_forecast_today">ఈ రోజు</string>
    <string name="sandfly_tutorial_forecast_today_text">ఎండ, వెచ్చగా, తేలికపాటి గాలితో.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">రేపు</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">ఉదయం మేఘావృతం, మధ్యాహ్నం నుండి వర్షం.</string>
    <string name="sandfly_tutorial_forecast_weekend">వారాంతం</string>
    <string name="sandfly_tutorial_forecast_weekend_text">శనివారం గాలులు, ఆదివారం నిర్మలమైన ఆకాశం.</string>
    <string name="sandfly_tutorial_headings_intro">స్క్రీన్‌లు, వెబ్ పేజీలు తమ కంటెంట్‌ను హెడింగ్‌లతో విభజిస్తాయి. “హెడింగ్‌లు” రీడింగ్ కంట్రోల్ ఒక హెడింగ్ నుండి తర్వాతి దానికి వెళ్తుంది.</string>
    <string name="sandfly_tutorial_headings_jump">తర్వాతి హెడింగ్‌కు వెళ్లడానికి <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>. <xliff:g id="heading" example="Weekend">%2$s</xliff:g>కు వెళ్లండి.</string>
    <string name="sandfly_tutorial_headings_title">హెడింగ్‌లు</string>
    <string name="sandfly_tutorial_item_apples">యాపిల్స్</string>
    <string name="sandfly_tutorial_item_bread">బ్రెడ్</string>
    <string name="sandfly_tutorial_item_cheese">చీజ్</string>
    <string name="sandfly_tutorial_item_dates">ఖర్జూరాలు</string>
    <string name="sandfly_tutorial_item_eggs">గుడ్లు</string>
    <string name="sandfly_tutorial_lesson_complete">పాఠం పూర్తయింది.</string>
    <string name="sandfly_tutorial_lesson_complete_last">పాఠం పూర్తయింది. ట్యుటోరియల్‌ను ముగించడానికి <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_lesson_complete_next">పాఠం పూర్తయింది. తర్వాతి పాఠాన్ని ప్రారంభించడానికి <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, పాఠం <xliff:g id="count" example="17">%3$d</xliff:g>లో <xliff:g id="number" example="3">%2$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">ఐటెమ్ <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close">మెనూను మూసివేయడానికి <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_menu_intro">SandFly మెనూలో ఫోకస్ చేసిన ఐటెమ్, ప్రస్తుత స్క్రీన్ కోసం ఆదేశాలు ఉంటాయి.</string>
    <string name="sandfly_tutorial_menu_open">SandFly మెనూను తెరవడానికి <xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>. దాని ఆదేశాల మధ్య స్వైప్ చేయండి. మెనూను మూసివేయడానికి <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_menu_title">SandFly మెనూ</string>
    <string name="sandfly_tutorial_message">సామ్ నుండి మెసేజ్: మధ్యాహ్నం 12 గంటలకు లంచ్?</string>
    <string name="sandfly_tutorial_message_archive">ఆర్కైవ్ చేయండి</string>
    <string name="sandfly_tutorial_message_delete">తొలగించండి</string>
    <string name="sandfly_tutorial_message_reply">ప్రత్యుత్తరం ఇవ్వండి</string>
    <string name="sandfly_tutorial_move_intro">స్వైప్ చేస్తే స్క్రీన్‌పై తర్వాతి లేదా మునుపటి ఐటెమ్‌కు, చదివే క్రమంలో, వెళ్తుంది.</string>
    <string name="sandfly_tutorial_move_next">తర్వాతి ఐటెమ్‌కు వెళ్లడానికి <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>. <xliff:g id="item" example="Eggs">%2$s</xliff:g> వచ్చే వరకు కొనసాగించండి.</string>
    <string name="sandfly_tutorial_move_previous">మునుపటి ఐటెమ్‌కు వెళ్లడానికి <xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>. <xliff:g id="item" example="Bread">%2$s</xliff:g>కు తిరిగి వెళ్లండి.</string>
    <string name="sandfly_tutorial_move_title">ఐటెమ్‌ల మధ్య కదలడం</string>
    <string name="sandfly_tutorial_name">పేరు</string>
    <string name="sandfly_tutorial_next_lesson">తర్వాతి పాఠం: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g>కి సంజ్ఞ లేదు. “ఆదేశాలు”లో ఒకదాన్ని కేటాయించండి, లేదా “దశను స్కిప్ చేయండి”ని ఉపయోగించండి.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> పాఠంలో జరగదు. ట్యుటోరియల్ నుండి బయటకు వెళ్లడానికి, “విషయ సూచిక”లో “ట్యుటోరియల్‌ను మూసివేయండి”ని ఉపయోగించండి.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> పాఠంలో జరగదు.</string>
    <string name="sandfly_tutorial_pause_intro">ఐటెమ్ మధ్యలో స్పీచ్‌ను పాజ్ చేసి, ఆగిన చోటు నుండి మళ్లీ కొనసాగించవచ్చు.</string>
    <string name="sandfly_tutorial_pause_pause">కింద ఉన్న కథకు వెళ్లండి. అది చదువుతున్నప్పుడు స్పీచ్‌ను పాజ్ చేయడానికి <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>, మళ్లీ కొనసాగించడానికి మరోసారి.</string>
    <string name="sandfly_tutorial_pause_resume">స్పీచ్‌ను మళ్లీ కొనసాగించడానికి మరోసారి <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_pause_title">స్పీచ్‌ను పాజ్ చేయడం</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">ప్రతి సంజ్ఞ తన చర్యను చేయకుండా, తన పేరును, చర్యను చెబుతుంది. తర్వాతి, మునుపటి ఐటెమ్‌కు వెళ్లడం, యాక్టివేట్ చేయడం ఇప్పటికీ పని చేస్తాయి.</string>
    <string name="sandfly_tutorial_practice_step">ఏదైనా సంజ్ఞ ఏమి చేస్తుందో వినడానికి దాన్ని చేయండి. ఆపడానికి, <xliff:g id="button" example="End practice">%1$s</xliff:g>ని యాక్టివేట్ చేయండి.</string>
    <string name="sandfly_tutorial_practice_title">సంజ్ఞల ప్రాక్టీస్</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="count" example="4">%2$d</xliff:g>లో <xliff:g id="done" example="2">%1$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">రీడింగ్ కంట్రోల్‌ను <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>కి మార్చండి. ఒక అక్షరం కదలడానికి <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_intro">పైకి, కిందికి స్వైప్ చేస్తే ఏమి జరుగుతుందో రీడింగ్ కంట్రోల్స్ నిర్ణయిస్తాయి, ఉదాహరణకు పదం వారీగా లేదా అక్షరం వారీగా కదలడం, లేదా స్పీచ్ రేట్‌ను మార్చడం. కుడికి, ఎడమకు స్వైప్ చేస్తే ఇప్పటికీ ఐటెమ్‌ల మధ్య కదులుతుంది.</string>
    <string name="sandfly_tutorial_reading_controls_move">కింద ఉన్న వాక్యానికి వెళ్లండి.</string>
    <string name="sandfly_tutorial_reading_controls_next_word">తర్వాతి పదానికి వెళ్లడానికి <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>. మూడు పదాలు కదలండి.</string>
    <string name="sandfly_tutorial_reading_controls_title">రీడింగ్ కంట్రోల్స్</string>
    <string name="sandfly_tutorial_recipe_1">పాన్‌కేక్‌లు: పిండి, గుడ్లు, పాలు కలిపి మెత్తని పిండి మిశ్రమం చేయండి.</string>
    <string name="sandfly_tutorial_recipe_2">పెనంలో కొంచెం వెన్న వేడి చేయండి.</string>
    <string name="sandfly_tutorial_recipe_3">పెనాన్ని పలుచగా కప్పేంత పిండి మిశ్రమం పోయండి.</string>
    <string name="sandfly_tutorial_recipe_4">కింది వైపు బంగారు రంగులోకి మారినప్పుడు పాన్‌కేక్‌ను తిప్పండి.</string>
    <string name="sandfly_tutorial_recipe_5">నిమ్మకాయ, చక్కెరతో వడ్డించండి.</string>
    <string name="sandfly_tutorial_scrolling_intro">లిస్ట్‌లు ఒకేసారి తమ ఐటెమ్‌లలో కొన్నింటిని మాత్రమే చూపిస్తాయి. చూపిన చివరి ఐటెమ్ దాటి స్వైప్ చేస్తే లిస్ట్ స్క్రోల్ అవుతుంది.</string>
    <string name="sandfly_tutorial_scrolling_page">ఒక పేజీ ముందుకు స్క్రోల్ చేయడానికి <xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="item" example="Item 15">%2$s</xliff:g> వచ్చే వరకు లిస్ట్‌లో <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">లిస్ట్‌లను స్క్రోల్ చేయడం</string>
    <string name="sandfly_tutorial_sentence">వేగంగా ఉన్న గోధుమ నక్క బద్ధకపు కుక్క మీదుగా దూకుతుంది.</string>
    <string name="sandfly_tutorial_skip_step">దశను స్కిప్ చేయండి</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> స్లయిడర్‌కు వెళ్లండి. దాని విలువను మార్చడానికి <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> లేదా <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g>ని దాని గరిష్ఠ విలువ అయిన 100 శాతానికి సెట్ చేయండి.</string>
    <string name="sandfly_tutorial_sliders_intro">స్లయిడర్‌పై ఫోకస్ ఉన్నప్పుడు, పైకి, కిందికి స్వైప్ చేస్తే దాని విలువ మారుతుంది.</string>
    <string name="sandfly_tutorial_sliders_title">స్లయిడర్‌లు</string>
    <string name="sandfly_tutorial_step">దశ <xliff:g id="count" example="2">%2$d</xliff:g>లో <xliff:g id="number" example="1">%1$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">ఇసుక ఈగలు సముద్ర తీరాలు, నదీ తీరాలు, అడవులలో నివసించే చిన్న ఈగలు. గాలి నిశ్చలంగా ఉండే వేకువ, సంధ్యా సమయాల్లో అవి ఎక్కువ చురుకుగా ఉంటాయి. ఆడ ఈగలు మాత్రమే కుడతాయి, ఎందుకంటే గుడ్లు పెట్టడానికి వాటికి రక్తం అవసరం. కాట్లు రోజుల తరబడి దురద పెడతాయి, అందుకే ఇసుక ఈగలు ఉండే ప్రాంతాలకు వెళ్లేవారు కీటక నివారిణి వెంట తీసుకెళ్తారు. ఇసుక ఈగలు బలహీనంగా ఎగురుతాయి, తేలికపాటి గాలి కూడా వాటిని దూరంగా ఉంచుతుంది.</string>
    <string name="sandfly_tutorial_system_back">వెనుకకు వెళ్లడానికి <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_home">హోమ్ స్క్రీన్‌కు వెళ్లడానికి <xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_intro">ఈ సంజ్ఞలు ప్రతి స్క్రీన్‌లో పని చేస్తాయి. ఈ పాఠంలో, ప్రతి సంజ్ఞను చేయడానికి బదులుగా అది ఏమి చేస్తుందో ట్యుటోరియల్ చెబుతుంది.</string>
    <string name="sandfly_tutorial_system_notifications">నోటిఫికేషన్‌లను తెరవడానికి <xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_overview">ఇటీవలి యాప్‌లను చూపడానికి <xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>.</string>
