<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">Sons e vibrações dos controles</string>
    <string name="summary_pref_control_sounds">Cada tipo de controle, como botões, caixas de seleção, campos de edição e itens de lista, recebe um som e uma vibração próprios do tema no lugar do som e da vibração de foco, como o Unspoken faz no NVDA. O som vem da posição do controle na tela, e o SandFly não diz o tipo de controle.</string>
    <string name="title_pref_control_sounds_speak_roles">Também falar o tipo de controle</string>
    <string name="summary_pref_control_sounds_speak_roles">Quando um som de controle toca, o tipo de controle ainda é falado, como botão. Vale para todos os temas sonoros.</string>
    <string name="title_pref_control_sounds_3d">Áudio 3D</string>
    <string name="pref_control_sounds_3d_headphones">Com fones de ouvido</string>
    <string name="pref_control_sounds_3d_always">Sempre</string>
    <string name="pref_control_sounds_3d_never">Nunca, apenas esquerda e direita</string>
