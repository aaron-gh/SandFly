    <string name="title_pref_control_sounds">নিয়ন্ত্ৰণৰ ধ্বনি আৰু কম্পন</string>
    <string name="summary_pref_control_sounds">ফ’কাছৰ ধ্বনি আৰু কম্পনৰ সলনি, বুটাম, চেকবক্স, সম্পাদনা ক্ষেত্ৰ আৰু সূচীৰ বস্তুৰ দৰে প্ৰতিটো প্ৰকাৰৰ নিয়ন্ত্ৰণক থীমৰ পৰা নিজা ধ্বনি আৰু নিজা কম্পন দিয়ক, NVDAৰ বাবে Unspokenএ কৰাৰ দৰে। ধ্বনিটো স্ক্ৰীনত নিয়ন্ত্ৰণটো থকা স্থানৰ পৰা আহে, আৰু SandFlyএ নিয়ন্ত্ৰণটোৰ প্ৰকাৰ নকয়।</string>
    <string name="title_pref_control_sounds_speak_roles">নিয়ন্ত্ৰণৰ প্ৰকাৰো কওক</string>
    <string name="summary_pref_control_sounds_speak_roles">নিয়ন্ত্ৰণৰ ধ্বনি বাজিলেও, নিয়ন্ত্ৰণটোৰ প্ৰকাৰ কওক, যেনে বুটাম। এইটো আটাইবোৰ ধ্বনিৰ থীমৰ বাবে প্ৰযোজ্য।</string>
