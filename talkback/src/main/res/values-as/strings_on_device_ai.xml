    <string name="title_pref_on_device_ai_ignore_memory_limits">ডিভাইচত থকা AIৰ মেমৰিৰ সীমা আওকাণ কৰক</string>
    <string name="summary_pref_on_device_ai_ignore_memory_limits">এই ফ’নটোত থকাতকৈ অধিক মেমৰিৰ প্ৰয়োজন থকা মডেল বাছনি কৰিব দিয়ে, আৰু Androidএ বন্ধ কৰিলে কি হয় পৰীক্ষা কৰিবলৈ খালী মেমৰি পৰীক্ষা নকৰাকৈ সেইটো ল’ড কৰে।</string>
    <string name="on_device_ai_not_enough_memory">%1$sৰ বাবে পৰ্যাপ্ত খালী মেমৰি নাই। কিছুমান এপ বন্ধ কৰক, বা ডিভাইচত থকা AIৰ ছেটিঙত এটা সৰু মডেল বাছনি কৰক।</string>
    <string name="on_device_ai_stopped">%1$s বন্ধ হ’ল, সম্ভৱতঃ ফ’নটোৰ মেমৰি শেষ হোৱাৰ বাবে। ডিভাইচত থকা AIৰ ছেটিঙত এটা সৰু মডেল বাছনি কৰক।</string>
