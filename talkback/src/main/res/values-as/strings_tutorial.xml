    <string name="sandfly_tutorial_title">SandFlyৰ টিউট’ৰিয়েল</string>
    <string name="sandfly_tutorial_typing_delete">কীব’ৰ্ডৰ Delete কীৰে শেষ আখৰটো মচক।</string>
    <string name="sandfly_tutorial_typing_intro">লিখনি ক্ষেত্ৰ সক্ৰিয় কৰিলে কীব’ৰ্ড খোল খায়। কী শুনিবলৈ স্পৰ্শ কৰক, আৰু টাইপ কৰিবলৈ আঙুলি উঠাওক।</string>
    <string name="sandfly_tutorial_typing_open"><xliff:g id="field" example="Name">%2$s</xliff:g> ক্ষেত্ৰলৈ যাওক। টাইপ কৰিবলৈ আৰম্ভ কৰিবলৈ: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_typing_title">টাইপিং</string>
