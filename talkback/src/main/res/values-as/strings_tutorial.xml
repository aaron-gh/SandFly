    <string name="sandfly_tutorial_typing_word">ঘৰ</string>
    <string name="sandfly_tutorial_welcome_intro">এই টিউট’ৰিয়েলে SandFlyৰ নিৰ্দেশসমূহ শিকায়। প্ৰতিটো পাঠে এটা নিৰ্দেশনা দিয়ে, আপুনি নিজৰ নিৰ্দেশেৰে সেয়া নকৰালৈকে অপেক্ষা কৰে, তাৰ পাছত পৰৱৰ্তীটো দিয়ে। নিৰ্দেশনাটো পাঠৰ নামৰ পাছৰ প্ৰথম বস্তু। “সূচীপত্ৰ”এ সকলো পাঠ দেখুৱায়, আৰু টিউট’ৰিয়েলটো আপুনি থকা পাঠতে পুনৰ খোল খায়।</string>
    <string name="sandfly_tutorial_welcome_start">আৰম্ভ কৰিবলৈ স্ক্ৰীনৰ য’তেই: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_welcome_title">স্বাগতম</string>
