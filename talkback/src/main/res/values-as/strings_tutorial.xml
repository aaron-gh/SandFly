    <string name="sandfly_tutorial_reading_controls_next_word">পৰৱৰ্তী শব্দলৈ যাবলৈ: <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>। তিনিটা শব্দ আগুৱাওক।</string>
    <string name="sandfly_tutorial_reading_controls_title">পঢ়াৰ নিয়ন্ত্ৰণ</string>
    <string name="sandfly_tutorial_recipe_1">পেনকেক: আটা, কণী আৰু গাখীৰ মিহলাই মিহি গোলা বনাওক।</string>
    <string name="sandfly_tutorial_recipe_2">ফ্ৰাইং পেনত অলপ মাখন গৰম কৰক।</string>
    <string name="sandfly_tutorial_recipe_3">পেনখন পাতলকৈ ঢাকিব পৰাকৈ গোলা ঢালক।</string>
    <string name="sandfly_tutorial_recipe_4">তলৰ ফালটো সোণালী হ’লে পেনকেকটো লুটিয়াই দিয়ক।</string>
    <string name="sandfly_tutorial_recipe_5">নেমু আৰু চেনিৰ সৈতে পৰিবেশন কৰক।</string>
    <string name="sandfly_tutorial_scrolling_intro">তালিকাই এবাৰত নিজৰ কিছুমান বস্তুহে দেখুৱায়। দেখুওৱা শেষ বস্তুটো পাৰ হৈ ছোৱাইপ কৰিলে তালিকাখন স্ক্ৰ’ল হয়।</string>
    <string name="sandfly_tutorial_scrolling_page">এটা পৃষ্ঠা আগলৈ স্ক্ৰ’ল কৰিবলৈ: <xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="item" example="Item 15">%2$s</xliff:g> নোপোৱালৈকে তালিকাখনত: <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_scrolling_title">তালিকা স্ক্ৰ’ল কৰা</string>
    <string name="sandfly_tutorial_sentence">চঞ্চল মটীয়া শিয়ালটোৱে এলেহুৱা কুকুৰটোৰ ওপৰেৰে জাঁপ মাৰে।</string>
    <string name="sandfly_tutorial_skip_step">পদক্ষেপ বাদ দিয়ক</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> শ্লাইডাৰলৈ যাওক। ইয়াৰ মান সলনি কৰিবলৈ: <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> বা <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>।</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> ইয়াৰ সৰ্বোচ্চ মান, ১০০ শতাংশলৈ ছেট কৰক।</string>
    <string name="sandfly_tutorial_sliders_intro">শ্লাইডাৰত ফ’কাছ থাকিলে ওপৰলৈ আৰু তললৈ ছোৱাইপ কৰিলে ইয়াৰ মান সলনি হয়।</string>
    <string name="sandfly_tutorial_sliders_title">শ্লাইডাৰ</string>
    <string name="sandfly_tutorial_step"><xliff:g id="count" example="2">%2$d</xliff:g>টাৰ ভিতৰত পদক্ষেপ <xliff:g id="number" example="1">%1$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">বালিমাখি হৈছে সৰু মাখি, যিবোৰ সাগৰৰ পাৰত, নদীৰ পাৰত আৰু হাবিত থাকে। পুৱতি নিশা আৰু গধূলি, যেতিয়া বতাহ স্থিৰ থাকে, তেতিয়া সিহঁত আটাইতকৈ সক্ৰিয়। কেৱল মাইকী মাখিয়েহে কামোৰে, কাৰণ কণী পাৰিবলৈ সিহঁতক তেজৰ প্ৰয়োজন। কামোৰা ঠাই কেইবাদিনলৈ খজুৱায়, সেয়েহে বালিমাখি থকা অঞ্চললৈ যোৱা মানুহে পোক খেদা দৰব লগত লৈ যায়। বালিমাখি দুৰ্বল উৰণীয়া, আৰু লাহী বতাহেও সিহঁতক আঁতৰাই ৰাখে।</string>
    <string name="sandfly_tutorial_system_back">উভতি যাবলৈ: <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_home">গৃহ স্ক্ৰীনলৈ যাবলৈ: <xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_intro">এই নিৰ্দেশসমূহে প্ৰতিখন স্ক্ৰীনত কাম কৰে। এই পাঠত টিউট’ৰিয়েলে প্ৰতিটো নিৰ্দেশৰ কাম কৰাৰ সলনি সি কি কৰে কয়।</string>
    <string name="sandfly_tutorial_system_notifications">জাননী খুলিবলৈ: <xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_overview">শেহতীয়া এপ্‌সমূহ দেখুৱাবলৈ: <xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>।</string>
