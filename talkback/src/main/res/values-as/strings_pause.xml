    <string name="dialog_message_pause_backtalk">SandFly পজ কৰি থোৱা অৱস্থাত ই কথা নকয় বা নিৰ্দেশৰ প্ৰতি সঁহাৰি নিদিয়ে, আৰু স্ক্ৰীনখনে কোনো স্ক্ৰীন ৰীডাৰ অন নথকাৰ দৰে কাম কৰে।</string>
    <string name="message_resume_keyguard">পুনৰ আৰম্ভ কৰিবলৈ, “SandFly পজ কৰা আছে” জাননীটোত টিপক, ভলিউম কমোৱা কীটো ক্ষিপ্ৰতাৰে ৩ বাৰ টিপক, অথবা লক স্ক্ৰীন দেখুৱাবলৈ ফ’নটো লক কৰি পুনৰ সক্ৰিয় কৰক।</string>
    <string name="message_resume_screen_on">পুনৰ আৰম্ভ কৰিবলৈ, “SandFly পজ কৰা আছে” জাননীটোত টিপক, ভলিউম কমোৱা কীটো ক্ষিপ্ৰতাৰে ৩ বাৰ টিপক, অথবা স্ক্ৰীনখন অফ কৰি পুনৰ অন কৰক।</string>
    <string name="message_resume_manual">পুনৰ আৰম্ভ কৰিবলৈ, “SandFly পজ কৰা আছে” জাননীটোত টিপক অথবা ভলিউম কমোৱা কীটো ক্ষিপ্ৰতাৰে ৩ বাৰ টিপক।</string>
