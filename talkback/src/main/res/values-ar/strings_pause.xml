    <string name="summary_pause_backtalk">إيقاف الكلام والإيماءات والاستكشاف باللمس إلى أن تستأنف SandFly</string>
    <string name="keycombo_menu_global_pause_backtalk">إيقاف SandFly مؤقتًا أو استئنافه</string>
    <string name="backtalk_paused">تم إيقاف SandFly مؤقتًا</string>
    <string name="backtalk_resumed">تم استئناف SandFly</string>
    <string name="notification_title_backtalk_paused">‏SandFly متوقف مؤقتًا</string>
