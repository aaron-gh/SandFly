    <string name="sandfly_tutorial_typing_word">قط</string>
    <string name="sandfly_tutorial_welcome_intro">يعلّم هذا الدليل التوجيهي إيماءات SandFly. يقدّم كل درس تعليمة، وينتظر حتى تنفّذها بإيماءاتك، ثم يقدّم التعليمة التالية. التعليمة هي أول عنصر بعد اسم الدرس. تعرض «المحتويات» كل الدروس، ويُفتح الدليل التوجيهي مرة أخرى على الدرس الذي توقّفت عنده.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> في أي مكان على الشاشة للبدء.</string>
    <string name="sandfly_tutorial_welcome_title">مرحبًا</string>
