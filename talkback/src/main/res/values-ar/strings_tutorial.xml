    <string name="sandfly_tutorial_system_intro">تعمل هذه الإيماءات في كل شاشة. في هذا الدرس، يقول الدليل التوجيهي ما تفعله كل إيماءة بدلاً من تنفيذها.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> لفتح الإشعارات.</string>
