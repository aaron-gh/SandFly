    <string name="live_recognition_connecting">Gemini bilan ulanmoqda…</string>
    <string name="live_recognition_cloud_title">Kamera tasvirlari Gemini’ga yuborilsinmi?</string>
    <string name="live_recognition_cloud_message">Sahnalar, Koʻrsat va oʻqi, Odamlarni aniqlash va Eshiklarni aniqlash har bir necha soniyada kameradan tasvirni Google’ning Gemini API xizmatiga yuboradi. Matn shu telefonda aniqlanadi.\n\nBepul API kaliti bilan Google olgan narsasini saqlashi, mahsulotlarini yaxshilash uchun ishlatishi va odamlarga koʻrib chiqtirishi mumkin. Generativ AI tajribaviy, shuning uchun u xato qiladi.</string>
    <string name="live_recognition_service_title">Kamera tasvirlari <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> manziliga yuborilsinmi?</string>
    <string name="live_recognition_service_message">Sahnalar, Koʻrsat va oʻqi, Odamlarni aniqlash va Eshiklarni aniqlash har bir necha soniyada kameradan tasvirni <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> manziliga yuboradi. Matn shu telefonda aniqlanadi.\n\nXizmatning oʻz shartlari va maxfiylik siyosati amal qiladi. Generativ AI tajribaviy, shuning uchun u xato qiladi.</string>
