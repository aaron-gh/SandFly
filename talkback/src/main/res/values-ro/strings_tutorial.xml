    <string name="sandfly_tutorial_actions_archive">Mergi la mesaj. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> sau <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> pentru a parcurge acțiunile lui. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> pentru a executa acțiunea pe care o auzi. Execută <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Unele elemente au acțiuni în afară de activare, cum ar fi Arhivează sau Șterge pentru un mesaj. Cât timp un astfel de element este focalizat, comanda pentru citire Acțiuni le parcurge.</string>
    <string name="sandfly_tutorial_actions_title">Acțiuni</string>
    <string name="sandfly_tutorial_activate_button">Mergi la <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> pentru a-l activa.</string>
    <string name="sandfly_tutorial_activate_check_box">Bifează <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> în același mod.</string>
    <string name="sandfly_tutorial_activate_hold">Unele elemente fac altceva când sunt ținute apăsat. Mergi la <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> pentru a-l ține apăsat.</string>
    <string name="sandfly_tutorial_activate_intro">Activarea se aplică elementului focalizat, oriunde ai atinge ecranul.</string>
    <string name="sandfly_tutorial_activate_title">Activarea elementelor</string>
    <string name="sandfly_tutorial_back_in_lesson">Înapoi nu părăsește o lecție. Pentru a alege altă lecție, folosește Cuprins.</string>
