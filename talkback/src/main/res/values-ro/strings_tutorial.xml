    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> pentru a accesa ecranul de pornire.</string>
    <string name="sandfly_tutorial_system_intro">Aceste gesturi funcționează pe orice ecran. În această lecție, tutorialul spune ce face fiecare în loc să-l execute.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> pentru a deschide notificările.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> pentru a afișa aplicațiile recente.</string>
