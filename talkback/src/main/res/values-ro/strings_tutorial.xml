    <string name="sandfly_tutorial_typing_type">Scrie cuvântul <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">pisica</string>
    <string name="sandfly_tutorial_welcome_intro">Acest tutorial te învață gesturile SandFly. Fiecare lecție dă o instrucțiune, așteaptă până o execuți cu propriile gesturi, apoi o dă pe următoarea. Instrucțiunea este primul element după numele lecției. Cuprins listează toate lecțiile, iar tutorialul se redeschide la lecția la care ai rămas.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> oriunde pe ecran pentru a începe.</string>
    <string name="sandfly_tutorial_welcome_title">Bun venit</string>
