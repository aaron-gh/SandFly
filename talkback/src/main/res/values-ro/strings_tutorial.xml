    <string name="sandfly_tutorial_typing_delete">Șterge ultima literă cu tasta Ștergere a tastaturii.</string>
    <string name="sandfly_tutorial_typing_intro">Activarea unui câmp de text deschide tastatura. Atinge o tastă pentru a o auzi și ridică degetul pentru a o introduce.</string>
    <string name="sandfly_tutorial_typing_open">Mergi la câmpul <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> pentru a începe să scrii.</string>
