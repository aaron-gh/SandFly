    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> nu se execută într-o lecție. Pentru a părăsi tutorialul, folosește Închide tutorialul din Cuprins.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> nu se execută într-o lecție.</string>
    <string name="sandfly_tutorial_pause_intro">Vorbirea poate fi întreruptă în mijlocul unui element și reluată de unde s-a oprit.</string>
    <string name="sandfly_tutorial_pause_pause">Mergi la povestea de mai jos. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> în timp ce este citită pentru a întrerupe vorbirea și încă o dată pentru a o relua.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> încă o dată pentru a relua vorbirea.</string>
    <string name="sandfly_tutorial_pause_title">Întreruperea vorbirii</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Fiecare gest își spune numele și acțiunea în loc s-o execute. Trecerea la elementul următor și anterior și activarea funcționează în continuare.</string>
    <string name="sandfly_tutorial_practice_step">Fă orice gest pentru a auzi ce face. Pentru a opri, activează <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Exersarea gesturilor</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> din <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Schimbă comanda pentru citire la <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> pentru a te deplasa cu un caracter.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Comenzile pentru citire aleg ce face glisarea în sus și în jos, cum ar fi deplasarea pe cuvinte sau pe caractere ori schimbarea vitezei vorbirii. Glisarea spre dreapta și spre stânga trece în continuare de la un element la altul.</string>
    <string name="sandfly_tutorial_reading_controls_move">Mergi la propoziția de mai jos.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> pentru a trece la cuvântul următor. Deplasează-te trei cuvinte.</string>
    <string name="sandfly_tutorial_reading_controls_title">Comenzi pentru citire</string>
    <string name="sandfly_tutorial_recipe_1">Clătite: amestecă făina, ouăle și laptele până obții un aluat omogen.</string>
    <string name="sandfly_tutorial_recipe_2">Încălzește puțin unt într-o tigaie.</string>
    <string name="sandfly_tutorial_recipe_3">Toarnă suficient aluat cât să acopere tigaia într-un strat subțire.</string>
    <string name="sandfly_tutorial_recipe_4">Întoarce clătita când partea de jos s-a rumenit.</string>
    <string name="sandfly_tutorial_recipe_5">Servește cu lămâie și zahăr.</string>
    <string name="sandfly_tutorial_scrolling_intro">Listele afișează doar o parte din elemente odată. Glisarea dincolo de ultimul element afișat derulează lista.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> pentru a derula înainte cu o pagină.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> prin listă până ajungi la <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Derularea listelor</string>
    <string name="sandfly_tutorial_sentence">Vulpea maro și iute sare peste câinele leneș.</string>
    <string name="sandfly_tutorial_skip_step">Omite pasul</string>
    <string name="sandfly_tutorial_sliders_change">Mergi la glisorul <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> sau <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> pentru a-i schimba valoarea.</string>
    <string name="sandfly_tutorial_sliders_highest">Setează <xliff:g id="slider" example="Brightness">%1$s</xliff:g> la 100 la sută, valoarea maximă.</string>
    <string name="sandfly_tutorial_sliders_intro">Când un glisor este focalizat, glisarea în sus și în jos îi schimbă valoarea.</string>
    <string name="sandfly_tutorial_sliders_title">Glisoare</string>
    <string name="sandfly_tutorial_step">Pasul <xliff:g id="number" example="1">%1$d</xliff:g> din <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Flebotomii sunt muște mici care trăiesc pe plaje, pe malurile râurilor și în păduri. Sunt cei mai activi în zori și la amurg, când aerul este nemișcat. Numai femelele înțeapă, deoarece au nevoie de sânge pentru a-și produce ouăle. Înțepăturile mănâncă zile întregi, așa că oamenii care vizitează zonele unde trăiesc poartă la ei soluție împotriva insectelor. Flebotomii zboară slab, iar chiar și o adiere ușoară îi ține la distanță.</string>
