    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> pentru a citi de la elementul focalizat.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> pentru a deschide meniul SandFly. Apoi alege <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
