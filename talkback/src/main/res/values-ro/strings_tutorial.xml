    <string name="sandfly_tutorial_move_intro">Glisarea trece la elementul următor sau anterior de pe ecran, în ordinea de citire.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> pentru a trece la elementul următor. Continuă până ajungi la <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> pentru a trece la elementul anterior. Revino la <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Deplasarea între elemente</string>
    <string name="sandfly_tutorial_name">Nume</string>
