<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="announcing_text_formatiing_sample"><![CDATA[このテキストは<b>太字</b>で、自信に満ちた叫びのよう。
<br>こちらは<u>下線</u>で、疑いようもなくささやき声。<br>
<br><span style="background-color:#b22222;">バラは赤い</span>、まさに定番、
<br><span style="background-color:#0000cd;">スミレは青い</span>、やさしく美しい色。
<br>
<br>かすかな秘密のように<small>小さな</small>ものもあれば、
<br>空気をすべて占めるほど<big>大きな</big>ものもあります。
<br>
<br>色彩がはじける、鮮やかな光景、
<br><font color="#f08080">燃えるような赤</font>から<font color="#80da88">青々とした緑</font>まで、穏やかに揺らめく。]]></string>
</resources>
