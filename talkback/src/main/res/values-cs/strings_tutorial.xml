    <string name="sandfly_tutorial_recipe_2">Na pánvi rozehřejte trochu másla.</string>
    <string name="sandfly_tutorial_recipe_3">Nalijte tolik těsta, aby tence pokrylo pánev.</string>
    <string name="sandfly_tutorial_recipe_4">Až bude spodní strana zlatavá, palačinku obraťte.</string>
    <string name="sandfly_tutorial_recipe_5">Podávejte s citronem a cukrem.</string>
    <string name="sandfly_tutorial_scrolling_intro">Seznamy zobrazují najednou jen některé položky. Přejetí za poslední zobrazenou položku seznam posune.</string>
