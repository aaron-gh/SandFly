    <string name="sandfly_tutorial_reading_controls_characters">Změňte ovládací prvek čtení na <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> pro přesun o jeden znak.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Ovládání čtení určuje, co dělá přejetí nahoru a dolů, například přesun po slovech nebo po znacích nebo změnu rychlosti řeči. Přejetí doprava a doleva dál přesouvá mezi položkami.</string>
    <string name="sandfly_tutorial_reading_controls_move">Přejděte na větu níže.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> pro přesun na další slovo. Posuňte se o tři slova.</string>
    <string name="sandfly_tutorial_reading_controls_title">Ovládání čtení</string>
