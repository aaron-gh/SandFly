    <string name="sandfly_tutorial_actions_archive">Přejděte na zprávu. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> nebo <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> pro procházení jejích akcí. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> pro provedení akce, kterou slyšíte. Proveďte akci <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Některé položky mají kromě aktivace i další akce, například Archivovat nebo Smazat u zprávy. Když je taková položka zaměřená, ovládací prvek čtení Akce jimi prochází.</string>
    <string name="sandfly_tutorial_actions_title">Akce</string>
    <string name="sandfly_tutorial_activate_button">Přejděte na položku <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> pro její aktivaci.</string>
