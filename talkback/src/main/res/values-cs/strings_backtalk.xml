    <string name="title_pref_speakerphone_away_from_ear">Reproduktor při oddálení od ucha</string>
    <string name="summary_pref_speakerphone_away_from_ear">Během hovoru přepne zvuk do reproduktoru, když telefon oddálíte od ucha, a zpět do sluchátka, když jej znovu přiložíte k uchu.</string>
    <string name="summary_pref_speakerphone_needs_permission">Vyžaduje oprávnění, které Android odečítačům obrazovky běžně neuděluje. Chcete-li je udělit, spusťte pomocí adb nebo Shizuku tento příkaz a potom se vraťte na tuto obrazovku: %1$s</string>

