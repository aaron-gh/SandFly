    <!-- Wrap around. -->
    <string name="title_pref_wrap_around">Přecházet přes okraj</string>
    <string name="summary_pref_wrap_around">Po přejetí za poslední položku se přejde na první a před první položkou na poslední. Je-li vypnuto, na konci se místo toho přehraje zvuk.</string>
