    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> atau <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> untuk mengubah kontrol pembacaan. Pilih <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Tutup tutorial</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> untuk menyalin teks terakhir yang diucapkan SandFly ke papan klip.</string>
    <string name="sandfly_tutorial_commands_intro">Perintah ini berfungsi di setiap layar.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> untuk menelusuri teks di layar. Di pelajaran ini, tutorial mengucapkan fungsinya sebagai gantinya.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> untuk menonaktifkan ucapan, dan sekali lagi untuk mengaktifkannya. Di pelajaran ini, tutorial mengucapkan fungsinya sebagai gantinya.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> untuk mendengar waktu, level baterai, dan status lainnya.</string>
