    <string name="sandfly_tutorial_forecast_tomorrow">Besok</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Berawan pada pagi hari, hujan mulai tengah hari.</string>
    <string name="sandfly_tutorial_forecast_weekend">Akhir pekan</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Berangin pada hari Sabtu, cerah pada hari Minggu.</string>
    <string name="sandfly_tutorial_headings_intro">Layar dan halaman web membagi kontennya dengan judul. Kontrol pembacaan Judul melompat dari satu judul ke judul berikutnya.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> untuk melompat ke judul berikutnya. Lompat ke <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
