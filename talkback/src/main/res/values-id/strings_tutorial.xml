    <string name="sandfly_tutorial_contents">Daftar isi</string>
    <string name="sandfly_tutorial_contents_intro">Pelajaran, secara berurutan. Setiap pelajaran dapat dibuka tersendiri.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly dapat membaca dari item yang difokuskan hingga akhir layar tanpa menggeser. Menyentuh layar menghentikan pembacaan.</string>
    <string name="sandfly_tutorial_continuous_move">Pindah ke baris pertama resep.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> untuk membaca dari item yang difokuskan.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> untuk membuka menu SandFly, lalu pilih <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
