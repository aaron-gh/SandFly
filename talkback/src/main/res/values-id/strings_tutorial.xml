    <string name="sandfly_tutorial_explore_activate">Sentuh Bintang lalu angkat jari Anda. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> di mana saja untuk mengaktifkannya.</string>
    <string name="sandfly_tutorial_explore_find">Geser satu jari di sekitar layar dan temukan empat kotak: Matahari, Bulan, Bintang, dan Awan.</string>
    <string name="sandfly_tutorial_explore_intro">Menyentuh layar mengucapkan item di bawah jari Anda. Menyentuh item tidak mengaktifkannya.</string>
    <string name="sandfly_tutorial_explore_title">Jelajahi dengan sentuhan</string>
