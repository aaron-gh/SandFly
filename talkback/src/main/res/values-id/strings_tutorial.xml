<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Pindah ke pesan. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> atau <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> untuk menelusuri tindakannya. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> untuk menjalankan tindakan yang terdengar. Jalankan <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Beberapa item memiliki tindakan selain aktivasi, seperti Arsipkan atau Hapus untuk pesan. Saat item seperti itu memiliki fokus, kontrol pembacaan Tindakan menelusuri tindakan tersebut.</string>
    <string name="sandfly_tutorial_actions_title">Tindakan</string>
    <string name="sandfly_tutorial_activate_button">Pindah ke <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> untuk mengaktifkannya.</string>
    <string name="sandfly_tutorial_activate_check_box">Centang <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> dengan cara yang sama.</string>
    <string name="sandfly_tutorial_activate_hold">Beberapa item melakukan hal lain saat ditahan. Pindah ke <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> untuk menahannya.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivasi berlaku untuk item yang memiliki fokus, di mana pun Anda mengetuk layar.</string>
    <string name="sandfly_tutorial_activate_title">Mengaktifkan item</string>
    <string name="sandfly_tutorial_back_in_lesson">Kembali tidak keluar dari pelajaran. Untuk memilih pelajaran lain, gunakan Daftar isi.</string>
    <string name="sandfly_tutorial_bell">Bunyikan bel</string>
    <string name="sandfly_tutorial_bell_rung">Jumlah bunyi: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Kecerahan</string>
