    <string name="sandfly_tutorial_title">Tutorial SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Hapus huruf terakhir dengan tombol Hapus pada keyboard.</string>
    <string name="sandfly_tutorial_typing_intro">Mengaktifkan kolom teks akan membuka keyboard. Sentuh tombol untuk mendengarnya, lalu angkat jari Anda untuk mengetiknya.</string>
    <string name="sandfly_tutorial_typing_open">Pindah ke kolom <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> untuk mulai mengetik.</string>
    <string name="sandfly_tutorial_typing_title">Mengetik</string>
    <string name="sandfly_tutorial_typing_type">Ketik kata <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">kucing</string>
    <string name="sandfly_tutorial_welcome_intro">Tutorial ini mengajarkan gestur SandFly. Setiap pelajaran memberikan instruksi, menunggu hingga Anda melakukannya dengan gestur Anda sendiri, lalu memberikan instruksi berikutnya. Instruksi adalah item pertama setelah nama pelajaran. Daftar isi mencantumkan setiap pelajaran, dan tutorial dibuka kembali di pelajaran terakhir Anda.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> di mana saja di layar untuk memulai.</string>
    <string name="sandfly_tutorial_welcome_title">Selamat datang</string>
</resources>
