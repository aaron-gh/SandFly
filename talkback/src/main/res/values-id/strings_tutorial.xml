    <string name="sandfly_tutorial_message_reply">Balas</string>
    <string name="sandfly_tutorial_move_intro">Menggeser berpindah ke item berikutnya atau sebelumnya di layar, sesuai urutan pembacaan.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> untuk berpindah ke item berikutnya. Lanjutkan hingga Anda mencapai <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> untuk berpindah ke item sebelumnya. Kembali ke <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Berpindah antar-item</string>
    <string name="sandfly_tutorial_name">Nama</string>
    <string name="sandfly_tutorial_next_lesson">Pelajaran berikutnya: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> tidak memiliki gestur. Tetapkan gestur di Perintah, atau gunakan Lewati langkah.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> tidak dijalankan dalam pelajaran. Untuk keluar dari tutorial, gunakan Tutup tutorial di Daftar isi.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> tidak dijalankan dalam pelajaran.</string>
    <string name="sandfly_tutorial_pause_intro">Ucapan dapat dijeda di tengah item, lalu dilanjutkan dari titik berhentinya.</string>
    <string name="sandfly_tutorial_pause_pause">Pindah ke cerita di bawah. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> saat cerita dibacakan untuk menjeda ucapan, dan sekali lagi untuk melanjutkan.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> lagi untuk melanjutkan ucapan.</string>
    <string name="sandfly_tutorial_pause_title">Menjeda ucapan</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Setiap gestur mengucapkan nama dan tindakannya, bukan menjalankannya. Berpindah ke item berikutnya dan sebelumnya serta aktivasi tetap berfungsi.</string>
    <string name="sandfly_tutorial_practice_step">Lakukan gestur apa pun untuk mendengar fungsinya. Untuk berhenti, aktifkan <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Latihan gestur</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> dari <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Ubah kontrol pembacaan ke <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> untuk berpindah satu karakter.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Kontrol pembacaan menentukan fungsi geser ke atas dan ke bawah, seperti berpindah per kata atau per karakter, atau mengubah kecepatan bicara. Geser ke kanan dan ke kiri tetap berpindah antar-item.</string>
    <string name="sandfly_tutorial_reading_controls_move">Pindah ke kalimat di bawah.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> untuk berpindah ke kata berikutnya. Pindah tiga kata.</string>
    <string name="sandfly_tutorial_reading_controls_title">Kontrol pembacaan</string>
    <string name="sandfly_tutorial_recipe_1">Panekuk: campur tepung, telur, dan susu menjadi adonan yang halus.</string>
    <string name="sandfly_tutorial_recipe_2">Panaskan sedikit mentega di wajan.</string>
    <string name="sandfly_tutorial_recipe_3">Tuang adonan secukupnya hingga menutupi wajan secara tipis.</string>
    <string name="sandfly_tutorial_recipe_4">Balik panekuk saat bagian bawahnya berwarna keemasan.</string>
    <string name="sandfly_tutorial_recipe_5">Sajikan dengan lemon dan gula.</string>
    <string name="sandfly_tutorial_scrolling_intro">Daftar hanya menampilkan sebagian itemnya sekaligus. Menggeser melewati item terakhir yang ditampilkan akan men-scroll daftar.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> untuk men-scroll maju satu halaman.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> di sepanjang daftar hingga Anda mencapai <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Men-scroll daftar</string>
    <string name="sandfly_tutorial_sentence">Rubah cokelat yang gesit melompati anjing yang malas.</string>
    <string name="sandfly_tutorial_skip_step">Lewati langkah</string>
    <string name="sandfly_tutorial_sliders_change">Pindah ke penggeser <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> atau <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> untuk mengubah nilainya.</string>
    <string name="sandfly_tutorial_sliders_highest">Setel <xliff:g id="slider" example="Brightness">%1$s</xliff:g> ke 100 persen, nilai tertingginya.</string>
    <string name="sandfly_tutorial_sliders_intro">Saat penggeser memiliki fokus, geser ke atas dan ke bawah mengubah nilainya.</string>
    <string name="sandfly_tutorial_sliders_title">Penggeser</string>
    <string name="sandfly_tutorial_step">Langkah <xliff:g id="number" example="1">%1$d</xliff:g> dari <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Lalat pasir adalah lalat kecil yang hidup di pantai, di tepi sungai, dan di hutan. Lalat ini paling aktif saat fajar dan senja, ketika udara tenang. Hanya lalat betina yang menggigit, karena membutuhkan darah untuk menghasilkan telur. Gigitannya gatal selama berhari-hari, sehingga orang yang mengunjungi daerah lalat pasir membawa obat antiserangga. Lalat pasir adalah penerbang yang lemah, dan angin sepoi-sepoi pun dapat menjauhkannya.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> untuk kembali.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> untuk membuka Layar utama.</string>
    <string name="sandfly_tutorial_system_intro">Gestur ini berfungsi di setiap layar. Di pelajaran ini, tutorial mengucapkan fungsi setiap gestur, bukan menjalankannya.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> untuk membuka notifikasi.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> untuk menampilkan aplikasi terbaru.</string>
    <string name="sandfly_tutorial_system_title">Kembali, Layar utama, dan notifikasi</string>
