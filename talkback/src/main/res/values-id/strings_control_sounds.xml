    <string name="title_pref_control_sounds">Suara dan getaran kontrol</string>
    <string name="summary_pref_control_sounds">Berikan suara dan getaran tersendiri dari tema untuk setiap jenis kontrol, seperti tombol, kotak centang, bidang edit, dan item daftar, sebagai pengganti suara dan getaran fokus, seperti Unspoken untuk NVDA. Suara diputar dari posisi kontrol di layar, dan SandFly tidak mengucapkan jenis kontrolnya.</string>
    <string name="title_pref_control_sounds_speak_roles">Tetap ucapkan jenis kontrol</string>
    <string name="summary_pref_control_sounds_speak_roles">Saat suara kontrol diputar, tetap ucapkan jenis kontrolnya, seperti tombol. Berlaku untuk semua tema suara.</string>
