    <string name="gesture_trainer_finding_taps_apart">輕按位置相距 <xliff:g id="mm">%1$.0f</xliff:g> 毫米，最多只可相距 <xliff:g id="limit">%2$.0f</xliff:g> 毫米。</string>
    <string name="gesture_trainer_finding_pinch_too_small">手指只移動了 <xliff:g id="mm">%1$.0f</xliff:g> 毫米，必須至少移動 <xliff:g id="limit">%2$.0f</xliff:g> 毫米。</string>
