    <string name="gesture_trainer_finding_off_line">路徑偏離直線 <xliff:g id="degrees">%1$.0f</xliff:g> 度，最多只可偏離 <xliff:g id="limit">%2$.0f</xliff:g> 度。</string>
    <string name="gesture_trainer_finding_curved">路徑彎成 <xliff:g id="parts">%1$d</xliff:g> 段，而非 <xliff:g id="wanted">%2$d</xliff:g> 段。</string>
