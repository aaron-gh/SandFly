    <string name="gesture_trainer_finding_second_part_wrong">轉彎後，手指<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_tap_moved">輕按時手指滑動了 <xliff:g id="mm">%1$.1f</xliff:g> 毫米，最多只可滑動 <xliff:g id="limit">%2$.1f</xliff:g> 毫米。</string>
    <string name="gesture_trainer_finding_tap_held_long">有一下輕按持續了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，超過 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_hold_too_short">最後一下按住了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，必須至少 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
