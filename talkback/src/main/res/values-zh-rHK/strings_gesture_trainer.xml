    <string name="gesture_trainer_how_shake">緊握手機並快速來回搖動，好像甩掉水滴一樣：每個方向至少兩次，全部在約三分之二秒內完成。然後保持手機不動。</string>
    <string name="gesture_trainer_how_two_stroke">用一隻手指<xliff:g id="first">%1$s</xliff:g>滑動約 2 公分，然後提起。接著立即在 <xliff:g id="time">%3$d</xliff:g> 毫秒內，用一隻手指<xliff:g id="second">%2$s</xliff:g>滑動約 2 公分，然後提起。</string>
    <string name="gesture_trainer_how_three_part">用一隻手指觸碰螢幕，不提起手指，<xliff:g id="first">%1$s</xliff:g>滑動，然後急轉<xliff:g id="second">%2$s</xliff:g>滑動，再急轉<xliff:g id="third">%3$s</xliff:g>滑動，每段約 2 公分，然後提起。整個動作要快速流暢、一氣呵成，轉角要尖銳而不是弧形。</string>
    <string name="gesture_trainer_how_taps_top_and_bottom">將一隻手指放在螢幕上方三分之一，另一隻放在下方三分之一，例如拇指在下、食指在上。</string>
    <string name="gesture_trainer_finding_tap_not_top_and_bottom">手指並非一隻在螢幕上方三分之一、一隻在下方三分之一。</string>
    <string name="gesture_trainer_finding_second_stroke_missing">沒有第二下滑動。</string>
    <string name="gesture_trainer_finding_second_stroke_late">第二下滑動在第一下之後 <xliff:g id="ms">%1$d</xliff:g> 毫秒才開始，最多只可相隔 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_first_stroke_wrong_direction">第一下滑動<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_second_stroke_wrong_direction">第二下滑動<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_shake_too_light">搖動太輕：所需力度的 <xliff:g id="percent">%1$d</xliff:g>%%。</string>
    <string name="gesture_trainer_finding_shake_too_few_swings">來回擺動：所需 <xliff:g id="wanted">%2$d</xliff:g> 次中的 <xliff:g id="swings">%1$d</xliff:g> 次。</string>
    <string name="gesture_trainer_tip_tap_not_top_and_bottom">將手指盡量分開，一隻靠近頂部邊緣，一隻靠近底部邊緣。</string>
    <string name="gesture_trainer_tip_second_stroke_missing">第一下滑動後，提起手指並立即再滑動。</string>
    <string name="gesture_trainer_tip_second_stroke_late">提起手指後立即開始第二下滑動。</string>
    <string name="gesture_trainer_tip_shake_too_light">搖動得更用力、更快。</string>
    <string name="gesture_trainer_tip_shake_too_few_swings">搖動快一點，每個方向至少來回兩次，中間不要停下。</string>
    <string name="gesture_trainer_measure_shake_strength">最強動作 <xliff:g id="strength">%1$.1f</xliff:g></string>
    <string name="gesture_trainer_advice_shake_sensitivity">搖動太輕。較高的<xliff:g id="setting">%1$s</xliff:g>可偵測較輕的搖動，但可能會將攜帶手機偵測為搖動。</string>
    <string name="gesture_trainer_advice_two_stroke_time">第二下滑動開始得遲。較長的<xliff:g id="setting">%1$s</xliff:g>容許較遲的第二下滑動，而單次滑動在執行前亦會等待較長時間。</string>
    <string name="gesture_trainer_scrub_two_finger_on"><xliff:g id="setting">%1$s</xliff:g>已開啟。</string>
    <string name="gesture_trainer_scrub_two_finger_off"><xliff:g id="setting">%1$s</xliff:g>已關閉：雙指滑動會捲動應用程式，而來回滑動大多亦會捲動。開啟此設定後，雙指滑動會執行 SandFly 命令，而不會捲動。</string>
    <string name="gesture_trainer_measure_first_stroke">第一下滑動 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
    <string name="gesture_trainer_measure_second_stroke">第二下滑動 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
    <string name="gesture_trainer_measure_whole_gesture">整個手勢 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
    <string name="gesture_trainer_measure_stroke_gap">兩下之間提起 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
