    <string name="gesture_trainer_finding_scrub_no_return">返回的一筆是 <xliff:g id="mm">%1$.0f</xliff:g> 毫米，必須至少 <xliff:g id="limit">%2$.0f</xliff:g> 毫米。</string>
    <string name="gesture_trainer_finding_scrub_too_slow">來回滑動用了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多只可用 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_edge_start_too_far">手指落在距離邊緣 <xliff:g id="mm">%1$.0f</xliff:g> 毫米處，而邊緣闊 <xliff:g id="limit">%2$.0f</xliff:g> 毫米。</string>
