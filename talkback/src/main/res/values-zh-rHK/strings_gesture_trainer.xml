    <string name="gesture_trainer_finding_fingers_lifted_apart">手指提起時間相差 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多只可相差 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_became_exploration">手指停留太久或開始時移動太慢，因此觸碰變成了輕觸探索。</string>
    <string name="gesture_trainer_finding_slow_start">第一公分用了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多只可用 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_paused">手指減慢了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，每公分最多只可用 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_too_short">移動距離只有 <xliff:g id="mm">%1$.0f</xliff:g> 毫米，必須至少 <xliff:g id="limit">%2$.0f</xliff:g> 毫米。</string>
