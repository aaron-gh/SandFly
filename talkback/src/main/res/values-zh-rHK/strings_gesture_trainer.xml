<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="gesture_trainer_title">手勢訓練</string>
    <string name="gesture_trainer_intro">選擇一組手勢。每個練習會描述一個手勢。請做該手勢 <xliff:g id="tries">%1$d</xliff:g> 次，每次嘗試的結果都會讀出。最後一次嘗試後，畫面會列出每次嘗試的量度、需要改變的地方和相關設定。</string>
    <string name="gesture_trainer_group_one_finger">單指</string>
    <string name="gesture_trainer_group_two_fingers">雙指</string>
    <string name="gesture_trainer_group_three_fingers">三指</string>
    <string name="gesture_trainer_group_four_fingers">四指</string>
    <string name="gesture_trainer_group_pinch_rotate_scrub">捏合、旋轉和來回滑動</string>
    <string name="gesture_trainer_group_count"><xliff:g id="group">%1$s</xliff:g>，<xliff:g id="count">%2$d</xliff:g> 個練習</string>
    <string name="gesture_trainer_close">關閉</string>
    <string name="gesture_trainer_no_detection">手勢訓練需要 Android 13 或以上版本。</string>
    <string name="gesture_trainer_left_out_swipes_before_lift">已略過來回手勢和角度手勢：<xliff:g id="setting">%1$s</xliff:g>已開啟。</string>
    <string name="gesture_trainer_left_out_two_finger_swipes">已略過雙指滑動：<xliff:g id="setting">%1$s</xliff:g>已關閉，因此雙指滑動會捲動應用程式。</string>
    <string name="gesture_trainer_exercise_heading">練習 <xliff:g id="number">%1$d</xliff:g>/<xliff:g id="count">%2$d</xliff:g>：<xliff:g id="gesture">%3$s</xliff:g></string>
    <string name="gesture_trainer_start">開始</string>
    <string name="gesture_trainer_skip">略過此練習</string>
    <string name="gesture_trainer_back_to_groups">返回組別</string>
    <string name="gesture_trainer_go">在螢幕任何位置做該手勢 <xliff:g id="tries">%1$d</xliff:g> 次。每次觸碰都算一次嘗試。</string>
    <string name="gesture_trainer_fingers_1">一隻手指</string>
    <string name="gesture_trainer_fingers_2">兩隻手指並排，相距約 1 公分</string>
    <string name="gesture_trainer_fingers_3">三隻手指並排，稍為分開</string>
    <string name="gesture_trainer_fingers_4">四隻手指並排，稍為分開</string>
    <string name="gesture_trainer_direction_up">向上</string>
    <string name="gesture_trainer_direction_down">向下</string>
    <string name="gesture_trainer_direction_left">向左</string>
    <string name="gesture_trainer_direction_right">向右</string>
    <string name="gesture_trainer_how_swipe">用<xliff:g id="fingers">%1$s</xliff:g>觸碰螢幕，不要停頓，以直線<xliff:g id="direction">%2$s</xliff:g>滑動約 2 至 3 公分，然後提起。請立即開始移動：手指先停留不動會啟動輕觸探索。</string>
    <string name="gesture_trainer_how_swipe_multi">同時放下手指，然後將所有手指往同一方向移動。每隻手指都必須一直<xliff:g id="direction">%1$s</xliff:g>移動，因此請保持直線。</string>
    <string name="gesture_trainer_how_back_and_forth">用一隻手指觸碰螢幕，<xliff:g id="first">%1$s</xliff:g>滑動約 2 公分，然後不提起手指，直接<xliff:g id="second">%2$s</xliff:g>返回約 2 公分，再提起。整個動作要快速流暢、一氣呵成。</string>
    <string name="gesture_trainer_how_angle">用<xliff:g id="fingers">%1$s</xliff:g>觸碰螢幕，<xliff:g id="first">%2$s</xliff:g>滑動約 2 公分，然後不提起手指，急轉<xliff:g id="second">%3$s</xliff:g>滑動約 2 公分，再提起。轉彎要像字母 L 一樣成銳角，而不是弧形。</string>
    <string name="gesture_trainer_taps_1">一下</string>
    <string name="gesture_trainer_taps_2">兩下</string>
    <string name="gesture_trainer_taps_3">三下</string>
    <string name="gesture_trainer_taps_4">四下</string>
    <string name="gesture_trainer_how_taps">用<xliff:g id="fingers">%2$s</xliff:g>輕按<xliff:g id="taps">%1$s</xliff:g>。同時放下手指並同時提起，動作要快，不要滑動。</string>
    <string name="gesture_trainer_how_taps_quick">輕按要快並在同一位置：下一下必須在上一下之後 <xliff:g id="gap">%1$d</xliff:g> 毫秒內。</string>
    <string name="gesture_trainer_how_hold">將<xliff:g id="fingers">%1$s</xliff:g>同時放在螢幕上，保持不動，不要滑動，至少 <xliff:g id="hold">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_how_long_hold_turns_off">如沒有指派其他命令，此手勢會關閉 SandFly。在訓練中，此手勢不會執行任何操作。</string>
    <string name="gesture_trainer_how_taps_hold">用<xliff:g id="fingers">%2$s</xliff:g>輕按<xliff:g id="taps">%1$s</xliff:g>，最後一下時將手指留在螢幕上保持不動，至少 <xliff:g id="hold">%3$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_how_three_finger_hand">使用拇指、食指和中指。</string>
    <string name="gesture_trainer_how_four_finger_pinch_hand">將食指和中指並排放置，拇指和無名指分別放在兩側幾公分外。然後將四隻指尖合攏到同一點。</string>
    <string name="gesture_trainer_how_pinch">將 <xliff:g id="fingers">%1$d</xliff:g> 隻手指放在螢幕上，盡量分開。然後將手指直線向彼此靠攏至少 1 公分，好像拿起東西一樣，再從螢幕提起。只移動手指，不要移動整隻手，也不要以弧形移動。</string>
    <string name="gesture_trainer_how_spread">將 <xliff:g id="fingers">%1$d</xliff:g> 隻手指放在螢幕上，互相靠近。然後將手指直線分開至少 1 公分，再從螢幕提起。只移動手指，不要移動整隻手，也不要以弧形移動。</string>
    <string name="gesture_trainer_clockwise">順時針</string>
    <string name="gesture_trainer_counterclockwise">逆時針</string>
    <string name="gesture_trainer_how_rotate">將兩隻手指放在螢幕上，相距約 2 至 3 公分，然後圍繞兩指中間<xliff:g id="way">%1$s</xliff:g>轉動，好像轉動旋鈕一樣，轉約四分之一圈。然後提起。</string>
    <string name="gesture_trainer_how_scrub">將兩隻手指放在螢幕上，快速向一側移動約 2 公分再返回，好像擦掉東西一樣，全部在約一秒內完成。然後提起。</string>
    <string name="gesture_trainer_edge_bottom">在底部邊緣</string>
    <string name="gesture_trainer_edge_top_left">在頂部邊緣的左半部</string>
    <string name="gesture_trainer_edge_top_right">在頂部邊緣的右半部</string>
    <string name="gesture_trainer_edge_left_top">在左邊緣的上半部</string>
    <string name="gesture_trainer_edge_left_bottom">在左邊緣的下半部</string>
    <string name="gesture_trainer_edge_right_top">在右邊緣的上半部</string>
    <string name="gesture_trainer_edge_right_bottom">在右邊緣的下半部</string>
    <string name="gesture_trainer_edge_left">在左邊緣</string>
    <string name="gesture_trainer_edge_right">在右邊緣</string>
    <string name="gesture_trainer_edge_top">在頂部邊緣</string>
    <string name="gesture_trainer_how_edge">將一隻手指放<xliff:g id="edge">%1$s</xliff:g>，距離邊緣最多 <xliff:g id="edge_width">%2$d</xliff:g> 毫米，然後<xliff:g id="direction">%3$s</xliff:g>滑入螢幕直至第一下卡嗒聲，約 <xliff:g id="distance">%4$d</xliff:g> 毫米。然後立即提起：超過第二下卡嗒聲的滑動會算作長滑動。</string>
    <string name="gesture_trainer_how_edge_long">將一隻手指放<xliff:g id="edge">%1$s</xliff:g>，距離邊緣最多 <xliff:g id="edge_width">%2$d</xliff:g> 毫米，然後<xliff:g id="direction">%3$s</xliff:g>滑入螢幕，越過第一下卡嗒聲直至第二下，約 <xliff:g id="distance">%4$d</xliff:g> 毫米。然後提起。</string>
    <string name="gesture_trainer_how_along">用一隻手指沿<xliff:g id="edge">%1$s</xliff:g><xliff:g id="direction">%2$s</xliff:g>滑動至少 <xliff:g id="distance">%3$d</xliff:g> 毫米。</string>
    <string name="gesture_trainer_corner_top_left">左上</string>
    <string name="gesture_trainer_corner_top_right">右上</string>
    <string name="gesture_trainer_corner_bottom_left">左下</string>
    <string name="gesture_trainer_corner_bottom_right">右下</string>
    <string name="gesture_trainer_how_corner">在螢幕<xliff:g id="corner">%2$s</xliff:g>角輕按<xliff:g id="taps">%1$s</xliff:g>。將手指放在角落最盡處，距離兩邊邊緣不超過 <xliff:g id="size">%3$d</xliff:g> 毫米，並在 <xliff:g id="time">%4$d</xliff:g> 毫秒內迅速提起。</string>
    <string name="gesture_trainer_sizes"><xliff:g id="edge_setting">%1$s</xliff:g>：<xliff:g id="edge">%2$d</xliff:g> 毫米。<xliff:g id="corner_setting">%3$s</xliff:g>：<xliff:g id="corner">%4$d</xliff:g> 毫米。</string>
    <string name="gesture_trainer_corner_warning">角落較大時，輕按角落附近的控制項 (例如左上方的「返回」) 可能會改為執行角落手勢。</string>
