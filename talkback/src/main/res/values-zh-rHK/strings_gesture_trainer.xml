    <string name="gesture_trainer_finding_fingers_landed_apart">手指落下時間相差 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多只可相差 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
