    <string name="title_pause_backtalk">暫停SandFly</string>
    <string name="summary_pause_backtalk">關閉語音、手勢和「輕觸探索」，直到你恢復 SandFly</string>
    <string name="keycombo_menu_global_pause_backtalk">暫停或恢復 SandFly</string>
    <string name="backtalk_paused">SandFly 已暫停</string>
    <string name="backtalk_resumed">SandFly 已恢復</string>
    <string name="notification_title_backtalk_paused">SandFly 已暫停</string>
    <string name="notification_message_backtalk_paused">輕觸即可恢復</string>
    <string name="notification_channel_backtalk_paused">SandFly 已暫停</string>
    <string name="dialog_title_pause_backtalk">暫停SandFly？</string>
    <string name="dialog_button_pause_backtalk">暫停</string>
    <string name="dialog_message_pause_backtalk">SandFly 暫停期間不會讀出內容或回應手勢，螢幕的運作方式就如沒有開啟螢幕閱讀器一樣。</string>
    <string name="message_resume_keyguard">如要繼續，請輕按「SandFly 已暫停」通知、快速按三下調低音量按鈕，或鎖定並喚醒手機，讓上鎖畫面顯示。</string>
    <string name="message_resume_screen_on">如要繼續，請輕按「SandFly 已暫停」通知、快速按三下調低音量按鈕，或關閉再重新開啟螢幕。</string>
    <string name="message_resume_manual">如要繼續，請輕按「SandFly 已暫停」通知，或快速按三下調低音量按鈕。</string>
    <string name="message_resume_key_combo">您也可以按 <xliff:g id="key_combo" example="Alt + P">%1$s</xliff:g>。</string>
    <string name="title_pref_resume_backtalk">恢復SandFly</string>
    <string name="value_resume_keyguard">鎖定畫面顯示時</string>
    <string name="value_resume_screen_on">螢幕亮起時</string>
    <string name="value_resume_manual">僅透過通知或快捷方式</string>
</resources>
