    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>可將 SandFly 最後讀出的文字複製到剪貼簿。</string>
    <string name="sandfly_tutorial_commands_intro">這些命令在任何畫面上都能使用。</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>可在畫面上搜尋文字。在本課程中，教學課程會說出這個命令的作用，而不會執行。</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>可關閉語音，再執行一次可開啟語音。在本課程中，教學課程會說出這個命令的作用，而不會執行。</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>可聽取時間、電池電量和其他狀態。</string>
    <string name="sandfly_tutorial_commands_title">實用命令</string>
    <string name="sandfly_tutorial_contents">目錄</string>
    <string name="sandfly_tutorial_contents_intro">課程依序排列。每個課程都能單獨開啟。</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly 不必滑動就能從焦點項目朗讀到畫面結尾。輕觸螢幕會停止朗讀。</string>
    <string name="sandfly_tutorial_continuous_move">移至食譜的第一行。</string>
