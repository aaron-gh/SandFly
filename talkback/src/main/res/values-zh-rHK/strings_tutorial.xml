    <string name="sandfly_tutorial_menu_intro">SandFly 選單提供適用於焦點項目和目前畫面的命令。</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>可開啟 SandFly 選單。滑動瀏覽其中的命令。<xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g>可關閉選單。</string>
    <string name="sandfly_tutorial_menu_title">SandFly 選單</string>
    <string name="sandfly_tutorial_message">Sam 傳來的訊息：中午一起吃午餐嗎？</string>
    <string name="sandfly_tutorial_message_archive">封存</string>
    <string name="sandfly_tutorial_message_delete">刪除</string>
    <string name="sandfly_tutorial_message_reply">回覆</string>
    <string name="sandfly_tutorial_move_intro">滑動可依閱讀順序移至畫面上的下一個或上一個項目。</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>可移至下一個項目。繼續移動，直到抵達「<xliff:g id="item" example="Eggs">%2$s</xliff:g>」。</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>可移至上一個項目。返回「<xliff:g id="item" example="Bread">%2$s</xliff:g>」。</string>
    <string name="sandfly_tutorial_move_title">在項目之間移動</string>
    <string name="sandfly_tutorial_name">名稱</string>
    <string name="sandfly_tutorial_next_lesson">下一個課程：<xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">「<xliff:g id="action" example="Next item">%1$s</xliff:g>」沒有手勢。請在「命令」中指派一個，或使用「略過步驟」。</string>
    <string name="sandfly_tutorial_not_in_lesson">課程中不會執行「<xliff:g id="action" example="Home">%1$s</xliff:g>」。如要離開教學課程，請使用「目錄」中的「關閉教學課程」。</string>
    <string name="sandfly_tutorial_not_in_lesson_short">課程中不會執行「<xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g>」。</string>
    <string name="sandfly_tutorial_pause_intro">語音可以在項目唸到一半時暫停，並從停止處繼續。</string>
    <string name="sandfly_tutorial_pause_pause">移至下方的故事。朗讀時，<xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>可暫停語音，再執行一次可繼續。</string>
    <string name="sandfly_tutorial_pause_resume">再<xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>一次即可繼續語音。</string>
    <string name="sandfly_tutorial_pause_title">暫停語音</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>：<xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">每個手勢都會說出名稱和動作，而不會執行。移至下一個和上一個項目以及啟用仍然有效。</string>
    <string name="sandfly_tutorial_practice_step">做出任何手勢即可聽到它的作用。如要停止，請啟用「<xliff:g id="button" example="End practice">%1$s</xliff:g>」。</string>
    <string name="sandfly_tutorial_practice_title">手勢練習</string>
    <string name="sandfly_tutorial_progress">已完成 <xliff:g id="done" example="2">%1$d</xliff:g> 個，共 <xliff:g id="count" example="4">%2$d</xliff:g> 個。</string>
    <string name="sandfly_tutorial_reading_controls_characters">將朗讀控制項變更為「<xliff:g id="reading_control" example="Characters">%2$s</xliff:g>」。<xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>可移動一個字元。</string>
    <string name="sandfly_tutorial_reading_controls_intro">朗讀控制項決定向上和向下滑動的作用，例如按字詞或字元移動，或變更語速。向右和向左滑動仍會在項目之間移動。</string>
    <string name="sandfly_tutorial_reading_controls_move">移至下方的句子。</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>可移至下一個字詞。移動三個字詞。</string>
    <string name="sandfly_tutorial_reading_controls_title">朗讀控制項</string>
    <string name="sandfly_tutorial_recipe_1">班戟：將麵粉、雞蛋和牛奶拌成滑順的麵糊。</string>
    <string name="sandfly_tutorial_recipe_2">在平底鍋中加熱少許奶油。</string>
    <string name="sandfly_tutorial_recipe_3">倒入適量麵糊，薄薄鋪滿鍋底。</string>
    <string name="sandfly_tutorial_recipe_4">底面呈金黃色時，將班戟翻面。</string>
    <string name="sandfly_tutorial_recipe_5">搭配檸檬和砂糖食用。</string>
    <string name="sandfly_tutorial_scrolling_intro">清單一次只會顯示部分項目。滑過顯示的最後一個項目會捲動清單。</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>可向前捲動一頁。</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>瀏覽清單，直到抵達「<xliff:g id="item" example="Item 15">%2$s</xliff:g>」。</string>
    <string name="sandfly_tutorial_scrolling_title">捲動清單</string>
    <string name="sandfly_tutorial_sentence">敏捷的棕色狐狸跳過了那隻懶狗。</string>
    <string name="sandfly_tutorial_skip_step">略過步驟</string>
    <string name="sandfly_tutorial_sliders_change">移至「<xliff:g id="slider" example="Brightness">%3$s</xliff:g>」滑桿。<xliff:g id="gesture" example="Swipe up">%1$s</xliff:g>或<xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>可變更它的值。</string>
    <string name="sandfly_tutorial_sliders_highest">將「<xliff:g id="slider" example="Brightness">%1$s</xliff:g>」設為百分之百，也就是最高值。</string>
    <string name="sandfly_tutorial_sliders_intro">滑桿取得焦點時，向上和向下滑動可變更它的值。</string>
    <string name="sandfly_tutorial_sliders_title">滑桿</string>
    <string name="sandfly_tutorial_step">步驟 <xliff:g id="number" example="1">%1$d</xliff:g>，共 <xliff:g id="count" example="2">%2$d</xliff:g> 步：<xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">沙蠅是生活在海灘、河岸和森林中的小型蠅類。牠們在黎明和黃昏空氣靜止時最活躍。只有雌蠅會叮人，因為牠們需要血液來產卵。叮咬處會癢上好幾天，所以前往沙蠅出沒地區的人都會攜帶驅蟲劑。沙蠅飛行能力很弱，即使是微風也能讓牠們遠離。</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>可返回。</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>可前往主畫面。</string>
