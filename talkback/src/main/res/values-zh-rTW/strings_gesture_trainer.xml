    <string name="gesture_trainer_measure_edge">從距離邊緣 <xliff:g id="mm">%1$.0f</xliff:g> 公釐處開始</string>
    <string name="gesture_trainer_finding_wrong_finger_count">螢幕上的手指：<xliff:g id="fingers">%1$d</xliff:g> 根，而不是 <xliff:g id="wanted">%2$d</xliff:g> 根。</string>
    <string name="gesture_trainer_finding_fingers_landed_apart">手指落下時間相差 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多允許 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_finger_lifted_early">有一根手指在所有手指放下前就抬起了。</string>
    <string name="gesture_trainer_finding_fingers_lifted_apart">手指抬起時間相差 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多允許 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_became_exploration">手指停住太久或一開始移動太慢，因此這次觸碰變成了觸控探索。</string>
    <string name="gesture_trainer_finding_slow_start">第一公分用了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多允許 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_paused">手指減速了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，每公分最多只能用 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_too_short">移動距離只有 <xliff:g id="mm">%1$.0f</xliff:g> 公釐，至少需要 <xliff:g id="limit">%2$.0f</xliff:g> 公釐。</string>
    <string name="gesture_trainer_finding_wrong_direction_one_finger">手指一開始向<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_wrong_direction">手指一開始向<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_off_line">路徑偏離直線 <xliff:g id="degrees">%1$.0f</xliff:g> 度，最多允許 <xliff:g id="limit">%2$.0f</xliff:g> 度。</string>
    <string name="gesture_trainer_finding_curved">路徑彎成了 <xliff:g id="parts">%1$d</xliff:g> 段，而不是 <xliff:g id="wanted">%2$d</xliff:g> 段。</string>
    <string name="gesture_trainer_finding_turn_missing">未偵測到轉彎。</string>
    <string name="gesture_trainer_finding_second_part_wrong">轉彎後，手指向<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_tap_moved">輕觸時手指滑動了 <xliff:g id="mm">%1$.1f</xliff:g> 公釐，最多允許 <xliff:g id="limit">%2$.1f</xliff:g> 公釐。</string>
    <string name="gesture_trainer_finding_tap_held_long">一次輕觸持續了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，超過 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_hold_too_short">最後一次輕觸按住了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，至少需要 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
