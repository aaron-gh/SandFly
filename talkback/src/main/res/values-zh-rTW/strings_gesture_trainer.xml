    <string name="gesture_trainer_finding_scrub_too_short">第一筆劃為 <xliff:g id="mm">%1$.0f</xliff:g> 公釐，至少需要 <xliff:g id="limit">%2$.0f</xliff:g> 公釐。</string>
    <string name="gesture_trainer_finding_scrub_no_return">返回的筆劃為 <xliff:g id="mm">%1$.0f</xliff:g> 公釐，至少需要 <xliff:g id="limit">%2$.0f</xliff:g> 公釐。</string>
    <string name="gesture_trainer_finding_scrub_too_slow">來回滑動用了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多允許 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_edge_start_too_far">手指落在距離邊緣 <xliff:g id="mm">%1$.0f</xliff:g> 公釐處，而邊緣寬度是 <xliff:g id="limit">%2$.0f</xliff:g> 公釐。</string>
    <string name="gesture_trainer_finding_edge_wrong_half">手指從邊緣的另一半開始。</string>
    <string name="gesture_trainer_finding_edge_too_short">手指滑動了 <xliff:g id="mm">%1$.0f</xliff:g> 公釐，至少需要滑動 <xliff:g id="limit">%2$.0f</xliff:g> 公釐。</string>
    <string name="gesture_trainer_finding_edge_too_long">滑動太長：手指越過了第二次點擊，<xliff:g id="mm">%1$.0f</xliff:g> 公釐，而第二次點擊在 <xliff:g id="limit">%2$.0f</xliff:g> 公釐處。</string>
