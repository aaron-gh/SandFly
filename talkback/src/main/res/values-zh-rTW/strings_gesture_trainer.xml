    <string name="gesture_trainer_how_shake">握緊手機，快速來回搖晃，就像甩掉一滴水一樣：每個方向至少兩次，全部在約三分之二秒內完成。然後拿穩不動。</string>
    <string name="gesture_trainer_how_two_stroke">用一根手指向<xliff:g id="first">%1$s</xliff:g>滑動約 2 公分，然後放開。接著立即在 <xliff:g id="time">%3$d</xliff:g> 毫秒內，用一根手指向<xliff:g id="second">%2$s</xliff:g>滑動約 2 公分，然後放開。</string>
    <string name="gesture_trainer_how_three_part">用一根手指觸碰螢幕，不放開，向<xliff:g id="first">%1$s</xliff:g>滑動，接著急轉向<xliff:g id="second">%2$s</xliff:g>滑動，再急轉向<xliff:g id="third">%3$s</xliff:g>滑動，每段約 2 公分，然後放開。整個動作要快速流暢、一氣呵成，轉角要銳利，不要畫弧線。</string>
    <string name="gesture_trainer_how_taps_top_and_bottom">將一根手指放在螢幕上方三分之一處，另一根放在下方三分之一處，例如拇指在下、食指在上。</string>
    <string name="gesture_trainer_finding_tap_not_top_and_bottom">手指不是一根在螢幕上方三分之一處、一根在下方三分之一處。</string>
    <string name="gesture_trainer_finding_second_stroke_missing">沒有第二次滑動。</string>
    <string name="gesture_trainer_finding_second_stroke_late">第二次滑動在第一次之後 <xliff:g id="ms">%1$d</xliff:g> 毫秒才開始，最多允許 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_first_stroke_wrong_direction">第一次滑動向<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_second_stroke_wrong_direction">第二次滑動向<xliff:g id="direction">%1$s</xliff:g>移動。</string>
    <string name="gesture_trainer_finding_shake_too_light">搖晃太輕：只有所需力道的 <xliff:g id="percent">%1$d</xliff:g>%%。</string>
    <string name="gesture_trainer_finding_shake_too_few_swings">來回擺動：<xliff:g id="swings">%1$d</xliff:g> 次，需要 <xliff:g id="wanted">%2$d</xliff:g> 次。</string>
    <string name="gesture_trainer_tip_tap_not_top_and_bottom">將手指張得很開，一根靠近頂部邊緣，一根靠近底部邊緣。</string>
    <string name="gesture_trainer_tip_second_stroke_missing">第一次滑動後，抬起手指並立即再次滑動。</string>
    <string name="gesture_trainer_tip_second_stroke_late">抬起手指後立即開始第二次滑動。</string>
    <string name="gesture_trainer_tip_shake_too_light">搖晃得更用力、更快。</string>
    <string name="gesture_trainer_tip_shake_too_few_swings">搖晃得更快，每個方向來回至少兩次，中間不要停。</string>
    <string name="gesture_trainer_measure_shake_strength">最強動作 <xliff:g id="strength">%1$.1f</xliff:g></string>
    <string name="gesture_trainer_advice_shake_sensitivity">搖晃較輕。將「<xliff:g id="setting">%1$s</xliff:g>」設高一點可以偵測較輕的搖晃，但可能會將攜帶手機偵測為搖晃。</string>
    <string name="gesture_trainer_advice_two_stroke_time">第二次滑動開始得晚。將「<xliff:g id="setting">%1$s</xliff:g>」設長一點可以允許較晚的第二次滑動，但單次滑動在執行前也會等待較久。</string>
    <string name="gesture_trainer_scrub_two_finger_on">「<xliff:g id="setting">%1$s</xliff:g>」已開啟。</string>
    <string name="gesture_trainer_scrub_two_finger_off">「<xliff:g id="setting">%1$s</xliff:g>」已關閉：雙指滑動會捲動應用程式，來回滑動通常也會捲動。開啟此設定後，雙指滑動會執行 SandFly 指令，而不是捲動。</string>
    <string name="gesture_trainer_measure_first_stroke">第一次滑動 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
    <string name="gesture_trainer_measure_second_stroke">第二次滑動 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
    <string name="gesture_trainer_measure_whole_gesture">整個手勢 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
    <string name="gesture_trainer_measure_stroke_gap">中間抬起 <xliff:g id="ms">%1$d</xliff:g> 毫秒</string>
</resources>
