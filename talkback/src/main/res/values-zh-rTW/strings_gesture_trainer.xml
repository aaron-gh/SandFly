    <string name="gesture_trainer_finding_too_many_taps">輕觸了 <xliff:g id="taps">%1$d</xliff:g> 次，而不是 <xliff:g id="wanted">%2$d</xliff:g> 次。</string>
    <string name="gesture_trainer_finding_taps_too_slow">輕觸之間間隔了 <xliff:g id="ms">%1$d</xliff:g> 毫秒，最多允許 <xliff:g id="limit">%2$d</xliff:g> 毫秒。</string>
    <string name="gesture_trainer_finding_taps_apart">每次輕觸的位置相距 <xliff:g id="mm">%1$.0f</xliff:g> 公釐，最多允許 <xliff:g id="limit">%2$.0f</xliff:g> 公釐。</string>
    <string name="gesture_trainer_finding_pinch_too_small">手指只移動了 <xliff:g id="mm">%1$.0f</xliff:g> 公釐，至少需要移動 <xliff:g id="limit">%2$.0f</xliff:g> 公釐。</string>
