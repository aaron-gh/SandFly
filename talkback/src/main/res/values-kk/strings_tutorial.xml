<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Хабарға өтіңіз. Оның әрекеттерін ауыстыру үшін <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> не <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> қимылын жасаңыз. Естіген әрекетті орындау үшін <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> қимылын жасаңыз. <xliff:g id="action" example="Archive">%4$s</xliff:g> әрекетін орындаңыз.</string>
    <string name="sandfly_tutorial_actions_intro">Кейбір элементтердің іске қосудан басқа әрекеттері бар, мысалы, хабар үшін Мұрағаттау не Жою. Мұндай элемент ерекшеленген кезде «Әрекеттер» оқуды басқару элементі солардың арасында ауысады.</string>
    <string name="sandfly_tutorial_actions_title">Әрекеттер</string>
    <string name="sandfly_tutorial_activate_button"><xliff:g id="button" example="Ring the bell">%2$s</xliff:g> элементіне өтіңіз. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> қимылымен оны іске қосыңыз.</string>
    <string name="sandfly_tutorial_activate_check_box"><xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> құсбелгісін дәл солай қойыңыз.</string>
    <string name="sandfly_tutorial_activate_hold">Кейбір элементтер ұстап тұрғанда басқа әрекет жасайды. <xliff:g id="button" example="Details">%2$s</xliff:g> элементіне өтіңіз. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> қимылымен оны ұстап тұрыңыз.</string>
    <string name="sandfly_tutorial_activate_intro">Іске қосу экранның қай жерін түртсеңіз де, ерекшеленген элементке әсер етеді.</string>
    <string name="sandfly_tutorial_activate_title">Элементтерді іске қосу</string>
    <string name="sandfly_tutorial_back_in_lesson">Артқа қимылы сабақтан шығармайды. Басқа сабақты таңдау үшін «Мазмұн» түймесін пайдаланыңыз.</string>
    <string name="sandfly_tutorial_bell">Қоңырауды соғу</string>
    <string name="sandfly_tutorial_bell_rung">Соғылды: <xliff:g id="count" example="1">%1$d</xliff:g> рет</string>
    <string name="sandfly_tutorial_brightness">Жарықтық</string>
    <string name="sandfly_tutorial_chapter_basics">Негіздер</string>
    <string name="sandfly_tutorial_chapter_controls">Басқару элементтері және мәтін</string>
    <string name="sandfly_tutorial_chapter_getting_around">Навигация</string>
    <string name="sandfly_tutorial_chapter_practice">Жаттығу</string>
    <string name="sandfly_tutorial_chapter_reading">Оқу</string>
    <string name="sandfly_tutorial_choose_reading_control">Оқуды басқару элементін өзгерту үшін <xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> не <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> қимылын жасаңыз. <xliff:g id="reading_control" example="Words">%3$s</xliff:g> таңдаңыз.</string>
    <string name="sandfly_tutorial_close">Оқулықты жабу</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> қимылы SandFly соңғы айтқан мәтінді буферге көшіреді.</string>
    <string name="sandfly_tutorial_commands_intro">Бұл командалар әр экранда жұмыс істейді.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> қимылы экраннан мәтін іздейді. Бұл сабақта оқулық оны орындаудың орнына не істейтінін айтады.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> қимылы дыбыстауды өшіреді, қайта жасалса қосады. Бұл сабақта оқулық оны орындаудың орнына не істейтінін айтады.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> қимылы уақытты, батарея деңгейін және басқа күй ақпаратын айтады.</string>
    <string name="sandfly_tutorial_commands_title">Пайдалы командалар</string>
    <string name="sandfly_tutorial_contents">Мазмұн</string>
    <string name="sandfly_tutorial_contents_intro">Сабақтар ретімен. Әрқайсысын бөлек ашуға болады.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly сырғытпай-ақ ерекшеленген элементтен экранның соңына дейін оқи алады. Экранды түрту оқуды тоқтатады.</string>
    <string name="sandfly_tutorial_continuous_move">Рецепттің бірінші жолына өтіңіз.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> қимылымен ерекшеленген элементтен бастап оқыңыз.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> қимылымен SandFly мәзірін ашып, <xliff:g id="command" example="Read from focused item">%2$s</xliff:g> командасын таңдаңыз.</string>
    <string name="sandfly_tutorial_continuous_title">Үздіксіз оқу</string>
    <string name="sandfly_tutorial_details">Мәліметтер</string>
    <string name="sandfly_tutorial_details_shown">Сағат 19:00-ге 2 адамдық үстел, терезе жанында.</string>
    <string name="sandfly_tutorial_done">Аяқталды</string>
    <string name="sandfly_tutorial_end_practice">Жаттығуды аяқтау</string>
    <string name="sandfly_tutorial_explore_activate">Жұлдызды түртіп, саусағыңызды көтеріңіз. Оны іске қосу үшін кез келген жерде <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> қимылын жасаңыз.</string>
    <string name="sandfly_tutorial_explore_find">Бір саусақты экран бойымен жүргізіп, төрт шаршыны табыңыз: Күн, Ай, Жұлдыз және Бұлт.</string>
    <string name="sandfly_tutorial_explore_intro">Экранды түрткенде саусақ астындағы элемент айтылады. Элементті түрту оны іске қоспайды.</string>
    <string name="sandfly_tutorial_explore_title">Түртіп зерттеу</string>
    <string name="sandfly_tutorial_extra_cheese">Қосымша ірімшік</string>
    <string name="sandfly_tutorial_finish">Оқулықты аяқтау</string>
    <string name="sandfly_tutorial_forecast_today">Бүгін</string>
    <string name="sandfly_tutorial_forecast_today_text">Күн ашық әрі жылы, жел әлсіз.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Ертең</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Таңертең бұлтты, түстен бастап жаңбыр.</string>
    <string name="sandfly_tutorial_forecast_weekend">Демалыс күндері</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Сенбіде желді, жексенбіде ашық.</string>
    <string name="sandfly_tutorial_headings_intro">Экрандар мен веб-беттер мазмұнды тақырыптармен бөледі. «Тақырыптар» оқуды басқару элементі бір тақырыптан келесісіне өтеді.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> қимылымен келесі тақырыпқа өтіңіз. <xliff:g id="heading" example="Weekend">%2$s</xliff:g> тақырыбына өтіңіз.</string>
    <string name="sandfly_tutorial_headings_title">Тақырыптар</string>
    <string name="sandfly_tutorial_item_apples">Алма</string>
    <string name="sandfly_tutorial_item_bread">Нан</string>
    <string name="sandfly_tutorial_item_cheese">Ірімшік</string>
    <string name="sandfly_tutorial_item_dates">Құрма</string>
    <string name="sandfly_tutorial_item_eggs">Жұмыртқа</string>
    <string name="sandfly_tutorial_lesson_complete">Сабақ аяқталды.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Сабақ аяқталды. Оқулықты аяқтау үшін <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> қимылын жасаңыз.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Сабақ аяқталды. Келесі сабақты бастау үшін <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> қимылын жасаңыз.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, сабақ <xliff:g id="number" example="3">%2$d</xliff:g>/<xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">Элемент <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> қимылымен мәзірді жабыңыз.</string>
    <string name="sandfly_tutorial_menu_intro">SandFly мәзірінде ерекшеленген элемент пен ағымдағы экранға арналған командалар бар.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> қимылымен SandFly мәзірін ашыңыз. Оның командаларын сырғытып қараңыз. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> қимылы мәзірді жабады.</string>
    <string name="sandfly_tutorial_menu_title">SandFly мәзірі</string>
    <string name="sandfly_tutorial_message">Сэмнен хабар: Түсте түскі ас ішеміз бе?</string>
    <string name="sandfly_tutorial_message_archive">Мұрағаттау</string>
    <string name="sandfly_tutorial_message_delete">Жою</string>
    <string name="sandfly_tutorial_message_reply">Жауап беру</string>
    <string name="sandfly_tutorial_move_intro">Сырғыту экрандағы келесі не алдыңғы элементке оқу ретімен өтеді.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> қимылымен келесі элементке өтіңіз. <xliff:g id="item" example="Eggs">%2$s</xliff:g> элементіне жеткенше жалғастырыңыз.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> қимылымен алдыңғы элементке өтіңіз. <xliff:g id="item" example="Bread">%2$s</xliff:g> элементіне қайта оралыңыз.</string>
    <string name="sandfly_tutorial_move_title">Элементтер арасында жылжу</string>
    <string name="sandfly_tutorial_name">Аты</string>
    <string name="sandfly_tutorial_next_lesson">Келесі сабақ: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> әрекетінің қимылы жоқ. Оны «Командалар» бөлімінде тағайындаңыз не «Қадамды өткізіп жіберу» түймесін пайдаланыңыз.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> сабақта орындалмайды. Оқулықтан шығу үшін «Мазмұн» бөліміндегі «Оқулықты жабу» түймесін пайдаланыңыз.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> сабақта орындалмайды.</string>
    <string name="sandfly_tutorial_pause_intro">Сөйлеуді элементтің ортасында кідіртіп, тоқтаған жерінен жалғастыруға болады.</string>
    <string name="sandfly_tutorial_pause_pause">Төмендегі әңгімеге өтіңіз. Ол оқылып жатқанда сөйлеуді кідірту үшін <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> қимылын жасаңыз, жалғастыру үшін қайта жасаңыз.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> қимылын қайта жасап, сөйлеуді жалғастырыңыз.</string>
    <string name="sandfly_tutorial_pause_title">Сөйлеуді кідірту</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Әр қимыл орындалудың орнына өз атауы мен әрекетін айтады. Келесі және алдыңғы элементке өту мен іске қосу бұрынғыдай жұмыс істейді.</string>
    <string name="sandfly_tutorial_practice_step">Не істейтінін есту үшін кез келген қимылды жасаңыз. Тоқтату үшін <xliff:g id="button" example="End practice">%1$s</xliff:g> түймесін іске қосыңыз.</string>
    <string name="sandfly_tutorial_practice_title">Қимыл жаттығуы</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Оқуды басқару элементін <xliff:g id="reading_control" example="Characters">%2$s</xliff:g> етіп өзгертіңіз. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> қимылымен бір таңбаға жылжыңыз.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Оқуды басқару элементтері жоғары және төмен сырғытудың не істейтінін таңдайды, мысалы, сөз не таңба бойынша жылжу немесе сөйлеу жылдамдығын өзгерту. Оңға және солға сырғыту бұрынғыдай элементтер арасында өтеді.</string>
    <string name="sandfly_tutorial_reading_controls_move">Төмендегі сөйлемге өтіңіз.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> қимылымен келесі сөзге өтіңіз. Үш сөзге жылжыңыз.</string>
    <string name="sandfly_tutorial_reading_controls_title">Оқуды басқару элементтері</string>
    <string name="sandfly_tutorial_recipe_1">Құймақ: ұнды, жұмыртқаны және сүтті араластырып, біркелкі қамыр жасаңыз.</string>
    <string name="sandfly_tutorial_recipe_2">Табада аздап сары май қыздырыңыз.</string>
    <string name="sandfly_tutorial_recipe_3">Табаны жұқа жабатындай қамыр құйыңыз.</string>
    <string name="sandfly_tutorial_recipe_4">Асты алтын түстес болғанда құймақты аударыңыз.</string>
    <string name="sandfly_tutorial_recipe_5">Лимон мен қантпен ұсыныңыз.</string>
    <string name="sandfly_tutorial_scrolling_intro">Тізімдер элементтерінің бір бөлігін ғана көрсетеді. Көрсетілген соңғы элементтен әрі сырғыту тізімді айналдырады.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> қимылымен бір бетке алға айналдырыңыз.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> қимылымен тізім бойынша <xliff:g id="item" example="Item 15">%2$s</xliff:g> элементіне жеткенше жылжыңыз.</string>
    <string name="sandfly_tutorial_scrolling_title">Тізімдерді айналдыру</string>
    <string name="sandfly_tutorial_sentence">Жылдам қоңыр түлкі жалқау иттің үстінен секіреді.</string>
    <string name="sandfly_tutorial_skip_step">Қадамды өткізіп жіберу</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> жүгірткісіне өтіңіз. Мәнін өзгерту үшін <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> не <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> қимылын жасаңыз.</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> мәнін ең жоғары мәні – 100 пайызға орнатыңыз.</string>
    <string name="sandfly_tutorial_sliders_intro">Жүгірткі ерекшеленген кезде жоғары және төмен сырғыту оның мәнін өзгертеді.</string>
    <string name="sandfly_tutorial_sliders_title">Жүгірткілер</string>
    <string name="sandfly_tutorial_step">Қадам <xliff:g id="number" example="1">%1$d</xliff:g>/<xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Құм шыбындары – жағажайларда, өзен жағаларында және ормандарда тіршілік ететін кішкентай шыбындар. Олар ауа тымық болатын таң сәріде және ымыртта ең белсенді. Тек аналықтары ғана шағады, өйткені жұмыртқа салу үшін оларға қан қажет. Шаққан жер бірнеше күн қышиды, сондықтан құм шыбыны көп өлкеге баратындар жәндіктерден қорғайтын құрал алып жүреді. Құм шыбындары нашар ұшады, тіпті жеңіл самал да оларды алыстатады.</string>
