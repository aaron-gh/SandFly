<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Преминете към съобщението. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> или <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> – преминаване през действията му. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> – изпълнение на чутото действие. Изпълнете „<xliff:g id="action" example="Archive">%4$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_actions_intro">Някои елементи имат действия освен активирането, например „Архивиране“ или „Изтриване“ за съобщение. Докато такъв елемент е на фокус, контролата за четене „Действия“ преминава през тях.</string>
    <string name="sandfly_tutorial_actions_title">Действия</string>
    <string name="sandfly_tutorial_activate_button">Преминете към „<xliff:g id="button" example="Ring the bell">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – активиране.</string>
    <string name="sandfly_tutorial_activate_check_box">По същия начин поставете отметка в „<xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_activate_hold">Някои елементи правят друго при задържане. Преминете към „<xliff:g id="button" example="Details">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> – задържане.</string>
    <string name="sandfly_tutorial_activate_intro">Активирането действа върху елемента на фокус, където и да докоснете екрана.</string>
    <string name="sandfly_tutorial_activate_title">Активиране на елементи</string>
    <string name="sandfly_tutorial_back_in_lesson">„Назад“ не излиза от урока. За да изберете друг урок, използвайте „Съдържание“.</string>
    <string name="sandfly_tutorial_bell">Позвъняване на звънеца</string>
    <string name="sandfly_tutorial_bell_rung">Позвънявания: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Яркост</string>
    <string name="sandfly_tutorial_chapter_basics">Основи</string>
    <string name="sandfly_tutorial_chapter_controls">Контроли и текст</string>
    <string name="sandfly_tutorial_chapter_getting_around">Придвижване</string>
    <string name="sandfly_tutorial_chapter_practice">Упражнения</string>
    <string name="sandfly_tutorial_chapter_reading">Четене</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> или <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> – смяна на контролата за четене. Изберете „<xliff:g id="reading_control" example="Words">%3$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_close">Затваряне на обучението</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> – копиране на последния изговорен от SandFly текст в буфера за обмен.</string>
    <string name="sandfly_tutorial_commands_intro">Тези команди работят на всеки екран.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> – търсене на текст на екрана. В този урок вместо това обучението казва какво прави командата.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> – изключване на говора, повторно – включване. В този урок вместо това обучението казва какво прави командата.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> – изговаряне на часа, нивото на батерията и друго състояние.</string>
    <string name="sandfly_tutorial_commands_title">Полезни команди</string>
    <string name="sandfly_tutorial_contents">Съдържание</string>
    <string name="sandfly_tutorial_contents_intro">Уроци по ред. Всеки може да се отвори самостоятелно.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly може да чете от елемента на фокус до края на екрана без прекарване на пръст. Докосването на екрана спира четенето.</string>
    <string name="sandfly_tutorial_continuous_move">Преминете към първия ред от рецептата.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> – четене от елемента на фокус.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> – отваряне на менюто на SandFly. След това изберете „<xliff:g id="command" example="Read from focused item">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_continuous_title">Непрекъснато четене</string>
    <string name="sandfly_tutorial_details">Подробности</string>
    <string name="sandfly_tutorial_details_shown">Маса за двама в 19:00, до прозореца.</string>
    <string name="sandfly_tutorial_done">Завършен</string>
    <string name="sandfly_tutorial_end_practice">Край на упражнението</string>
    <string name="sandfly_tutorial_explore_activate">Докоснете „Звезда“ и вдигнете пръста си. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> навсякъде на екрана – активиране.</string>
    <string name="sandfly_tutorial_explore_find">Плъзнете един пръст по екрана и намерете четирите квадрата: Слънце, Луна, Звезда и Облак.</string>
    <string name="sandfly_tutorial_explore_intro">При докосване на екрана се изговаря елементът под пръста. Докосването на елемент не го активира.</string>
    <string name="sandfly_tutorial_explore_title">Изследване чрез докосване</string>
    <string name="sandfly_tutorial_extra_cheese">Допълнително сирене</string>
    <string name="sandfly_tutorial_finish">Завършване на обучението</string>
    <string name="sandfly_tutorial_forecast_today">Днес</string>
    <string name="sandfly_tutorial_forecast_today_text">Слънчево и топло, със слаб вятър.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Утре</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Облачно сутринта, с дъжд от обяд.</string>
    <string name="sandfly_tutorial_forecast_weekend">Уикенд</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Ветровито в събота, ясно в неделя.</string>
    <string name="sandfly_tutorial_headings_intro">Екраните и уеб страниците разделят съдържанието си със заглавия. Контролата за четене „Заглавия“ прескача от едно заглавие към следващото.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – преминаване към следващото заглавие. Преминете към „<xliff:g id="heading" example="Weekend">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_headings_title">Заглавия</string>
    <string name="sandfly_tutorial_item_apples">Ябълки</string>
    <string name="sandfly_tutorial_item_bread">Хляб</string>
    <string name="sandfly_tutorial_item_cheese">Сирене</string>
    <string name="sandfly_tutorial_item_dates">Фурми</string>
    <string name="sandfly_tutorial_item_eggs">Яйца</string>
    <string name="sandfly_tutorial_lesson_complete">Урокът е завършен.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Урокът е завършен. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – завършване на обучението.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Урокът е завършен. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – започване на следващия урок.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, урок <xliff:g id="number" example="3">%2$d</xliff:g> от <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_list_item">Елемент <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> – затваряне на менюто.</string>
    <string name="sandfly_tutorial_menu_intro">Менюто на SandFly има команди за елемента на фокус и за текущия екран.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> – отваряне на менюто на SandFly. Прекарайте пръст през командите му. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> – затваряне на менюто.</string>
    <string name="sandfly_tutorial_menu_title">Меню на SandFly</string>
    <string name="sandfly_tutorial_message">Съобщение от Сашо: обяд по пладне?</string>
    <string name="sandfly_tutorial_message_archive">Архивиране</string>
    <string name="sandfly_tutorial_message_delete">Изтриване</string>
    <string name="sandfly_tutorial_message_reply">Отговор</string>
    <string name="sandfly_tutorial_move_intro">Прекарването на пръст премества към следващия или предишния елемент на екрана по реда на четене.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> – преминаване към следващия елемент. Продължете, докато стигнете до „<xliff:g id="item" example="Eggs">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> – преминаване към предишния елемент. Върнете се към „<xliff:g id="item" example="Bread">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_move_title">Придвижване между елементи</string>
    <string name="sandfly_tutorial_name">Име</string>
    <string name="sandfly_tutorial_next_lesson">Следващ урок: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">„<xliff:g id="action" example="Next item">%1$s</xliff:g>“ няма жест. Присвоете жест в „Команди“ или използвайте „Пропускане на стъпката“.</string>
    <string name="sandfly_tutorial_not_in_lesson">„<xliff:g id="action" example="Home">%1$s</xliff:g>“ не се изпълнява в урок. За да излезете от обучението, използвайте „Затваряне на обучението“ в „Съдържание“.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">„<xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g>“ не се изпълнява в урок.</string>
    <string name="sandfly_tutorial_pause_intro">Говорът може да се постави на пауза по средата на елемент и да се възобнови оттам, където е спрял.</string>
    <string name="sandfly_tutorial_pause_pause">Преминете към разказа по-долу. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> по време на четенето – пауза на говора, повторно – възобновяване.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> отново – възобновяване на говора.</string>
    <string name="sandfly_tutorial_pause_title">Поставяне на говора на пауза</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Всеки жест изговаря името и действието си, вместо да го изпълни. Преминаването към следващия и предишния елемент и активирането продължават да работят.</string>
    <string name="sandfly_tutorial_practice_step">Направете произволен жест, за да чуете какво прави. За да спрете, активирайте „<xliff:g id="button" example="End practice">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_practice_title">Упражнение с жестове</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> от <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Сменете контролата за четене на „<xliff:g id="reading_control" example="Characters">%2$s</xliff:g>“. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – придвижване с един знак.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Контролите за четене определят какво прави прекарването на пръст нагоре и надолу, например придвижване по думи или по знаци или промяна на скоростта на говора. Прекарването на пръст надясно и наляво продължава да премества между елементите.</string>
    <string name="sandfly_tutorial_reading_controls_move">Преминете към изречението по-долу.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> – преминаване към следващата дума. Придвижете се с три думи.</string>
    <string name="sandfly_tutorial_reading_controls_title">Контроли за четене</string>
    <string name="sandfly_tutorial_recipe_1">Палачинки: смесете брашно, яйца и мляко в гладко тесто.</string>
    <string name="sandfly_tutorial_recipe_2">Загрейте малко масло в тиган.</string>
    <string name="sandfly_tutorial_recipe_3">Изсипете толкова тесто, колкото да покрие тигана на тънък слой.</string>
    <string name="sandfly_tutorial_recipe_4">Обърнете палачинката, когато долната страна стане златиста.</string>
    <string name="sandfly_tutorial_recipe_5">Сервирайте с лимон и захар.</string>
    <string name="sandfly_tutorial_scrolling_intro">Списъците показват само част от елементите си наведнъж. Прекарването на пръст след последния показан елемент превърта списъка.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> – превъртане напред с една страница.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> – придвижване през списъка. Стигнете до „<xliff:g id="item" example="Item 15">%2$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_scrolling_title">Превъртане на списъци</string>
    <string name="sandfly_tutorial_sentence">Ах, чудна българска земьо, полюшвай цъфтящи жита.</string>
    <string name="sandfly_tutorial_skip_step">Пропускане на стъпката</string>
    <string name="sandfly_tutorial_sliders_change">Преминете към плъзгача „<xliff:g id="slider" example="Brightness">%3$s</xliff:g>“. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> или <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> – промяна на стойността му.</string>
    <string name="sandfly_tutorial_sliders_highest">Задайте „<xliff:g id="slider" example="Brightness">%1$s</xliff:g>“ на 100 процента, най-високата стойност.</string>
    <string name="sandfly_tutorial_sliders_intro">Когато плъзгач е на фокус, прекарването на пръст нагоре и надолу променя стойността му.</string>
    <string name="sandfly_tutorial_sliders_title">Плъзгачи</string>
    <string name="sandfly_tutorial_step">Стъпка <xliff:g id="number" example="1">%1$d</xliff:g> от <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Пясъчните мухи са малки мухи, които живеят по плажове, речни брегове и в гори. Най-активни са на зазоряване и привечер, когато въздухът е неподвижен. Хапят само женските, защото им трябва кръв, за да снесат яйцата си. Ухапванията сърбят с дни, затова хората, които посещават местата с пясъчни мухи, носят репелент. Пясъчните мухи летят слабо и дори лек бриз ги държи настрана.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> – връщане назад.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> – преминаване към началния екран.</string>
    <string name="sandfly_tutorial_system_intro">Тези жестове работят на всеки екран. В този урок обучението казва какво прави всеки от тях, вместо да го изпълни.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> – отваряне на известията.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> – показване на скорошните приложения.</string>
    <string name="sandfly_tutorial_system_title">Назад, начален екран и известия</string>
    <string name="sandfly_tutorial_tile_cloud">Облак</string>
    <string name="sandfly_tutorial_tile_moon">Луна</string>
    <string name="sandfly_tutorial_tile_star">Звезда</string>
    <string name="sandfly_tutorial_tile_sun">Слънце</string>
    <string name="sandfly_tutorial_title">Обучение за SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Изтрийте последната буква с клавиша за изтриване на клавиатурата.</string>
    <string name="sandfly_tutorial_typing_intro">Активирането на текстово поле отваря клавиатурата. Докоснете клавиш, за да го чуете, и вдигнете пръста си, за да го въведете.</string>
    <string name="sandfly_tutorial_typing_open">Преминете към полето „<xliff:g id="field" example="Name">%2$s</xliff:g>“. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> – започване на въвеждането.</string>
    <string name="sandfly_tutorial_typing_title">Въвеждане</string>
    <string name="sandfly_tutorial_typing_type">Въведете думата „<xliff:g id="word" example="cat">%1$s</xliff:g>“.</string>
    <string name="sandfly_tutorial_typing_word">котка</string>
    <string name="sandfly_tutorial_welcome_intro">Това обучение представя жестовете на SandFly. Всеки урок дава инструкция, изчаква да я изпълните със своите жестове и след това дава следващата. Инструкцията е първият елемент след името на урока. „Съдържание“ показва всички уроци, а обучението се отваря отново на урока, на който сте били.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> навсякъде на екрана – започване.</string>
    <string name="sandfly_tutorial_welcome_title">Добре дошли</string>
</resources>
