    <string name="sandfly_tutorial_explore_activate">Toque em Estrela e levante o dedo. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> em qualquer lugar para ativar.</string>
    <string name="sandfly_tutorial_explore_find">Deslize um dedo pela tela e encontre os quatro quadrados: Sol, Lua, Estrela e Nuvem.</string>
    <string name="sandfly_tutorial_explore_intro">Tocar na tela fala o item sob o dedo. Tocar em um item não o ativa.</string>
    <string name="sandfly_tutorial_explore_title">Explorar por toque</string>
    <string name="sandfly_tutorial_extra_cheese">Queijo extra</string>
