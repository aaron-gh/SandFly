    <string name="sandfly_tutorial_message_reply">Responder</string>
    <string name="sandfly_tutorial_move_intro">Deslizar move para o próximo item ou o anterior na tela, na ordem de leitura.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> para ir para o próximo item. Continue até chegar a <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> para ir para o item anterior. Volte para <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Mover entre itens</string>
    <string name="sandfly_tutorial_name">Nome</string>
    <string name="sandfly_tutorial_next_lesson">Próxima lição: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> não tem gesto. Atribua um em Comandos ou use Pular etapa.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> não é executado em uma lição. Para sair do tutorial, use Fechar tutorial em Conteúdo.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> não é executado em uma lição.</string>
    <string name="sandfly_tutorial_pause_intro">A fala pode ser pausada no meio de um item e retomada de onde parou.</string>
    <string name="sandfly_tutorial_pause_pause">Vá até a história abaixo. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> durante a leitura para pausar a fala e de novo para retomá-la.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> de novo para retomar a fala.</string>
    <string name="sandfly_tutorial_pause_title">Pausar a fala</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Cada gesto diz o nome e a ação dele em vez de executá-la. Ir para o próximo item e o anterior e ativar continuam funcionando.</string>
    <string name="sandfly_tutorial_practice_step">Faça qualquer gesto para ouvir o que ele faz. Para parar, ative <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Prática de gestos</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> de <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Mude o controle de leitura para <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para avançar um caractere.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Os controles de leitura definem o que deslizar para cima e para baixo faz, como mover por palavra ou por caractere ou alterar a velocidade da fala. Deslizar para a direita e para a esquerda continua movendo entre itens.</string>
    <string name="sandfly_tutorial_reading_controls_move">Vá até a frase abaixo.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para ir para a próxima palavra. Avance três palavras.</string>
    <string name="sandfly_tutorial_reading_controls_title">Controles de leitura</string>
    <string name="sandfly_tutorial_recipe_1">Panquecas: misture farinha, ovos e leite até obter uma massa lisa.</string>
    <string name="sandfly_tutorial_recipe_2">Aqueça um pouco de manteiga em uma frigideira.</string>
    <string name="sandfly_tutorial_recipe_3">Despeje massa suficiente para cobrir o fundo da frigideira com uma camada fina.</string>
    <string name="sandfly_tutorial_recipe_4">Vire a panqueca quando o lado de baixo estiver dourado.</string>
    <string name="sandfly_tutorial_recipe_5">Sirva com limão e açúcar.</string>
    <string name="sandfly_tutorial_scrolling_intro">As listas mostram apenas alguns itens por vez. Deslizar além do último item mostrado rola a lista.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> para rolar uma página para frente.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> pela lista até chegar a <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Rolar listas</string>
    <string name="sandfly_tutorial_sentence">Um pequeno jabuti xereta viu dez cegonhas felizes.</string>
    <string name="sandfly_tutorial_skip_step">Pular etapa</string>
    <string name="sandfly_tutorial_sliders_change">Vá até o controle deslizante <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para mudar o valor dele.</string>
    <string name="sandfly_tutorial_sliders_highest">Defina <xliff:g id="slider" example="Brightness">%1$s</xliff:g> como 100 por cento, o valor máximo.</string>
    <string name="sandfly_tutorial_sliders_intro">Quando um controle deslizante está em foco, deslizar para cima e para baixo muda o valor dele.</string>
    <string name="sandfly_tutorial_sliders_title">Controles deslizantes</string>
    <string name="sandfly_tutorial_step">Etapa <xliff:g id="number" example="1">%1$d</xliff:g> de <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Os mosquitos-palha são pequenos insetos que vivem em praias, margens de rios e florestas. Eles são mais ativos ao amanhecer e ao anoitecer, quando o ar está parado. Só as fêmeas picam, porque precisam de sangue para produzir os ovos. As picadas coçam por dias, por isso quem visita regiões com esses insetos leva repelente. Os mosquitos-palha voam mal, e até uma brisa leve os mantém afastados.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> para voltar.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> para ir para a tela inicial.</string>
    <string name="sandfly_tutorial_system_intro">Estes gestos funcionam em todas as telas. Nesta lição, o tutorial diz o que cada um faz em vez de executá-lo.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> para abrir as notificações.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> para mostrar os apps recentes.</string>
    <string name="sandfly_tutorial_system_title">Voltar, Início e notificações</string>
