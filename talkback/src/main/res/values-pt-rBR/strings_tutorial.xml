    <string name="sandfly_tutorial_tile_sun">Sol</string>
    <string name="sandfly_tutorial_title">Tutorial do SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Apague a última letra com a tecla Excluir do teclado.</string>
    <string name="sandfly_tutorial_typing_intro">Ativar um campo de texto abre o teclado. Toque em uma tecla para ouvi-la e levante o dedo para digitá-la.</string>
    <string name="sandfly_tutorial_typing_open">Vá até o campo <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para começar a digitar.</string>
    <string name="sandfly_tutorial_typing_title">Digitação</string>
    <string name="sandfly_tutorial_typing_type">Digite a palavra <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">gato</string>
    <string name="sandfly_tutorial_welcome_intro">Este tutorial ensina os gestos do SandFly. Cada lição dá uma instrução, espera até você executá-la com seus próprios gestos e depois dá a próxima. A instrução é o primeiro item depois do nome da lição. Conteúdo lista todas as lições, e o tutorial é reaberto na lição em que você estava.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> em qualquer lugar da tela para começar.</string>
    <string name="sandfly_tutorial_welcome_title">Boas-vindas</string>
</resources>
