    <string name="sandfly_tutorial_forecast_today">Hoje</string>
    <string name="sandfly_tutorial_forecast_today_text">Ensolarado e quente, com vento fraco.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Amanhã</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Nublado pela manhã, com chuva a partir do meio-dia.</string>
    <string name="sandfly_tutorial_forecast_weekend">Fim de semana</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Ventania no sábado, céu limpo no domingo.</string>
    <string name="sandfly_tutorial_headings_intro">Telas e páginas da Web dividem o conteúdo com títulos. O controle de leitura Títulos pula de um título para o próximo.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para pular para o próximo título. Pule para <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_headings_title">Títulos</string>
