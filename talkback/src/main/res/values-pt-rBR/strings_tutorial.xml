    <string name="sandfly_tutorial_lesson_complete_last">Lição concluída. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para concluir o tutorial.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Lição concluída. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para iniciar a próxima lição.</string>
