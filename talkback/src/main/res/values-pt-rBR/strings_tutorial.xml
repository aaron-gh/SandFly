<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Vá até a mensagem. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para percorrer as ações dela. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> para executar a ação anunciada. Execute <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Alguns itens têm ações além de ativar, como Arquivar ou Excluir em uma mensagem. Enquanto um item desses está em foco, o controle de leitura Ações percorre essas ações.</string>
    <string name="sandfly_tutorial_actions_title">Ações</string>
    <string name="sandfly_tutorial_activate_button">Vá até <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para ativar.</string>
    <string name="sandfly_tutorial_activate_check_box">Marque <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> da mesma forma.</string>
    <string name="sandfly_tutorial_activate_hold">Alguns itens fazem outra coisa quando mantidos pressionados. Vá até <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> para mantê-lo pressionado.</string>
    <string name="sandfly_tutorial_activate_intro">A ativação funciona no item em foco, em qualquer lugar da tela que você tocar.</string>
    <string name="sandfly_tutorial_activate_title">Ativar itens</string>
    <string name="sandfly_tutorial_back_in_lesson">Voltar não sai de uma lição. Para escolher outra lição, use Conteúdo.</string>
    <string name="sandfly_tutorial_bell">Tocar o sino</string>
    <string name="sandfly_tutorial_bell_rung">Toques: <xliff:g id="count" example="1">%1$d</xliff:g></string>
