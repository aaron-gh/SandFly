    <string name="sandfly_tutorial_list_item">Item <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> para fechar o menu.</string>
    <string name="sandfly_tutorial_menu_intro">O menu do SandFly tem comandos para o item em foco e para a tela atual.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir o menu do SandFly. Deslize pelos comandos dele. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> fecha o menu.</string>
    <string name="sandfly_tutorial_menu_title">Menu do SandFly</string>
