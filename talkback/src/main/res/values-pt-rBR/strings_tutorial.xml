    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> para mudar o controle de leitura. Escolha <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Fechar tutorial</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> para copiar o último texto falado pelo SandFly para a área de transferência.</string>
    <string name="sandfly_tutorial_commands_intro">Estes comandos funcionam em todas as telas.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> para pesquisar texto na tela. Nesta lição, o tutorial diz o que o comando faz em vez de executá-lo.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> para desativar a fala e de novo para ativá-la. Nesta lição, o tutorial diz o que o comando faz em vez de executá-lo.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> para ouvir a hora, o nível da bateria e outros status.</string>
    <string name="sandfly_tutorial_commands_title">Comandos úteis</string>
    <string name="sandfly_tutorial_contents">Conteúdo</string>
    <string name="sandfly_tutorial_contents_intro">Lições, em ordem. Cada uma pode ser aberta separadamente.</string>
    <string name="sandfly_tutorial_continuous_intro">O SandFly pode ler do item em foco até o fim da tela sem você deslizar. Tocar na tela interrompe a leitura.</string>
    <string name="sandfly_tutorial_continuous_move">Vá até a primeira linha da receita.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> para ler a partir do item em foco.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir o menu do SandFly. Depois, escolha <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_title">Leitura contínua</string>
    <string name="sandfly_tutorial_details">Detalhes</string>
