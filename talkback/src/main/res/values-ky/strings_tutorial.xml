    <string name="sandfly_tutorial_message_archive">Архивдөө</string>
    <string name="sandfly_tutorial_message_delete">Өчүрүү</string>
    <string name="sandfly_tutorial_message_reply">Жооп берүү</string>
    <string name="sandfly_tutorial_move_intro">Сүрүү экрандагы кийинки же мурунку нерсеге окуу ирети боюнча өтөт.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> жаңсоосу менен кийинки нерсеге өтүңүз. <xliff:g id="item" example="Eggs">%2$s</xliff:g> нерсесине жеткенче улантыңыз.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> жаңсоосу менен мурунку нерсеге өтүңүз. <xliff:g id="item" example="Bread">%2$s</xliff:g> нерсесине кайтыңыз.</string>
    <string name="sandfly_tutorial_move_title">Нерселердин ортосунда жылуу</string>
    <string name="sandfly_tutorial_name">Аты</string>
    <string name="sandfly_tutorial_next_lesson">Кийинки сабак: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> аракетинин жаңсоосу жок. Аны «Командалар» бөлүмүнөн дайындаңыз же «Кадамды өткөрүп жиберүү» баскычын колдонуңуз.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> сабакта аткарылбайт. Үйрөткүчтөн чыгуу үчүн «Мазмуну» бөлүмүндөгү «Үйрөткүчтү жабуу» баскычын колдонуңуз.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> сабакта аткарылбайт.</string>
    <string name="sandfly_tutorial_pause_intro">Кепти нерсенин ортосунда тындырып, токтогон жеринен улантса болот.</string>
    <string name="sandfly_tutorial_pause_pause">Төмөнкү окуяга өтүңүз. Ал окулуп жатканда кепти тындыруу үчүн <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> жаңсоосун аткарыңыз, улантуу үчүн кайра аткарыңыз.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> жаңсоосун кайра аткарып, кепти улантыңыз.</string>
    <string name="sandfly_tutorial_pause_title">Кепти тындыруу</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Ар бир жаңсоо аткарылбай, өзүнүн аталышын жана аракетин айтат. Кийинки жана мурунку нерсеге өтүү жана иштетүү мурдагыдай иштейт.</string>
    <string name="sandfly_tutorial_practice_step">Эмне кыларын угуу үчүн каалаган жаңсоону аткарыңыз. Токтотуу үчүн <xliff:g id="button" example="End practice">%1$s</xliff:g> баскычын иштетиңиз.</string>
    <string name="sandfly_tutorial_practice_title">Жаңсоо көнүгүүсү</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Окууну башкаруу элементин <xliff:g id="reading_control" example="Characters">%2$s</xliff:g> кылып өзгөртүңүз. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> жаңсоосу менен бир символго жылыңыз.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Окууну башкаруу элементтери өйдө жана ылдый сүрүү эмне кыларын тандайт, мисалы, сөз же символ боюнча жылуу же кеп ылдамдыгын өзгөртүү. Оңго жана солго сүрүү мурдагыдай нерселердин ортосунда өтөт.</string>
    <string name="sandfly_tutorial_reading_controls_move">Төмөнкү сүйлөмгө өтүңүз.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> жаңсоосу менен кийинки сөзгө өтүңүз. Үч сөзгө жылыңыз.</string>
    <string name="sandfly_tutorial_reading_controls_title">Окууну башкаруу элементтери</string>
    <string name="sandfly_tutorial_recipe_1">Куймак: унду, жумуртканы жана сүттү аралаштырып, бир калыптагы камыр жасаңыз.</string>
    <string name="sandfly_tutorial_recipe_2">Табада бир аз сары май ысытыңыз.</string>
    <string name="sandfly_tutorial_recipe_3">Табаны жука каптагандай камыр куюңуз.</string>
    <string name="sandfly_tutorial_recipe_4">Асты алтын түскө киргенде куймакты оодарыңыз.</string>
    <string name="sandfly_tutorial_recipe_5">Лимон жана кант менен бериңиз.</string>
    <string name="sandfly_tutorial_scrolling_intro">Тизмелер нерселеринин бир бөлүгүн гана көрсөтөт. Көрсөтүлгөн акыркы нерседен ары сүрүү тизмени сыдырат.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> жаңсоосу менен бир баракча алдыга сыдырыңыз.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> жаңсоосу менен тизме боюнча <xliff:g id="item" example="Item 15">%2$s</xliff:g> нерсесине жеткенче жылыңыз.</string>
    <string name="sandfly_tutorial_scrolling_title">Тизмелерди сыдыруу</string>
    <string name="sandfly_tutorial_sentence">Тез күрөң түлкү жалкоо иттин үстүнөн секирет.</string>
    <string name="sandfly_tutorial_skip_step">Кадамды өткөрүп жиберүү</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> сыдырмасына өтүңүз. Маанисин өзгөртүү үчүн <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> же <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> жаңсоосун аткарыңыз.</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> маанисин эң жогорку мааниси – 100 пайызга коюңуз.</string>
    <string name="sandfly_tutorial_sliders_intro">Сыдырма тандалып турганда өйдө жана ылдый сүрүү анын маанисин өзгөртөт.</string>
    <string name="sandfly_tutorial_sliders_title">Сыдырмалар</string>
    <string name="sandfly_tutorial_step">Кадам <xliff:g id="number" example="1">%1$d</xliff:g>/<xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Кум чымындары – деңиз жээктеринде, дарыя жээктеринде жана токойлордо жашаган кичинекей чымындар. Алар аба тынч болгон таң атарда жана күүгүмдө эң активдүү. Ургаачылары гана чагат, анткени жумуртка салыш үчүн аларга кан керек. Чаккан жер бир нече күн кычышат, ошондуктан кум чымыны көп жерлерге баргандар курт-кумурскадан коргоочу каражат алып жүрүшөт. Кум чымындары начар учат, жеңил шамал да аларды алыс кармайт.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> жаңсоосу менен артка кайтыңыз.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> жаңсоосу менен башкы экранга өтүңүз.</string>
    <string name="sandfly_tutorial_system_intro">Бул жаңсоолор ар бир экранда иштейт. Бул сабакта үйрөткүч ар бирин аткаруунун ордуна эмне кыларын айтат.</string>
