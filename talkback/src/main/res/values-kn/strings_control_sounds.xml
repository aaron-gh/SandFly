<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">ಶಬ್ದಗಳು ಮತ್ತು ಕಂಪನಗಳನ್ನು ನಿಯಂತ್ರಿಸಿ</string>
    <string name="summary_pref_control_sounds">ಬಟನ್‌ಗಳು, ಚೆಕ್‌ಬಾಕ್ಸ್‌ಗಳು, ಎಡಿಟ್ ಫೀಲ್ಡ್‌ಗಳು ಮತ್ತು ಪಟ್ಟಿ ಐಟಂಗಳು, ತನ್ನದೇ ಆದ ಧ್ವನಿ ಮತ್ತು ಥೀಮ್‌ನಿಂದ ಅದರ ಸ್ವಂತ ಕಂಪನದಂತಹ ಪ್ರತಿಯೊಂದು ರೀತಿಯ ನಿಯಂತ್ರಣವನ್ನು ನೀಡಿ, ಫೋಕಸ್ ಸೌಂಡ್ ಮತ್ತು ವೈಬ್ರೇಶನ್ ಬದಲಿಗೆ, ಅನ್‌ಸ್ಪೋಕನ್ ಮಾಡುವಂತೆ ಎನ್‌ವಿಡಿಎ. ಪರದೆಯ ಮೇಲೆ ನಿಯಂತ್ರಣ ಇರುವ ಸ್ಥಳದಿಂದ ಧ್ವನಿ ಬರುತ್ತದೆ ಮತ್ತು SandFly ಇದು ಯಾವ ರೀತಿಯ ನಿಯಂತ್ರಣ ಎಂದು ಹೇಳುತ್ತದೆ.</string>
    <string name="title_pref_control_sounds_speak_roles">ಇನ್ನೂ ರೀತಿಯ ನಿಯಂತ್ರಣವನ್ನು ಹೇಳುತ್ತಾರೆ</string>
    <string name="summary_pref_control_sounds_speak_roles">ಕಂಟ್ರೋಲ್ ಸೌಂಡ್ ಪ್ಲೇ ಆಗುವಾಗ, ಅದು ಯಾವ ರೀತಿಯ ನಿಯಂತ್ರಣ ಎಂದು ಇನ್ನೂ ಹೇಳಿ, ಉದಾಹರಣೆಗೆ ಬಟನ್. ಇದು ಪ್ರತಿ ಧ್ವನಿ ಥೀಮ್‌ಗೆ ಆಗಿದೆ.</string>
