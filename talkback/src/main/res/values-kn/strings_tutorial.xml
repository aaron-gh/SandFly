    <string name="sandfly_tutorial_pause_intro">ಐಟಂನ ಮಧ್ಯದಲ್ಲಿ ಮಾತನ್ನು ವಿರಾಮಗೊಳಿಸಬಹುದು, ಮತ್ತು ನಿಂತ ಕಡೆಯಿಂದ ಮುಂದುವರಿಸಬಹುದು.</string>
    <string name="sandfly_tutorial_pause_pause">ಕೆಳಗಿನ ಕಥೆಗೆ ಹೋಗಿ. ಅದನ್ನು ಓದುತ್ತಿರುವಾಗ ಮಾತನ್ನು ವಿರಾಮಗೊಳಿಸಲು <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>, ಮತ್ತು ಮುಂದುವರಿಸಲು ಮತ್ತೊಮ್ಮೆ.</string>
    <string name="sandfly_tutorial_pause_resume">ಮಾತನ್ನು ಮುಂದುವರಿಸಲು ಮತ್ತೊಮ್ಮೆ <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_pause_title">ಮಾತನ್ನು ವಿರಾಮಗೊಳಿಸುವುದು</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">ಪ್ರತಿ ಜೆಸ್ಚರ್ ತನ್ನ ಕ್ರಿಯೆಯನ್ನು ಮಾಡುವ ಬದಲು ತನ್ನ ಹೆಸರು ಮತ್ತು ಕ್ರಿಯೆಯನ್ನು ಹೇಳುತ್ತದೆ. ಮುಂದಿನ ಮತ್ತು ಹಿಂದಿನ ಐಟಂಗೆ ಹೋಗುವುದು ಮತ್ತು ಸಕ್ರಿಯಗೊಳಿಸುವುದು ಈಗಲೂ ಕೆಲಸ ಮಾಡುತ್ತವೆ.</string>
    <string name="sandfly_tutorial_practice_step">ಯಾವುದೇ ಜೆಸ್ಚರ್ ಏನು ಮಾಡುತ್ತದೆ ಎಂದು ಕೇಳಲು ಅದನ್ನು ಮಾಡಿ. ನಿಲ್ಲಿಸಲು, <xliff:g id="button" example="End practice">%1$s</xliff:g> ಸಕ್ರಿಯಗೊಳಿಸಿ.</string>
    <string name="sandfly_tutorial_practice_title">ಜೆಸ್ಚರ್ ಅಭ್ಯಾಸ</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="count" example="4">%2$d</xliff:g> ರಲ್ಲಿ <xliff:g id="done" example="2">%1$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">ಓದುವಿಕೆ ನಿಯಂತ್ರಣವನ್ನು <xliff:g id="reading_control" example="Characters">%2$s</xliff:g> ಗೆ ಬದಲಾಯಿಸಿ. ಒಂದು ಅಕ್ಷರ ಚಲಿಸಲು <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_intro">ಮೇಲೆ ಮತ್ತು ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿದರೆ ಏನಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ಓದುವಿಕೆ ನಿಯಂತ್ರಣಗಳು ಆಯ್ಕೆಮಾಡುತ್ತವೆ, ಉದಾಹರಣೆಗೆ ಪದ ಅಥವಾ ಅಕ್ಷರದ ಮೂಲಕ ಚಲಿಸುವುದು, ಅಥವಾ ಮಾತಿನ ವೇಗ ಬದಲಾಯಿಸುವುದು. ಬಲಕ್ಕೆ ಮತ್ತು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿದರೆ ಈಗಲೂ ಐಟಂಗಳ ನಡುವೆ ಚಲಿಸುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_reading_controls_move">ಕೆಳಗಿನ ವಾಕ್ಯಕ್ಕೆ ಹೋಗಿ.</string>
    <string name="sandfly_tutorial_reading_controls_next_word">ಮುಂದಿನ ಪದಕ್ಕೆ ಹೋಗಲು <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>. ಮೂರು ಪದಗಳು ಚಲಿಸಿ.</string>
    <string name="sandfly_tutorial_reading_controls_title">ಓದುವಿಕೆ ನಿಯಂತ್ರಣಗಳು</string>
    <string name="sandfly_tutorial_recipe_1">ಪ್ಯಾನ್‌ಕೇಕ್‌ಗಳು: ಹಿಟ್ಟು, ಮೊಟ್ಟೆ ಮತ್ತು ಹಾಲನ್ನು ಬೆರೆಸಿ ನಯವಾದ ಮಿಶ್ರಣ ಮಾಡಿ.</string>
    <string name="sandfly_tutorial_recipe_2">ಬಾಣಲೆಯಲ್ಲಿ ಸ್ವಲ್ಪ ಬೆಣ್ಣೆ ಬಿಸಿ ಮಾಡಿ.</string>
    <string name="sandfly_tutorial_recipe_3">ಬಾಣಲೆಯನ್ನು ತೆಳುವಾಗಿ ಆವರಿಸುವಷ್ಟು ಮಿಶ್ರಣ ಸುರಿಯಿರಿ.</string>
    <string name="sandfly_tutorial_recipe_4">ಕೆಳಭಾಗ ಹೊಂಬಣ್ಣಕ್ಕೆ ಬಂದಾಗ ಪ್ಯಾನ್‌ಕೇಕ್ ತಿರುಗಿಸಿ.</string>
    <string name="sandfly_tutorial_recipe_5">ನಿಂಬೆ ಮತ್ತು ಸಕ್ಕರೆಯೊಂದಿಗೆ ಬಡಿಸಿ.</string>
    <string name="sandfly_tutorial_scrolling_intro">ಪಟ್ಟಿಗಳು ಒಮ್ಮೆಗೆ ತಮ್ಮ ಕೆಲವು ಐಟಂಗಳನ್ನು ಮಾತ್ರ ತೋರಿಸುತ್ತವೆ. ತೋರಿಸಿದ ಕೊನೆಯ ಐಟಂ ದಾಟಿ ಸ್ವೈಪ್ ಮಾಡಿದರೆ ಪಟ್ಟಿ ಸ್ಕ್ರೋಲ್ ಆಗುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_scrolling_page">ಒಂದು ಪುಟ ಮುಂದಕ್ಕೆ ಸ್ಕ್ರೋಲ್ ಮಾಡಲು <xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="item" example="Item 15">%2$s</xliff:g> ತಲುಪುವವರೆಗೆ ಪಟ್ಟಿಯಲ್ಲಿ <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">ಪಟ್ಟಿಗಳನ್ನು ಸ್ಕ್ರೋಲ್ ಮಾಡುವುದು</string>
    <string name="sandfly_tutorial_sentence">ಚುರುಕಾದ ಕಂದು ನರಿ ಸೋಮಾರಿ ನಾಯಿಯ ಮೇಲೆ ಜಿಗಿಯುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_skip_step">ಹಂತ ಸ್ಕಿಪ್ ಮಾಡಿ</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> ಸ್ಲೈಡರ್‌ಗೆ ಹೋಗಿ. ಅದರ ಮೌಲ್ಯ ಬದಲಾಯಿಸಲು <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ಅಥವಾ <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> ಅನ್ನು ಅದರ ಗರಿಷ್ಠ ಮೌಲ್ಯವಾದ 100 ಪ್ರತಿಶತಕ್ಕೆ ಹೊಂದಿಸಿ.</string>
    <string name="sandfly_tutorial_sliders_intro">ಸ್ಲೈಡರ್ ಮೇಲೆ ಫೋಕಸ್ ಇರುವಾಗ, ಮೇಲೆ ಮತ್ತು ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿದರೆ ಅದರ ಮೌಲ್ಯ ಬದಲಾಗುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_sliders_title">ಸ್ಲೈಡರ್‌ಗಳು</string>
    <string name="sandfly_tutorial_step">ಹಂತ <xliff:g id="count" example="2">%2$d</xliff:g> ರಲ್ಲಿ <xliff:g id="number" example="1">%1$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">ಮರಳು ನೊಣಗಳು ಸಮುದ್ರ ತೀರಗಳಲ್ಲಿ, ನದಿ ದಡಗಳಲ್ಲಿ ಮತ್ತು ಕಾಡುಗಳಲ್ಲಿ ವಾಸಿಸುವ ಸಣ್ಣ ನೊಣಗಳು. ಗಾಳಿ ಸ್ತಬ್ಧವಾಗಿರುವ ಮುಂಜಾನೆ ಮತ್ತು ಮುಸ್ಸಂಜೆಯಲ್ಲಿ ಅವು ಹೆಚ್ಚು ಚುರುಕಾಗಿರುತ್ತವೆ. ಹೆಣ್ಣು ನೊಣಗಳು ಮಾತ್ರ ಕಚ್ಚುತ್ತವೆ, ಏಕೆಂದರೆ ಮೊಟ್ಟೆಗಳನ್ನು ಉತ್ಪಾದಿಸಲು ಅವುಗಳಿಗೆ ರಕ್ತ ಬೇಕು. ಕಡಿತಗಳು ದಿನಗಟ್ಟಲೆ ತುರಿಸುತ್ತವೆ, ಆದ್ದರಿಂದ ಮರಳು ನೊಣಗಳ ಪ್ರದೇಶಕ್ಕೆ ಹೋಗುವವರು ಕೀಟ ನಿವಾರಕ ಒಯ್ಯುತ್ತಾರೆ. ಮರಳು ನೊಣಗಳು ದುರ್ಬಲವಾಗಿ ಹಾರುತ್ತವೆ, ಮತ್ತು ಲಘು ಗಾಳಿ ಕೂಡ ಅವುಗಳನ್ನು ದೂರವಿಡುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_system_back">ಹಿಂದಕ್ಕೆ ಹೋಗಲು <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_home">ಮುಖಪುಟ ಸ್ಕ್ರೀನ್‌ಗೆ ಹೋಗಲು <xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_intro">ಈ ಜೆಸ್ಚರ್‌ಗಳು ಪ್ರತಿ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತವೆ. ಈ ಪಾಠದಲ್ಲಿ, ಪ್ರತಿಯೊಂದನ್ನು ಮಾಡುವ ಬದಲು ಅದು ಏನು ಮಾಡುತ್ತದೆ ಎಂದು ಟ್ಯುಟೋರಿಯಲ್ ಹೇಳುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_system_notifications">ಅಧಿಸೂಚನೆಗಳನ್ನು ತೆರೆಯಲು <xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_overview">ಇತ್ತೀಚಿನ ಆ್ಯಪ್‌ಗಳನ್ನು ತೋರಿಸಲು <xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_system_title">ಹಿಂದಕ್ಕೆ, ಮುಖಪುಟ ಮತ್ತು ಅಧಿಸೂಚನೆಗಳು</string>
