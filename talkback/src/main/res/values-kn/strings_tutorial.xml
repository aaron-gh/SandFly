    <string name="sandfly_tutorial_actions_archive">ಸಂದೇಶಕ್ಕೆ ಹೋಗಿ. ಅದರ ಕ್ರಿಯೆಗಳ ನಡುವೆ ಹೋಗಲು <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ಅಥವಾ <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>. ನೀವು ಕೇಳಿದ ಕ್ರಿಯೆಯನ್ನು ಮಾಡಲು <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>. <xliff:g id="action" example="Archive">%4$s</xliff:g> ಮಾಡಿ.</string>
    <string name="sandfly_tutorial_actions_intro">ಕೆಲವು ಐಟಂಗಳು ಸಕ್ರಿಯಗೊಳಿಸುವುದರ ಜೊತೆಗೆ ಇತರ ಕ್ರಿಯೆಗಳನ್ನು ಹೊಂದಿರುತ್ತವೆ, ಉದಾಹರಣೆಗೆ ಸಂದೇಶಕ್ಕೆ ಆರ್ಕೈವ್ ಅಥವಾ ಅಳಿಸಿ. ಅಂತಹ ಐಟಂ ಮೇಲೆ ಫೋಕಸ್ ಇರುವಾಗ, “ಕ್ರಿಯೆಗಳು” ಓದುವಿಕೆ ನಿಯಂತ್ರಣ ಅವುಗಳ ನಡುವೆ ಹೋಗುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_actions_title">ಕ್ರಿಯೆಗಳು</string>
    <string name="sandfly_tutorial_activate_button"><xliff:g id="button" example="Ring the bell">%2$s</xliff:g> ಗೆ ಹೋಗಿ. ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_check_box">ಅದೇ ರೀತಿಯಲ್ಲಿ <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> ಅನ್ನು ಗುರುತು ಮಾಡಿ.</string>
    <string name="sandfly_tutorial_activate_hold">ಕೆಲವು ಐಟಂಗಳನ್ನು ಹಿಡಿದಾಗ ಬೇರೆ ಏನನ್ನಾದರೂ ಮಾಡುತ್ತವೆ. <xliff:g id="button" example="Details">%2$s</xliff:g> ಗೆ ಹೋಗಿ. ಅದನ್ನು ಹಿಡಿಯಲು <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_intro">ನೀವು ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಎಲ್ಲಿ ಟ್ಯಾಪ್ ಮಾಡಿದರೂ, ಸಕ್ರಿಯಗೊಳಿಸುವಿಕೆ ಫೋಕಸ್ ಇರುವ ಐಟಂ ಮೇಲೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_activate_title">ಐಟಂಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವುದು</string>
    <string name="sandfly_tutorial_back_in_lesson">ಹಿಂದಕ್ಕೆ ಪಾಠದಿಂದ ಹೊರಗೆ ಕರೆದೊಯ್ಯುವುದಿಲ್ಲ. ಬೇರೆ ಪಾಠ ಆಯ್ಕೆಮಾಡಲು, “ಪರಿವಿಡಿ” ಬಳಸಿ.</string>
