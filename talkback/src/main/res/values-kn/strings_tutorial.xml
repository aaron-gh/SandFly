    <string name="sandfly_tutorial_commands_copy">SandFly ಕೊನೆಯದಾಗಿ ಹೇಳಿದ ಪಠ್ಯವನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ಕಾಪಿ ಮಾಡಲು <xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_commands_intro">ಈ ಆಜ್ಞೆಗಳು ಪ್ರತಿ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತವೆ.</string>
    <string name="sandfly_tutorial_commands_search">ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಪಠ್ಯವನ್ನು ಹುಡುಕಲು <xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>. ಈ ಪಾಠದಲ್ಲಿ, ಬದಲಿಗೆ ಅದು ಏನು ಮಾಡುತ್ತದೆ ಎಂದು ಟ್ಯುಟೋರಿಯಲ್ ಹೇಳುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_commands_speech_off">ಮಾತನ್ನು ಆಫ್ ಮಾಡಲು <xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>, ಮತ್ತು ಆನ್ ಮಾಡಲು ಮತ್ತೊಮ್ಮೆ. ಈ ಪಾಠದಲ್ಲಿ, ಬದಲಿಗೆ ಅದು ಏನು ಮಾಡುತ್ತದೆ ಎಂದು ಟ್ಯುಟೋರಿಯಲ್ ಹೇಳುತ್ತದೆ.</string>
    <string name="sandfly_tutorial_commands_status">ಸಮಯ, ಬ್ಯಾಟರಿ ಮಟ್ಟ ಮತ್ತು ಇತರ ಸ್ಥಿತಿಯನ್ನು ಕೇಳಲು <xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>.</string>
