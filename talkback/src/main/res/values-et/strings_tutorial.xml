    <string name="sandfly_tutorial_menu_intro">SandFlyi menüüs on käsud fookuses oleva üksuse ja praeguse kuva jaoks.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g>: avage SandFlyi menüü. Pühkige läbi selle käskude. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> sulgeb menüü.</string>
