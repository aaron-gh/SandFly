    <string name="sandfly_tutorial_message_reply">Vasta</string>
    <string name="sandfly_tutorial_move_intro">Pühkimine liigub ekraanil järgmisele või eelmisele üksusele lugemisjärjekorras.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: liikuge järgmisele üksusele. Jätkake, kuni jõuate üksuseni <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g>: liikuge eelmisele üksusele. Minge tagasi üksusele <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Üksuste vahel liikumine</string>
    <string name="sandfly_tutorial_name">Nimi</string>
    <string name="sandfly_tutorial_next_lesson">Järgmine õppetund: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture">Toimingul <xliff:g id="action" example="Next item">%1$s</xliff:g> pole liigutust. Määrake see jaotises Käsud või kasutage valikut Jäta samm vahele.</string>
    <string name="sandfly_tutorial_not_in_lesson">Toimingut <xliff:g id="action" example="Home">%1$s</xliff:g> õppetunnis ei tehta. Õpetusest lahkumiseks kasutage jaotises Sisukord valikut Sulge õpetus.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">Toimingut <xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> õppetunnis ei tehta.</string>
    <string name="sandfly_tutorial_pause_intro">Kõne saab üksuse keskel peatada ja jätkata sealt, kus see pooleli jäi.</string>
    <string name="sandfly_tutorial_pause_pause">Liikuge allolevale loole. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> selle lugemise ajal: peatage kõne, uuesti tehes jätkake.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> uuesti: jätkake kõnet.</string>
    <string name="sandfly_tutorial_pause_title">Kõne peatamine</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Iga liigutus ütleb toimingu tegemise asemel oma nime ja toimingu. Järgmisele ja eelmisele üksusele liikumine ning aktiveerimine töötavad endiselt.</string>
    <string name="sandfly_tutorial_practice_step">Tehke mis tahes liigutus, et kuulda, mida see teeb. Lõpetamiseks aktiveerige <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Liigutuste harjutamine</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Muutke lugemise juhtelemendiks <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: liikuge ühe tähemärgi võrra.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Lugemise juhtelemendid määravad, mida üles ja alla pühkimine teeb, näiteks sõna või tähemärgi kaupa liikumine või kõne kiiruse muutmine. Paremale ja vasakule pühkimine liigub endiselt üksuste vahel.</string>
    <string name="sandfly_tutorial_reading_controls_move">Liikuge allolevale lausele.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: liikuge järgmisele sõnale. Liikuge kolm sõna edasi.</string>
    <string name="sandfly_tutorial_reading_controls_title">Lugemise juhtelemendid</string>
    <string name="sandfly_tutorial_recipe_1">Pannkoogid: segage jahu, munad ja piim ühtlaseks taignaks.</string>
    <string name="sandfly_tutorial_recipe_2">Kuumutage pannil veidi võid.</string>
    <string name="sandfly_tutorial_recipe_3">Valage pannile nii palju tainast, et põhi oleks õhukeselt kaetud.</string>
    <string name="sandfly_tutorial_recipe_4">Pöörake pannkook ümber, kui alumine pool on kuldne.</string>
    <string name="sandfly_tutorial_recipe_5">Serveerige sidruni ja suhkruga.</string>
    <string name="sandfly_tutorial_scrolling_intro">Loendid näitavad korraga ainult osa oma üksustest. Viimasest kuvatud üksusest edasi pühkimine kerib loendit.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>: kerige lehe võrra edasi.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: liikuge loendis, kuni jõuate üksuseni <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Loendite kerimine</string>
    <string name="sandfly_tutorial_sentence">Põdur Zagros jõi õllevaadis šampust ja küüslauku.</string>
    <string name="sandfly_tutorial_skip_step">Jäta samm vahele</string>
    <string name="sandfly_tutorial_sliders_change">Liikuge liugurile <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> või <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: muutke selle väärtust.</string>
    <string name="sandfly_tutorial_sliders_highest">Seadke <xliff:g id="slider" example="Brightness">%1$s</xliff:g> väärtusele 100 protsenti, mis on selle suurim väärtus.</string>
    <string name="sandfly_tutorial_sliders_intro">Kui liugur on fookuses, muudab üles ja alla pühkimine selle väärtust.</string>
    <string name="sandfly_tutorial_sliders_title">Liugurid</string>
    <string name="sandfly_tutorial_step">Samm <xliff:g id="number" example="1">%1$d</xliff:g>/<xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Liivakärbsed on väikesed kärbsed, kes elavad randadel, jõekallastel ja metsades. Kõige aktiivsemad on nad koidikul ja hämaras, kui õhk on vaikne. Hammustavad ainult emased, sest nad vajavad munade tootmiseks verd. Hammustused sügelevad päevi, seega kannavad liivakärbeste aladele minejad kaasas putukatõrjevahendit. Liivakärbsed on nõrgad lendajad ja isegi kerge tuul hoiab nad eemal.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>: minge tagasi.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>: minge avakuvale.</string>
    <string name="sandfly_tutorial_system_intro">Need liigutused töötavad igal kuval. Selles õppetunnis ütleb õpetus iga liigutuse toimingu selle tegemise asemel.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>: avage märguanded.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>: kuvage hiljutised rakendused.</string>
    <string name="sandfly_tutorial_system_title">Tagasi, avakuva ja märguanded</string>
