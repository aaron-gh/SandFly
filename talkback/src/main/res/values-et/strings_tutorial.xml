<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Liikuge sõnumile. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> või <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: liikuge läbi selle toimingute. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>: tehke kuuldud toiming. Tehke toiming <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Mõnel üksusel on peale aktiveerimise ka muid toiminguid, näiteks sõnumil Arhiivi või Kustuta. Kui selline üksus on fookuses, liigub lugemise juhtelement Toimingud nende vahel.</string>
    <string name="sandfly_tutorial_actions_title">Toimingud</string>
    <string name="sandfly_tutorial_activate_button">Liikuge üksusele <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: aktiveerige see.</string>
    <string name="sandfly_tutorial_activate_check_box">Märkige samal viisil <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_hold">Mõni üksus teeb hoidmisel midagi muud. Liikuge üksusele <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>: hoidke seda.</string>
    <string name="sandfly_tutorial_activate_intro">Aktiveerimine toimib fookuses oleval üksusel, ükskõik kus ekraani puudutate.</string>
    <string name="sandfly_tutorial_activate_title">Üksuste aktiveerimine</string>
    <string name="sandfly_tutorial_back_in_lesson">Tagasi ei lahku õppetunnist. Muu õppetunni valimiseks kasutage valikut Sisukord.</string>
