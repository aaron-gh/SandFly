    <string name="sandfly_tutorial_typing_delete">Kustutage viimane täht klaviatuuri kustutusklahviga.</string>
    <string name="sandfly_tutorial_typing_intro">Tekstivälja aktiveerimine avab klaviatuuri. Puudutage klahvi, et seda kuulda, ja tõstke sõrm, et see sisestada.</string>
    <string name="sandfly_tutorial_typing_open">Liikuge väljale <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: alustage sisestamist.</string>
