    <string name="sandfly_tutorial_typing_type">Sisestage sõna <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">kass</string>
    <string name="sandfly_tutorial_welcome_intro">See õpetus õpetab SandFlyi liigutusi. Iga õppetund annab juhise, ootab, kuni olete selle oma liigutustega teinud, ja annab siis järgmise. Juhis on esimene üksus pärast õppetunni nime. Sisukord loetleb kõik õppetunnid ja õpetus avaneb uuesti õppetunnis, kus pooleli jäite.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> ükskõik kus ekraanil: alustage.</string>
    <string name="sandfly_tutorial_welcome_title">Tere tulemast</string>
