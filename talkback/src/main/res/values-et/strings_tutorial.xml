    <string name="sandfly_tutorial_commands_intro">Need käsud töötavad igal kuval.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g>: otsige ekraanilt teksti. Selles õppetunnis ütleb õpetus selle asemel, mida käsk teeb.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g>: lülitage kõne välja, uuesti tehes sisse. Selles õppetunnis ütleb õpetus selle asemel, mida käsk teeb.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g>: kuulake kellaaega, aku taset ja muud olekut.</string>
