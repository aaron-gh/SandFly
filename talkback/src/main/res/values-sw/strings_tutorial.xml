    <string name="sandfly_tutorial_move_intro">Kutelezesha kidole husogeza hadi kipengee kinachofuata au kilichotangulia kwenye skrini, kwa mpangilio wa kusoma.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> ili uende kwenye kipengee kinachofuata. Endelea hadi ufike <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> ili uende kwenye kipengee kilichotangulia. Rudi kwenye <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
