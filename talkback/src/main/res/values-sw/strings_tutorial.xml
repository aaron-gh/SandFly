    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> ili utafute maandishi kwenye skrini. Katika somo hili, mafunzo hutamka kile ambacho amri hufanya badala yake.</string>
