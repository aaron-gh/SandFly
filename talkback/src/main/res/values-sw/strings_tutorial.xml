    <string name="sandfly_tutorial_typing_word">paka</string>
    <string name="sandfly_tutorial_welcome_intro">Mafunzo haya hufundisha ishara za SandFly. Kila somo hutoa maagizo, husubiri hadi uyatekeleze kwa ishara zako mwenyewe, kisha hutoa maagizo yanayofuata. Maagizo ni kipengee cha kwanza baada ya jina la somo. Yaliyomo huorodhesha kila somo, na mafunzo hufunguka tena kwenye somo ulilokuwa ukifanya.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> popote kwenye skrini ili uanze.</string>
