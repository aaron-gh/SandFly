    <string name="sandfly_tutorial_actions_archive">Nenda kwenye ujumbe. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> au <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> ili upitie vitendo vyake. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> ili utekeleze kitendo unachosikia. Tekeleza <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Baadhi ya vipengee vina vitendo zaidi ya kuwasha, kama vile Weka kwenye kumbukumbu au Futa kwa ujumbe. Kipengee kama hicho kikiwa kimeangaziwa, kidhibiti cha kusoma cha Vitendo hupitia vitendo hivyo.</string>
    <string name="sandfly_tutorial_actions_title">Vitendo</string>
    <string name="sandfly_tutorial_activate_button">Nenda kwenye <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> ili ukiwashe.</string>
    <string name="sandfly_tutorial_activate_check_box">Teua <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> kwa njia hiyo hiyo.</string>
    <string name="sandfly_tutorial_activate_hold">Baadhi ya vipengee hufanya kitu kingine vikishikiliwa. Nenda kwenye <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> ili ukishikilie.</string>
    <string name="sandfly_tutorial_activate_intro">Kuwasha hufanya kazi kwenye kipengee kilichoangaziwa, popote unapogusa skrini.</string>
    <string name="sandfly_tutorial_activate_title">Kuwasha vipengee</string>
    <string name="sandfly_tutorial_back_in_lesson">Nyuma haitoki kwenye somo. Ili uchague somo lingine, tumia Yaliyomo.</string>
