    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> ili uende kwenye Skrini ya kwanza.</string>
    <string name="sandfly_tutorial_system_intro">Ishara hizi hufanya kazi kwenye kila skrini. Katika somo hili, mafunzo hutamka kile ambacho kila ishara hufanya badala ya kuitekeleza.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> ili ufungue arifa.</string>
