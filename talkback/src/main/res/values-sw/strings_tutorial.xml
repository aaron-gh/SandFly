    <string name="sandfly_tutorial_title">Mafunzo ya SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Futa herufi ya mwisho kwa kitufe cha Futa cha kibodi.</string>
    <string name="sandfly_tutorial_typing_intro">Kuwasha sehemu ya maandishi hufungua kibodi. Gusa kitufe ili ukisikie, kisha uinue kidole chako ili ukiandike.</string>
    <string name="sandfly_tutorial_typing_open">Nenda kwenye sehemu ya <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> ili uanze kuandika.</string>
