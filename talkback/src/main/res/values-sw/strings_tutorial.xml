    <string name="sandfly_tutorial_pause_intro">Matamshi yanaweza kusitishwa katikati ya kipengee, na kuendelezwa pale yaliposimama.</string>
    <string name="sandfly_tutorial_pause_pause">Nenda kwenye hadithi iliyo hapa chini. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> inaposomwa ili usitishe matamshi, na tena ili uendelee.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> tena ili uendelee na matamshi.</string>
    <string name="sandfly_tutorial_pause_title">Kusitisha matamshi</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Kila ishara hutamka jina na kitendo chake badala ya kukitekeleza. Kusogea hadi kipengee kinachofuata na kilichotangulia na kuwasha bado hufanya kazi.</string>
    <string name="sandfly_tutorial_practice_step">Fanya ishara yoyote ili usikie inachofanya. Ili usimamishe, washa <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Mazoezi ya ishara</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> kati ya <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Badilisha kidhibiti cha kusoma kiwe <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> ili usogee herufi moja.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Vidhibiti vya kusoma huchagua kile ambacho kutelezesha kidole juu na chini hufanya, kama vile kusogea kwa neno au kwa herufi, au kubadilisha kasi ya kutamka. Kutelezesha kidole kulia na kushoto bado husogeza kati ya vipengee.</string>
    <string name="sandfly_tutorial_reading_controls_move">Nenda kwenye sentensi iliyo hapa chini.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> ili uende kwenye neno linalofuata. Sogea maneno matatu.</string>
    <string name="sandfly_tutorial_reading_controls_title">Vidhibiti vya kusoma</string>
    <string name="sandfly_tutorial_recipe_1">Pankeki: changanya unga, mayai na maziwa kuwa mchanganyiko laini.</string>
    <string name="sandfly_tutorial_recipe_2">Pasha moto siagi kidogo kwenye kikaango.</string>
    <string name="sandfly_tutorial_recipe_3">Mimina mchanganyiko wa kutosha kufunika kikaango kwa safu nyembamba.</string>
    <string name="sandfly_tutorial_recipe_4">Geuza pankeki upande wa chini ukiwa wa rangi ya dhahabu.</string>
    <string name="sandfly_tutorial_recipe_5">Pakua pamoja na limau na sukari.</string>
    <string name="sandfly_tutorial_scrolling_intro">Orodha huonyesha baadhi tu ya vipengee vyake kwa wakati mmoja. Kutelezesha kidole kupita kipengee cha mwisho kinachoonyeshwa husogeza orodha.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> ili usogeze mbele ukurasa mmoja.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> kwenye orodha hadi ufike <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Kusogeza orodha</string>
    <string name="sandfly_tutorial_sentence">Mbweha mwepesi wa kahawia anamruka mbwa mvivu.</string>
    <string name="sandfly_tutorial_skip_step">Ruka hatua</string>
    <string name="sandfly_tutorial_sliders_change">Nenda kwenye kitelezi cha <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> au <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> ili ubadilishe thamani yake.</string>
    <string name="sandfly_tutorial_sliders_highest">Weka <xliff:g id="slider" example="Brightness">%1$s</xliff:g> kiwe asilimia 100, thamani yake ya juu zaidi.</string>
    <string name="sandfly_tutorial_sliders_intro">Kitelezi kikiwa kimeangaziwa, kutelezesha kidole juu na chini hubadilisha thamani yake.</string>
    <string name="sandfly_tutorial_sliders_title">Vitelezi</string>
    <string name="sandfly_tutorial_step">Hatua ya <xliff:g id="number" example="1">%1$d</xliff:g> kati ya <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Inzi wa mchanga ni inzi wadogo wanaoishi kwenye fuo, kwenye kingo za mito na misituni. Huwa na shughuli nyingi zaidi alfajiri na jioni, wakati hewa imetulia. Majike pekee ndio huuma, kwa sababu yanahitaji damu ili kutaga mayai. Kuumwa huwasha kwa siku kadhaa, kwa hiyo watu wanaotembelea maeneo ya inzi wa mchanga hubeba dawa ya kufukuza wadudu. Inzi wa mchanga ni dhaifu katika kuruka, na hata upepo mwanana huwaweka mbali.</string>
