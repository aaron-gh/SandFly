<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">Sauti na mitetemo ya vidhibiti</string>
    <string name="summary_pref_control_sounds">Kila aina ya kidhibiti, kama vile vitufe, visanduku vya kuteua, sehemu za kuhariri na vipengee vya orodha, hupata sauti na mtetemo wake kutoka kwenye mandhari badala ya sauti na mtetemo wa kulenga, kama Unspoken inavyofanya kwa NVDA. Sauti hutoka mahali kidhibiti kilipo kwenye skrini, na SandFly haitamki aina ya kidhibiti.</string>
    <string name="title_pref_control_sounds_speak_roles">Bado taja aina ya kidhibiti</string>
    <string name="summary_pref_control_sounds_speak_roles">Sauti ya kidhibiti inapocheza, aina ya kidhibiti bado hutamkwa, kama kitufe. Inatumika kwa mandhari yote ya sauti.</string>
    <string name="title_pref_control_sounds_3d">Sauti ya 3D</string>
    <string name="pref_control_sounds_3d_headphones">Na vipokea sauti vya kichwani</string>
