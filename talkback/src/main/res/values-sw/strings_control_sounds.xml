<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="title_pref_control_sounds">Dhibiti sauti na mitetemo</string>
    <string name="summary_pref_control_sounds">Ipe kila aina ya udhibiti, kama vile vitufe, visanduku vya kuteua, sehemu za kuhariri na vipengee vya kuorodhesha, sauti yake yenyewe na mtetemo wake kutoka kwa mandhari, badala ya sauti inayolenga na mtetemo, kama vile Haijatamkwa inavyofanya kwa NVDA. Sauti hutoka mahali kidhibiti kiko kwenye skrini, na SandFly huacha kusema ni aina gani ya udhibiti.</string>
    <string name="title_pref_control_sounds_speak_roles">Bado sema aina ya udhibiti</string>
    <string name="summary_pref_control_sounds_speak_roles">Wakati sauti ya kudhibiti inapocheza, bado sema ni aina gani ya udhibiti, kama vile kitufe. Hii ni kwa kila mada ya sauti.</string>
    <string name="title_pref_control_sounds_3d">Sauti ya 3D</string>
    <string name="pref_control_sounds_3d_headphones">Na vipokea sauti vya kichwani</string>
