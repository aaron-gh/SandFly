    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">Elekeza kamera ya nyuma kwenye kitu unachotaka kifafanuliwe. Kwa Onyesha na usome, onyesha maandishi kwenye picha ya kamera kwa kidole. Maelezo yanaweza kuwa si sahihi. Usiyategemee ili kutembea kwa usalama.</string>
    <string name="live_recognition_camera_off">Kamera imezimwa</string>
    <string name="live_recognition_camera_on">Kamera imewashwa</string>
    <string name="live_recognition_connecting">Inaunganisha kwenye Gemini…</string>
    <string name="live_recognition_cloud_title">Ungependa kutuma picha za kamera kwenye Gemini?</string>
    <string name="live_recognition_cloud_message">Mandhari, Onyesha na usome, Kutambua watu na Kutambua milango hutuma picha kutoka kwenye kamera kwenda Gemini API ya Google kila baada ya sekunde chache. Maandishi hutambuliwa kwenye simu hii.\n\nUkitumia ufunguo wa API usiolipiwa, Google inaweza kuhifadhi inachopokea, kukitumia kuboresha bidhaa zake na kuwaruhusu watu wakikague. AI zalishi bado ni ya majaribio, kwa hivyo itakosea.</string>
    <string name="live_recognition_service_title">Ungependa kutuma picha za kamera kwenye <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">Mandhari, Onyesha na usome, Kutambua watu na Kutambua milango hutuma picha kutoka kwenye kamera kwenda <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> kila baada ya sekunde chache. Maandishi hutambuliwa kwenye simu hii.\n\nMasharti na sera ya faragha ya huduma hiyo yanatumika. AI zalishi bado ni ya majaribio, kwa hivyo itakosea.</string>
