    <string name="title_pref_control_sounds">Kontroller lyder og vibrasjoner</string>
    <string name="summary_pref_control_sounds">Gi hver type kontroll, for eksempel knapper, avmerkingsbokser, redigeringsfelt og listeelementer, sin egen lyd og sin egen vibrasjon fra temaet, i stedet for fokuslyden og vibrasjonen, slik Unspoken gjør for NVDA. Lyden kommer fra der kontrollen er på skjermen, og SandFly utelater å si hva slags kontroll det er.</string>
    <string name="title_pref_control_sounds_speak_roles">Fortsatt si hva slags kontroll</string>
    <string name="summary_pref_control_sounds_speak_roles">Når en kontrolllyd spilles av, si fortsatt hva slags kontroll det er, for eksempel knapp. Dette er for hvert lydtema.</string>
