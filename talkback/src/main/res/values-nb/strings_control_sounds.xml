    <string name="title_pref_control_sounds">Lyder og vibrasjoner for kontroller</string>
    <string name="summary_pref_control_sounds">Hver type kontroll, for eksempel knapper, avmerkingsbokser, redigeringsfelt og listeelementer, får sin egen lyd og vibrasjon fra temaet i stedet for fokuslyden og fokusvibrasjonen, slik Unspoken gjør for NVDA. Lyden kommer fra kontrollens plassering på skjermen, og SandFly sier ikke hva slags kontroll det er.</string>
    <string name="title_pref_control_sounds_speak_roles">Si likevel typen kontroll</string>
    <string name="summary_pref_control_sounds_speak_roles">Når en kontrollyd spilles av, sies kontrolltypen likevel, for eksempel knapp. Gjelder alle lydtemaer.</string>
