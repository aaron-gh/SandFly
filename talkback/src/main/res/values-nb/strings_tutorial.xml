<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Gå til meldingen. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> for å gå gjennom handlingene. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> for å utføre handlingen du hører. Utfør <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Noen elementer har handlinger i tillegg til aktivering, for eksempel Arkiver eller Slett for en melding. Når et slikt element er uthevet, går lesekontrollen Handlinger gjennom dem.</string>
    <string name="sandfly_tutorial_actions_title">Handlinger</string>
    <string name="sandfly_tutorial_activate_button">Gå til <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> for å aktivere det.</string>
    <string name="sandfly_tutorial_activate_check_box">Merk av for <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> på samme måte.</string>
    <string name="sandfly_tutorial_activate_hold">Noen elementer gjør noe annet når de holdes. Gå til <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> for å holde det.</string>
    <string name="sandfly_tutorial_activate_intro">Aktivering virker på det uthevede elementet, uansett hvor du trykker på skjermen.</string>
    <string name="sandfly_tutorial_activate_title">Aktivere elementer</string>
    <string name="sandfly_tutorial_back_in_lesson">Tilbake avslutter ikke en leksjon. For å velge en annen leksjon bruker du Innhold.</string>
    <string name="sandfly_tutorial_bell">Ring med bjella</string>
    <string name="sandfly_tutorial_bell_rung">Antall ganger ringt: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Lysstyrke</string>
    <string name="sandfly_tutorial_chapter_basics">Grunnleggende</string>
    <string name="sandfly_tutorial_chapter_controls">Kontroller og tekst</string>
    <string name="sandfly_tutorial_chapter_getting_around">Navigering</string>
    <string name="sandfly_tutorial_chapter_practice">Øving</string>
    <string name="sandfly_tutorial_chapter_reading">Lesing</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> for å bytte lesekontroll. Velg <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Lukk veiledningen</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> for å kopiere den siste teksten SandFly sa, til utklippstavlen.</string>
    <string name="sandfly_tutorial_commands_intro">Disse kommandoene fungerer på alle skjermer.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> for å søke etter tekst på skjermen. I denne leksjonen sier veiledningen hva bevegelsen gjør, i stedet.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> for å slå av talen, og igjen for å slå den på. I denne leksjonen sier veiledningen hva bevegelsen gjør, i stedet.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> for å høre klokkeslettet, batterinivået og annen status.</string>
    <string name="sandfly_tutorial_commands_title">Nyttige kommandoer</string>
    <string name="sandfly_tutorial_contents">Innhold</string>
    <string name="sandfly_tutorial_contents_intro">Leksjonene i rekkefølge. Hver av dem kan åpnes for seg.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly kan lese fra det uthevede elementet til slutten av skjermen uten sveiping. Berøring av skjermen stopper lesingen.</string>
    <string name="sandfly_tutorial_continuous_move">Gå til den første linjen i oppskriften.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> for å lese fra det uthevede elementet.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> for å åpne SandFly-menyen, og velg deretter <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_title">Kontinuerlig lesing</string>
