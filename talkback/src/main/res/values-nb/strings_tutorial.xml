    <string name="sandfly_tutorial_end_practice">Avslutt øving</string>
    <string name="sandfly_tutorial_explore_activate">Berør Stjerne og løft fingeren. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> hvor som helst for å aktivere den.</string>
    <string name="sandfly_tutorial_explore_find">Før én finger rundt på skjermen og finn de fire rutene: Sol, Måne, Stjerne og Sky.</string>
    <string name="sandfly_tutorial_explore_intro">Når du berører skjermen, leses elementet under fingeren opp. Berøring av et element aktiverer det ikke.</string>
    <string name="sandfly_tutorial_explore_title">Berøringsutforskning</string>
    <string name="sandfly_tutorial_extra_cheese">Ekstra ost</string>
    <string name="sandfly_tutorial_finish">Fullfør veiledningen</string>
    <string name="sandfly_tutorial_forecast_today">I dag</string>
    <string name="sandfly_tutorial_forecast_today_text">Sol og varmt, med svak vind.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">I morgen</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Skyet om morgenen, regn fra midt på dagen.</string>
    <string name="sandfly_tutorial_forecast_weekend">Helgen</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Vind på lørdag, klarvær på søndag.</string>
    <string name="sandfly_tutorial_headings_intro">Skjermer og nettsider deler inn innholdet med overskrifter. Lesekontrollen Overskrifter hopper fra én overskrift til den neste.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> for å hoppe til neste overskrift. Hopp til <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_headings_title">Overskrifter</string>
