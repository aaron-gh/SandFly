    <string name="sandfly_tutorial_lesson_complete_last">Leksjonen er fullført. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> for å fullføre veiledningen.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Leksjonen er fullført. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> for å starte neste leksjon.</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, leksjon <xliff:g id="number" example="3">%2$d</xliff:g> av <xliff:g id="count" example="17">%3$d</xliff:g></string>
