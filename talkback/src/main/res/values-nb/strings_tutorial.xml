    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> for å lukke menyen.</string>
    <string name="sandfly_tutorial_menu_intro">SandFly-menyen har kommandoer for det uthevede elementet og den nåværende skjermen.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> for å åpne SandFly-menyen. Sveip gjennom kommandoene. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> lukker menyen.</string>
    <string name="sandfly_tutorial_menu_title">SandFly-meny</string>
