    <string name="sandfly_tutorial_message_archive">Arkiver</string>
    <string name="sandfly_tutorial_message_delete">Slett</string>
    <string name="sandfly_tutorial_message_reply">Svar</string>
    <string name="sandfly_tutorial_move_intro">Sveiping går til neste eller forrige element på skjermen, i leserekkefølge.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> for å gå til neste element. Fortsett til du kommer til <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> for å gå til forrige element. Gå tilbake til <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Flytte mellom elementer</string>
    <string name="sandfly_tutorial_name">Navn</string>
    <string name="sandfly_tutorial_next_lesson">Neste leksjon: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> har ingen bevegelse. Tilordne en under Kommandoer, eller bruk Hopp over trinn.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> utføres ikke i en leksjon. For å avslutte veiledningen bruker du Lukk veiledningen i Innhold.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> utføres ikke i en leksjon.</string>
    <string name="sandfly_tutorial_pause_intro">Talen kan settes på pause midt i et element og fortsette der den stoppet.</string>
    <string name="sandfly_tutorial_pause_pause">Gå til historien nedenfor. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> mens den leses for å sette talen på pause, og igjen for å fortsette.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> igjen for å fortsette talen.</string>
    <string name="sandfly_tutorial_pause_title">Sette talen på pause</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Hver bevegelse sier navnet og handlingen sin i stedet for å utføre den. Å gå til neste og forrige element og aktivering fungerer fortsatt.</string>
    <string name="sandfly_tutorial_practice_step">Utfør en hvilken som helst bevegelse for å høre hva den gjør. For å stoppe aktiverer du <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Bevegelsesøving</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> av <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Bytt lesekontroll til <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> for å flytte ett tegn.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Lesekontroller bestemmer hva sveiping opp og ned gjør, for eksempel å flytte ord for ord eller tegn for tegn, eller endre talehastigheten. Sveiping til høyre og venstre flytter fortsatt mellom elementer.</string>
    <string name="sandfly_tutorial_reading_controls_move">Gå til setningen nedenfor.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> for å gå til neste ord. Flytt tre ord.</string>
    <string name="sandfly_tutorial_reading_controls_title">Lesekontroller</string>
    <string name="sandfly_tutorial_recipe_1">Pannekaker: Rør mel, egg og melk til en jevn røre.</string>
    <string name="sandfly_tutorial_recipe_2">Varm litt smør i en stekepanne.</string>
    <string name="sandfly_tutorial_recipe_3">Hell i nok røre til å dekke pannen tynt.</string>
    <string name="sandfly_tutorial_recipe_4">Snu pannekaken når undersiden er gyllen.</string>
    <string name="sandfly_tutorial_recipe_5">Server med sitron og sukker.</string>
    <string name="sandfly_tutorial_scrolling_intro">Lister viser bare noen av elementene om gangen. Sveiping forbi det siste viste elementet ruller listen.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> for å rulle én side fremover.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> gjennom listen til du kommer til <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Rulle i lister</string>
    <string name="sandfly_tutorial_sentence">Den raske brune reven hopper over den late hunden.</string>
    <string name="sandfly_tutorial_skip_step">Hopp over trinn</string>
    <string name="sandfly_tutorial_sliders_change">Gå til glidebryteren <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> eller <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> for å endre verdien.</string>
    <string name="sandfly_tutorial_sliders_highest">Sett <xliff:g id="slider" example="Brightness">%1$s</xliff:g> til 100 prosent, den høyeste verdien.</string>
    <string name="sandfly_tutorial_sliders_intro">Når en glidebryter er uthevet, endrer sveiping opp og ned verdien.</string>
    <string name="sandfly_tutorial_sliders_title">Glidebrytere</string>
    <string name="sandfly_tutorial_step">Trinn <xliff:g id="number" example="1">%1$d</xliff:g> av <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Sandfluer er små fluer som lever på strender, langs elvebredder og i skoger. De er mest aktive ved soloppgang og solnedgang, når luften er stille. Bare hunnene stikker, fordi de trenger blod for å produsere egg. Stikkene klør i flere dager, så folk som besøker sandfluområder, har med seg insektmiddel. Sandfluer er svake flygere, og selv en svak bris holder dem borte.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> for å gå tilbake.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> for å gå til startskjermen.</string>
    <string name="sandfly_tutorial_system_intro">Disse bevegelsene fungerer på alle skjermer. I denne leksjonen sier veiledningen hva hver av dem gjør, i stedet for å gjøre det.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> for å åpne varsler.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> for å vise nylige apper.</string>
    <string name="sandfly_tutorial_system_title">Tilbake, Startskjerm og varsler</string>
    <string name="sandfly_tutorial_tile_cloud">Sky</string>
    <string name="sandfly_tutorial_tile_moon">Måne</string>
    <string name="sandfly_tutorial_tile_star">Stjerne</string>
    <string name="sandfly_tutorial_tile_sun">Sol</string>
    <string name="sandfly_tutorial_title">SandFly-veiledning</string>
    <string name="sandfly_tutorial_typing_delete">Slett den siste bokstaven med slettetasten på tastaturet.</string>
    <string name="sandfly_tutorial_typing_intro">Når du aktiverer et tekstfelt, åpnes tastaturet. Berør en tast for å høre den, og løft fingeren for å skrive den.</string>
    <string name="sandfly_tutorial_typing_open">Gå til feltet <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> for å begynne å skrive.</string>
    <string name="sandfly_tutorial_typing_title">Skriving</string>
    <string name="sandfly_tutorial_typing_type">Skriv ordet <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">katt</string>
    <string name="sandfly_tutorial_welcome_intro">Denne veiledningen lærer deg bevegelsene i SandFly. Hver leksjon gir en instruksjon, venter til du har utført den med dine egne bevegelser, og gir deretter den neste. Instruksjonen er det første elementet etter navnet på leksjonen. Innhold viser alle leksjonene, og veiledningen åpnes igjen på leksjonen du var på.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> hvor som helst på skjermen for å starte.</string>
    <string name="sandfly_tutorial_welcome_title">Velkommen</string>
</resources>
