    <string name="sandfly_tutorial_sliders_change">Lépjen a(z) <xliff:g id="slider" example="Brightness">%3$s</xliff:g> csúszkára. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> vagy <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: az érték módosítása.</string>
    <string name="sandfly_tutorial_sliders_highest">Állítsa a(z) <xliff:g id="slider" example="Brightness">%1$s</xliff:g> értékét 100 százalékra, a legnagyobb értékére.</string>
    <string name="sandfly_tutorial_sliders_intro">Ha egy csúszkán van a fókusz, a felfelé és a lefelé csúsztatás módosítja az értékét.</string>
    <string name="sandfly_tutorial_sliders_title">Csúszkák</string>
