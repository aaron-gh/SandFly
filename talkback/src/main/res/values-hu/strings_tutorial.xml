    <string name="sandfly_tutorial_actions_archive">Lépjen az üzenetre. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> vagy <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>: lépkedés a műveletei között. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>: a hallott művelet végrehajtása. Hajtsa végre ezt: <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Egyes elemeknek az aktiváláson kívül más műveleteik is vannak, például egy üzenetnél Archiválás vagy Törlés. Amíg egy ilyen elemen van a fókusz, a „Műveletek” felolvasásvezérlő végighalad rajtuk.</string>
    <string name="sandfly_tutorial_actions_title">Műveletek</string>
    <string name="sandfly_tutorial_activate_button">Lépjen ide: <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>: aktiválás.</string>
    <string name="sandfly_tutorial_activate_check_box">Jelölje be ugyanígy ezt: <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_activate_hold">Egyes elemek nyomva tartva mást csinálnak. Lépjen ide: <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g>: nyomva tartás.</string>
