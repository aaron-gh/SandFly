    <string name="sandfly_tutorial_not_in_lesson">A(z) <xliff:g id="action" example="Home">%1$s</xliff:g> nem hajtható végre leckében. Az útmutatóból a Tartalom alatti Útmutató bezárása gombbal léphet ki.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">A(z) <xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> nem hajtható végre leckében.</string>
    <string name="sandfly_tutorial_pause_intro">A beszéd egy elem közepén szüneteltethető, és onnan folytatható, ahol megállt.</string>
    <string name="sandfly_tutorial_pause_pause">Lépjen az alábbi történetre. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> a felolvasása közben: a beszéd szüneteltetése, ismét: folytatása.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> ismét: a beszéd folytatása.</string>
    <string name="sandfly_tutorial_pause_title">A beszéd szüneteltetése</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Minden kézmozdulat végrehajtás helyett kimondja a nevét és a műveletét. A következő és az előző elemre lépés és az aktiválás továbbra is működik.</string>
    <string name="sandfly_tutorial_practice_step">Végezzen bármilyen kézmozdulatot, és a SandFly kimondja, mit csinál. A befejezéshez aktiválja ezt: <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Kézmozdulat-gyakorlás</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> / <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Állítsa a felolvasásvezérlőt erre: <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: lépés egy karakterrel.</string>
    <string name="sandfly_tutorial_reading_controls_intro">A felolvasásvezérlés határozza meg, mit tesz a felfelé és a lefelé csúsztatás, például szavanként vagy karakterenként léptet, vagy módosítja a beszéd sebességét. A jobbra és a balra csúsztatás továbbra is az elemek között lép.</string>
    <string name="sandfly_tutorial_reading_controls_move">Lépjen az alábbi mondatra.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g>: lépés a következő szóra. Lépjen tovább három szót.</string>
    <string name="sandfly_tutorial_reading_controls_title">Felolvasásvezérlés</string>
    <string name="sandfly_tutorial_recipe_1">Palacsinta: keverje simára a lisztet, a tojást és a tejet.</string>
    <string name="sandfly_tutorial_recipe_2">Hevítsen kevés vajat egy serpenyőben.</string>
    <string name="sandfly_tutorial_recipe_3">Öntsön bele annyi tésztát, hogy vékonyan befedje a serpenyő alját.</string>
    <string name="sandfly_tutorial_recipe_4">Fordítsa meg a palacsintát, amikor az alja aranybarna.</string>
    <string name="sandfly_tutorial_recipe_5">Citrommal és cukorral tálalja.</string>
    <string name="sandfly_tutorial_scrolling_intro">A listák egyszerre csak néhány elemüket jelenítik meg. Az utolsó megjelenített elemen túl csúsztatva a lista görget.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>: görgetés előre egy oldallal.</string>
