    <string name="sandfly_tutorial_move_intro">Scorrendo ti sposti all\'elemento successivo o precedente sullo schermo, in ordine di lettura.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> per passare all\'elemento successivo. Continua fino a raggiungere <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> per passare all\'elemento precedente. Torna a <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Spostarsi tra gli elementi</string>
    <string name="sandfly_tutorial_name">Nome</string>
    <string name="sandfly_tutorial_next_lesson">Lezione successiva: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> non ha un gesto. Assegnane uno in Comandi o usa Salta passaggio.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> non viene eseguito in una lezione. Per uscire dal tutorial, usa Chiudi tutorial in Indice.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> non viene eseguito in una lezione.</string>
    <string name="sandfly_tutorial_pause_intro">La voce può essere messa in pausa a metà di un elemento e ripresa dal punto in cui si è fermata.</string>
    <string name="sandfly_tutorial_pause_pause">Vai al racconto qui sotto. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> mentre viene letto per mettere in pausa la voce, e di nuovo per riprendere.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> di nuovo per riprendere la voce.</string>
    <string name="sandfly_tutorial_pause_title">Mettere in pausa la voce</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Ogni gesto pronuncia il suo nome e la sua azione invece di eseguirla. Lo spostamento all\'elemento successivo e precedente e l\'attivazione funzionano comunque.</string>
    <string name="sandfly_tutorial_practice_step">Esegui un gesto qualsiasi per sentire cosa fa. Per smettere, attiva <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Esercizio sui gesti</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> di <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Imposta il controllo di lettura su <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> per spostarti di un carattere.</string>
    <string name="sandfly_tutorial_reading_controls_intro">I controlli di lettura scelgono cosa fa lo scorrimento verso l\'alto e verso il basso, ad esempio spostarsi per parola o per carattere, o cambiare la velocità del parlato. Lo scorrimento verso destra e verso sinistra continua a spostarsi tra gli elementi.</string>
    <string name="sandfly_tutorial_reading_controls_move">Vai alla frase qui sotto.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> per passare alla parola successiva. Spostati di tre parole.</string>
    <string name="sandfly_tutorial_reading_controls_title">Controlli di lettura</string>
    <string name="sandfly_tutorial_recipe_1">Crêpe: mescola farina, uova e latte fino a ottenere una pastella liscia.</string>
    <string name="sandfly_tutorial_recipe_2">Scalda un po\' di burro in una padella.</string>
    <string name="sandfly_tutorial_recipe_3">Versa pastella quanto basta per coprire la padella in uno strato sottile.</string>
    <string name="sandfly_tutorial_recipe_4">Gira la crêpe quando il lato inferiore è dorato.</string>
    <string name="sandfly_tutorial_recipe_5">Servi con limone e zucchero.</string>
    <string name="sandfly_tutorial_scrolling_intro">Gli elenchi mostrano solo alcuni elementi alla volta. Scorrendo oltre l\'ultimo elemento visualizzato, l\'elenco scorre.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> per scorrere avanti di una pagina.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> nell\'elenco fino a raggiungere <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Scorrere gli elenchi</string>
    <string name="sandfly_tutorial_sentence">Quel vituperabile xenofobo zelante assaggia il whisky ed esclama: alleluja!</string>
    <string name="sandfly_tutorial_skip_step">Salta passaggio</string>
    <string name="sandfly_tutorial_sliders_change">Vai al cursore <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> o <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> per cambiarne il valore.</string>
    <string name="sandfly_tutorial_sliders_highest">Imposta <xliff:g id="slider" example="Brightness">%1$s</xliff:g> al 100 per cento, il suo valore massimo.</string>
    <string name="sandfly_tutorial_sliders_intro">Quando un cursore è selezionato, lo scorrimento verso l\'alto e verso il basso ne cambia il valore.</string>
    <string name="sandfly_tutorial_sliders_title">Cursori</string>
    <string name="sandfly_tutorial_step">Passaggio <xliff:g id="number" example="1">%1$d</xliff:g> di <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">I flebotomi sono piccoli insetti che vivono sulle spiagge, lungo le rive dei fiumi e nei boschi. Sono più attivi all\'alba e al tramonto, quando l\'aria è ferma. Pungono solo le femmine, perché hanno bisogno di sangue per produrre le uova. Le punture prudono per giorni, perciò chi visita le zone dei flebotomi porta con sé un repellente per insetti. I flebotomi volano male, e basta una leggera brezza a tenerli lontani.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> per tornare indietro.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> per andare alla schermata Home.</string>
    <string name="sandfly_tutorial_system_intro">Questi gesti funzionano in ogni schermata. In questa lezione, il tutorial dice cosa fa ciascuno invece di eseguirlo.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> per aprire le notifiche.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> per mostrare le app recenti.</string>
    <string name="sandfly_tutorial_system_title">Indietro, Home e notifiche</string>
