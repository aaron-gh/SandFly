    <string name="sandfly_tutorial_actions_archive">Vai al messaggio. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> o <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> per scorrere le sue azioni. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> per eseguire l\'azione che senti. Esegui <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Alcuni elementi hanno azioni oltre all\'attivazione, come Archivia o Elimina per un messaggio. Quando un elemento di questo tipo è selezionato, il controllo di lettura Azioni le scorre.</string>
    <string name="sandfly_tutorial_actions_title">Azioni</string>
    <string name="sandfly_tutorial_activate_button">Vai a <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> per attivarlo.</string>
    <string name="sandfly_tutorial_activate_check_box">Seleziona <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> allo stesso modo.</string>
    <string name="sandfly_tutorial_activate_hold">Alcuni elementi fanno qualcos\'altro se tenuti premuti. Vai a <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> per tenerlo premuto.</string>
    <string name="sandfly_tutorial_activate_intro">L\'attivazione agisce sull\'elemento selezionato, ovunque tocchi lo schermo.</string>
    <string name="sandfly_tutorial_activate_title">Attivare elementi</string>
    <string name="sandfly_tutorial_back_in_lesson">Indietro non esce da una lezione. Per scegliere un\'altra lezione, usa Indice.</string>
