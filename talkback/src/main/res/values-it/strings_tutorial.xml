    <string name="sandfly_tutorial_typing_delete">Elimina l\'ultima lettera con il tasto Elimina della tastiera.</string>
    <string name="sandfly_tutorial_typing_intro">Attivando un campo di testo si apre la tastiera. Tocca un tasto per sentirlo e solleva il dito per digitarlo.</string>
    <string name="sandfly_tutorial_typing_open">Vai al campo <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> per iniziare a digitare.</string>
    <string name="sandfly_tutorial_typing_title">Digitazione</string>
    <string name="sandfly_tutorial_typing_type">Digita la parola <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">gatto</string>
    <string name="sandfly_tutorial_welcome_intro">Questo tutorial insegna i gesti di SandFly. Ogni lezione dà un\'istruzione, aspetta che tu l\'abbia eseguita con i tuoi gesti, poi dà la successiva. L\'istruzione è il primo elemento dopo il nome della lezione. Indice elenca tutte le lezioni, e il tutorial si riapre alla lezione in cui eri.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> in un punto qualsiasi dello schermo per iniziare.</string>
    <string name="sandfly_tutorial_welcome_title">Benvenuto</string>
</resources>
