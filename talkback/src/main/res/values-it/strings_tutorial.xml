    <string name="sandfly_tutorial_commands_intro">Questi comandi funzionano in ogni schermata.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> per cercare testo sullo schermo. In questa lezione, il tutorial dice cosa fa invece di eseguirlo.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> per disattivare la voce, e di nuovo per riattivarla. In questa lezione, il tutorial dice cosa fa invece di eseguirlo.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> per sentire l\'ora, il livello della batteria e altre informazioni di stato.</string>
    <string name="sandfly_tutorial_commands_title">Comandi utili</string>
    <string name="sandfly_tutorial_contents">Indice</string>
    <string name="sandfly_tutorial_contents_intro">Lezioni, in ordine. Ognuna può essere aperta da sola.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly può leggere dall\'elemento selezionato fino alla fine dello schermo senza scorrere. Toccare lo schermo interrompe la lettura.</string>
    <string name="sandfly_tutorial_continuous_move">Vai alla prima riga della ricetta.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> per leggere dall\'elemento selezionato.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> per aprire il menu SandFly, poi scegli <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
