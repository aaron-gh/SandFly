    <string name="live_recognition_mode_state"><xliff:g id="mode" example="Scenes">%1$s</xliff:g>, <xliff:g id="state" example="on">%2$s</xliff:g></string>
    <string name="live_recognition_instructions">Beindu myndavélinni að aftan að því sem þú vilt fá lýsingu á. Fyrir Benda og lesa bendirðu með fingri á texta í mynd myndavélarinnar. Lýsingar geta verið rangar. Ekki treysta á þær til að komast örugglega leiðar þinnar.</string>
    <string name="live_recognition_camera_off">Slökkt á myndavél</string>
    <string name="live_recognition_camera_on">Kveikt á myndavél</string>
    <string name="live_recognition_connecting">Tengist Gemini…</string>
    <string name="live_recognition_cloud_title">Senda myndir úr myndavélinni til Gemini?</string>
    <string name="live_recognition_cloud_message">Umhverfi, Benda og lesa, Greining fólks og Greining hurða senda mynd úr myndavélinni til Gemini API frá Google á nokkurra sekúndna fresti. Texti er greindur í þessum síma.\n\nMeð ókeypis API-lykli getur Google geymt það sem berst, notað það til að bæta vörur sínar og látið fólk fara yfir það. Gervigreind sem býr til efni er á tilraunastigi og gerir því mistök.</string>
    <string name="live_recognition_service_title">Senda myndir úr myndavélinni til <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g>?</string>
    <string name="live_recognition_service_message">Umhverfi, Benda og lesa, Greining fólks og Greining hurða senda mynd úr myndavélinni til <xliff:g id="host" example="api.anthropic.com">%1$s</xliff:g> á nokkurra sekúndna fresti. Texti er greindur í þessum síma.\n\nSkilmálar og persónuverndarstefna þjónustunnar gilda. Gervigreind sem býr til efni er á tilraunastigi og gerir því mistök.</string>
