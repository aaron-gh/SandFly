<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" xmlns:tools="http://schemas.android.com/tools" tools:ignore="InconsistentArrays">
    <!-- Watches use the phone defaults, except where those would not work on a watch: screen
         search and voice commands are not offered, there are no volume keys or braille keyboard,
         and three- and four-finger gestures do not fit, as watch screens track only two fingers.
         Two-finger swipes scroll the app, so the menu, repeating and muting are on gestures that a
         watch has to spare. -->
    <string name="pref_shortcut_left_and_down_default">@string/shortcut_value_unassigned</string>
    <string name="pref_shortcut_left_and_up_default">@string/shortcut_value_repeat_last_spoken_phrase</string>
    <string name="pref_shortcut_right_and_up_default">@string/shortcut_value_increase_volume</string>
    <string name="pref_shortcut_right_and_down_default">@string/shortcut_value_decrease_volume</string>

    <string name="pref_shortcut_2finger_2tap_hold_default">@string/shortcut_value_talkback_breakout</string>
    <string name="pref_shortcut_2finger_3tap_hold_default">@string/shortcut_value_toggle_voice_feedback</string>
    <string name="pref_shortcut_3finger_1tap_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_2tap_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_3tap_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_1tap_hold_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_3tap_hold_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_swipe_up_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_swipe_down_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_swipe_left_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_swipe_right_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_swipe_up_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_swipe_down_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_swipe_left_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_swipe_right_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_1tap_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_2tap_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_3tap_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_3finger_2tap_hold_default">@string/shortcut_value_unsupported</string>
    <string name="pref_shortcut_4finger_2tap_hold_default">@string/shortcut_value_unsupported</string>

    <!-- None of the strings here should be translated -->
    <!-- Shortcut preference of basic navigation -->
    <string-array name="shortcut_basic_navigation">
        <item>@string/shortcut_perform_click_action</item>
        <item>@string/shortcut_perform_long_click_action</item>
        <item>@string/shortcut_previous</item>
        <item>@string/shortcut_next</item>
        <item>@string/shortcut_first_in_screen</item>
        <item>@string/shortcut_last_in_screen</item>
    </string-array>

    <!-- Shortcut preference value of basic navigation -->
    <string-array name="shortcut_value_basic_navigation">
        <item>@string/shortcut_value_perform_click_action</item>
        <item>@string/shortcut_value_perform_long_click_action</item>
        <item>@string/shortcut_value_previous</item>
        <item>@string/shortcut_value_next</item>
        <item>@string/shortcut_value_first_in_screen</item>
        <item>@string/shortcut_value_last_in_screen</item>
    </string-array>

    <!-- Shortcut preference of system actions -->
    <string-array name="shortcut_system_actions">
        <item>@string/shortcut_home</item>
        <item>@string/shortcut_back</item>
    </string-array>

    <!-- Shortcut preference value of system actions -->
    <string-array name="shortcut_value_system_actions">
        <item>@string/shortcut_value_home</item>
        <item>@string/shortcut_value_back</item>
    </string-array>

    <!-- Shortcut preference of reading control -->
    <string-array name="shortcut_reading_control">
        <item>@string/shortcut_read_from_top</item>
        <item>@string/shortcut_read_from_current</item>
        <item>@string/title_repeat_last_spoken_phrase</item>
        <item>@string/title_spell_last_spoken_phrase</item>
        <item>@string/shortcut_pause_or_resume_feedback</item>
        <item>@string/shortcut_toggle_voice_feedback</item>
        <item>@string/shortcut_show_language_options</item>
        <item>@string/shortcut_voice_profiles</item>
        <item>@string/shortcut_previous_voice_profile</item>
        <item>@string/shortcut_next_voice_profile</item>
    </string-array>

    <!-- Shortcut preference value of reading control -->
    <string-array name="shortcut_value_reading_control">
        <item>@string/shortcut_value_read_from_top</item>
        <item>@string/shortcut_value_read_from_current</item>
        <item>@string/shortcut_value_repeat_last_spoken_phrase</item>
        <item>@string/shortcut_value_spell_last_spoken_phrase</item>
        <item>@string/shortcut_value_pause_or_resume_feedback</item>
        <item>@string/shortcut_value_toggle_voice_feedback</item>
        <item>@string/shortcut_value_show_language_options</item>
        <item>@string/shortcut_value_voice_profiles</item>
        <item>@string/shortcut_value_previous_voice_profile</item>
        <item>@string/shortcut_value_next_voice_profile</item>
    </string-array>

    <!-- Shortcut preference of menu control -->
    <string-array name="shortcut_menu_control">
        <item>@string/shortcut_talkback_breakout</item>
        <item>@string/shortcut_select_previous_setting</item>
        <item>@string/shortcut_select_next_setting</item>
        <item>@string/shortcut_selected_setting_previous_action</item>
        <item>@string/shortcut_selected_setting_next_action</item>
    </string-array>

    <!-- Shortcut preference value of menu control -->
    <string-array name="shortcut_value_menu_control">
        <item>@string/shortcut_value_talkback_breakout</item>
        <item>@string/shortcut_value_select_previous_setting</item>
        <item>@string/shortcut_value_select_next_setting</item>
        <item>@string/shortcut_value_selected_setting_previous_action</item>
        <item>@string/shortcut_value_selected_setting_next_action</item>
    </string-array>

    <!-- Shortcut preference of text editing -->
    <string-array name="shortcut_text_editing">
        <item>@string/title_edittext_breakout_move_to_beginning</item>
        <item>@string/title_edittext_breakout_move_to_end</item>
    </string-array>

    <!-- Shortcut preference value of text editing -->
    <string-array name="shortcut_value_text_editing">
        <item>@string/shortcut_value_move_cursor_to_beginning</item>
        <item>@string/shortcut_value_move_cursor_to_end</item>
    </string-array>

    <!-- The list of the gestures which the platform supports. [CHAR_LIMIT=NONE] -->
    <string-array name="service_detected_gesture_list">
        <!-- Start with double tap. -->
        <item>MAPPER_GESTURE_DOUBLE_TAP</item>
        <item>MAPPER_GESTURE_DOUBLE_TAP_AND_HOLD</item>
        <!-- One-direction swipes. -->
        <item>MAPPER_GESTURE_SWIPE_RIGHT</item>
        <item>MAPPER_GESTURE_SWIPE_LEFT</item>
        <item>MAPPER_GESTURE_SWIPE_UP</item>
        <item>MAPPER_GESTURE_SWIPE_DOWN</item>
        <!-- Two-direction swipes. -->
        <item>MAPPER_GESTURE_SWIPE_LEFT_AND_RIGHT</item>
        <item>MAPPER_GESTURE_SWIPE_LEFT_AND_UP</item>
        <item>MAPPER_GESTURE_SWIPE_LEFT_AND_DOWN</item>
        <item>MAPPER_GESTURE_SWIPE_RIGHT_AND_UP</item>
        <item>MAPPER_GESTURE_SWIPE_RIGHT_AND_DOWN</item>
        <item>MAPPER_GESTURE_SWIPE_RIGHT_AND_LEFT</item>
        <item>MAPPER_GESTURE_SWIPE_DOWN_AND_UP</item>
        <item>MAPPER_GESTURE_SWIPE_DOWN_AND_LEFT</item>
        <item>MAPPER_GESTURE_SWIPE_DOWN_AND_RIGHT</item>
        <item>MAPPER_GESTURE_SWIPE_UP_AND_DOWN</item>
        <item>MAPPER_GESTURE_SWIPE_UP_AND_LEFT</item>
        <item>MAPPER_GESTURE_SWIPE_UP_AND_RIGHT</item>
        <!--> Two-finger taps. -->
        <item>MAPPER_GESTURE_2_FINGER_SINGLE_TAP</item>
        <item>MAPPER_GESTURE_2_FINGER_DOUBLE_TAP</item>
        <item>MAPPER_GESTURE_2_FINGER_DOUBLE_TAP_AND_HOLD</item>
        <item>MAPPER_GESTURE_2_FINGER_TRIPLE_TAP</item>
        <!-- As on phones, but no three- or four-finger gestures, which do not fit on a watch. -->
        <item>MAPPER_GESTURE_2_FINGER_SINGLE_TAP_AND_HOLD</item>
        <item>MAPPER_GESTURE_2_FINGER_TRIPLE_TAP_AND_HOLD</item>
        <item>MAPPER_GESTURE_2_FINGER_SWIPE_DOWN</item>
        <item>MAPPER_GESTURE_2_FINGER_SWIPE_LEFT</item>
        <item>MAPPER_GESTURE_2_FINGER_SWIPE_RIGHT</item>
        <item>MAPPER_GESTURE_2_FINGER_SWIPE_UP</item>
    </string-array>

    <!-- A watch's screen is small enough to read directly, and each item narrows the circle menu's
         slices, so Describe screen is off in the Backtalk menu unless turned on. -->
    <bool name="pref_show_context_menu_summarize_view_default">false</bool>
</resources>
