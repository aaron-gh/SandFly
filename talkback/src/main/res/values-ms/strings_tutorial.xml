    <string name="sandfly_tutorial_message_delete">Padam</string>
    <string name="sandfly_tutorial_message_reply">Balas</string>
    <string name="sandfly_tutorial_move_intro">Meleret mengalihkan ke item seterusnya atau sebelumnya pada skrin, mengikut susunan bacaan.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> untuk beralih ke item seterusnya. Teruskan sehingga anda sampai ke <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> untuk beralih ke item sebelumnya. Kembali ke <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Bergerak antara item</string>
    <string name="sandfly_tutorial_name">Nama</string>
    <string name="sandfly_tutorial_next_lesson">Pelajaran seterusnya: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> tiada gerak isyarat. Berikan satu dalam Perintah, atau gunakan Langkau langkah.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> tidak dilakukan dalam pelajaran. Untuk meninggalkan tutorial, gunakan Tutup tutorial dalam Kandungan.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> tidak dilakukan dalam pelajaran.</string>
    <string name="sandfly_tutorial_pause_intro">Pertuturan boleh dijeda di tengah-tengah item, dan disambung semula di tempat ia berhenti.</string>
    <string name="sandfly_tutorial_pause_pause">Alih ke cerita di bawah. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> semasa cerita dibaca untuk menjeda pertuturan, dan sekali lagi untuk menyambung semula.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> sekali lagi untuk menyambung semula pertuturan.</string>
    <string name="sandfly_tutorial_pause_title">Menjeda pertuturan</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Setiap gerak isyarat menyebut nama dan tindakannya dan tidak melaksanakannya. Beralih ke item seterusnya dan sebelumnya serta pengaktifan masih berfungsi.</string>
    <string name="sandfly_tutorial_practice_step">Buat sebarang gerak isyarat untuk mendengar fungsinya. Untuk berhenti, aktifkan <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Latihan gerak isyarat</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> daripada <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Tukar kawalan bacaan kepada <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> untuk beralih satu aksara.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Kawalan bacaan menentukan fungsi leret ke atas dan ke bawah, seperti beralih mengikut perkataan atau aksara, atau menukar kadar pertuturan. Leret ke kanan dan ke kiri masih beralih antara item.</string>
    <string name="sandfly_tutorial_reading_controls_move">Alih ke ayat di bawah.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> untuk beralih ke perkataan seterusnya. Alih tiga perkataan.</string>
    <string name="sandfly_tutorial_reading_controls_title">Kawalan bacaan</string>
    <string name="sandfly_tutorial_recipe_1">Lempeng: campurkan tepung, telur dan susu menjadi adunan yang licin.</string>
    <string name="sandfly_tutorial_recipe_2">Panaskan sedikit mentega dalam kuali.</string>
    <string name="sandfly_tutorial_recipe_3">Tuangkan adunan secukupnya untuk menutup kuali dengan nipis.</string>
    <string name="sandfly_tutorial_recipe_4">Terbalikkan lempeng apabila bahagian bawahnya keemasan.</string>
    <string name="sandfly_tutorial_recipe_5">Hidangkan dengan lemon dan gula.</string>
    <string name="sandfly_tutorial_scrolling_intro">Senarai hanya menunjukkan sebahagian itemnya pada satu masa. Meleret melepasi item terakhir yang ditunjukkan akan menatal senarai.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> untuk menatal ke hadapan satu halaman.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> melalui senarai sehingga anda sampai ke <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Menatal senarai</string>
    <string name="sandfly_tutorial_sentence">Musang perang yang pantas melompat ke atas anjing yang malas.</string>
    <string name="sandfly_tutorial_skip_step">Langkau langkah</string>
    <string name="sandfly_tutorial_sliders_change">Alih ke peluncur <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> atau <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> untuk menukar nilainya.</string>
    <string name="sandfly_tutorial_sliders_highest">Tetapkan <xliff:g id="slider" example="Brightness">%1$s</xliff:g> kepada 100 peratus, nilai tertingginya.</string>
    <string name="sandfly_tutorial_sliders_intro">Apabila peluncur difokuskan, leret ke atas dan ke bawah menukar nilainya.</string>
    <string name="sandfly_tutorial_sliders_title">Peluncur</string>
    <string name="sandfly_tutorial_step">Langkah <xliff:g id="number" example="1">%1$d</xliff:g> daripada <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Lalat pasir ialah lalat kecil yang hidup di pantai, di tebing sungai dan di hutan. Lalat ini paling aktif pada waktu subuh dan senja, apabila udara tenang. Hanya lalat betina yang menggigit, kerana lalat betina memerlukan darah untuk menghasilkan telur. Gigitannya gatal selama berhari-hari, jadi orang yang melawat kawasan lalat pasir membawa penghalau serangga. Lalat pasir ialah penerbang yang lemah, dan angin sepoi-sepoi pun dapat menjauhkannya.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> untuk kembali.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> untuk pergi ke Skrin Utama.</string>
    <string name="sandfly_tutorial_system_intro">Gerak isyarat ini berfungsi pada setiap skrin. Dalam pelajaran ini, tutorial menyebut fungsi setiap gerak isyarat dan tidak melaksanakannya.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> untuk membuka pemberitahuan.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> untuk menunjukkan apl terbaharu.</string>
