    <string name="sandfly_tutorial_forecast_today_text">Cerah dan panas, dengan angin sepoi-sepoi bahasa.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Esok</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Mendung pada waktu pagi, dengan hujan mulai tengah hari.</string>
    <string name="sandfly_tutorial_forecast_weekend">Hujung minggu</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Berangin pada hari Sabtu, cerah pada hari Ahad.</string>
    <string name="sandfly_tutorial_headings_intro">Skrin dan halaman web membahagikan kandungannya dengan tajuk. Kawalan bacaan Tajuk melompat dari satu tajuk ke tajuk seterusnya.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> untuk melompat ke tajuk seterusnya. Lompat ke <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
