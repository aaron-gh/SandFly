    <string name="sandfly_tutorial_contents_intro">Pelajaran, mengikut susunan. Setiap pelajaran boleh dibuka secara berasingan.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly boleh membaca daripada item yang difokuskan hingga ke hujung skrin tanpa meleret. Menyentuh skrin menghentikan bacaan.</string>
    <string name="sandfly_tutorial_continuous_move">Alih ke baris pertama resipi.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> untuk membaca daripada item yang difokuskan.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> untuk membuka menu SandFly, kemudian pilih <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
