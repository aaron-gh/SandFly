    <string name="sandfly_tutorial_actions_archive">Alih ke mesej. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> atau <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> untuk melalui tindakannya. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> untuk melaksanakan tindakan yang anda dengar. Laksanakan <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Sesetengah item mempunyai tindakan selain pengaktifan, seperti Arkib atau Padam untuk mesej. Semasa item sedemikian difokuskan, kawalan bacaan Tindakan melalui tindakan tersebut.</string>
    <string name="sandfly_tutorial_actions_title">Tindakan</string>
    <string name="sandfly_tutorial_activate_button">Alih ke <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> untuk mengaktifkannya.</string>
    <string name="sandfly_tutorial_activate_check_box">Tandai <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> dengan cara yang sama.</string>
    <string name="sandfly_tutorial_activate_hold">Sesetengah item melakukan perkara lain apabila ditahan. Alih ke <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> untuk menahannya.</string>
    <string name="sandfly_tutorial_activate_intro">Pengaktifan berfungsi pada item yang difokuskan, di mana-mana sahaja anda mengetik skrin.</string>
    <string name="sandfly_tutorial_activate_title">Mengaktifkan item</string>
    <string name="sandfly_tutorial_back_in_lesson">Kembali tidak meninggalkan pelajaran. Untuk memilih pelajaran lain, gunakan Kandungan.</string>
