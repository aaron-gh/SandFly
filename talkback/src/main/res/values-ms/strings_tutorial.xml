    <string name="sandfly_tutorial_menu_intro">Menu SandFly mempunyai perintah untuk item yang difokuskan dan skrin semasa.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> untuk membuka menu SandFly. Leret melalui perintahnya. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> menutup menu.</string>
    <string name="sandfly_tutorial_menu_title">Menu SandFly</string>
    <string name="sandfly_tutorial_message">Mesej daripada Sam: Makan tengah hari pukul 12?</string>
