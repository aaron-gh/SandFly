    <string name="sandfly_tutorial_title">Tutorial SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Padam huruf terakhir dengan kekunci Padam pada papan kekunci.</string>
    <string name="sandfly_tutorial_typing_intro">Mengaktifkan medan teks membuka papan kekunci. Sentuh kekunci untuk mendengarnya, dan angkat jari anda untuk menaipnya.</string>
    <string name="sandfly_tutorial_typing_open">Alih ke medan <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> untuk mula menaip.</string>
    <string name="sandfly_tutorial_typing_title">Menaip</string>
    <string name="sandfly_tutorial_typing_type">Taip perkataan <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">kucing</string>
    <string name="sandfly_tutorial_welcome_intro">Tutorial ini mengajar gerak isyarat SandFly. Setiap pelajaran memberikan arahan, menunggu sehingga anda melakukannya dengan gerak isyarat anda sendiri, kemudian memberikan arahan seterusnya. Arahan ialah item pertama selepas nama pelajaran. Kandungan menyenaraikan setiap pelajaran, dan tutorial dibuka semula pada pelajaran terakhir anda.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> di mana-mana pada skrin untuk bermula.</string>
    <string name="sandfly_tutorial_welcome_title">Selamat datang</string>
