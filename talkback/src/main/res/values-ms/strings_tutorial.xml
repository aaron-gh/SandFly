    <string name="sandfly_tutorial_explore_activate">Sentuh Bintang dan angkat jari anda. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> di mana-mana untuk mengaktifkannya.</string>
    <string name="sandfly_tutorial_explore_find">Gerakkan satu jari di sekitar skrin dan cari empat petak: Matahari, Bulan, Bintang dan Awan.</string>
    <string name="sandfly_tutorial_explore_intro">Menyentuh skrin menyebut item di bawah jari anda. Menyentuh item tidak mengaktifkannya.</string>
    <string name="sandfly_tutorial_explore_title">Meneroka melalui sentuhan</string>
