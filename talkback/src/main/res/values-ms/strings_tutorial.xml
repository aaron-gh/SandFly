    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> atau <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> untuk menukar kawalan bacaan. Pilih <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Tutup tutorial</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> untuk menyalin teks terakhir yang dituturkan oleh SandFly ke papan keratan.</string>
    <string name="sandfly_tutorial_commands_intro">Perintah ini berfungsi pada setiap skrin.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> untuk mencari teks pada skrin. Dalam pelajaran ini, tutorial menyebut fungsinya sebagai ganti.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> untuk mematikan pertuturan, dan sekali lagi untuk menghidupkannya. Dalam pelajaran ini, tutorial menyebut fungsinya sebagai ganti.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> untuk mendengar masa, aras bateri dan status lain.</string>
