    <string name="title_pref_control_sounds">Bunyi dan getaran kawalan</string>
    <string name="summary_pref_control_sounds">Setiap jenis kawalan, seperti butang, kotak semak, medan edit dan item senarai, mendapat bunyi dan getarannya sendiri daripada tema sebagai ganti bunyi dan getaran fokus, seperti yang dilakukan oleh Unspoken untuk NVDA. Bunyi datang dari kedudukan kawalan pada skrin, dan SandFly tidak menyebut jenis kawalan.</string>
    <string name="title_pref_control_sounds_speak_roles">Tetap sebut jenis kawalan</string>
    <string name="summary_pref_control_sounds_speak_roles">Apabila bunyi kawalan dimainkan, jenis kawalan tetap disebut, contohnya butang. Digunakan untuk semua tema bunyi.</string>
