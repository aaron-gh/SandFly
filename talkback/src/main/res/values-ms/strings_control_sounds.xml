    <string name="title_pref_control_sounds">Kawal bunyi dan getaran</string>
    <string name="summary_pref_control_sounds">Berikan setiap jenis kawalan, seperti butang, kotak semak, medan edit dan senarai item, bunyinya sendiri dan getarannya sendiri daripada tema, sebagai ganti bunyi fokus dan getaran, seperti yang dilakukan Unspoken untuk NVDA. Bunyi datang dari tempat kawalan pada skrin, dan SandFly tidak menyatakan jenis kawalan itu.</string>
    <string name="title_pref_control_sounds_speak_roles">Masih sebut jenis kawalan</string>
    <string name="summary_pref_control_sounds_speak_roles">Apabila bunyi kawalan dimainkan, tetap sebut jenis kawalan itu, seperti butang. Ini adalah untuk setiap tema bunyi.</string>
