<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications > Repeats: notifications that come again, and apps that post many. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <ListPreference
      android:defaultValue="0"
      android:key="pref_notification_repeat_seconds"
      android:summary="%s"
      android:title="@string/notification_repeat_seconds_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_notification_numbers_alike"
      android:summary="@string/notification_numbers_alike_summary"
      android:title="@string/notification_numbers_alike_title" />
  <ListPreference
      android:defaultValue="0"
      android:key="pref_notification_cooldown"
      android:summary="%s"
      android:title="@string/notification_cooldown_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_notification_skip_prefix"
      android:summary="@string/notification_skip_prefix_summary"
      android:title="@string/notification_skip_prefix_title" />
  <ListPreference
      android:defaultValue="60"
      android:dependency="pref_notification_skip_prefix"
      android:key="pref_notification_prefix_memory"
      android:summary="%s"
      android:title="@string/notification_prefix_memory_title" />
</PreferenceScreen>
