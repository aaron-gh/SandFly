<?xml version="1.0" encoding="UTF-8"?>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_survey_setting_entry_point_key"
      android:title="@string/survey_setting_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_audio_key"
      android:title="@string/title_pref_category_feedback">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.TextToSpeechSettingsFragment"
        android:key="@string/pref_tts_settings_key"
        android:title="@string/tts_preferences_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.VerbosityPrefFragment"
        android:key="@string/pref_verbosity_key"
        android:title="@string/pref_verbosity_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.AutomaticDescriptionsFragment"
        android:key="@string/pref_auto_image_captioning_key"
        android:summary="@string/summary_pref_auto_image_captioning"
        android:title="@string/title_pref_auto_image_captioning"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SoundAndVibrationFragment"
        android:key="@string/pref_sound_and_vibration_key"
        android:title="@string/title_pref_sound_and_vibration" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.FocusIndicatorPrefFragment"
        android:key="@string/pref_category_manage_focus_indicator_key"
        android:title="@string/title_pref_category_manage_focus_indicator" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_category_notifications"
      android:title="@string/notification_category_title">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_notifications_default"
        android:key="@string/pref_speak_notifications_key"
        android:summary="@string/summary_pref_speak_notifications"
        android:title="@string/title_pref_speak_notifications" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationReadingFragment"
        android:key="pref_notification_reading_screen"
        android:title="@string/notification_reading_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationAppsFragment"
        android:key="pref_notification_apps_screen"
        android:title="@string/notification_apps_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationWordsFragment"
        android:key="pref_notification_words_screen"
        android:title="@string/notification_words_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationKindsFragment"
        android:key="pref_notification_kinds_screen"
        android:title="@string/notification_kinds_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationWhenFragment"
        android:key="pref_notification_when_screen"
        android:title="@string/notification_when_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationRulesFragment"
        android:key="pref_notification_rules_screen"
        android:title="@string/notification_rules_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationRepeatsFragment"
        android:key="pref_notification_repeats_screen"
        android:title="@string/notification_repeats_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationStopFragment"
        android:key="pref_notification_stop_screen"
        android:title="@string/notification_stop_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationSchedulesFragment"
        android:key="pref_notification_schedules_screen"
        android:title="@string/notification_schedules_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notifications.NotificationHistoryFragment"
        android:key="pref_notification_history_screen"
        android:title="@string/notification_history_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_notification_list_default"
        android:key="@string/pref_notification_list_key"
        android:title="@string/title_pref_notification_list"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.notificationlist.NotificationPartsFragment"
        android:key="@string/pref_notification_parts_key"
        android:title="@string/title_pref_notification_parts"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_notification_test"
        android:title="@string/notification_test_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_automation_allowed"
        android:title="@string/notification_automation_allowed_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_notification_automation"
        android:dependency="pref_notification_automation_allowed"
        android:title="@string/notification_automation_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_controls_key"
      android:title="@string/title_pref_category_controls">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.TalkBackGestureShortcutPreferenceFragment"
        android:key="@string/pref_category_manage_gestures_key"
        android:title="@string/title_pref_category_manage_gestures" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ContextMenuFragment"
        android:key="@string/pref_category_manage_context_menu_key"
        android:title="@string/title_pref_category_context_menu" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SelectorMenuFragment"
        android:key="@string/pref_category_manage_selector_menu_key"
        android:title="@string/title_pref_category_selector_menu" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.TouchActivationFragment"
        android:key="@string/pref_touch_activation_key"
        android:title="@string/title_pref_touch_activation" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.NavigationPrefFragment"
        android:key="@string/pref_navigation_settings_key"
        android:title="@string/title_pref_navigation" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.status.StatusReadoutFragment"
        android:key="@string/pref_status_readout_key"
        android:title="@string/title_pref_status_readout" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.directtouch.DirectTouchFragment"
        android:key="@string/pref_direct_touch_key"
        android:title="@string/title_pref_direct_touch" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_category_manage_keyboard_shortcut_key"
        android:title="@string/title_pref_manage_keyboard_shortcuts"
        android:fragment="com.google.android.accessibility.talkback.preference.base.TalkBackKeyboardShortcutPreferenceFragment" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.GeminiSettingsFragment"
        android:key="@string/pref_gemini_settings_key"
        android:title="@string/title_pref_gemini_settings" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_typing_key"
      android:title="@string/title_pref_category_typing_and_braille"
      app:allowDividerAbove="true" >
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.keyboardecho.KeyboardEchoFragment"
        android:key="@string/pref_keyboard_echo_screen_key"
        android:title="@string/title_pref_keyboard_echo" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.OnScreenKeyboardFragment"
        android:key="@string/pref_on_screen_keyboard_key"
        android:title="@string/title_pref_on_screen_keyboard" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_physical_keyboard_key"
        android:title="@string/title_pref_physical_keyboard" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_brailleime_key"
        android:title="@string/title_pref_brailleime">
      <intent
          android:targetPackage="@string/app_id"
          android:targetClass="com.google.android.accessibility.brailleime.settings.BrailleImePreferencesActivity" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_handwriting_keyboard_key"
        android:summary="@string/summary_pref_handwriting_keyboard"
        android:title="@string/title_pref_handwriting_keyboard">
      <intent android:action="android.settings.INPUT_METHOD_SETTINGS" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_brailledisplay_key"
        android:title="@string/title_pref_brailledisplay">
      <intent
          android:targetPackage="@string/app_id"
          android:targetClass="com.google.android.accessibility.braille.brailledisplay.settings.BrailleDisplaySettingsActivity" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_apps_key"
      android:title="@string/title_pref_category_apps">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_scripts_key"
        android:title="@string/title_pref_scripts"
        android:summary="@string/summary_pref_scripts"
        android:fragment="com.google.android.accessibility.talkback.scripting.ScriptsFragment" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_manage_labels_key"
        android:title="@string/title_pref_manage_labels" >
      <intent
          android:targetPackage="@string/app_id"
          android:targetClass="com.google.android.accessibility.talkback.labeling.LabelManagerSummaryActivity" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.speechcontrol.SpeechControlFragment"
        android:key="pref_speech_control_screen"
        android:title="@string/title_pref_speech_control" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_advanced_key"
      android:title="@string/title_pref_category_more">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.AdvancedSettingFragment"
        android:key="@string/pref_advanced_settings_key"
        android:title="@string/title_pref_advanced_settings" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_export_settings_key"
        android:title="@string/title_pref_export_settings" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_import_settings_key"
        android:title="@string/title_pref_import_settings" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_tutorial_and_help_key"
        android:title="@string/title_pref_category_tutorial" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.report.ReportsFragment"
        android:key="@string/pref_problem_report_key"
        android:title="@string/title_pref_problem_report" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_check_for_updates_key"
        android:title="@string/title_pref_check_for_updates" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_auto_update_check_default"
        android:key="@string/pref_auto_update_check_key"
        android:summary="@string/summary_pref_auto_update_check"
        android:title="@string/title_pref_auto_update_check" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_dev_builds_default"
        android:key="@string/pref_dev_builds_key"
        android:title="@string/title_pref_dev_builds" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
