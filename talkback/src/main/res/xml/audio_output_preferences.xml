<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_audio_output_device_default"
      android:dialogTitle="@string/dialog_title_audio_output_device"
      android:entries="@array/pref_audio_output_device_entries"
      android:entryValues="@array/pref_audio_output_device_values"
      android:key="@string/pref_audio_output_device_key"
      android:summary="%s"
      android:title="@string/title_pref_audio_output_device" />
  <MultiSelectListPreference
      android:dialogTitle="@string/title_pref_speaker_devices"
      android:key="@string/pref_speaker_devices_key"
      android:title="@string/title_pref_speaker_devices" />
  <com.google.android.accessibility.talkback.preference.base.CommandSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_speakerphone_away_from_ear_key"
      android:title="@string/title_pref_speakerphone_away_from_ear"
      android:summary="@string/summary_pref_speakerphone_away_from_ear" />
  <com.google.android.accessibility.talkback.preference.base.CommandSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_reset_accessibility_audio_key"
      android:title="@string/title_pref_reset_accessibility_audio" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:key="@string/pref_speech_stream_key"
      android:title="@string/title_pref_speech_stream_control"
      android:entries="@array/pref_speech_stream_entries"
      android:entryValues="@array/pref_speech_stream_values"
      android:summary="%s" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_sandfly_volume_bluetooth"
      android:title="@string/title_pref_sandfly_volume_bluetooth" />
  <com.google.android.accessibility.talkback.preference.base.PercentSeekBarPreference
      android:defaultValue="100"
      android:dependency="pref_sandfly_volume_bluetooth"
      android:key="pref_sandfly_volume_percent"
      android:max="200"
      android:title="@string/title_pref_sandfly_volume"
      app:min="5"
      app:seekBarIncrement="5" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_use_audio_focus_default"
      android:key="@string/pref_use_audio_focus_key"
      android:title="@string/title_pref_use_audio_focus"
      android:summary="@string/summary_audio_ducking" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:title="@string/title_pref_low_latency_audio"
      android:summary="@string/summary_pref_low_latency_audio"
      android:key="pref_low_latency_audio" />
</PreferenceScreen>
