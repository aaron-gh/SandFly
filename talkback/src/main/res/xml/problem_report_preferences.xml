<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="Incorrect behavior"
      android:entries="@array/problem_report_type_entries"
      android:entryValues="@array/problem_report_type_values"
      android:key="@string/pref_problem_report_type_key"
      android:title="@string/title_pref_problem_report_type"
      app:useSimpleSummaryProvider="true" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:entries="@array/problem_report_area_entries"
      android:entryValues="@array/problem_report_area_values"
      android:key="@string/pref_problem_report_area_key"
      android:title="@string/title_pref_problem_report_area"
      app:useSimpleSummaryProvider="true" />
  <EditTextPreference
      android:key="@string/pref_problem_report_title_key"
      android:title="@string/title_pref_problem_report_title"
      app:useSimpleSummaryProvider="true" />
  <EditTextPreference
      android:key="@string/pref_problem_report_app_key"
      android:title="@string/title_pref_problem_report_app"
      app:useSimpleSummaryProvider="true" />
  <EditTextPreference
      android:dialogMessage="@string/dialog_message_problem_report_description"
      android:key="@string/pref_problem_report_description_key"
      android:title="@string/title_pref_problem_report_description"
      app:useSimpleSummaryProvider="true" />
  <EditTextPreference
      android:key="@string/pref_problem_report_steps_key"
      android:title="@string/title_pref_problem_report_steps"
      app:useSimpleSummaryProvider="true" />
  <EditTextPreference
      android:key="@string/pref_problem_report_email_key"
      android:title="@string/title_pref_problem_report_email"
      app:useSimpleSummaryProvider="true" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_problem_report_device_key"
      android:title="@string/title_pref_problem_report_device" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_problem_report_log_key"
      android:summary="@string/summary_pref_problem_report_log"
      android:title="@string/title_pref_problem_report_log" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_problem_report_send_key"
      android:persistent="false"
      android:title="@string/title_pref_problem_report_send" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_problem_report_clear_key"
      android:persistent="false"
      android:title="@string/title_report_delete_draft" />
</PreferenceScreen>
