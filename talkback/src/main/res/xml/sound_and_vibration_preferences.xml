<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_sounds_category_sounds"
      android:title="@string/sounds_category_sounds">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_soundback_default"
        android:key="@string/pref_soundback_key"
        android:title="@string/title_pref_soundback" />
    <com.google.android.accessibility.talkback.preference.base.PercentSeekBarPreference
        android:dependency="@string/pref_soundback_key"
        android:key="@string/pref_soundback_volume_seekbar_key_int"
        android:persistent="false"
        android:title="@string/title_pref_soundback_volume" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.soundthemes.SoundThemesFragment"
        android:key="pref_sound_themes"
        android:title="@string/title_pref_sound_themes"
        android:summary="@string/summary_pref_sound_themes" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_control_sounds_speak_roles"
        android:title="@string/title_pref_control_sounds_speak_roles"
        android:summary="@string/summary_pref_control_sounds_speak_roles" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_sounds_category_vibration"
      android:title="@string/sounds_category_vibration">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_vibration_default"
        android:key="@string/pref_vibration_key"
        android:title="@string/title_pref_vibration" />
    <com.google.android.accessibility.talkback.preference.base.PercentSeekBarPreference
        android:defaultValue="@integer/pref_vibration_strength_default"
        android:dependency="@string/pref_vibration_key"
        android:key="@string/pref_vibration_strength_key"
        android:title="@string/title_pref_vibration_strength" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.individualfeedback.IndividualFeedbackFragment"
      android:key="pref_individual_feedback"
      android:title="@string/title_pref_individual_feedback"
      android:summary="@string/summary_pref_individual_feedback" />
</PreferenceScreen>
