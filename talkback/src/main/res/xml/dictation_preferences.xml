<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_dictation_recognition_choice"
      android:order="0"
      android:persistent="false"
      android:title="@string/title_pref_dictation_recognition" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="pref_dictation_rambler_live"
      android:order="1"
      android:title="@string/title_pref_dictation_rambler_live" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_dictation_google_download"
      android:order="2"
      android:persistent="false"
      android:title="@string/dictation_google_download" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="0"
      android:entries="@array/pref_dictation_auto_stop_entries"
      android:entryValues="@array/pref_dictation_auto_stop_values"
      android:key="pref_dictation_auto_stop_ms"
      android:order="3"
      android:summary="%s"
      android:title="@string/title_pref_dictation_auto_stop" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_dictation_ai"
      android:order="4"
      android:title="@string/title_pref_category_ai_services">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_ai_dictation_default"
        android:key="@string/pref_ai_dictation_key"
        android:title="@string/title_pref_ai_dictation" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:dependency="@string/pref_ai_dictation_key"
        android:key="pref_dictation_ai_service_choice"
        android:persistent="false"
        android:title="@string/title_pref_dictation_ai_service" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>

</PreferenceScreen>
