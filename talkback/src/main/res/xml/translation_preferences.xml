<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_translation_service_choice"
      android:persistent="false"
      android:title="@string/title_pref_translation_service" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_translation_source_choice"
      android:persistent="false"
      android:title="@string/title_pref_translation_source" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_translation_target_choice"
      android:persistent="false"
      android:title="@string/title_pref_translation_target" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_translation_second_target_choice"
      android:persistent="false"
      android:title="@string/title_pref_translation_second_target" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_translation_swap_action"
      android:persistent="false"
      android:title="@string/title_pref_translation_swap" />

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_translation_auto_category"
      android:order="50"
      android:title="@string/title_pref_translation_auto">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_translation_auto"
        android:title="@string/title_pref_translation_auto" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_translation_auto_service_choice"
        android:persistent="false"
        android:title="@string/title_pref_translation_auto_service" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_translation_untranslated_choice"
        android:persistent="false"
        android:title="@string/title_pref_translation_untranslated" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_translation_speech"
      android:order="100"
      android:title="@string/translation_category_speech">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="true"
        android:key="pref_translation_target_voice"
        android:title="@string/title_pref_translation_target_voice" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_translation_say_source"
        android:title="@string/title_pref_translation_say_source" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_translation_copy"
        android:title="@string/title_pref_translation_copy" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>

</PreferenceScreen>
