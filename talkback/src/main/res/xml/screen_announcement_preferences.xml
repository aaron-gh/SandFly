<?xml version="1.0" encoding="UTF-8"?>
<!-- What Backtalk says when the screen turns off or on and when the phone is unlocked. The keys
     and defaults match ScreenAnnouncementSettings, except the time, which is an older setting. The
     status items after the time are separate from the status gesture's Status readout. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_screen_announcements_screen_off_category"
      android:title="@string/title_screen_announcements_screen_off">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="true"
        android:key="pref_screen_off_say_screen_off"
        android:title="@string/title_pref_say_screen_off" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="true"
        android:key="pref_screen_off_ringer_mode"
        android:summary="@string/summary_pref_announce_ringer_mode"
        android:title="@string/title_pref_announce_ringer_mode" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_screen_announcements_screen_on_category"
      android:title="@string/title_screen_announcements_screen_on">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_tell_time_default"
        android:key="@string/pref_speak_time_key"
        android:title="@string/title_pref_announce_time" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_screen_on_battery"
        android:summary="@string/status_item_battery_summary"
        android:title="@string/status_item_battery" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_screen_on_wifi"
        android:summary="@string/status_item_wifi_summary"
        android:title="@string/status_item_wifi" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_screen_on_mobile_network"
        android:summary="@string/status_item_mobile_summary"
        android:title="@string/status_item_mobile" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_screen_on_ringer"
        android:summary="@string/status_item_ringer_summary"
        android:title="@string/status_item_ringer" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_screen_on_airplane_mode"
        android:summary="@string/status_item_airplane_mode_summary"
        android:title="@string/status_item_airplane_mode" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_screen_announcements_unlock_category"
      android:title="@string/title_screen_announcements_unlock">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="true"
        android:key="pref_unlock_say_unlocked"
        android:title="@string/title_pref_say_device_unlocked" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
