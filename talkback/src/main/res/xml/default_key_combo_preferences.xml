<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:key="@string/pref_keymap_category_key"
        android:title="@string/keycombo_menu_category_select_keymap">
        <ListPreference
            android:key="@string/pref_select_keymap_key"
            android:title="@string/keycombo_menu_select_keymap"
            android:summary="%s"
            android:defaultValue="@string/default_keymap_entry_value"
            android:entries="@array/pref_select_keymap_entries"
            android:entryValues="@array/pref_select_keymap_values" />
        <ListPreference
            android:key="@string/pref_default_keymap_trigger_modifier_key"
            android:title="@string/keycombo_menu_choose_trigger_modifier"
            android:summary="%s"
            android:defaultValue="@string/trigger_modifier_alt_entry_value"
            android:entries="@array/pref_choose_trigger_modifier_entries"
            android:entryValues="@array/pref_choose_trigger_modifier_values" />
        <PreferenceScreen
            android:key="@string/pref_reset_keymap_key"
            android:title="@string/keycombo_menu_reset_keymap" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_arrow_key_nav_category"
        android:title="@string/keycombo_menu_category_arrow_key_nav">
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_toggle"
            android:title="@string/arrow_key_nav_toggle" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_next_item"
            android:title="@string/keycombo_menu_navigate_next" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_previous_item"
            android:title="@string/keycombo_menu_navigate_previous" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_reading_control_down"
            android:title="@string/keycombo_menu_global_adjust_reading_setting_next" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_reading_control_up"
            android:title="@string/keycombo_menu_global_adjust_reading_settings_previous" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_click"
            android:title="@string/keycombo_menu_perform_click" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_next_reading_control"
            android:title="@string/keycombo_menu_global_scroll_forward_reading_menu" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_previous_reading_control"
            android:title="@string/keycombo_menu_global_scroll_backward_reading_menu" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_first_item"
            android:title="@string/keycombo_menu_navigate_first" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_last_item"
            android:title="@string/keycombo_menu_navigate_last" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_page_up"
            android:title="@string/title_viewpager_breakout_page_up" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_page_down"
            android:title="@string/title_viewpager_breakout_page_down" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_page_left"
            android:title="@string/arrow_key_nav_page_left" />
        <com.google.android.accessibility.talkback.preference.base.ArrowKeyNavKeyPreference
            android:key="arrow_key_nav_keys_page_right"
            android:title="@string/arrow_key_nav_page_right" />
    </PreferenceCategory>
</PreferenceScreen>
