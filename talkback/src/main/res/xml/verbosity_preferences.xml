<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="@string/pref_verbosity_key">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_verbosity_category_items"
      android:title="@string/verbosity_category_items">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_a11y_hints_default"
        android:key="@string/pref_a11y_hints_key"
        android:summary="@string/summary_pref_a11y_hints"
        android:title="@string/title_pref_a11y_hints" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_roles_default"
        android:key="@string/pref_speak_roles_key"
        android:summary="@string/pref_speak_roles_summary"
        android:title="@string/pref_speak_roles_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_role_without_pause_default"
        android:key="@string/pref_speak_role_without_pause_key"
        android:title="@string/pref_speak_role_without_pause_title" />
    <!-- Key matches ActionsAvailable. -->
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_speak_actions_available"
        android:title="@string/title_pref_speak_actions_available" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_container_element_positions_default"
        android:key="@string/pref_speak_container_element_positions_key"
        android:title="@string/pref_speak_list_positions_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_grid_positions_default"
        android:key="@string/pref_speak_grid_positions_key"
        android:title="@string/pref_speak_grid_positions_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ItemDetailsOrderFragment"
        android:key="@string/pref_node_desc_order_key"
        android:persistent="false"
        android:title="@string/pref_node_desc_order_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_element_ids_default"
        android:key="@string/pref_speak_element_ids_key"
        android:summary="@string/summary_pref_speak_element_ids"
        android:title="@string/title_pref_speak_element_ids" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_verbosity_category_text"
      android:title="@string/verbosity_category_text">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_punctuation_default"
        android:key="@string/pref_punctuation_key"
        android:visibility="invisible"
        android:title="@string/title_pref_punctuation" />
    <com.google.android.accessibility.talkback.preference.base.PunctuationListPreference
        android:defaultValue="@string/pref_punctuation_verbosity_default"
        android:entries="@array/pref_punctuation_entries"
        android:entryValues="@array/pref_punctuation_values"
        android:key="@string/pref_punctuation_verbosity"
        android:summary="%s"
        android:title="@string/title_pref_punctuation" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_punctuation_none_keep_meaning_default"
        android:key="@string/pref_punctuation_none_keep_meaning_key"
        android:title="@string/title_pref_punctuation_none_keep_meaning" />
    <ListPreference
        android:defaultValue="@string/pref_capital_letters_default"
        android:entries="@array/pref_capital_letters_entries"
        android:entryValues="@array/pref_capital_letters_values"
        android:key="@string/pref_capital_letters_key"
        android:summary="%s"
        android:title="@string/title_pref_capital_letters" />
    <ListPreference
        android:defaultValue="@string/pref_emoji_speech_default"
        android:entries="@array/pref_emoji_speech_entries"
        android:entryValues="@array/pref_emoji_speech_values"
        android:key="@string/pref_emoji_speech_key"
        android:summary="%s"
        android:title="@string/title_pref_emoji_speech" />
    <ListPreference
        android:defaultValue="@string/pref_emoji_repeat_count_default"
        android:entries="@array/pref_emoji_repeat_count_entries"
        android:entryValues="@array/pref_emoji_repeat_count_values"
        android:key="@string/pref_emoji_repeat_count_key"
        android:summary="%s"
        android:title="@string/title_pref_emoji_repeat_count" />
    <ListPreference
        android:defaultValue="@string/pref_emoji_after_name_default"
        android:entries="@array/pref_emoji_after_name_entries"
        android:entryValues="@array/pref_emoji_after_name_values"
        android:key="pref_emoji_after_name"
        android:summary="%s"
        android:title="@string/title_pref_emoji_after_name" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_count_repeated_symbols_default"
        android:key="@string/pref_count_repeated_symbols_key"
        android:summary="@string/summary_pref_count_repeated_symbols"
        android:title="@string/title_pref_count_repeated_symbols" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_formatting_inline_default"
        android:key="@string/pref_formatting_inline_key"
        android:summary="@string/summary_text_formatting_verbosity"
        android:title="@string/title_text_formatting_inline" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_formatting_inline_detail_key"
        android:dependency="@string/pref_formatting_inline_key"
        android:title="@string/title_text_formatting_verbosity_options"
        android:fragment="com.google.android.accessibility.talkback.preference.base.TextFormattingDetailFragment" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_table_headers_category_key"
      android:title="@string/commands_category_tables">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_table_speak_row_column_numbers_default"
        android:key="@string/pref_table_speak_row_column_numbers_key"
        android:summary="@string/pref_table_speak_row_column_numbers_summary"
        android:title="@string/pref_table_speak_row_column_numbers_title" />
    <ListPreference
        android:defaultValue="@string/pref_table_column_headers_default"
        android:entries="@array/pref_table_column_headers_entries"
        android:entryValues="@array/pref_table_column_headers_values"
        android:key="@string/pref_table_column_headers_key"
        android:summary="%s"
        android:title="@string/pref_table_column_headers_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_verbosity_category_announcements"
      android:title="@string/verbosity_category_announcements">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_window_names_default"
        android:entries="@array/pref_window_names_entries"
        android:entryValues="@array/pref_window_names_values"
        android:key="@string/pref_window_names_key"
        android:summary="%s"
        android:title="@string/title_pref_window_names" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_verbose_scroll_announcement_default"
        android:key="@string/pref_verbose_scroll_announcement_key"
        android:summary="@string/summary_pref_verbose_scroll_announcement"
        android:title="@string/title_pref_verbose_scroll_announcement" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_allow_frequent_content_change_announcement_default"
        android:key="@string/pref_allow_frequent_content_change_announcement_key"
        android:title="@string/pref_allow_frequent_content_change_announcement_title"
        android:summary="@string/summary_pref_allow_frequent_content_change_announcement" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_announce_full_charge_default"
        android:key="@string/pref_announce_full_charge_key"
        android:title="@string/title_pref_announce_full_charge" />
    <!-- Keys and values match BatteryLevelAnnouncements. VerbosityPrefFragment lists the voices. -->
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="off"
        android:dialogTitle="@string/title_pref_battery_level_interval"
        android:entries="@array/pref_battery_level_interval_entries"
        android:entryValues="@array/pref_battery_level_interval_values"
        android:key="pref_battery_level_interval"
        android:summary="%s"
        android:title="@string/title_pref_battery_level_interval" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue=""
        android:dialogTitle="@string/title_pref_battery_level_voice"
        android:key="pref_battery_level_voice_profile"
        android:summary="%s"
        android:title="@string/title_pref_battery_level_voice" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_announce_caller_default"
        android:dialogTitle="@string/title_pref_announce_caller"
        android:entries="@array/pref_announce_caller_entries"
        android:entryValues="@array/pref_announce_caller_values"
        android:key="@string/pref_announce_caller_key"
        android:summary="%s"
        android:title="@string/title_pref_announce_caller" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_announce_call_length_default"
        android:key="@string/pref_announce_call_length_key"
        android:title="@string/title_pref_announce_call_length" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_announce_keyboard_shown_hidden_default"
        android:key="@string/pref_announce_keyboard_shown_hidden_key"
        android:title="@string/title_pref_announce_keyboard_shown_hidden" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_screen_announcements"
        android:summary="@string/summary_pref_screen_announcements"
        android:title="@string/title_pref_screen_announcements"
        android:fragment="com.google.android.accessibility.talkback.preference.base.ScreenAnnouncementsFragment" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_time_feedback_format_default"
        android:dialogTitle="@string/pref_time_feedback_format_title"
        android:entries="@array/pref_time_feedback_format_entries"
        android:entryValues="@array/pref_time_feedback_format_values"
        android:key="@string/pref_time_feedback_format_key"
        android:summary="%s"
        android:title="@string/pref_time_feedback_format_title"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_time_seconds_default"
        android:key="@string/pref_time_seconds_key"
        android:title="@string/title_pref_time_seconds" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_time_seconds_screen_on_default"
        android:dependency="@string/pref_time_seconds_key"
        android:key="@string/pref_time_seconds_screen_on_key"
        android:title="@string/title_pref_time_seconds_screen_on" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.status.StatusReadoutFragment"
        android:key="@string/pref_status_readout_key"
        android:title="@string/title_pref_status_readout" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_verbosity_category_own_speech"
      android:title="@string/title_pref_category_own_speech">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_speak_user_focus_default"
        android:entries="@array/pref_speak_user_focus_entries"
        android:entryValues="@array/pref_speak_user_focus_values"
        android:key="@string/pref_speak_user_focus_key"
        android:summary="%s"
        android:title="@string/title_pref_speak_user_focus" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.feedbackpolicy.SpeakUserFocusAppsFragment"
        android:key="@string/pref_speak_user_focus_apps_key"
        android:persistent="false"
        android:title="@string/title_pref_speak_user_focus_apps" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_user_focus_assistant_audio_default"
        android:key="@string/pref_speak_user_focus_assistant_audio_key"
        android:title="@string/title_pref_speak_user_focus_assistant_audio" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.feedbackpolicy.KeyboardsWithOwnSpeechFragment"
        android:key="@string/pref_keyboards_with_own_speech_key"
        android:persistent="false"
        android:title="@string/title_pref_keyboards_with_own_speech" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
