<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:key="@string/pref_keymap_category_key"
        android:title="@string/keycombo_menu_category_select_keymap">
        <ListPreference
            android:key="@string/pref_select_keymap_key"
            android:title="@string/keycombo_menu_select_keymap"
            android:summary="%s"
            android:defaultValue="@string/new_keymap_entry_value"
            android:entries="@array/pref_select_keymap_entries"
            android:entryValues="@array/pref_select_keymap_values" />
        <ListPreference
            android:key="@string/pref_voiceover_keymap_trigger_modifier_key"
            android:title="@string/keycombo_menu_choose_trigger_modifier"
            android:summary="%s"
            android:defaultValue="@string/trigger_modifier_ctrl_alt_entry_value"
            android:entries="@array/pref_voiceover_keymap_sandfly_key_entries"
            android:entryValues="@array/pref_voiceover_keymap_sandfly_key_values" />
        <PreferenceScreen
            android:key="@string/pref_reset_keymap_key"
            android:title="@string/keycombo_menu_reset_keymap" />
        <PreferenceScreen
            android:key="@string/pref_view_system_keyboard_shortcuts_key"
            android:title="@string/keycombo_menu_view_system_keyboard_shortcuts" />
    </PreferenceCategory>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.commands.AppGesturesFragment"
        android:key="pref_app_keyboard_shortcuts_screen"
        android:persistent="false"
        android:title="@string/title_pref_app_keyboard_shortcuts">
        <extra android:name="shown_from" android:value="keyboard_shortcuts" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>

</PreferenceScreen>
