<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_lift_to_activate_default"
      android:dialogTitle="@string/title_pref_lift_to_activate"
      android:entries="@array/pref_lift_to_activate_entries"
      android:entryValues="@array/pref_lift_to_activate_values"
      android:key="@string/pref_lift_to_activate_key"
      android:summary="%s"
      android:title="@string/title_pref_lift_to_activate" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_single_tap_default"
      android:key="@string/pref_single_tap_key"
      android:summary="@string/summary_pref_single_tap"
      android:title="@string/title_pref_single_tap" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.preference.base.FocusDelayPrefFragment"
      android:key="@string/pref_touch_focus_time_out_key"
      app:summary="%s"
      android:title="@string/title_pref_touch_focus_timeout" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="pref_speak_nav_bar_buttons"
      android:summary="@string/summary_pref_speak_nav_bar_buttons"
      android:title="@string/title_pref_speak_nav_bar_buttons" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.directtouch.DirectTouchFragment"
      android:key="@string/pref_direct_touch_key"
      android:title="@string/title_pref_direct_touch" />
  <com.google.android.accessibility.talkback.preference.base.CommandSwitchPreference
      android:defaultValue="@bool/pref_fix_stuck_touch_exploration_default"
      android:key="@string/pref_fix_stuck_touch_exploration_key"
      android:title="@string/title_pref_fix_stuck_touch_exploration" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:title="@string/reset_latency_settings_title"
      android:key="@string/pref_reset_latency_settings_key"
      app:allowDividerBelow="true"/>
</PreferenceScreen>
