<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.keyboardecho.KeyboardEchoFragment"
      android:key="@string/pref_keyboard_echo_screen_key"
      android:title="@string/title_pref_keyboard_echo" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_double_tap_moves_cursor_default"
      android:key="@string/pref_double_tap_moves_cursor_key"
      android:title="@string/title_pref_double_tap_moves_cursor" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_typing_category_keyboard"
      android:title="@string/title_pref_on_screen_keyboard">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.TypingMethodPrefFragment"
        android:key="@string/pref_typing_confirmation_key"
        android:title="@string/title_pref_typing_confirmation"
        app:summary="%s" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_typing_swipes_through_keys_default"
        android:key="@string/pref_typing_swipes_through_keys_key"
        android:title="@string/title_pref_typing_swipes_through_keys" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_typing_long_press_duration_default"
        android:dialogTitle="@string/title_pref_typing_long_tap_duration"
        android:entries="@array/pref_typing_long_press_entries"
        android:entryValues="@array/pref_typing_long_press_values"
        android:key="@string/pref_typing_long_press_duration_key"
        android:summary="%s"
        android:title="@string/title_pref_typing_long_tap_duration" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_typing_hold_keys_down_default"
        android:key="@string/pref_typing_hold_keys_down_key"
        android:title="@string/title_pref_typing_hold_keys_down" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.TypingFocusDelayPrefFragment"
        android:key="@string/pref_typing_focus_time_out_key"
        app:summary="%s"
        android:title="@string/title_pref_touch_explore_timeout" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_cache_keyboard_keys_default"
        android:title="@string/title_pref_cache_keyboard_keys"
        android:summary="@string/summary_cache_keyboard_keys"
        android:key="@string/pref_cache_keyboard_keys" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_typing_category_physical_keyboard"
      android:title="@string/title_pref_physical_keyboard">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_keypad_letter_keys_default"
        android:key="@string/pref_keypad_letter_keys_key"
        android:title="@string/title_pref_keypad_letter_keys" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_enter_sends_messages_default"
        android:key="@string/pref_enter_sends_messages_key"
        android:title="@string/title_pref_enter_sends_messages" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_sandfly_keyboard_key"
        android:title="@string/sandfly_keyboard_name">
      <intent android:action="android.settings.INPUT_METHOD_SETTINGS" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_sandfly_keyboard_held_keys_default"
        android:entries="@array/pref_sandfly_keyboard_held_keys_entries"
        android:entryValues="@array/pref_sandfly_keyboard_held_keys_values"
        android:key="@string/pref_sandfly_keyboard_held_keys_key"
        android:summary="%s"
        android:title="@string/title_pref_sandfly_keyboard_held_keys" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.keyboard.DoublePressCharactersFragment"
        android:key="@string/pref_sandfly_keyboard_double_press_key"
        android:persistent="false"
        android:title="@string/title_pref_sandfly_keyboard_double_press" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_sandfly_keyboard_double_space_period_default"
        android:key="@string/pref_sandfly_keyboard_double_space_period_key"
        android:title="@string/title_pref_sandfly_keyboard_double_space_period" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_sandfly_keyboard_autocorrect_default"
        android:key="@string/pref_sandfly_keyboard_autocorrect_key"
        android:title="@string/title_pref_sandfly_keyboard_autocorrect" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_sandfly_keyboard_suggestions_default"
        android:key="@string/pref_sandfly_keyboard_suggestions_key"
        android:title="@string/title_pref_sandfly_keyboard_suggestions" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_sandfly_keyboard_suggestion_pause_default"
        android:entries="@array/pref_sandfly_keyboard_suggestion_pause_entries"
        android:entryValues="@array/pref_sandfly_keyboard_suggestion_pause_values"
        android:key="@string/pref_sandfly_keyboard_suggestion_pause_key"
        android:summary="%s"
        android:title="@string/title_pref_sandfly_keyboard_suggestion_pause" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_sandfly_keyboard_enter_types_suggestion_default"
        android:key="@string/pref_sandfly_keyboard_enter_types_suggestion_key"
        android:title="@string/title_pref_sandfly_keyboard_enter_types_suggestion" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_sandfly_keyboard_word_language_default"
        android:entries="@array/pref_sandfly_keyboard_word_language_entries"
        android:entryValues="@array/pref_sandfly_keyboard_word_language_values"
        android:key="@string/pref_sandfly_keyboard_word_language_key"
        android:summary="%s"
        android:title="@string/title_pref_sandfly_keyboard_word_language" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_sandfly_keyboard_delete_learned_words_key"
        android:persistent="false"
        android:title="@string/title_pref_sandfly_keyboard_delete_learned_words" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_password_characters_default"
        android:key="@string/pref_speak_password_characters_key"
        android:summary="@string/summary_pref_speak_password_characters"
        android:title="@string/title_pref_speak_password_characters" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_physical_keyboard_key"
        android:title="@string/title_pref_system_physical_keyboard" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_typing_category_other"
      android:title="@string/typing_category_other_input">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.dictation.DictationFragment"
        android:key="pref_dictation_screen"
        android:title="@string/title_pref_dictation" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_handwriting_keyboard_key"
        android:summary="@string/summary_pref_handwriting_keyboard"
        android:title="@string/title_pref_handwriting_keyboard">
      <intent android:action="android.settings.INPUT_METHOD_SETTINGS" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_handwriting_wait_default"
        android:dialogTitle="@string/title_pref_handwriting_wait"
        android:entries="@array/pref_handwriting_wait_entries"
        android:entryValues="@array/pref_handwriting_wait_values"
        android:key="@string/pref_handwriting_wait_key"
        android:summary="%s"
        android:title="@string/title_pref_handwriting_wait" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
