<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_volume_keys_adjust_sliders_default"
      android:key="@string/pref_volume_keys_adjust_sliders_key"
      android:summary="@string/summary_pref_volume_keys_adjust_sliders"
      android:title="@string/title_pref_volume_keys_adjust_sliders" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_volume_keys_move_cursor_default"
      android:key="@string/pref_volume_keys_move_cursor_key"
      android:summary="@string/summary_pref_volume_keys_move_cursor"
      android:title="@string/title_pref_volume_keys_move_cursor" />
  <com.google.android.accessibility.talkback.preference.base.GestureListPreference
      android:defaultValue="@string/shortcut_value_unassigned"
      android:key="@string/pref_volume_up_double_press_key"
      android:summary="%s"
      android:title="@string/title_pref_volume_up_double_press" />
  <com.google.android.accessibility.talkback.preference.base.GestureListPreference
      android:defaultValue="@string/shortcut_value_unassigned"
      android:key="@string/pref_volume_up_triple_press_key"
      android:summary="%s"
      android:title="@string/title_pref_volume_up_triple_press" />
  <com.google.android.accessibility.talkback.preference.base.GestureListPreference
      android:defaultValue="@string/shortcut_value_unassigned"
      android:key="@string/pref_volume_up_long_press_key"
      android:summary="%s"
      android:title="@string/title_pref_volume_up_long_press" />
  <com.google.android.accessibility.talkback.preference.base.GestureListPreference
      android:defaultValue="@string/shortcut_value_unassigned"
      android:key="@string/pref_volume_down_double_press_key"
      android:summary="%s"
      android:title="@string/title_pref_volume_down_double_press" />
  <com.google.android.accessibility.talkback.preference.base.GestureListPreference
      android:defaultValue="@string/shortcut_value_unassigned"
      android:key="@string/pref_volume_down_triple_press_key"
      android:summary="%s"
      android:title="@string/title_pref_volume_down_triple_press" />
  <com.google.android.accessibility.talkback.preference.base.GestureListPreference
      android:defaultValue="@string/shortcut_value_unassigned"
      android:key="@string/pref_volume_down_long_press_key"
      android:summary="%s"
      android:title="@string/title_pref_volume_down_long_press" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_volume_key_long_press_duration_default"
      android:dialogTitle="@string/title_pref_volume_key_long_press_duration"
      android:entries="@array/pref_volume_key_long_press_duration_entries"
      android:entryValues="@array/pref_volume_key_long_press_duration_values"
      android:key="@string/pref_volume_key_long_press_duration_key"
      android:summary="%s"
      android:title="@string/title_pref_volume_key_long_press_duration" />
  <com.google.android.accessibility.talkback.preference.base.AccessibilityFooterPreference
      android:key="@string/pref_speech_footer_key"
      android:title="@string/title_pref_speech_footer"
      android:selectable="false" />
</PreferenceScreen>
