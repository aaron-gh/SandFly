<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_wrap_around_default"
      android:key="@string/pref_wrap_around_key"
      android:summary="@string/summary_pref_wrap_around"
      android:title="@string/title_pref_wrap_around" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_stop_before_wrap_default"
      android:dependency="@string/pref_wrap_around_key"
      android:key="@string/pref_stop_before_wrap_key"
      android:title="@string/title_pref_stop_before_wrap" />
  <!-- No default: until it is set, it follows Wrap around, which NavigationPrefFragment shows. -->
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:key="@string/pref_wrap_around_reading_controls_key"
      android:title="@string/title_pref_wrap_around_reading_controls" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_leave_system_bars_default"
      android:key="@string/pref_leave_system_bars_key"
      android:title="@string/title_pref_leave_system_bars" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_focus_new_windows_default"
      android:key="@string/pref_focus_new_windows_key"
      android:title="@string/title_pref_focus_new_windows" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_speak_items_before_scroll_default"
      android:title="@string/title_pref_speak_items_before_scroll"
      android:key="@string/pref_speak_items_before_scroll_key" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_scroll_ahead_default"
      android:key="@string/pref_scroll_ahead_key"
      android:title="@string/title_pref_scroll_ahead" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_speak_while_scrolling_default"
      android:key="@string/pref_speak_while_scrolling_key"
      android:title="@string/title_pref_speak_while_scrolling" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_focus_text_inside_items_default"
      android:key="@string/pref_focus_text_inside_items_key"
      android:title="@string/title_pref_focus_text_inside_items" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_auto_enter_table_navigation_default"
      android:key="@string/pref_auto_enter_table_navigation_key"
      android:title="@string/pref_auto_enter_table_navigation_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_smart_browse_mode_default"
      android:key="@string/pref_smart_browse_mode_key"
      android:title="@string/title_smart_browse_mode"
      android:summary="@string/summary_smart_browse_mode" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_browse_mode_per_app_default"
      android:key="@string/pref_browse_mode_per_app_key"
      android:title="@string/title_pref_browse_mode_per_app" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_sliders_key"
      android:title="@string/title_pref_category_sliders">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_slider_step_default"
        android:dialogTitle="@string/title_pref_slider_step"
        android:entries="@array/pref_slider_step_entries"
        android:entryValues="@array/pref_slider_step_values"
        android:key="@string/pref_slider_step_key"
        android:summary="%s"
        android:title="@string/title_pref_slider_step" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_slider_skip_unchanged_default"
        android:key="@string/pref_slider_skip_unchanged_key"
        android:title="@string/title_pref_slider_skip_unchanged" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_navigation_apps_category"
      android:title="@string/title_pref_category_apps">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_telegram_reply_quotes_default"
        android:key="@string/pref_telegram_reply_quotes_key"
        android:title="@string/title_pref_telegram_reply_quotes" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
