    <string name="sandfly_tutorial_tile_sun">Sol</string>
    <string name="sandfly_tutorial_title">Titorial de SandFly</string>
    <string name="sandfly_tutorial_typing_delete">Elimina a última letra coa tecla de eliminar do teclado.</string>
    <string name="sandfly_tutorial_typing_intro">Ao activar un campo de texto ábrese o teclado. Toca unha tecla para oíla e levanta o dedo para escribila.</string>
    <string name="sandfly_tutorial_typing_open">Vai ao campo <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para comezar a escribir.</string>
    <string name="sandfly_tutorial_typing_title">Escritura</string>
    <string name="sandfly_tutorial_typing_type">Escribe a palabra <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_word">gato</string>
    <string name="sandfly_tutorial_welcome_intro">Este titorial ensina os xestos de SandFly. Cada lección dá unha instrución, agarda ata que a fagas cos teus propios xestos e despois dá a seguinte. A instrución é o primeiro elemento despois do nome da lección. Contido lista todas as leccións, e o titorial ábrese de novo na lección na que estabas.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> en calquera lugar da pantalla para comezar.</string>
    <string name="sandfly_tutorial_welcome_title">Benvida</string>
</resources>
