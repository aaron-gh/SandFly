    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> para pechar o menú.</string>
    <string name="sandfly_tutorial_menu_intro">O menú de SandFly ten comandos para o elemento enfocado e para a pantalla actual.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir o menú de SandFly. Percorre os seus comandos pasando o dedo. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> pecha o menú.</string>
    <string name="sandfly_tutorial_menu_title">Menú de SandFly</string>
    <string name="sandfly_tutorial_message">Mensaxe de Sam: xantamos ao mediodía?</string>
    <string name="sandfly_tutorial_message_archive">Arquivar</string>
    <string name="sandfly_tutorial_message_delete">Eliminar</string>
    <string name="sandfly_tutorial_message_reply">Responder</string>
    <string name="sandfly_tutorial_move_intro">Ao pasar o dedo, vaise ao elemento seguinte ou anterior da pantalla, na orde de lectura.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> para ir ao seguinte elemento. Continúa ata chegar a <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> para ir ao elemento anterior. Volve a <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_title">Moverse entre elementos</string>
    <string name="sandfly_tutorial_name">Nome</string>
    <string name="sandfly_tutorial_next_lesson">Seguinte lección: <xliff:g id="lesson" example="Activating items">%1$s</xliff:g></string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> non ten ningún xesto. Asigna un en Comandos ou usa Omitir paso.</string>
    <string name="sandfly_tutorial_not_in_lesson"><xliff:g id="action" example="Home">%1$s</xliff:g> non se executa nunha lección. Para saír do titorial, usa Pechar titorial en Contido.</string>
    <string name="sandfly_tutorial_not_in_lesson_short"><xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> non se executa nunha lección.</string>
    <string name="sandfly_tutorial_pause_intro">A voz pódese poñer en pausa no medio dun elemento e retomarse onde se detivo.</string>
    <string name="sandfly_tutorial_pause_pause">Vai á historia de abaixo. <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> mentres se le para poñer a voz en pausa, e outra vez para retomala.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> outra vez para retomar a voz.</string>
    <string name="sandfly_tutorial_pause_title">Poñer a voz en pausa</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_practice_intro">Cada xesto di o seu nome e a súa acción en lugar de realizala. Ir ao elemento seguinte e ao anterior e activar seguen funcionando.</string>
    <string name="sandfly_tutorial_practice_step">Fai calquera xesto para oír o que fai. Para parar, activa <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_title">Práctica de xestos</string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> de <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Cambia o control de lectura a <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para moverte un carácter.</string>
    <string name="sandfly_tutorial_reading_controls_intro">Os controis de lectura determinan o que fai pasar o dedo cara arriba e cara abaixo, como moverse por palabras ou por caracteres, ou cambiar a velocidade da fala. Pasar o dedo á dereita e á esquerda segue movendo entre elementos.</string>
    <string name="sandfly_tutorial_reading_controls_move">Vai á frase de abaixo.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para ir á seguinte palabra. Avanza tres palabras.</string>
    <string name="sandfly_tutorial_reading_controls_title">Controis de lectura</string>
    <string name="sandfly_tutorial_recipe_1">Filloas: mestura fariña, ovos e leite ata obter unha masa lisa.</string>
    <string name="sandfly_tutorial_recipe_2">Quenta un pouco de manteiga nunha tixola.</string>
    <string name="sandfly_tutorial_recipe_3">Bota masa abonda para cubrir a tixola cunha capa fina.</string>
    <string name="sandfly_tutorial_recipe_4">Dálle a volta á filloa cando a parte de abaixo estea dourada.</string>
    <string name="sandfly_tutorial_recipe_5">Serve con limón e azucre.</string>
    <string name="sandfly_tutorial_scrolling_intro">As listas só mostran algúns dos seus elementos á vez. Ao pasar o dedo máis alá do último elemento mostrado, desprázase a lista.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> para avanzar unha páxina.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> pola lista ata chegar a <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_title">Desprazar listas</string>
    <string name="sandfly_tutorial_sentence">O raposo marrón rápido salta sobre o can preguiceiro.</string>
    <string name="sandfly_tutorial_skip_step">Omitir paso</string>
    <string name="sandfly_tutorial_sliders_change">Vai ao control desprazable <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para cambiar o seu valor.</string>
    <string name="sandfly_tutorial_sliders_highest">Pon <xliff:g id="slider" example="Brightness">%1$s</xliff:g> ao 100 por cento, o seu valor máximo.</string>
    <string name="sandfly_tutorial_sliders_intro">Cando un control desprazable está enfocado, pasar o dedo cara arriba e cara abaixo cambia o seu valor.</string>
    <string name="sandfly_tutorial_sliders_title">Controis desprazables</string>
    <string name="sandfly_tutorial_step">Paso <xliff:g id="number" example="1">%1$d</xliff:g> de <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">Os flebótomos son pequenas moscas que viven en praias, en ribeiras de ríos e en bosques. Están máis activos ao amencer e ao solpor, cando o aire está quieto. Só pican as femias, porque necesitan sangue para producir os ovos. As picadas proen durante días, así que quen visita as zonas onde viven leva repelente de insectos. Os flebótomos voan mal, e ata unha brisa lixeira os mantén afastados.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> para volver atrás.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> para ir á pantalla de inicio.</string>
    <string name="sandfly_tutorial_system_intro">Estes xestos funcionan en todas as pantallas. Nesta lección, o titorial di o que fai cada un en lugar de facelo.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> para abrir as notificacións.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> para mostrar as aplicacións recentes.</string>
    <string name="sandfly_tutorial_system_title">Atrás, Inicio e notificacións</string>
