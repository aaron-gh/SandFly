    <string name="sandfly_tutorial_lesson_complete_last">Lección completada. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para finalizar o titorial.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Lección completada. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para iniciar a seguinte lección.</string>
