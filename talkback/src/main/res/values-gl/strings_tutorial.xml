    <string name="sandfly_tutorial_forecast_tomorrow">Mañá</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Nubrado pola mañá, con choiva desde o mediodía.</string>
    <string name="sandfly_tutorial_forecast_weekend">Fin de semana</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Vento o sábado, ceo despexado o domingo.</string>
    <string name="sandfly_tutorial_headings_intro">As pantallas e as páxinas web dividen o seu contido con títulos. O control de lectura Títulos salta dun título ao seguinte.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> para saltar ao seguinte título. Salta a <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
