<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sandfly_tutorial_actions_archive">Vai á mensaxe. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> para percorrer as súas accións. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> para realizar a acción que oes. Realiza <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_actions_intro">Algúns elementos teñen accións ademais de activalos, como Arquivar ou Eliminar nunha mensaxe. Mentres un destes elementos está enfocado, o control de lectura Accións percorre esas accións.</string>
    <string name="sandfly_tutorial_actions_title">Accións</string>
    <string name="sandfly_tutorial_activate_button">Vai a <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> para activalo.</string>
    <string name="sandfly_tutorial_activate_check_box">Marca <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> da mesma maneira.</string>
    <string name="sandfly_tutorial_activate_hold">Algúns elementos fan outra cousa se se manteñen premidos. Vai a <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> para mantelo premido.</string>
    <string name="sandfly_tutorial_activate_intro">A activación funciona sobre o elemento enfocado, toques onde toques na pantalla.</string>
    <string name="sandfly_tutorial_activate_title">Activar elementos</string>
    <string name="sandfly_tutorial_back_in_lesson">Atrás non sae dunha lección. Para escoller outra lección, usa Contido.</string>
    <string name="sandfly_tutorial_bell">Tocar o timbre</string>
    <string name="sandfly_tutorial_bell_rung">Veces tocado: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_brightness">Brillo</string>
