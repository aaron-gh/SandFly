    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> ou <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> para cambiar o control de lectura. Escolle <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_close">Pechar titorial</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> para copiar no portapapeis o último texto que dixo SandFly.</string>
    <string name="sandfly_tutorial_commands_intro">Estes comandos funcionan en todas as pantallas.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> para buscar texto na pantalla. Nesta lección, o titorial di o que fai o comando en lugar de executalo.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> para desactivar a voz, e outra vez para activala. Nesta lección, o titorial di o que fai o comando en lugar de executalo.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> para oír a hora, o nivel de batería e outros datos de estado.</string>
    <string name="sandfly_tutorial_commands_title">Comandos útiles</string>
    <string name="sandfly_tutorial_contents">Contido</string>
    <string name="sandfly_tutorial_contents_intro">Leccións, en orde. Cada unha pódese abrir por separado.</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly pode ler desde o elemento enfocado ata o final da pantalla sen pasar o dedo. Ao tocar a pantalla, detense a lectura.</string>
    <string name="sandfly_tutorial_continuous_move">Vai á primeira liña da receita.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> para ler desde o elemento enfocado.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> para abrir o menú de SandFly. Despois, escolle <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_continuous_title">Lectura continua</string>
