    <string name="title_pref_control_sounds">কন্ট্রোল সাউন্ড ও ভাইব্রেশন</string>
    <string name="summary_pref_control_sounds">ফোকাস সাউন্ড ও ভাইব্রেশনের বদলে প্রতিটি ধরনের কন্ট্রোলকে, যেমন বোতাম, চেকবক্স, এডিট ফিল্ড ও তালিকার আইটেমকে, থিম থেকে নিজস্ব সাউন্ড ও নিজস্ব ভাইব্রেশন দেয়, যেমন NVDA-এর জন্য Unspoken করে। কন্ট্রোলটি স্ক্রিনের যেখানে আছে সেদিক থেকে সাউন্ড বাজে এবং SandFly কন্ট্রোলের ধরন বলে না।</string>
    <string name="title_pref_control_sounds_speak_roles">তবুও কন্ট্রোলের ধরন বলুন</string>
    <string name="summary_pref_control_sounds_speak_roles">কন্ট্রোল সাউন্ড বাজলেও কন্ট্রোলের ধরন বলে, যেমন বোতাম। এটি সব সাউন্ড থিমের জন্য প্রযোজ্য।</string>
