    <string name="sandfly_tutorial_actions_archive">মেসেজে যান। এর অ্যাকশনগুলিতে যেতে: <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> বা <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>। শোনা অ্যাকশনটি করতে: <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g>। <xliff:g id="action" example="Archive">%4$s</xliff:g> করুন।</string>
