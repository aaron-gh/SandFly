    <string name="sandfly_tutorial_recipe_5">লেবু ও চিনি দিয়ে পরিবেশন করুন।</string>
    <string name="sandfly_tutorial_scrolling_intro">তালিকা একবারে তার কিছু আইটেমই দেখায়। দেখানো শেষ আইটেম পেরিয়ে সোয়াইপ করলে তালিকা স্ক্রল হয়।</string>
    <string name="sandfly_tutorial_scrolling_page">এক পৃষ্ঠা সামনে স্ক্রল করতে: <xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="item" example="Item 15">%2$s</xliff:g> পর্যন্ত পৌঁছাতে তালিকায়: <xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_scrolling_title">তালিকা স্ক্রল করা</string>
    <string name="sandfly_tutorial_sentence">চটপটে বাদামি শিয়াল অলস কুকুরের উপর দিয়ে লাফ দেয়।</string>
    <string name="sandfly_tutorial_skip_step">ধাপ এড়িয়ে যান</string>
    <string name="sandfly_tutorial_sliders_change"><xliff:g id="slider" example="Brightness">%3$s</xliff:g> স্লাইডারে যান। এর মান পরিবর্তন করতে: <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> বা <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g>।</string>
    <string name="sandfly_tutorial_sliders_highest"><xliff:g id="slider" example="Brightness">%1$s</xliff:g> এর সর্বোচ্চ মান, ১০০ শতাংশে সেট করুন।</string>
    <string name="sandfly_tutorial_sliders_intro">কোনও স্লাইডারে ফোকাস থাকলে উপরে ও নিচে সোয়াইপ করলে এর মান পরিবর্তন হয়।</string>
    <string name="sandfly_tutorial_sliders_title">স্লাইডার</string>
    <string name="sandfly_tutorial_step">ধাপ <xliff:g id="count" example="2">%2$d</xliff:g>-এর মধ্যে <xliff:g id="number" example="1">%1$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_story">স্যান্ডফ্লাই হল ছোট মাছি, যারা সমুদ্রসৈকতে, নদীর তীরে ও বনে থাকে। ভোরে ও সন্ধ্যায়, যখন বাতাস স্থির থাকে, তখন তারা সবচেয়ে সক্রিয়। শুধু স্ত্রী মাছিরা কামড়ায়, কারণ ডিম তৈরির জন্য তাদের রক্ত দরকার। কামড়ের জায়গা কয়েক দিন চুলকায়, তাই স্যান্ডফ্লাইয়ের এলাকায় যারা যায় তারা পোকা তাড়ানোর ওষুধ নিয়ে যায়। স্যান্ডফ্লাই দুর্বল উড়িয়ে, আর হালকা বাতাসও তাদের দূরে রাখে।</string>
    <string name="sandfly_tutorial_system_back">ফিরে যেতে: <xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_home">হোম স্ক্রিনে যেতে: <xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_intro">এই জেসচারগুলি প্রতিটি স্ক্রিনে কাজ করে। এই পাঠে টিউটোরিয়াল প্রতিটি জেসচারের কাজ না করে সেটি কী করে তা বলে।</string>
    <string name="sandfly_tutorial_system_notifications">বিজ্ঞপ্তি খুলতে: <xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_overview">সাম্প্রতিক অ্যাপ দেখাতে: <xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_system_title">ফিরুন, হোম ও বিজ্ঞপ্তি</string>
    <string name="sandfly_tutorial_tile_cloud">মেঘ</string>
    <string name="sandfly_tutorial_tile_moon">চাঁদ</string>
    <string name="sandfly_tutorial_tile_star">তারা</string>
    <string name="sandfly_tutorial_tile_sun">সূর্য</string>
    <string name="sandfly_tutorial_title">SandFly টিউটোরিয়াল</string>
    <string name="sandfly_tutorial_typing_delete">কীবোর্ডের Delete কী দিয়ে শেষ অক্ষর মুছুন।</string>
    <string name="sandfly_tutorial_typing_intro">টেক্সট ফিল্ড অ্যাক্টিভেট করলে কীবোর্ড খোলে। কী শুনতে স্পর্শ করুন, এবং টাইপ করতে আঙুল তুলুন।</string>
    <string name="sandfly_tutorial_typing_open"><xliff:g id="field" example="Name">%2$s</xliff:g> ফিল্ডে যান। টাইপ করা শুরু করতে: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_typing_title">টাইপিং</string>
    <string name="sandfly_tutorial_typing_type"><xliff:g id="word" example="cat">%1$s</xliff:g> শব্দটি টাইপ করুন।</string>
    <string name="sandfly_tutorial_typing_word">ঘর</string>
    <string name="sandfly_tutorial_welcome_intro">এই টিউটোরিয়াল SandFly-এর জেসচার শেখায়। প্রতিটি পাঠ একটি নির্দেশ দেয়, আপনি নিজের জেসচার দিয়ে সেটি না করা পর্যন্ত অপেক্ষা করে, তারপর পরেরটি দেয়। নির্দেশটি পাঠের নামের পরের প্রথম আইটেম। “সূচিপত্র” সব পাঠ দেখায়, এবং টিউটোরিয়াল আপনি যে পাঠে ছিলেন সেখানেই আবার খোলে।</string>
    <string name="sandfly_tutorial_welcome_start">শুরু করতে স্ক্রিনের যেকোনও জায়গায়: <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g>।</string>
    <string name="sandfly_tutorial_welcome_title">স্বাগতম</string>
